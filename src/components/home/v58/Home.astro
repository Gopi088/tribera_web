const coverageGroups = [
  {
    name: 'Engineering & infrastructure',
    roles: [
      'Software engineering',
      'Platform & infrastructure',
      'Data engineering & analytics',
      'AI & machine learning',
      'Cybersecurity',
      'Networks & DC',
    ],
    focus:
      'System design and scale, pipelines and modelling, incidents and reliability, threat models and response, model design and evaluation, routing and fabric.',
  },
  {
    name: 'Finance & risk',
    roles: [
      'Finance & accounting systems',
      'Finance operations',
      'Risk, controls & compliance',
      'Commercial & revenue analytics',
      'Capital markets',
    ],
    focus: 'Controls and transformation, audits and exposure, risk and the trade lifecycle.',
  },
  {
    name: 'Operations',
    roles: ['Supply chain & planning', 'Procurement & sourcing', 'HR operations', 'Manufacturing'],
    focus:
      'Planning and cost in supply chain and manufacturing. We confirm the expertise needed for procurement and HR operations on the first call.',
  },
  {
    name: 'Product & leadership',
    roles: ['Product & design', 'Technology leadership'],
    focus: 'Product judgment and design craft.',
  },
];
const rubricDimensions: Array<[string, string, string, number, number]> = [
  ['A', 'System building & ownership', 'Systems built', 5, 7],
  ['B', 'Detection & prevention design', 'Detection', 5, 7],
  ['C', 'AI / LLM security basics', 'LLM security', 2, 6],
  ['D', 'ML / LLM pipeline fundamentals', 'ML pipeline', 5, 6],
  ['E', 'Python automation & tooling', 'Python', 4, 5],
  ['F', 'Secure data access', 'Data access', 2, 4],
  ['G', 'Cloud deployment & runtime', 'Cloud runtime', 4, 4],
  ['H', 'Incident handling & ownership', 'Incidents', 3, 5],
  ['I', 'Authenticity', 'Authenticity', 4, 6],
];
const funnelStages = [
  ['126', 'Sourced & screened', 'Every CV reviewed. Forty worth a conversation.', 'tribera'],
  ['40', 'A first conversation', 'An HR interview. Fourteen progressed to an expert.', 'tribera'],
  ['14', 'Interviewed by an expert', 'Forty-five minutes on the technical work. Five cleared the bar.', 'tribera'],
  ['5', 'Sent to their team', 'Five qualified candidates. The first names their team saw.', 'their team'],
  ['2', 'They hired two', 'Five interviews. Two hires.', 'their team'],
];
const funnelTiers = Array.from({ length: 126 }, (_, index): number => {
  return index < 86 ? 1 : index < 112 ? 2 : index < 121 ? 3 : index < 124 ? 4 : 5;
});
// Seeded Fisher-Yates keeps the scatter stable across renders and stage changes.
let funnelSeed = 0x58f126;
for (let index = funnelTiers.length - 1; index > 0; index -= 1) {
  funnelSeed ^= funnelSeed << 13;
  funnelSeed ^= funnelSeed >>> 17;
  funnelSeed ^= funnelSeed << 5;
  const swapIndex = Math.floor(((funnelSeed >>> 0) / 4294967296) * (index + 1));
  [funnelTiers[index], funnelTiers[swapIndex]] = [funnelTiers[swapIndex], funnelTiers[index]];
}
const funnelColors = ['#3a3a37', '#585852', '#8a8a83', '#d7d7d1', '#DA0007'];
const heroFieldSquares = Array.from({ length: 306 }, (_, index) => index);
const heroFieldAccents = new Set([3, 32, 275, 302]);
const heroClients = [
  'Mizuho',
  'Capco',
  'Deloitte',
  'ArcelorMittal',
  'Flipkart',
  'Myntra',
  'Motherson',
  'Publicis Sapient',
  'Publicis Resources',
  'Evident Microscopy',
  'Antz',
];
const testimonials = [
  [
    'Hiring team',
    'The profiles were consistently high quality and well matched to what we were looking for. Your team stayed proactive throughout - anticipating our needs, responding quickly and staying closely engaged until every candidate was onboarded. That responsiveness made a real difference in helping us meet our customer commitments on time.',
    'Sashank Pappu',
    'Founder & CEO, Antz AI',
  ],
  [
    'Candidate',
    'From the very first conversation, the process was handled with professionalism, transparency and steady communication. A special mention to Chyna from Tribera, who understood my background and stayed with me the whole way - coordinating interviews, sharing timely updates and offering guidance at every stage. She made a stressful process feel genuinely smooth.',
    'Anil Giri',
    'Placed through Tribera',
  ],
  [
    'Candidate',
    'From the initial shortlisting of my profile to coordinating the discussions and interview rounds, the team kept a high level of professionalism, responsiveness and transparency. Expectations, timelines, feedback and next steps were communicated clearly at every stage - which made the whole process feel smooth, structured and genuinely well-run.',
    'Reema Mitra',
    'Placed through Tribera',
  ],
];
