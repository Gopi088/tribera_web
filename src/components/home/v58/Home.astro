<script>
  document.querySelectorAll<HTMLElement>('[data-v58-count]').forEach((counter) => {
    const target = Number(counter.dataset.v58Count);
    const finish = () => {
      counter.textContent = String(target);
    };
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      finish();
      return;
    }
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        const startedAt = performance.now();
        const tick = (now: number) => {
          const progress = Math.min((now - startedAt) / 1100, 1);
          counter.textContent = String(Math.round((1 - (1 - progress) ** 3) * target));
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        observer.disconnect();
      },
      { threshold: 0.7 }
    );
    observer.observe(counter);
  });

  const lab = document.querySelector('[data-v58-lab]');

  if (lab instanceof HTMLElement) {
    const inputs = [...lab.querySelectorAll<HTMLInputElement>('input[type="range"]')];
    const evidenceTiles = [...lab.querySelectorAll<HTMLElement>('.v58-score-tiles > span')];
    const highlightEvidence = (activeIndex: number) => {
      evidenceTiles.forEach((tile, index) => tile.classList.toggle('is-linked', index === activeIndex));
      inputs.forEach((input, index) => input.parentElement?.classList.toggle('is-linked', index === activeIndex));
    };
    let hoveredIndex = -1;
    let focusedIndex = -1;
    const refreshHighlight = () => highlightEvidence(hoveredIndex >= 0 ? hoveredIndex : focusedIndex);
    inputs.forEach((input, index) => {
      [input.parentElement, evidenceTiles[index]].forEach((element) => {
        element?.addEventListener('pointerenter', (event) => {
          if (event.pointerType !== 'mouse') return;
          hoveredIndex = index;
          refreshHighlight();
        });
        element?.addEventListener('pointerleave', () => {
          if (hoveredIndex === index) hoveredIndex = -1;
          refreshHighlight();
        });
        element?.addEventListener('focusin', () => {
          focusedIndex = index;
          refreshHighlight();
        });
        element?.addEventListener('focusout', () => {
          focusedIndex = -1;
          refreshHighlight();
        });
      });
    });
    const scoreOutput = lab.querySelector<HTMLElement>('[data-verdict-score]');
    const mobileScore = lab.querySelector<HTMLElement>('[data-mobile-score]');
    const mobileBand = lab.querySelector<HTMLElement>('[data-mobile-band]');
    const verdictStatus = lab.querySelector<HTMLElement>('[data-verdict-status]');
    let announcementTimer: ReturnType<typeof setTimeout>;
    const shareStatus = lab.querySelector<HTMLElement>('[data-share-status]');
    const calculatedPoints = [...lab.querySelectorAll<HTMLElement>('[data-calculated-points]')];
    const bandOutput = lab.querySelector<HTMLElement>('[data-band]');
    const pin = lab.querySelector<HTMLElement>('[data-pin]');
    const note = lab.querySelector<HTMLElement>('[data-note]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let shownScore = Number(scoreOutput?.textContent ?? 39);
    let targetScore = shownScore;
    let hasPriorities = true;
    let scoreFrame = 0;
    const paintScore = (value: number) => {
      shownScore = value;
      if (pin) pin.hidden = !hasPriorities;
      if (!hasPriorities) {
        if (scoreOutput) scoreOutput.textContent = '-';
        if (mobileScore?.firstChild) mobileScore.firstChild.textContent = '- ';
        [bandOutput, mobileBand].forEach((output) => {
          if (output) {
            output.textContent = 'SET PRIORITIES';
            output.dataset.bandState = 'unset';
          }
        });
        return;
      }
      const band = value >= 34 ? 'SELECT' : value >= 26 ? 'GREY' : 'REJECT';
      if (scoreOutput) scoreOutput.textContent = value.toFixed(2);
      if (mobileScore?.firstChild) mobileScore.firstChild.textContent = `${value.toFixed(2)} `;
      [bandOutput, mobileBand].forEach((output) => {
        if (!output) return;
        output.textContent = band;
        output.dataset.bandState = band.toLowerCase();
      });
      if (pin) pin.style.left = `${Math.max(1, Math.min(99, value * 2))}%`;
    };
    const moveScore = (target: number, animate: boolean) => {
      cancelAnimationFrame(scoreFrame);
      targetScore = target;
      if (!animate || reducedMotion.matches) {
        paintScore(target);
        return;
      }
      const from = shownScore;
      const started = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - started) / 220);
        paintScore(progress === 1 ? target : from + (target - from) * (1 - (1 - progress) ** 3));
        if (progress < 1) scoreFrame = requestAnimationFrame(tick);
      };
      scoreFrame = requestAnimationFrame(tick);
    };
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        cancelAnimationFrame(scoreFrame);
        paintScore(targetScore);
      }
    });
    const presets: Record<string, number[]> = {
      brief: [7, 7, 6, 6, 5, 4, 4, 5, 6],
      detection: [8, 10, 6, 4, 4, 3, 3, 4, 8],
      llm: [3, 3, 12, 5, 4, 10, 4, 3, 6],
      ownership: [8, 8, 4, 8, 6, 3, 5, 5, 3],
    };
    const notes: Record<string, string> = {
      brief:
        'As briefed: building production detection systems carries the weight. AI security controls are the evidence to probe further.',
      detection:
        'Detection becomes decisive. The production threat-detection work carries the verdict; the AI-security detail remains the next-round probe.',
      llm: 'LLM security becomes decisive. The candidate names risks, but the transcript does not establish a specific control and test in production - the verdict moves to GREY.',
      ownership:
        'Production ownership rewards the deployed system, iteration and operating context. The verdict remains above the select threshold.',
    };

    const update = (announce = true) => {
      const total = inputs.reduce((sum, input) => sum + Number(input.value), 0);
      const score = inputs.reduce((sum, input) => sum + (Number(input.value) * Number(input.dataset.score)) / 5, 0);
      const normalized = total ? (score / total) * 50 : 0;
      const strongest = Math.max(...inputs.map((input) => Number(input.value)));
      const band = normalized >= 34 ? 'SELECT' : normalized >= 26 ? 'GREY' : 'REJECT';

      const shares = inputs.map((input) => (total ? (Number(input.value) / total) * 1000 : 0));
      const roundedShares = shares.map(Math.floor);
      // Allocate rounding tenths without changing the exact shares used for scoring.
      const remainder = total ? 1000 - roundedShares.reduce((sum, value) => sum + value, 0) : 0;
      const order = shares
        .map((value, index) => ({ index, fraction: value - roundedShares[index] }))
        .sort((a, b) => b.fraction - a.fraction || a.index - b.index);
      order.slice(0, remainder).forEach(({ index }) => {
        roundedShares[index] += 1;
      });
      inputs.forEach((input, index) => {
        const share = (roundedShares[index] / 10).toFixed(1);
        const output = input.parentElement?.querySelector<HTMLElement>('[data-share]');
        if (output) output.textContent = `${share}%`;
        input.setAttribute('aria-valuetext', `${share}% share of importance`);
        if (calculatedPoints[index])
          calculatedPoints[index].textContent = (
            total ? (((Number(input.value) / total) * Number(input.dataset.score)) / 5) * 50 : 0
          ).toFixed(2);
        input.parentElement?.toggleAttribute('data-changed', Number(input.value) !== Number(input.dataset.default));
        // Emphasise the leading priorities using relative weights, independent of their scale.
        const isPriority =
          total > 0 && Number(input.value) > total / inputs.length && Number(input.value) >= strongest * 0.92;
        input.parentElement?.classList.toggle('is-priority', isPriority);
        evidenceTiles[index]?.classList.toggle('is-priority', isPriority);
      });
      hasPriorities = total > 0;
      moveScore(normalized, announce && hasPriorities);
      // Announce the settled verdict once, rather than every intermediate drag value.
      clearTimeout(announcementTimer);
      if (announce)
        announcementTimer = setTimeout(() => {
          if (verdictStatus)
            verdictStatus.textContent = total
              ? `${normalized.toFixed(2)} out of 50. ${band.toLowerCase()}.`
              : 'Set a priority above zero to calculate a verdict.';
        }, 300);
      if (shareStatus) shareStatus.hidden = total > 0;
    };

    inputs.forEach((input, index) => {
      input.addEventListener('input', () => {
        highlightEvidence(index);
        lab.querySelectorAll('[data-preset]').forEach((button) => {
          button.classList.remove('is-active');
          button.setAttribute('aria-pressed', 'false');
        });
        if (note) note.textContent = 'Your priorities determine the verdict. Interview scores stay the same.';
        update();
      });
    });
    lab.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) =>
      button.addEventListener('click', () => {
        const key = button.dataset.preset ?? 'brief';
        hoveredIndex = focusedIndex = -1;
        highlightEvidence(-1);
        presets[key].forEach((value, index) => {
          inputs[index].value = String(value);
        });
        lab.querySelectorAll('[data-preset]').forEach((item) => {
          item.classList.toggle('is-active', item === button);
          item.setAttribute('aria-pressed', String(item === button));
        });
        if (note) note.textContent = notes[key];
        update();
      })
    );
    update(false);
  }

  const funnel = document.querySelector('[data-v58-funnel]');
  if (funnel instanceof HTMLElement) {
    const buttons = [...funnel.querySelectorAll<HTMLButtonElement>('[data-stage]')];
    const squares = [...funnel.querySelectorAll<HTMLElement>('[data-square]')];
    const label = funnel.querySelector<HTMLElement>('[data-funnel-label]');
    const number = funnel.querySelector<HTMLElement>('[data-funnel-number]');
    const field = funnel.querySelector<HTMLElement>('.v58-funnel-field');
    const grid = funnel.querySelector<HTMLElement>('.v58-square-grid');
    const stages = buttons.map((button) => ({
      count: button.dataset.count ?? '',
      label: button.dataset.label ?? '',
    }));
    let stage = 1;
    const draw = (nextStage: number) => {
      const data = stages[nextStage - 1];
      buttons.forEach((button, index) => button.classList.toggle('is-active', index + 1 === nextStage));
      squares.forEach((square) => square.classList.toggle('is-out', Number(square.dataset.tier) < nextStage));
      grid?.classList.add('is-dim');
      field?.classList.toggle('is-hired', nextStage === 5);
      if (label) label.textContent = data.label;
      if (number) number.textContent = data.count;
    };
    const restore = () => {
      draw(stage);
    };
    const activate = (nextStage: number) => {
      stage = nextStage;
      buttons.forEach((button, index) => {
        button.setAttribute('aria-pressed', String(index + 1 === stage));
      });
      restore();
    };
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => activate(index + 1));
      const preview = () => draw(index + 1);
      button.addEventListener('mouseenter', preview);
      button.addEventListener('mouseleave', restore);
      button.addEventListener('focus', preview);
      button.addEventListener('blur', restore);
    });
    grid?.addEventListener('mouseover', (event) => {
      const square = (event.target as HTMLElement).closest<HTMLElement>('[data-square]');
      const tier = Number(square?.dataset.tier);
      if (!square || !tier) return;
      draw(tier);
    });
    grid?.addEventListener('mouseleave', restore);
    activate(1);
  }
</script>
