---
const {
  title,
  summary,
  status = 'open',
  applyUrl,
} = Astro.props as {
  title?: string;
  summary?: string;
  status?: string;
  applyUrl?: string;
};

const isClosed = status === 'closed';
const label = 'Apply';
---

<aside class="rounded-[24px] border border-black/5 bg-white p-5 sm:p-6 shadow-[0_12px_35px_rgba(0,0,0,0.07)]">
  <div
    class="inline-flex items-center gap-2 rounded-full bg-[#da0007]/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#da0007]"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-[#da0007]"></span>
    {isClosed ? 'This role is closed' : 'Apply now'}
  </div>

  <h3 class="mt-4 text-[20px] font-[700] leading-tight text-black">{title}</h3>
  {summary ? <p class="mt-3 text-[13px] leading-relaxed text-black/60">{summary}</p> : null}

  <div class="mt-6 space-y-3 rounded-2xl bg-black/[0.03] p-4">
    <p class="text-[11px] uppercase tracking-[0.22em] text-black/35">What happens next</p>
    <p class="text-[13px] leading-relaxed text-black/60">
      We review every application. If there is a fit, we move quickly and keep the process clear.
    </p>
  </div>

  {
    isClosed ? (
      <a
        href="/careers"
        data-astro-reload
        class="mt-6 inline-flex w-full cursor-default items-center justify-center rounded-full border border-black/10 bg-black/5 px-5 py-3 text-[13px] font-semibold text-black/35 transition"
      >
        Role filled
      </a>
    ) : applyUrl ? (
      <a
        href={applyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-[#da0007] px-5 py-3 text-[13px] font-semibold text-white transition hover:bg-[#c50006]"
      >
        {label}
      </a>
    ) : (
      <button
        type="button"
        data-open-careers-apply
        class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-[#da0007] px-5 py-3 text-[13px] font-semibold text-white transition hover:bg-[#c50006]"
      >
        {label}
      </button>
    )
  }
</aside>
