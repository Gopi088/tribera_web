---
const { title, slug, department } = Astro.props as {
  title: string;
  slug: string;
  department?: string;
};
---

<div
  id="careersApplyModal"
  class="fixed inset-0 z-[1200] hidden overflow-y-auto bg-black/55 px-4 py-6 sm:px-6 sm:py-8"
>
  <div class="pointer-events-none flex min-h-full items-center justify-center">
    <div
      class="pointer-events-auto relative w-full max-w-[560px] overflow-hidden rounded-[30px] border border-white/10 bg-[#0a0a0a] px-6 pt-6 pb-5 text-white shadow-[0_28px_100px_rgba(0,0,0,0.45)] sm:px-8 sm:pt-8 sm:pb-6"
    >
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#DA0007]/80 to-transparent"></div>
      <div class="pointer-events-none absolute -left-20 top-0 h-52 w-52 rounded-full bg-[#DA0007]/12 blur-3xl"></div>
      <div class="pointer-events-none absolute -right-16 bottom-0 h-44 w-44 rounded-full bg-white/[0.04] blur-3xl"></div>
      <button
        id="closeCareersApplyModal"
        class="absolute right-4 top-4 z-20 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/[0.02] p-0 text-white/45 transition-colors duration-200 hover:border-[#DA0007]/35 hover:bg-[#DA0007]/12 hover:text-white/85"
        type="button"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M6 6L18 18" stroke-linecap="round"></path>
          <path d="M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>

      <form
        id="careersApplyForm"
        action="/.netlify/functions/careers-apply"
        method="POST"
        enctype="multipart/form-data"
        class="relative space-y-5"
      >
        <input type="hidden" name="job_title" value={title} />
        <input type="hidden" name="job_slug" value={slug} />
        <input type="hidden" name="department" value={department || ''} />
        <input type="hidden" name="form_loaded_at" value="" data-form-loaded-at />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div class="relative pb-1">
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#DA0007]">Careers at Tribera</p>
          <h3 class="pr-12 text-[1.5rem] font-[640] leading-[1.02] tracking-[-0.035em] text-white sm:text-[1.75rem]">
            Apply for {title}
          </h3>
          <p class="mt-4 max-w-[28rem] text-[14px] leading-7 text-white/58 sm:text-[15px]">
            Share your details and resume. We review every application with care.
          </p>
        </div>

        <div class="space-y-3.5">
          <div class="grid gap-3.5 sm:grid-cols-2 sm:gap-4">
            <input
              type="text"
              name="name"
              placeholder="Full name *"
              autocomplete="name"
              required
              class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 transition focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
            />

            <input
              type="email"
              name="email"
              placeholder="Email address *"
              autocomplete="email"
              required
              class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 transition focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
            />
          </div>

          <div class="grid gap-3.5 sm:grid-cols-2 sm:gap-4">
            <input
              type="tel"
              name="mobile"
              placeholder="Mobile number"
              autocomplete="tel"
              class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 transition focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
            />

            <input
              type="text"
              name="current_company"
              placeholder="Current company"
              autocomplete="organization"
              class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 transition focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
            />
          </div>
          <input
            type="url"
            name="linkedin"
            placeholder="LinkedIn URL"
            autocomplete="url"
            class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 transition focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
          />

          <textarea
            name="note"
            rows="3"
            placeholder="Anything you'd like us to know?"
            class="w-full resize-none rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 transition focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
          ></textarea>
        </div>

        <input type="file" id="careersResumeInput" name="resume" accept=".pdf,.doc,.docx" class="hidden" />

        <div class="space-y-3 border-t border-white/5 pt-4">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <button
              type="button"
              id="careersUploadBtn"
              class="w-full rounded-full border border-white/14 bg-white/[0.03] px-6 py-3 text-[14px] font-semibold text-white transition hover:border-[#DA0007]/50 hover:bg-[#DA0007]/10"
            >
              Upload Resume *
            </button>

            <button
              type="submit"
              id="careersSubmitBtn"
              disabled
              class="w-full rounded-full bg-[#DA0007] px-8 py-3 text-[14px] font-semibold text-white transition hover:bg-[#b80005] disabled:cursor-not-allowed disabled:opacity-45"
            >
              Submit Application
            </button>
          </div>

          <p id="careersFileName" class="min-h-[16px] break-words text-[12px] leading-5 text-white/45"></p>
          <p id="careersErrorMsg" class="hidden text-[13px] text-white/55"></p>
        </div>
      </form>

      <div id="careersSuccessMessage" class="hidden text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#DA0007]/10">
          <svg viewBox="0 0 24 24" class="h-7 w-7 text-[#DA0007]" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>

        <h3 class="text-[22px] font-[700] text-white">Application Submitted</h3>
        <p class="mt-3 text-[14px] leading-relaxed text-white/60">
          Thanks for applying. Our team will review your application and get back to you if there is a fit.
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const careersApplyFailureMessage =
    'Something went wrong while submitting your application. Please try again. If the issue continues, email your resume to careers@tribera.ai.';

  function initCareersApplyModal() {
    const modal = document.getElementById('careersApplyModal');
    const closeBtn = document.getElementById('closeCareersApplyModal');
    const form = document.getElementById('careersApplyForm');
    const success = document.getElementById('careersSuccessMessage');
    const uploadBtn = document.getElementById('careersUploadBtn');
    const resumeInput = document.getElementById('careersResumeInput');
    const submitBtn = document.getElementById('careersSubmitBtn');
    const fileName = document.getElementById('careersFileName');
    const errorMsg = document.getElementById('careersErrorMsg');
    const formLoadedAtInput = form.querySelector('[data-form-loaded-at]');

    if (
      !(modal instanceof HTMLDivElement) ||
      !(form instanceof HTMLFormElement) ||
      !(closeBtn instanceof HTMLButtonElement) ||
      !(uploadBtn instanceof HTMLButtonElement) ||
      !(resumeInput instanceof HTMLInputElement) ||
      !(submitBtn instanceof HTMLButtonElement) ||
      !(fileName instanceof HTMLElement) ||
      !(errorMsg instanceof HTMLElement)
    ) {
      return;
    }

    const openModal = () => {
      form.classList.remove('hidden');
      success?.classList.add('hidden');
      errorMsg.classList.add('hidden');
      if (formLoadedAtInput instanceof HTMLInputElement) {
        formLoadedAtInput.value = String(Date.now());
      }
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      modal.dataset.lastOpenedAt = String(Date.now());
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    if (!window.__triberaCareersApplyBound) {
      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;

        if (target.closest('[data-open-careers-apply]')) {
          e.preventDefault();
          openModal();
        }
      });

      window.__triberaCareersApplyBound = true;
    }

    if (closeBtn.dataset.bound !== 'true') {
      closeBtn.dataset.bound = 'true';
      closeBtn.addEventListener('click', closeModal);
    }

    if (modal.dataset.overlayBound !== 'true') {
      modal.dataset.overlayBound = 'true';
      modal.addEventListener('click', (e) => {
        if (e.target !== modal) return;
        const justOpened = Date.now() - Number(modal.dataset.lastOpenedAt || 0) < 500;
        if (justOpened) return;
        closeModal();
      });
    }

    if (!window.__triberaCareersApplyEscBound) {
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (modal.classList.contains('hidden')) return;
        closeModal();
      });
      window.__triberaCareersApplyEscBound = true;
    }

    if (uploadBtn.dataset.bound !== 'true') {
      uploadBtn.dataset.bound = 'true';
      uploadBtn.addEventListener('click', () => resumeInput.click());
      resumeInput.addEventListener('change', () => {
        if (resumeInput.files && resumeInput.files.length > 0) {
          submitBtn.disabled = false;
          fileName.textContent = `Selected: ${resumeInput.files[0].name}`;
        } else {
          submitBtn.disabled = true;
          fileName.textContent = '';
        }
      });
    }

    if (form.dataset.submitBound === 'true') return;
    form.dataset.submitBound = 'true';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalText = submitBtn.textContent || 'Submit Application';
      errorMsg.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const isJson = res.headers.get('content-type')?.includes('application/json');
        const result = isJson
          ? await res.json()
          : {
              success: false,
              message: careersApplyFailureMessage,
            };

        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Submission failed');
        }

        form.classList.add('hidden');
        success?.classList.remove('hidden');

        window.setTimeout(() => {
          form.reset();
          if (formLoadedAtInput instanceof HTMLInputElement) {
            formLoadedAtInput.value = String(Date.now());
          }
          form.classList.remove('hidden');
          success?.classList.add('hidden');
          submitBtn.textContent = originalText;
          submitBtn.disabled = true;
          fileName.textContent = '';
          closeModal();
        }, 3200);
      } catch (error) {
        console.error('Careers application submit failed:', error);
        errorMsg.textContent = careersApplyFailureMessage;
        errorMsg.classList.remove('hidden');
      } finally {
        if (!success || success.classList.contains('hidden')) {
          submitBtn.textContent = originalText;
          submitBtn.disabled = !resumeInput.files?.length;
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initCareersApplyModal);
  document.addEventListener('DOMContentLoaded', initCareersApplyModal);
</script>
