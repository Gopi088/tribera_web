---
const { title, slug, department } = Astro.props as {
  title: string;
  slug: string;
  department?: string;
};
---

<div
  id="careersApplyModal"
  class="fixed inset-0 z-[1200] hidden items-start justify-center overflow-y-auto bg-black/65 p-3 backdrop-blur-sm sm:items-center sm:p-4"
>
  <div
    class="relative my-4 w-full max-w-[620px] rounded-2xl border border-white/10 bg-gradient-to-b from-white to-[#f7f7f7] p-5 shadow-[0_30px_90px_rgba(0,0,0,0.4)] sm:my-0 sm:p-8 max-h-[calc(100dvh-1.5rem)] overflow-y-auto overscroll-contain"
  >
    <button
      id="closeCareersApplyModal"
      class="absolute right-3 top-3 h-9 w-9 rounded-full border border-black/10 text-xl text-black/40 transition hover:bg-black/5 hover:text-black sm:right-4 sm:top-4"
      type="button"
    >
      ✕
    </button>

    <form
      id="careersApplyForm"
      action="/.netlify/functions/careers-apply"
      method="POST"
      enctype="multipart/form-data"
      class="space-y-4 sm:space-y-5"
    >
      <input type="hidden" name="job_title" value={title} />
      <input type="hidden" name="job_slug" value={slug} />
      <input type="hidden" name="department" value={department || ''} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#DA0007]">Careers at Tribera</p>
        <h3 class="mt-2 pr-10 text-[22px] font-[700] leading-tight text-black sm:text-[28px]">Apply for {title}</h3>
        <p class="mt-2 text-[13px] text-black/55 sm:text-[14px]">
          Share your details and resume. We review every application with care.
        </p>
      </div>

      <div>
        <input
          type="text"
          name="name"
          placeholder="Full Name *"
          autocomplete="name"
          required
          class="w-full rounded-xl border border-black/15 bg-white px-4 py-3.5 text-[14px] placeholder:text-black/35 transition focus:border-[#DA0007]/50 focus:outline-none focus:ring-2 focus:ring-[#DA0007]/10"
        />
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <input
            type="email"
            name="email"
            placeholder="Email Address *"
            autocomplete="email"
            required
            class="w-full rounded-xl border border-black/15 bg-white px-4 py-3.5 text-[14px] placeholder:text-black/35 transition focus:border-[#DA0007]/50 focus:outline-none focus:ring-2 focus:ring-[#DA0007]/10"
          />
        </div>

        <div>
          <input
            type="tel"
            name="mobile"
            placeholder="Mobile Number"
            autocomplete="tel"
            class="w-full rounded-xl border border-black/15 bg-white px-4 py-3.5 text-[14px] placeholder:text-black/35 transition focus:border-[#DA0007]/50 focus:outline-none focus:ring-2 focus:ring-[#DA0007]/10"
          />
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <input
            type="text"
            name="current_company"
            placeholder="Current Company"
            autocomplete="organization"
            class="w-full rounded-xl border border-black/15 bg-white px-4 py-3.5 text-[14px] placeholder:text-black/35 transition focus:border-[#DA0007]/50 focus:outline-none focus:ring-2 focus:ring-[#DA0007]/10"
          />
        </div>

        <div>
          <input
            type="url"
            name="linkedin"
            placeholder="LinkedIn URL"
            autocomplete="url"
            class="w-full rounded-xl border border-black/15 bg-white px-4 py-3.5 text-[14px] placeholder:text-black/35 transition focus:border-[#DA0007]/50 focus:outline-none focus:ring-2 focus:ring-[#DA0007]/10"
          />
        </div>
      </div>

      <div>
        <textarea
          name="note"
          rows="4"
          placeholder="Anything you'd like us to know?"
          class="w-full resize-none rounded-xl border border-black/15 bg-white px-4 py-3.5 text-[14px] placeholder:text-black/35 transition focus:border-[#DA0007]/50 focus:outline-none focus:ring-2 focus:ring-[#DA0007]/10"
        ></textarea>
      </div>

      <input type="file" id="careersResumeInput" name="resume" accept=".pdf,.doc,.docx" class="hidden" />

      <div class="flex flex-col gap-3 pt-1 sm:flex-row">
        <button
          type="button"
          id="careersUploadBtn"
          class="flex-1 rounded-xl border border-[#DA0007]/70 bg-white py-3 text-[14px] font-semibold text-[#DA0007] transition hover:bg-[#DA0007] hover:text-white"
        >
          Upload Resume *
        </button>

        <button
          type="submit"
          id="careersSubmitBtn"
          disabled
          class="tribera-primary-button flex-1 rounded-xl py-3 text-[14px] font-semibold disabled:cursor-not-allowed disabled:opacity-45"
        >
          Submit Application
        </button>
      </div>

      <p id="careersFileName" class="mt-1 min-h-[18px] break-words text-[12px] text-black/60"></p>
      <p id="careersErrorMsg" class="hidden text-center text-[13px] text-black/60"></p>
    </form>

    <div id="careersSuccessMessage" class="hidden text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#DA0007]/10">
        <svg viewBox="0 0 24 24" class="h-7 w-7 text-[#DA0007]" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>

      <h3 class="text-[22px] font-[700] text-black">Application Submitted</h3>
      <p class="mt-3 text-[14px] leading-relaxed text-black/60">
        Thanks for applying. Our team will review your application and get back to you if there is a fit.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  const careersApplyFailureMessage =
    'Something went wrong while submitting your application. Please try again. If the issue continues, email your resume to careers@tribera.ai.';

  function initCareersApplyModal() {
    const modal = document.getElementById('careersApplyModal');
    const closeBtn = document.getElementById('closeCareersApplyModal');
    const form = document.getElementById('careersApplyForm');
    const success = document.getElementById('careersSuccessMessage');
    const uploadBtn = document.getElementById('careersUploadBtn');
    const resumeInput = document.getElementById('careersResumeInput');
    const submitBtn = document.getElementById('careersSubmitBtn');
    const fileName = document.getElementById('careersFileName');
    const errorMsg = document.getElementById('careersErrorMsg');

    if (
      !(modal instanceof HTMLDivElement) ||
      !(form instanceof HTMLFormElement) ||
      !(closeBtn instanceof HTMLButtonElement) ||
      !(uploadBtn instanceof HTMLButtonElement) ||
      !(resumeInput instanceof HTMLInputElement) ||
      !(submitBtn instanceof HTMLButtonElement) ||
      !(fileName instanceof HTMLElement) ||
      !(errorMsg instanceof HTMLElement)
    ) {
      return;
    }

    const openModal = () => {
      form.classList.remove('hidden');
      success?.classList.add('hidden');
      errorMsg.classList.add('hidden');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
      modal.dataset.lastOpenedAt = String(Date.now());
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    };

    if (!window.__triberaCareersApplyBound) {
      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;

        if (target.closest('[data-open-careers-apply]')) {
          e.preventDefault();
          openModal();
        }
      });

      window.__triberaCareersApplyBound = true;
    }

    if (closeBtn.dataset.bound !== 'true') {
      closeBtn.dataset.bound = 'true';
      closeBtn.addEventListener('click', closeModal);
    }

    if (modal.dataset.overlayBound !== 'true') {
      modal.dataset.overlayBound = 'true';
      modal.addEventListener('click', (e) => {
        if (e.target !== modal) return;
        const justOpened = Date.now() - Number(modal.dataset.lastOpenedAt || 0) < 500;
        if (justOpened) return;
        closeModal();
      });
    }

    if (uploadBtn.dataset.bound !== 'true') {
      uploadBtn.dataset.bound = 'true';
      uploadBtn.addEventListener('click', () => resumeInput.click());
      resumeInput.addEventListener('change', () => {
        if (resumeInput.files && resumeInput.files.length > 0) {
          submitBtn.disabled = false;
          fileName.textContent = `Selected: ${resumeInput.files[0].name}`;
        } else {
          submitBtn.disabled = true;
          fileName.textContent = '';
        }
      });
    }

    if (form.dataset.submitBound === 'true') return;
    form.dataset.submitBound = 'true';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalText = submitBtn.textContent || 'Submit Application';
      errorMsg.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const result = await res.json();

        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Submission failed');
        }

        form.classList.add('hidden');
        success?.classList.remove('hidden');

        window.setTimeout(() => {
          form.reset();
          form.classList.remove('hidden');
          success?.classList.add('hidden');
          submitBtn.textContent = originalText;
          submitBtn.disabled = true;
          fileName.textContent = '';
          closeModal();
        }, 3200);
      } catch (error) {
        console.error('Careers application submit failed:', error);
        errorMsg.textContent = careersApplyFailureMessage;
        errorMsg.classList.remove('hidden');
      } finally {
        if (!success || success.classList.contains('hidden')) {
          submitBtn.textContent = originalText;
          submitBtn.disabled = !resumeInput.files?.length;
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initCareersApplyModal);
  document.addEventListener('DOMContentLoaded', initCareersApplyModal);
</script>
