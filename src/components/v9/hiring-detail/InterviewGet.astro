---
import { v9Href } from '~/data/v9/routes';
---

<section class="g-white" id="get">
  <div class="wrap iq-get">
    <div>
      <div data-v9-reveal class="eyebrow"><span class="tick">\</span> 02 · What you get</div>
      <h2 data-v9-reveal style="--d:60ms">A decision, not a pile of CVs.</h2>
      <p data-v9-reveal class="lead" style="--d:120ms">
        Your panel spends its time on the people who cleared the bar, and on the questions still open about them.
      </p>
    </div>
    <div>
      <ul class="jb-list">
        <li>A score for each skill, linked to the answer behind it</li>
        <li>A ranked list across every candidate in the batch</li>
        <li>The open questions for your final round, named</li>
        <li>Agency, referral and in-house candidates compared on one bar</li>
        <li>The recording and transcript of every interview</li>
      </ul>
      <p class="iq-sample">
        <a class="link" href={v9Href('/__v9/sample-write-up', Astro.url.pathname)}>Request a sample ›</a>
      </p>
    </div>
  </div>
</section>
