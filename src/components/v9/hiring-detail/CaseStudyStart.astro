---
import { v9Href } from '~/data/v9/routes';
---

<section class="start g-white" id="start">
  <div class="wrap">
    <div class="start-head">
      <div data-v9-reveal class="eyebrow" style="justify-content:center"><span class="tick">\</span> Your turn</div>
      <h2 data-v9-reveal style="--d:60ms">
        Send us the role that’s been open <span class="hd-word"
          >longest.<svg class="hd-underline hd-ink" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true"
            ><path d="M3,8 Q34,3.5 62,6.5 Q92,9 117,5 Q92,11.2 62,9.2 Q34,6.4 3,8.7 Z"></path></svg
          ></span
        >
      </h2>
    </div>
    <p data-v9-reveal class="lead" style="--d:120ms">
      One forty-five-minute call sets the bar. Then everyone, including the people you’ve already seen, is read against
      it.
    </p>
    <div data-v9-reveal class="cta-row" style="--d:180ms">
      <a class="btn btn-primary" href={v9Href('/__v9/services#sv-scorecard', Astro.url.pathname)}
        >Book a scorecard session</a
      ><a class="link" href={v9Href('/__v9/home#start', Astro.url.pathname)}>Or start a full search ›</a>
    </div>
  </div>
</section>
