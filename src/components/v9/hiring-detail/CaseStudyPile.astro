---
import { scorecardReRead } from '../../../data/v9/case-studies';
---

<section class="g-white" id="pile">
  <div class="wrap cs-pile">
    <div>
      <div data-v9-reveal class="eyebrow"><span class="tick">\</span> 02 · The people already there</div>
      <h2 data-v9-reveal style="--d:60ms">The hire was in the pile all along.</h2>
      <p data-v9-reveal class="lead" style="--d:120ms">
        Each square is one of the 327 profiles. Eleven had been interviewed and passed over. Read again against one
        written bar, two came back into contention, and one was hired.
      </p>
      <ul data-v9-reveal class="cs-count" style="--d:160ms">
        <li><b>327</b>profiles seen</li><li><b class="e"></b>11 passed over</li><li>
          <b class="b"></b>2 back in contention
        </li><li><b class="h"></b>1 hired</li>
      </ul>
    </div>
    <div
      class="cs-field in"
      data-v9-reveal
      data-case-field
      data-stage="3"
      role="img"
      aria-label="327 profiles: 11 passed over, 2 back in contention, 1 hired"
    >
      {
        Array.from({ length: scorecardReRead.profileCount }, (_, index) => (
          <i
            class={
              scorecardReRead.hired.includes(index)
                ? 'h'
                : scorecardReRead.returned.includes(index)
                  ? 'b'
                  : scorecardReRead.passedOver.includes(index)
                    ? 'e'
                    : ''
            }
            aria-hidden="true"
          />
        ))
      }
    </div><div class="case-controls" hidden data-case-controls>
      <p class="case-status" aria-live="polite" data-case-status>1 hired after 22 days.</p><div
        role="group"
        aria-label="Re-read the profiles"
      >
        <button type="button" data-case-stage="0" aria-pressed="false">327 profiles</button><button
          type="button"
          data-case-stage="1"
          aria-pressed="false">11 re-read</button
        ><button type="button" data-case-stage="2" aria-pressed="false">2 back</button><button
          type="button"
          data-case-stage="3"
          aria-pressed="true">1 hired</button
        >
      </div>
    </div>
  </div>
</section>
