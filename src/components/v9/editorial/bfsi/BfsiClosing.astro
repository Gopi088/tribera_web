---
import { v9Href } from '~/data/v9/routes';
---

<!-- Handoff industries/banking-financial-services.html: start. Native Astro markup; shared document shell is V9Layout. -->
<section class="start g-white" id="start">
  <div class="wrap">
    <div class="start-head">
      <div class="eyebrow" style="justify-content:center" data-v9-reveal><span class="tick">\</span> Start here</div>
      <h2 style="--d:60ms" data-v9-reveal>
        Tell us the role. Three names in <span class="hd-word"
          >36 hours.<svg class="hd-underline hd-ink" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true"
            ><path d="M3,8 Q34,3.5 62,6.5 Q92,9 117,5 Q92,11.2 62,9.2 Q34,6.4 3,8.7 Z"></path></svg
          ></span
        >
      </h2>
    </div>
    <p class="lead" style="--d:120ms" data-v9-reveal>
      A 45-minute intake call sets the bar with you, including how hard controls and risk should lean for this seat.
      Then three people you’d take any of.
    </p>
    <div class="cta-row" style="--d:180ms" data-v9-reveal>
      <a class="btn btn-primary" href={v9Href('/__v9/contact?sector=banking-financial-services', Astro.url.pathname)}
        >Brief a role</a
      >
      <a class="link" href={v9Href('/__v9/industries', Astro.url.pathname)}>Other sectors ›</a>
    </div>
  </div>
</section>
