---
import { fetchPosts } from '~/utils/blog';
import ArticleHeader from '../../ArticleHeader.astro';
import AuthorBlock from '../../AuthorBlock.astro';
const post = (await fetchPosts()).find((post) => post.permalink === 'blog/seventeen-interviews-one-hire')!;
---

<ArticleHeader
  title={post.title}
  summary={post.excerpt || ''}
  category={post.category?.title || 'Hiring strategy'}
  cover={{ issue: 'Field note', value: '17.6', caption: 'interviews for every technical hire' }}
>
  <AuthorBlock
    slot="author"
    name={post.author || 'Akshata Chandavarkar'}
    role="Founder & CEO · twenty years of enterprise hiring"
    image="/brand/v9/authors/akshata-chandavarkar.jpg"
    date={post.publishDate.toISOString().slice(0, 10)}
    dateLabel={post.publishDate.toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })}
    readingTime={`${post.readingTime} read`}
  />
</ArticleHeader>
