<!-- Handoff blog/seventeen-interviews-one-hire.html: subscribe. Native Astro markup; shared document shell is V9Layout. -->
<section class="g-dark" id="subscribe">
  <div class="wrap bl-sub">
    <div>
      <div class="eyebrow"><span class="tick">\</span> Once a month, at most</div>
      <h2 style="--d:60ms">We write one when a search teaches us something.</h2>
      <p class="lead" style="--d:120ms">
        One email when there’s a piece worth your ten minutes. No drip sequence, no webinar invitations.
      </p>
    </div>
    <div class="qs-form" role="group" aria-label="Newsletter preview">
      <div class="qs-in">
        <input type="email" name="email" required="" placeholder="you@company.com" aria-label="Email" /><button
          class="btn btn-primary"
          type="button"
          disabled
          aria-describedby="v9-subscription-status">Subscribe</button
        >
      </div>
      <span class="qs-note">We never share the list. The unsubscribe link works on the first click.</span>
    </div><p class="qs-note" id="v9-subscription-status">
      Subscription is unavailable in this private preview. Newsletter integration will be completed separately.
    </p>
  </div>
</section>
