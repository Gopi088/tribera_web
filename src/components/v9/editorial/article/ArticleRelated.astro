---
import { fetchPosts } from '~/utils/blog';
const published = await fetchPosts();
const slugs = [
  'blog/designing-ai-for-high-stakes-technical-assessment',
  'blog/why-tech-hiring-really-takes-so-long',
  'blog/rethinking-hiring-metrics-signal-efficiency',
];
const related = slugs
  .map((slug) => published.find((post) => post.permalink === slug))
  .filter((post) => post !== undefined);
---

<section class="g-paper" id="related">
  <div class="wrap">
    <div class="eyebrow" data-v9-reveal><span class="tick">\</span> Keep reading</div>
    <h2 style="--d:60ms" data-v9-reveal>More from our field notes.</h2>
    <div class="bl-rel">
      {
        related.map((post) => (
          <a class="bt" href={`/${post.permalink}`} data-v9-reveal>
            <span class="ql">{post.category?.title || 'Field notes'}</span>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <em>
              <time datetime={post.publishDate.toISOString()}>
                {post.publishDate.toLocaleDateString('en-GB', {
                  timeZone: 'UTC',
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                })}
              </time>{' '}
              · {post.readingTime} read
            </em>
          </a>
        ))
      }
    </div>
  </div>
</section>
