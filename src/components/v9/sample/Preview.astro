---
import RequestForm from './RequestForm.astro';
---

<section class="g-paper" id="sample">
  <div class="wrap sw-g">
    <figure class="sw-doc">
      <div class="sw-page">
        <img
          src="/images/v9/sample/write-up-page-one.jpg"
          alt="Page one of a sample Tribera candidate write-up: a SELECT verdict, a score of 40 out of 50 against a bar of 34, and six skills with evidence"
          width="1270"
          height="1797"
        />
      </div>
      <figcaption>Page 1 of 2. The candidate, client and figures are invented to show the format.</figcaption>
    </figure>
    <div class="sw-side">
      <p class="ql">What’s in it</p>
      <ul class="sw-list">
        <li>The verdict and the score against your bar</li><li>
          Every skill, with the evidence and the moment in the recording
        </li><li>Three answers in the candidate’s own words</li><li>The open questions for your final round</li><li>
          Notice, CTC and what we couldn’t test
        </li>
      </ul>
      <RequestForm />
    </div>
  </div>
</section>
