---
import '../../assets/styles/v9/content.css';
interface Props {
  title: string;
  summary: string;
  category: string;
  backHref?: string;
  backLabel?: string;
  cover?: { issue: string; value: string; caption: string };
}
const { title, summary, category, backHref = '/blog', backLabel = 'Field notes', cover } = Astro.props;
---

<header class="v9-article-header">
  <div class="v9-wrap">
    <div class="v9-eyebrow"><span aria-hidden="true">\</span> <a href={backHref}>{backLabel}</a> · {category}</div>
    <div class:list={['v9-article-grid', { 'v9-article-grid--plain': !cover }]}>
      <div><h1>{title}</h1><p class="v9-article-lead">{summary}</p><slot name="author" /></div>
      {
        cover && (
          <div class="v9-article-cover" aria-hidden="true">
            <>
              <span class="v9-article-issue">{cover.issue}</span>
              <b>{cover.value}</b>
              <span class="v9-article-caption">{cover.caption}</span>
              <span class="v9-article-marks">
                {[0.5, 0.14, 0.3, 0.08, 0.22, 0.4, 0.1, 0.18, 0.06, 0.34, 0.12, 0.26].map((opacity) => (
                  <i style={`opacity:${opacity}`} />
                ))}
              </span>
            </>
          </div>
        )
      }
    </div>
  </div>
</header>
