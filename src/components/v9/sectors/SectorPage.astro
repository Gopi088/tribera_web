          <ul class="ix-bars">
            {
              skills.map((skill, i) => (
                <li class:list={{ top: i === top }}>
                  <>
                    <span class="ix-dn">{skill}</span>
                    <span class="ix-tr">
                      <i style={`--v:${values[i]}`} />
                    </span>
                    <b>{values[i]}%</b>
                  </>
                </li>
              ))
            }
          </ul>
          <p class="ix-card-ft"><b>{skills[top]}</b> carries {values[top]}% of the score here.</p>
        </aside>
