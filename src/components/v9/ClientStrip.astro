---
interface Props {
  label?: string;
}
const { label = 'Teams we work with' } = Astro.props;
const clients = [
  'Mizuho',
  'Capco',
  'Deloitte',
  'Flipkart',
  'Myntra',
  'Motherson',
  'Publicis Sapient',
  'Publicis Resources',
  'Heineken',
  'Ascendion',
  'Evident Microscopy',
  'CMART',
  'Antz',
];
---

<div class="v9-client-strip" data-v9-strip>
  <div class="v9-wrap">
    <p class="v9-eyebrow">{label}</p>
    <div class="v9-client-window" tabindex="0" role="region" aria-label="Customer names">
      <div class="v9-client-track">
        <ul>{clients.map((name) => <li>{name}</li>)}</ul>
        <ul aria-hidden="true">{clients.map((name) => <li>{name}</li>)}</ul>
      </div>
    </div>
  </div>
</div>
