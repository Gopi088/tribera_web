<div id="contactSalesModal" class="fixed inset-0 bg-black/50 flex items-center justify-center hidden z-50">
  <div class="bg-white w-[92vw] max-w-[400px] rounded-xl p-5 sm:p-6 relative">
    <!-- Close -->
    <button data-close-sales class="absolute top-3 right-3 text-gray-500 text-lg"> ✕ </button>

    <h2 class="text-xl font-semibold text-center mb-4">Contact Sales</h2>

    <p class="text-sm text-center text-gray-500 mb-4">Tell us about your needs and our team will reach out.</p>

    <form id="contactSalesForm" action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
      <input type="hidden" name="access_key" value="f3c09cb0-6c94-405e-af37-4f01141d40bd" />
      <input type="hidden" name="subject" value="New Contact Sales Submission - Tribera" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
      <input
        type="text"
        name="name"
        placeholder="Full name"
        autocomplete="name"
        required
        class="w-full border rounded-md px-3 py-2"
      />

      <input
        type="email"
        name="email"
        placeholder="Work email"
        autocomplete="email"
        required
        class="w-full border rounded-md px-3 py-2"
      />

      <input
        type="text"
        name="company"
        placeholder="Company name"
        autocomplete="organization"
        class="w-full border rounded-md px-3 py-2"
      />

      <textarea
        rows="3"
        name="message"
        autocomplete="off"
        placeholder="How can we help?"
        class="w-full border rounded-md px-3 py-2"></textarea>

      <button
        type="submit"
        id="contactSalesSubmitBtn"
        class="w-full bg-[#Da0007] text-white py-2 rounded-md font-semibold"
      >
        Submit
      </button>
      <p id="contactSalesErrorMsg" class="hidden text-[13px] text-center text-black/60">
        Submission failed. Please try again in a moment.
      </p>
    </form>
    <div id="contactSalesSuccessMsg" class="hidden text-center pt-2">
      <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#DA0007]/10 flex items-center justify-center">
        <svg viewBox="0 0 24 24" class="w-7 h-7 text-[#DA0007]" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <h4 class="text-[20px] font-[700] text-black">Request Submitted</h4>
      <p class="mt-2 text-[14px] leading-relaxed text-black/60">
        Thanks for reaching out. Our team will contact you shortly.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  function initContactSalesModal() {
    const modal = document.getElementById('contactSalesModal');
    const form = document.getElementById('contactSalesForm');
    const submitBtn = document.getElementById('contactSalesSubmitBtn');
    const successMsg = document.getElementById('contactSalesSuccessMsg');
    const errorMsg = document.getElementById('contactSalesErrorMsg');
    if (!modal || !form) return;
    if (modal.dataset.bound === 'true') return;
    modal.dataset.bound = 'true';

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      if (target.id === 'contactSalesBtn') {
        modal.classList.remove('hidden');
      }

      if (target.hasAttribute('data-close-sales')) {
        modal.classList.add('hidden');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalText = submitBtn?.textContent || 'Submit';
      errorMsg?.classList.add('hidden');
      successMsg?.classList.add('hidden');

      if (submitBtn) {
        submitBtn.textContent = 'Submitting...';
        submitBtn.setAttribute('disabled', 'true');
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await res.json();
        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Submission failed');
        }

        form.reset();
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');

        setTimeout(() => {
          successMsg?.classList.add('hidden');
          form.classList.remove('hidden');
          modal.classList.add('hidden');
        }, 3000);
      } catch (error) {
        console.error('Contact sales form submit failed:', error);
        errorMsg?.classList.remove('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.textContent = originalText;
          submitBtn.removeAttribute('disabled');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initContactSalesModal);
  document.addEventListener('DOMContentLoaded', initContactSalesModal);
</script>
