<div
  id="contactSalesModal"
  class="fixed inset-0 z-[1200] hidden overflow-y-auto bg-black/55 px-4 py-6 sm:px-6 sm:py-8"
>
  <div class="pointer-events-none flex min-h-full items-center justify-center">
    <div class="pointer-events-auto relative w-full max-w-[560px] overflow-hidden rounded-[30px] border border-white/10 bg-[#0a0a0a] px-6 py-6 text-white shadow-[0_28px_100px_rgba(0,0,0,0.45)] sm:px-8 sm:py-8">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#DA0007]/80 to-transparent"></div>
      <div class="pointer-events-none absolute -left-20 top-0 h-52 w-52 rounded-full bg-[#DA0007]/12 blur-3xl"></div>
      <div class="pointer-events-none absolute -right-16 bottom-0 h-44 w-44 rounded-full bg-white/[0.04] blur-3xl"></div>
      <button
        data-close-sales
        type="button"
        aria-label="Close contact sales modal"
        class="absolute right-4 top-4 z-20 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/[0.02] p-0 text-white/45 transition-colors duration-200 hover:border-[#DA0007]/35 hover:bg-[#DA0007]/12 hover:text-white/85"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M6 6L18 18" stroke-linecap="round"></path>
          <path d="M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>

      <div class="relative">
        <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#DA0007]">For Hiring Teams</p>
        <h2 class="pr-12 text-[1.5rem] font-[640] leading-[1.02] tracking-[-0.035em] text-white sm:text-[1.8rem]">
          Contact Sales
        </h2>
        <p class="mt-4 max-w-[28rem] text-[14px] leading-7 text-white/58 sm:text-[15px]">
          Tell us what you are hiring for. We will reach out with the right next step.
        </p>
      </div>

      <form
        id="contactSalesForm"
        action="/.netlify/functions/site-inquiry"
        method="POST"
        class="relative mt-7 space-y-3.5 sm:mt-8 sm:space-y-4"
      >
        <input type="hidden" name="form_type" value="sales" />
        <input type="hidden" name="form_loaded_at" value="" data-form-loaded-at />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div class="grid gap-3.5 sm:grid-cols-2 sm:gap-4">
          <input
            type="text"
            name="name"
            placeholder="Full name"
            autocomplete="name"
            required
            class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
          />

          <input
            type="email"
            name="email"
            placeholder="Work email"
            autocomplete="email"
            required
            class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
          />
        </div>

        <input
          type="text"
          name="company"
          placeholder="Company name"
          autocomplete="organization"
          class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
        />

        <input
          type="tel"
          name="phone"
          placeholder="Phone number"
          autocomplete="tel"
          class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
        />

        <textarea
          rows="3"
          name="message"
          autocomplete="off"
          placeholder="How can we help?"
          class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"></textarea>

        <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-[12px] leading-6 text-white/35">Response within 24 hours for qualified hiring requests.</p>
          <button
            type="submit"
            id="contactSalesSubmitBtn"
            class="w-full rounded-full bg-[#DA0007] px-8 py-3 text-[14px] font-semibold text-white transition hover:bg-[#b80005] sm:w-auto"
          >
            Submit
          </button>
        </div>
        <p id="contactSalesErrorMsg" class="hidden text-[13px] leading-6 text-white/55">
          Something went wrong while submitting your request. Please try again or email sales@tribera.ai.
        </p>
      </form>
      <div id="contactSalesSuccessMsg" class="hidden pt-2 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#DA0007]/10">
          <svg viewBox="0 0 24 24" class="h-7 w-7 text-[#DA0007]" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <h4 class="text-[20px] font-[700] text-white">Request Submitted</h4>
        <p class="mt-2 text-[14px] leading-relaxed text-white/60">
          Thanks for reaching out. Our team will contact you shortly.
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function initContactSalesModal() {
    const modal = document.getElementById('contactSalesModal');
    const form = document.getElementById('contactSalesForm');
    const submitBtn = document.getElementById('contactSalesSubmitBtn');
    const successMsg = document.getElementById('contactSalesSuccessMsg');
    const errorMsg = document.getElementById('contactSalesErrorMsg');
    const formLoadedAtInput = form.querySelector('[data-form-loaded-at]');
    const closeBtn = modal?.querySelector('[data-close-sales]');
    if (!modal || !form) return;
    if (modal.dataset.bound === 'true') return;
    modal.dataset.bound = 'true';

    const closeModal = () => {
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    const stampFormLoadedAt = () => {
      if (formLoadedAtInput instanceof HTMLInputElement) {
        formLoadedAtInput.value = String(Date.now());
      }
    };

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      if (target.id === 'contactSalesBtn' || target.closest('[data-open-sales]')) {
        stampFormLoadedAt();
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        modal.dataset.lastOpenedAt = String(Date.now());
      }
    });

    if (closeBtn instanceof HTMLButtonElement && closeBtn.dataset.bound !== 'true') {
      closeBtn.dataset.bound = 'true';
      closeBtn.addEventListener('click', closeModal);
    }

    if (modal.dataset.overlayBound !== 'true') {
      modal.dataset.overlayBound = 'true';
      modal.addEventListener('click', (e) => {
        if (e.target !== modal) return;
        const justOpened = Date.now() - Number(modal.dataset.lastOpenedAt || 0) < 500;
        if (justOpened) return;
        closeModal();
      });
    }

    if (!window.__triberaSalesModalEscBound) {
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (modal.classList.contains('hidden')) return;
        closeModal();
      });
      window.__triberaSalesModalEscBound = true;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalText = submitBtn?.textContent || 'Submit';
      errorMsg?.classList.add('hidden');
      successMsg?.classList.add('hidden');

      if (submitBtn) {
        submitBtn.textContent = 'Submitting...';
        submitBtn.setAttribute('disabled', 'true');
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const isJson = res.headers.get('content-type')?.includes('application/json');
        const result = isJson
          ? await res.json()
          : {
              success: false,
              message: 'Something went wrong while submitting your request. Please try again or email sales@tribera.ai.',
            };
        if (!res.ok || !result.success) {
          const safeClientMessage =
            res.status >= 400 && res.status < 500 && typeof result.message === 'string' && result.message.trim()
              ? result.message
              : 'Something went wrong while submitting your request. Please try again or email sales@tribera.ai.';
          throw new Error(safeClientMessage);
        }

        form.reset();
        stampFormLoadedAt();
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');

        setTimeout(() => {
          successMsg?.classList.add('hidden');
          form.classList.remove('hidden');
          closeModal();
        }, 3000);
      } catch (error) {
        console.error('Contact sales form submit failed:', error);
        if (errorMsg instanceof HTMLElement) {
          errorMsg.textContent =
            error instanceof Error && error.message
              ? error.message
              : 'Something went wrong while submitting your request. Please try again or email sales@tribera.ai.';
        }
        errorMsg?.classList.remove('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.textContent = originalText;
          submitBtn.removeAttribute('disabled');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initContactSalesModal);
  document.addEventListener('DOMContentLoaded', initContactSalesModal);
</script>
