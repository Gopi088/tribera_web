---
import { defaultHiringFormIntent, formIntentConfigs } from '~/config/formIntents';

const hiringIntentConfigs = {
  demo: formIntentConfigs.demo,
  sales: formIntentConfigs.sales,
};
const defaultIntentConfig = hiringIntentConfigs[defaultHiringFormIntent];
---

<style>
#contactSalesModal {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: block;
  overflow-y: auto;
  background: rgba(0, 0, 0, 0.55);
  padding: clamp(18px, 4vw, 40px);
}
#contactSalesModal.hidden {
  display: none;
}
.cs__wrap {
  pointer-events: none;
  min-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cs__card {
  pointer-events: auto;
  position: relative;
  width: 100%;
  max-width: 560px;
  background: linear-gradient(158deg, #232320 0%, #1a1a18 42%, #141413 100%);
  border: 1px solid #33332e;
  border-radius: 18px;
  padding: clamp(24px, 3vw, 40px);
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset, 0 24px 56px rgba(0, 0, 0, 0.45);
  overflow: hidden;
}
.cs__glint {
  position: absolute;
  top: 0;
  left: 8%;
  right: 8%;
  height: 1px;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
}
.cs__close {
  position: absolute;
  right: 16px;
  top: 16px;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid var(--cline);
  background: rgba(255, 255, 255, 0.03);
  color: var(--onc3);
  cursor: pointer;
  padding: 0;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}
.cs__close:hover {
  border-color: rgba(218, 0, 7, 0.45);
  color: #fff;
  background: rgba(218, 0, 7, 0.1);
}
.cs__close svg {
  width: 18px;
  height: 18px;
}
.cs__aud {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--red);
  margin: 0 0 14px;
}
.cs__ttl {
  font-family: var(--display);
  font-weight: 700;
  font-size: clamp(26px, 3.4vw, 34px);
  line-height: 1.05;
  letter-spacing: -0.035em;
  color: #fff;
  margin: 0;
  padding-right: 44px;
}
.cs__bd {
  font-size: 15px;
  line-height: 1.6;
  color: var(--onc2);
  margin: 16px 0 0;
  max-width: 40ch;
}
.cs__f {
  position: relative;
  margin-top: clamp(22px, 2.6vw, 30px);
  display: grid;
  gap: 14px;
}
.cs__row {
  display: grid;
  gap: 14px;
}
@media (min-width: 640px) {
  .cs__row--2 {
    grid-template-columns: 1fr 1fr;
  }
}
.cs__in {
  width: 100%;
  font-family: var(--ui);
  font-size: 15px;
  color: var(--onc);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--cline);
  border-radius: 12px;
  padding: 13px 15px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.3s var(--spring);
}
.cs__in::placeholder {
  color: var(--onc3);
}
.cs__in:focus {
  border-color: var(--onc2);
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
}
.cs__in--ta {
  resize: vertical;
  min-height: 88px;
}
.cs__ft {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-top: 2px;
}
@media (min-width: 640px) {
  .cs__ft {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}
.cs__note {
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--onc3);
  margin: 0;
}
.cs__go {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  width: 100%;
  border-radius: 999px;
  border: 0;
  background: var(--onc);
  color: var(--char);
  font-family: var(--ui);
  font-weight: 600;
  font-size: 15px;
  padding: 15px 28px;
  cursor: pointer;
  line-height: 1;
  white-space: nowrap;
  box-shadow: 0 2px 14px rgba(0, 0, 0, 0.14);
  transition: transform 0.18s var(--ease), box-shadow 0.25s, background 0.2s, color 0.2s;
}
.cs__go:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
}
@media (min-width: 640px) {
  .cs__go {
    width: auto;
  }
}
.cs__err {
  font-size: 13px;
  line-height: 1.6;
  color: #e0484e;
  margin: 12px 0 0;
}
.cs__ok {
  padding-top: 8px;
  text-align: center;
}
.cs__ok.on {
  display: block;
}
.cs__ok__i {
  margin: 0 auto 16px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(218, 0, 7, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cs__ok__i svg {
  width: 24px;
  height: 24px;
  color: var(--red);
}
.cs__ok h4 {
  font-family: var(--display);
  font-weight: 700;
  font-size: 20px;
  letter-spacing: -0.02em;
  color: #fff;
  margin: 0;
}
.cs__ok p {
  font-size: 14px;
  line-height: 1.6;
  color: var(--onc2);
  margin: 8px 0 0;
}
</style>

<div id="contactSalesModal" class="hidden" hidden>
  <div class="cs__wrap">
    <div class="cs__card">
      <span class="cs__glint"></span>
      <button data-close-sales type="button" aria-label="Close contact sales modal" class="cs__close">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M6 6L18 18" stroke-linecap="round"></path>
          <path d="M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>

      <div class="relative">
        <p data-form-audience class="cs__aud">{defaultIntentConfig.audienceLabel}</p>
        <h2 data-form-title class="cs__ttl">{defaultIntentConfig.title}</h2>
        <p data-form-body class="cs__bd">{defaultIntentConfig.body}</p>
      </div>

      <form
        id="contactSalesForm"
        action="/.netlify/functions/site-inquiry"
        method="POST"
        class="cs__f"
      >
        <input type="hidden" name="form_type" value={defaultIntentConfig.formType} data-form-type />
        <input type="hidden" name="form_intent" value={defaultHiringFormIntent} data-form-intent-input />
        <input type="hidden" name="form_source" value="" data-form-source-input />
        <input type="hidden" name="form_label" value="" data-form-label-input />
        <input type="hidden" name="form_loaded_at" value="" data-form-loaded-at />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div class="cs__row cs__row--2">
          <input
            type="text"
            name="name"
            placeholder="Full name"
            autocomplete="name"
            required
            class="cs__in"
          />

          <input
            type="email"
            name="email"
            placeholder="Work email"
            autocomplete="email"
            required
            class="cs__in"
          />
        </div>

        <input
          type="text"
          name="company"
          placeholder="Company name"
          autocomplete="organization"
          class="cs__in"
        />

        <input
          type="tel"
          name="phone"
          placeholder="Phone number"
          autocomplete="tel"
          class="cs__in"
        />

        <textarea rows="3" name="message" autocomplete="off" placeholder="How can we help?" class="cs__in cs__in--ta"></textarea>

        <div class="cs__ft">
          <p data-form-response-note class="cs__note">{defaultIntentConfig.responseNote}</p>
          <button type="submit" id="contactSalesSubmitBtn" class="cs__go">
            {defaultIntentConfig.submitLabel}
          </button>
        </div>
        <p id="contactSalesErrorMsg" class="cs__err hidden" hidden>
          Something went wrong while submitting your request. Please try again or email sales@tribera.ai.
        </p>
      </form>
      <div id="contactSalesSuccessMsg" class="cs__ok hidden" hidden>
        <div class="cs__ok__i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <h4 data-form-success-title>{defaultIntentConfig.successTitle}</h4>
        <p data-form-success-body>{defaultIntentConfig.successBody}</p>
      </div>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    hiringIntentConfigs,
    defaultHiringFormIntent,
  }}
>
  function initContactSalesModal() {
    const modal = document.getElementById('contactSalesModal');
    const form = document.getElementById('contactSalesForm');
    const submitBtn = document.getElementById('contactSalesSubmitBtn');
    const successMsg = document.getElementById('contactSalesSuccessMsg');
    const errorMsg = document.getElementById('contactSalesErrorMsg');
    const formLoadedAtInput = form?.querySelector('[data-form-loaded-at]');
    const formTypeInput = form?.querySelector('[data-form-type]');
    const formIntentInput = form?.querySelector('[data-form-intent-input]');
    const formSourceInput = form?.querySelector('[data-form-source-input]');
    const formLabelInput = form?.querySelector('[data-form-label-input]');
    const audience = modal?.querySelector('[data-form-audience]');
    const title = modal?.querySelector('[data-form-title]');
    const body = modal?.querySelector('[data-form-body]');
    const responseNote = modal?.querySelector('[data-form-response-note]');
    const successTitle = modal?.querySelector('[data-form-success-title]');
    const successBody = modal?.querySelector('[data-form-success-body]');
    const closeBtn = modal?.querySelector('[data-close-sales]');
    if (!modal || !form) return;
    if (modal.dataset.bound === 'true') return;
    modal.dataset.bound = 'true';

    const resolveIntentConfig = (intent) => {
      if (intent && hiringIntentConfigs[intent]) return [intent, hiringIntentConfigs[intent]];

      if (intent && !hiringIntentConfigs[intent] && window.location.hostname === 'localhost') {
        console.warn(`[tribera] Unknown hiring form intent "${intent}". Falling back to "${defaultHiringFormIntent}".`);
      }

      return [defaultHiringFormIntent, hiringIntentConfigs[defaultHiringFormIntent]];
    };

    const applyIntentConfig = (intent, source = '', label = '') => {
      const [resolvedIntent, config] = resolveIntentConfig(intent);
      modal.dataset.activeFormIntent = resolvedIntent;
      modal.dataset.activeFormSource = source;
      modal.dataset.activeFormLabel = label;

      if (audience instanceof HTMLElement) audience.textContent = config.audienceLabel;
      if (title instanceof HTMLElement) title.textContent = config.title;
      if (body instanceof HTMLElement) body.textContent = config.body;
      if (responseNote instanceof HTMLElement) responseNote.textContent = config.responseNote;
      if (submitBtn instanceof HTMLButtonElement) submitBtn.textContent = config.submitLabel;
      if (successTitle instanceof HTMLElement) successTitle.textContent = config.successTitle;
      if (successBody instanceof HTMLElement) successBody.textContent = config.successBody;
      if (formTypeInput instanceof HTMLInputElement) formTypeInput.value = config.formType;
      if (formIntentInput instanceof HTMLInputElement) formIntentInput.value = resolvedIntent;
      if (formSourceInput instanceof HTMLInputElement) formSourceInput.value = source;
      if (formLabelInput instanceof HTMLInputElement) formLabelInput.value = label;
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.setAttribute('hidden', '');
      document.body.classList.remove('overflow-hidden');
    };

    const stampFormLoadedAt = () => {
      if (formLoadedAtInput instanceof HTMLInputElement) {
        formLoadedAtInput.value = String(Date.now());
      }
    };

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest('[data-form-intent], [data-open-sales], [data-open-demo], #contactSalesBtn');
      if (trigger instanceof HTMLElement) {
        e.preventDefault();
        const rawIntent =
          trigger.dataset.formIntent ||
          (trigger.hasAttribute('data-open-demo')
            ? 'demo'
            : trigger.hasAttribute('data-open-sales')
              ? defaultHiringFormIntent
              : '');
        const source = trigger.dataset.formSource || '';
        const label = (trigger.dataset.formLabel || trigger.textContent || '').trim();
        applyIntentConfig(rawIntent, source, label);
        stampFormLoadedAt();
        modal.classList.remove('hidden');
        modal.removeAttribute('hidden');
        document.body.classList.add('overflow-hidden');
        modal.dataset.lastOpenedAt = String(Date.now());
      }
    });

    if (closeBtn instanceof HTMLButtonElement && closeBtn.dataset.bound !== 'true') {
      closeBtn.dataset.bound = 'true';
      closeBtn.addEventListener('click', closeModal);
    }

    if (modal.dataset.overlayBound !== 'true') {
      modal.dataset.overlayBound = 'true';
      modal.addEventListener('click', (e) => {
        if (e.target !== modal) return;
        const justOpened = Date.now() - Number(modal.dataset.lastOpenedAt || 0) < 500;
        if (justOpened) return;
        closeModal();
      });
    }

    if (!window.__triberaSalesModalEscBound) {
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (modal.classList.contains('hidden')) return;
        closeModal();
      });
      window.__triberaSalesModalEscBound = true;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalText = submitBtn?.textContent || 'Submit';
      errorMsg?.classList.add('hidden');
      errorMsg?.setAttribute('hidden', '');
      successMsg?.classList.add('hidden');
      successMsg?.setAttribute('hidden', '');

      if (submitBtn) {
        submitBtn.textContent = 'Submitting...';
        submitBtn.setAttribute('disabled', 'true');
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const isJson = res.headers.get('content-type')?.includes('application/json');
        const result = isJson
          ? await res.json()
          : {
              success: false,
              message:
                'Something went wrong while submitting your request. Please try again or email sales@tribera.ai.',
            };
        if (!res.ok || !result.success) {
          const safeClientMessage =
            res.status >= 400 && res.status < 500 && typeof result.message === 'string' && result.message.trim()
              ? result.message
              : 'Something went wrong while submitting your request. Please try again or email sales@tribera.ai.';
          throw new Error(safeClientMessage);
        }

        form.reset();
        stampFormLoadedAt();
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');
        successMsg?.removeAttribute('hidden');

        setTimeout(() => {
          successMsg?.classList.add('hidden');
          successMsg?.setAttribute('hidden', '');
          form.classList.remove('hidden');
          closeModal();
        }, 3000);
      } catch (error) {
        console.error('Contact sales form submit failed:', error);
        if (errorMsg instanceof HTMLElement) {
          errorMsg.textContent =
            error instanceof Error && error.message
              ? error.message
              : 'Something went wrong while submitting your request. Please try again or email sales@tribera.ai.';
        }
        errorMsg?.classList.remove('hidden');
          errorMsg?.removeAttribute('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.textContent = originalText;
          submitBtn.removeAttribute('disabled');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initContactSalesModal);
  document.addEventListener('DOMContentLoaded', initContactSalesModal);
</script>
