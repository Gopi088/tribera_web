<div
  id="contactSalesModal"
  class="fixed inset-0 z-[1200] hidden items-start justify-center overflow-y-auto bg-black/50 p-3 sm:items-center sm:p-4"
>
  <div class="relative my-4 w-full max-w-[420px] rounded-2xl border border-black/10 bg-white p-5 sm:my-0 sm:p-6">
    <!-- Close -->
    <button data-close-sales class="absolute right-3 top-3 text-lg text-gray-500"> ✕ </button>

    <h2 class="text-xl font-semibold text-center mb-4">Contact Sales</h2>

    <p class="text-sm text-center text-gray-500 mb-4">Tell us about your needs and our team will reach out.</p>

    <form id="contactSalesForm" action="/.netlify/functions/site-inquiry" method="POST" class="space-y-4">
      <input type="hidden" name="form_type" value="sales" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
      <input
        type="text"
        name="name"
        placeholder="Full name"
        autocomplete="name"
        required
        class="w-full rounded-xl border border-black/15 px-4 py-3 text-[14px] focus:border-[#DA0007]/40 focus:outline-none focus:ring-1 focus:ring-[#DA0007]/30"
      />

      <input
        type="email"
        name="email"
        placeholder="Work email"
        autocomplete="email"
        required
        class="w-full rounded-xl border border-black/15 px-4 py-3 text-[14px] focus:border-[#DA0007]/40 focus:outline-none focus:ring-1 focus:ring-[#DA0007]/30"
      />

      <input
        type="text"
        name="company"
        placeholder="Company name"
        autocomplete="organization"
        class="w-full rounded-xl border border-black/15 px-4 py-3 text-[14px] focus:border-[#DA0007]/40 focus:outline-none focus:ring-1 focus:ring-[#DA0007]/30"
      />

      <textarea
        rows="3"
        name="message"
        autocomplete="off"
        placeholder="How can we help?"
        class="w-full rounded-xl border border-black/15 px-4 py-3 text-[14px] focus:border-[#DA0007]/40 focus:outline-none focus:ring-1 focus:ring-[#DA0007]/30"></textarea>

      <button
        type="submit"
        id="contactSalesSubmitBtn"
        class="w-full rounded-xl bg-[#Da0007] py-3 font-semibold text-white"
      >
        Submit
      </button>
      <p id="contactSalesErrorMsg" class="hidden text-[13px] text-center text-black/60">
        Something went wrong while submitting your request. Please try again or email sales@tribera.ai.
      </p>
    </form>
    <div id="contactSalesSuccessMsg" class="hidden text-center pt-2">
      <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#DA0007]/10 flex items-center justify-center">
        <svg viewBox="0 0 24 24" class="w-7 h-7 text-[#DA0007]" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <h4 class="text-[20px] font-[700] text-black">Request Submitted</h4>
      <p class="mt-2 text-[14px] leading-relaxed text-black/60">
        Thanks for reaching out. Our team will contact you shortly.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  function initContactSalesModal() {
    const modal = document.getElementById('contactSalesModal');
    const form = document.getElementById('contactSalesForm');
    const submitBtn = document.getElementById('contactSalesSubmitBtn');
    const successMsg = document.getElementById('contactSalesSuccessMsg');
    const errorMsg = document.getElementById('contactSalesErrorMsg');
    if (!modal || !form) return;
    if (modal.dataset.bound === 'true') return;
    modal.dataset.bound = 'true';

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      if (target.id === 'contactSalesBtn' || target.closest('[data-open-sales]')) {
        modal.classList.remove('hidden');
      }

      if (target.hasAttribute('data-close-sales')) {
        modal.classList.add('hidden');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalText = submitBtn?.textContent || 'Submit';
      errorMsg?.classList.add('hidden');
      successMsg?.classList.add('hidden');

      if (submitBtn) {
        submitBtn.textContent = 'Submitting...';
        submitBtn.setAttribute('disabled', 'true');
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await res.json();
        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Submission failed');
        }

        form.reset();
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');

        setTimeout(() => {
          successMsg?.classList.add('hidden');
          form.classList.remove('hidden');
          modal.classList.add('hidden');
        }, 3000);
      } catch (error) {
        console.error('Contact sales form submit failed:', error);
        errorMsg?.classList.remove('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.textContent = originalText;
          submitBtn.removeAttribute('disabled');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initContactSalesModal);
  document.addEventListener('DOMContentLoaded', initContactSalesModal);
</script>
