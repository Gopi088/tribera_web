<link rel="stylesheet" href="/fonts/site-fonts.css" />
<script is:inline>
  // Decode shared faces before body layout without hiding content.
  if ('fonts' in document) {
    for (const font of [
      '800 20px Figtree',
      '400 16px "Inter Tight"',
      '500 16px "Inter Tight"',
      '600 16px "Inter Tight"',
      '400 16px Fraunces',
      '500 16px Fraunces',
      '600 16px Fraunces',
      'italic 500 16px Fraunces',
      '400 12px "JetBrains Mono"',
      '500 12px "JetBrains Mono"',
      '700 12px "JetBrains Mono"',
    ])
      document.fonts.load(font).catch(() => {});
  }
</script>
