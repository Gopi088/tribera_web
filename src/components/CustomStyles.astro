---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    /* Shared Tribera design tokens. Page sections should use these instead of
       repeating literal fonts, colours, radii, and button transitions. */
    --tribera-font-display: 'Figtree', 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --tribera-font-body: 'Inter Tight', 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --tribera-font-mono: 'JetBrains Mono', ui-monospace, monospace;
    --tribera-color-ink: #111110;
    --tribera-color-surface: #f2f2f0;
    --tribera-color-paper: #ffffff;
    --tribera-color-muted: #6b6b67;
    --tribera-color-on-dark: #f3f3f0;
    --tribera-color-red: #da0007;
    --tribera-radius-pill: 999px;
    --tribera-transition: 200ms cubic-bezier(.16, 1, .3, 1);

    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);
    --aw-letter-spacing-heading: -0.02em;
    --aw-letter-spacing-h1: -0.07em;

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(3 6 32);

    ::selection {
      background-color: black;
      color: snow;
    }
  }

  h1 {
    letter-spacing: var(--aw-letter-spacing-h1);
  }

  h2,
  h3 {
    letter-spacing: var(--aw-letter-spacing-heading);
  }

  .tribera-primary-button {
    background-color: var(--tribera-color-red);
    color: #fff;
    transition:
      background-color 300ms ease,
      box-shadow 300ms ease,
      transform 300ms ease;
  }

  .tribera-primary-button:hover {
    background-color: #c10006;
    box-shadow: 0 12px 40px rgba(218, 0, 7, 0.4);
    transform: translateY(-2px);
  }

  .tribera-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--tribera-radius-pill);
    font-family: var(--tribera-font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    transition: transform var(--tribera-transition), background-color var(--tribera-transition), border-color var(--tribera-transition);
  }

  .tribera-button:hover {
    transform: translateY(-1px);
  }

  /* The mobile Coverage label opens the overview; its adjacent control only expands the submenu. */
  html body .nav__l.dd__t[aria-current='page']::after {
    display: none !important;
  }

  html body .navp__coverage {
    display: flex;
    align-items: center;
  }

  html body .navp a.navp__coverage-link {
    display: block;
    flex: 1 1 auto;
    padding: 7px 0;
    color: var(--onc2, #a8a8a2);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
  }

  html body .navp a.navp__coverage-link:hover,
  html body .navp a.navp__coverage-link[aria-current='page'] {
    color: #fff;
  }

  html body .navp__coverage .navp__t {
    width: auto;
    padding: 7px 6px 7px 14px;
  }

  html body .navp__coverage .navp__t i {
    margin-right: 0;
  }

  html body .navp__sw {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }
  html body .navp .navp__sw a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    text-align: center;
    padding: 10px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--onc2);
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    transition: background 0.25s var(--ease), color 0.2s;
  }
  html body .navp .navp__sw a::before {
    display: none;
  }
  html body .navp .navp__sw a.is {
    background: var(--onc);
    color: var(--char);
  }
  html body .navp__sw a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.11);
  }
  html body .navp__sw a.is {
    background: var(--onc);
    color: var(--char);
  }

  @media (max-width: 1079px) {
    html body .nav__sw {
      display: none !important;
    }
  }

  :root {
    --tribera-blog-display: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --tribera-blog-body: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Palatino, Georgia, serif;
  }

  .blog-display {
    font-family: var(--tribera-blog-display);
  }

  .blog-body {
    font-family: var(--tribera-blog-body);
  }

  /* Mobile-specific adjustments */
  @media (max-width: 640px) {
    /* Slightly smaller base text for very small screens */
    html {
      font-size: 93.75%; /* 15px base instead of 16px */
    }
    /* Buttons */
    .tribera-button {
      font-size: 0.75rem; /* 12px */
      padding: 0.5rem 1rem;
    }
    .tribera-primary-button {
      font-size: 0.75rem;
      padding: 0.5rem 1rem;
    }
    /* Headings */
    h1 { font-size: 1.75rem; line-height: 1.2; }
    h2 { font-size: 1.5rem; line-height: 1.3; }
    h3 { font-size: 1.25rem; line-height: 1.35; }
    /* Adjust spacing containers */
    .wrap {
      padding-inline: 1rem;
    }
    .band {
      padding-block: 2rem;
    }
    /* Ensure grid columns become single column where appropriate */
    .grid-cols-2,
    .grid-cols-3,
    .grid-cols-4 {
      grid-template-columns: 1fr !important;
    }
    /* Header navigation adjustments */
    .nav__links {
      flex-direction: column;
      gap: 0.5rem;
      align-items: stretch;
    }
    .nav__sw {
      flex-direction: column;
      gap: 0.25rem;
    }
    .burger {
      margin-top: 0.5rem;
    }
    /* Hide large desktop-only elements if any */
    .hidden-mobile {
      display: none !important;
    }
    /* Show mobile-only elements */
    .block-mobile {
      display: block !important;
    }
  }
</style>
