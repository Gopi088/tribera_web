---
import { dimensions, briefs, weightedScore, leadingPriorities, weakerEvidence } from './model';
import EditorialHeading from '../v58/EditorialHeading.astro';
const initialScore = weightedScore(briefs[0].weights).toFixed(1);
const initialPriorities = leadingPriorities(briefs[0].weights);
const clients = [
  'Mizuho',
  'Capco',
  'Deloitte',
  'ArcelorMittal',
  'Flipkart',
  'Myntra',
  'Motherson',
  'Publicis Sapient',
  'Publicis Resources',
  'Evident Microscopy',
  'Antz',
];
const steps = [
  ['01', 'Share your profile', 'Your CV, experience and the kind of work you want next.'],
  ['02', 'Speak with an expert', 'A conversation about your work, decisions and the problems you have solved.'],
  ['03', 'Explore relevant roles', 'We review your experience against what each hiring team needs.'],
  ['04', 'Choose your next move', 'Meet the team, ask your questions and decide whether the role fits.'],
];
const quotes = [
  [
    'From the very first conversation, the process was handled with professionalism, transparency and steady communication. A special mention to Chyna from Tribera, who understood my background and stayed with me the whole way - coordinating interviews, sharing timely updates and offering guidance at every stage. She made a stressful process feel genuinely smooth.',
    'Anil Giri',
  ],
  [
    'From the initial shortlisting of my profile to coordinating the discussions and interview rounds, the team kept a high level of professionalism, responsiveness and transparency. Expectations, timelines, feedback and next steps were communicated clearly at every stage - which made the whole process feel smooth, structured and genuinely well-run.',
    'Reema Mitra',
  ],
];
---

<div class="candidate-page">
  <header class="c-hero" id="top">
    <div class="c-hero__main c-wrap">
      <p class="c-eyebrow"><span aria-hidden="true">\</span> Be seen for what you can do</p>
      <h1>
        Interview once.<br /><em class="c-underline"
          >Be seen for your work.<svg viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true"
            ><path d="M2,8 C26,3.5 54,9.5 84,6 C104,3.6 116,8 118,5"></path></svg
          ></em
        >
      </h1>
      <p class="c-lead">
        You know what it is like to send a CV and hear nothing back. One conversation with an expert brings your work
        into focus. We take that evidence to relevant teams, so they have more to go on before they meet you.
      </p>
      <div class="c-actions">
        <a class="c-primary" href="#apply">Create your profile</a><a class="c-link" href="#score"
          >See how teams assess fit &rsaquo;</a
        >
      </div>
      <p class="c-micro">Less ground to cover again. More of your work understood.</p>
    </div>
    <a class="c-cue" href="#score">Same person. A different fit.<span aria-hidden="true">&darr;</span></a>
  </header>
  <div class="c-clients">
    <div class="c-wrap">
      <span class="c-label">Teams we have worked with</span><div class="c-clients__window">
        <div class="c-clients__track">
          {
            [0, 1].map((copy) => (
              <div aria-hidden={copy === 1 ? 'true' : undefined}>
                {clients.map((client) => (
                  <span>
                    {client}
                    <i aria-hidden="true">&middot;</i>
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <section class="c-section c-dark" id="score" aria-labelledby="score-title">
    <div class="c-wrap">
      <p class="c-eyebrow"><span aria-hidden="true">\</span> How fit works</p>
      <div class="c-head">
        <div>
          <EditorialHeading id="score-title">Same person.<br />Different team.<br />Different score.</EditorialHeading>
        </div><p class="c-lead">
          These six scores come from Anirudh's sample interview. They stay the same, but what each team needs is
          different. Choose a team to see how that changes his overall score.
        </p>
      </div>
      <div class="c-score-layout" data-candidate-score>
        <article class="c-scorecard">
          <div class="c-score-summary">
            <div data-score-summary-content>
              <div class="c-scorecard__who">
                <div><h3>Anirudh Mehta</h3><p>Senior backend &middot; 6 years</p></div><span class="c-badge"
                  >Sample profile</span
                >
              </div>
              <p class="c-scorecard__number"><b data-score>{initialScore}</b><span>/ 100</span></p>
              <div class="c-scorecard__track" aria-hidden="true">
                <i data-score-pin style={`left:${initialScore}%`}></i>
              </div>
              <p class="c-scorecard__axis">
                <span>0</span><span>Weighted score &middot; not a ranking</span><span>100</span>
              </p>
            </div>
          </div>
          <p class="c-label c-evidence-label">Interview scores &middot; out of 100</p>
          <dl class="c-evidence">
            {
              dimensions.map((dimension, index) => (
                <div
                  tabindex="0"
                  data-evidence-row={index}
                  class:list={{ 'is-priority': initialPriorities[index], 'is-weaker': weakerEvidence[index] }}
                >
                  <>
                    <dt>{dimension.name}</dt>
                    <dd>{dimension.score}</dd>
                  </>
                </div>
              ))
            }
          </dl>
          <p class="c-evidence-key">
            <span>Amber: relatively weaker areas</span><span>Bright borders: this team's leading priorities</span>
          </p>
        </article>
        <div class="c-priorities">
          <div class="c-mobile-score">
            <div><span>Anirudh's overall score</span><small data-mobile-team>{briefs[0].name}</small></div><strong
              ><b data-mobile-score>{initialScore}</b><small> / 100</small></strong
            >
          </div>
          <div class="c-score-summary">
            <div data-score-summary-content>
              <p class="c-label" id="brief-label">Choose a team</p>
              <div class="c-presets" role="group" aria-labelledby="brief-label">
                {
                  briefs.map((brief, index) => (
                    <button type="button" data-brief={index} aria-pressed={index === 0}>
                      {brief.name}
                    </button>
                  ))
                }
              </div>
              <p class="c-score-note" data-score-note>{briefs[0].note}</p>
            </div>
          </div>
          <div class="c-weights-heading"><span>What this team values</span><span>Importance</span></div>
          <dl class="c-weights">
            {
              dimensions.map((dimension, index) => (
                <div tabindex="0" data-priority-row={index} class:list={{ 'is-priority': initialPriorities[index] }}>
                  <>
                    <dt>{dimension.name}</dt>
                    <dd>
                      <>
                        <span class="c-weight-track" aria-hidden="true">
                          <i data-weight-bar style={`width:${briefs[0].weights[index]}%`} />
                        </span>
                        <b data-weight>{briefs[0].weights[index]}%</b>
                      </>
                    </dd>
                  </>
                </div>
              ))
            }
          </dl>
          <p class="c-small">
            Weights total 100%. These briefs illustrate the calculation, not a live vacancy or a hiring decision.
          </p>
          <noscript
            ><p class="c-small">
              The Consumer product example is shown. Enable JavaScript to compare the other briefs.
            </p></noscript
          >
          <p class="c-sr-only" role="status" aria-live="polite" data-score-status></p>
        </div>
      </div>
    </div>
  </section>

  <section class="c-section c-paper" id="tally">
    <div class="c-wrap">
      <div class="c-head">
        <div>
          <p class="c-eyebrow"><span aria-hidden="true">\</span> What teams could not see</p><h2>
            The same experience.<br />A different picture.
          </h2>
        </div><p class="c-lead">
          Your ability did not begin with this interview. What changes is what a team can see: the decisions you made,
          the alternatives you rejected and what you learned when things went wrong.
        </p>
      </div>
      <div class="c-comparison">
        <article>
          <p class="c-label">On a CV &middot; illustrative example</p><h3>Built a payments service.</h3><p>
            The project and the stack. A useful starting point, but your contribution is still hard to see.
          </p>
        </article><article class="c-comparison__evidence">
          <p class="c-label">In the conversation</p><h3>Why that design? What did it cost?</h3><p>
            The trade-off you rejected, why you rejected it, and what happened six months later. Now the team can see
            the judgment behind the job title.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="c-section" id="proof">
    <div class="c-wrap">
      <div class="c-head">
        <div>
          <p class="c-eyebrow"><span aria-hidden="true">\</span> Both sides of the conversation</p><h2>
            See what the team sees.
          </h2>
        </div><p class="c-lead">
          Your interview gives the team more than a CV to read before they call. You need a clear picture of them, too.
          Explore both sides in this example: your experience, and the opportunity you are considering.
        </p>
      </div>
      <div class="c-preview" data-candidate-preview>
        <div class="c-tabs" role="tablist" aria-label="Profile and team examples">
          <button type="button" role="tab" id="profile-tab" aria-controls="profile-panel" aria-selected="true"
            >Your profile</button
          ><button type="button" role="tab" id="team-tab" aria-controls="team-panel" aria-selected="false" tabindex="-1"
            >The team asking</button
          >
        </div>
        <div class="c-preview__frame">
          <article id="profile-panel" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
            <div class="c-preview__heading">
              <div class="c-preview__meta">
                <p class="c-label">Illustrative profile</p><span class="c-badge">Evidence first</span>
              </div><h3>Senior backend engineer</h3><p>6 years &middot; Python, AWS, Kubernetes</p>
            </div>
            <div class="c-preview__columns">
              <div>
                <p class="c-label">What the interview brought out</p><h4>
                  Designed for retries, without duplicate payments.
                </h4><p>
                  Explained the failure mode, why an idempotency key was needed, and how the team checked the change in
                  production.
                </p>
              </div><div>
                <p class="c-label">What to explore next</p><h4>How did you bring the team with you?</h4><p>
                  The technical reasoning is clear. A worked example of resolving a design disagreement would add the
                  collaboration behind it.
                </p>
              </div>
            </div>
          </article>
          <article id="team-panel" role="tabpanel" aria-labelledby="team-tab" tabindex="0" hidden>
            <div class="c-preview__heading">
              <div class="c-preview__meta">
                <p class="c-label">Illustrative team brief</p><span class="c-badge">Example team</span>
              </div><h3>Platform team, 9 engineers</h3><p>Consumer internet &middot; reports to VP Engineering</p>
            </div>
            <dl class="c-team-facts">
              <div><dt>The work</dt><dd>Own reliability and on-call improvements for a growing platform</dd></div><div>
                <dt>The manager</dt><dd>VP Engineering, with a team of nine engineers</dd>
              </div><div>
                <dt>The process</dt><dd>Technical discussion, manager conversation, then a team meeting</dd>
              </div><div>
                <dt>The practicalities</dt><dd>
                  Discuss the on-call rotation, location and compensation before proceeding
                </dd>
              </div>
            </dl>
          </article>
        </div>
        <p class="c-small">Examples only. Actual evidence and role details depend on the interview and hiring brief.</p>
      </div>
    </div>
  </section>

  <section class="c-section c-paper" id="thirty">
    <div class="c-wrap">
      <div class="c-head c-conversation-head">
        <div>
          <p class="c-eyebrow"><span aria-hidden="true">\</span> The expert conversation</p><h2>
            One conversation.<br /><span class="c-underline"
              >Less starting over.<svg viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true"
                ><path d="M2,8 C26,3.5 54,9.5 84,6 C104,3.6 116,8 118,5"></path></svg
              ></span
            >
          </h2>
        </div><p class="c-lead">
          Tell someone who knows the work how you actually did it. The evidence carries forward to relevant teams, so
          each introduction can build on what you have already explained.
        </p>
      </div>
      <div class="c-features">
        <article>
          <h3>Someone who knows where to go deeper.</h3><p>
            An expert in your field explores your decisions and trade-offs, with questions shaped by the work you have
            done.
          </p>
        </article><article>
          <h3>A starting point for the next conversation.</h3><p>
            Teams can build on your evidence rather than just your CV. They may still ask follow-up questions and run
            their own interviews.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="c-section" id="controls">
    <div class="c-wrap">
      <div class="c-head">
        <div>
          <p class="c-eyebrow"><span aria-hidden="true">\</span> Your preferences matter</p><h2>
            Looking for a move.<br />Keeping it discreet.
          </h2>
        </div><p class="c-lead">
          Exploring your next role does not mean announcing your search. Tell us which companies should be excluded and
          discuss how your profile will be shared before an introduction.
        </p>
      </div>
      <div class="c-control-grid">
        <article>
          <h3>Who can see your profile.</h3><p>
            Let us know if your current employer or other companies should be excluded from introductions.
          </p>
        </article><article>
          <h3>Which conversations you want.</h3><p>
            Share your priorities for the role, location and team. You decide which opportunities to explore.
          </p>
        </article><article>
          <h3>When your plans change.</h3><p>Tell us if you want to pause your search or update your preferences.</p>
        </article><article>
          <h3>How your data is handled.</h3><p>
            Review our privacy policy and ask about access, recording, retention or deletion before you proceed.
          </p>
        </article>
      </div>
      <a class="c-policy" href="/privacy">Read our privacy policy</a>
      <div class="c-control-foot">
        <div>
          <h3>No candidate fee.</h3><p>
            Companies pay for our services. You do not pay us to be considered for a role.
          </p>
        </div><div>
          <h3>Across functions.</h3><p>
            Engineering, data, infrastructure, finance, operations and leadership. We confirm whether we cover your
            area.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="c-section c-paper" id="when">
    <div class="c-wrap">
      <div class="c-head">
        <div>
          <p class="c-eyebrow"><span aria-hidden="true">\</span> What happens next</p><h2>
            A clear next step.<br />At every stage.
          </h2>
        </div><p class="c-lead">
          Start with your profile. We review where we can help and explain the next step. Timing depends on your
          experience and the roles available.
        </p>
      </div>
      <ol class="c-steps">
        {
          steps.map(([number, title, copy], index) => (
            <li class:list={{ 'c-step--yours': index === 0 || index === 3 }}>
              <div class="c-step__card">
                <>
                  <span class="c-label">
                    {number} &middot; {index === 0 || index === 3 ? 'Your move' : 'With Tribera'}
                  </span>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </>
              </div>
              {index < steps.length - 1 && (
                <svg class="c-step__arrow" viewBox="0 0 36 16" aria-hidden="true">
                  <path d="M2 9 Q12 6 32 8 M24 3 L33 8 L25 13" />
                </svg>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="c-section c-dark" id="voices">
    <div class="c-wrap">
      <div class="c-head">
        <div>
          <p class="c-eyebrow"><span aria-hidden="true">\</span> In their words</p><h2>What candidates say.</h2>
        </div>
      </div>
      <div class="c-quotes">
        {
          quotes.map(([quote, name]) => (
            <figure>
              <>
                <span class="c-badge">Candidate</span>
                <blockquote>&ldquo;{quote}&rdquo;</blockquote>
                <figcaption>
                  <>
                    <b>{name}</b>
                    <span>Placed through Tribera</span>
                  </>
                </figcaption>
              </>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="c-section c-apply" id="apply">
    <div class="c-wrap" id="close">
      <p class="c-eyebrow"><span aria-hidden="true">\</span> Start with your experience</p><h2>
        Give the right teams<br />more reasons to meet you.
      </h2>
      <p class="c-lead">
        Share your CV and the work you want next. An expert conversation can turn that experience into evidence for
        relevant teams, so your next introduction starts with what you can do.
      </p>
      <form action="/candidates/start" method="get" class="c-signup">
        <label for="candidate-email">Your email</label><div>
          <input
            id="candidate-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="you@example.com"
          /><button type="submit" class="c-primary">Create your profile</button>
        </div><p class="c-small">
          Next: your name and CV. Review our <a href="/privacy">privacy policy</a> before submitting your profile.
        </p>
      </form>
      <p class="c-other">Hiring for your team? <a href="/">See how we work with you &rsaquo;</a></p>
    </div>
  </section>
</div>

<script>
  import { briefs, weightedScore, leadingPriorities } from './model';
  const root = document.querySelector('.candidate-page');
  if (root) {
    const scoreLayout = root.querySelector<HTMLElement>('[data-candidate-score]')!;
    const summaries = [...root.querySelectorAll<HTMLElement>('[data-score-summary-content]')];
    // Share only the summary height, leaving the two breakdowns at natural height.
    const alignSummaries = () => {
      scoreLayout.style.setProperty(
        '--score-summary-height',
        `${Math.ceil(Math.max(...summaries.map((summary) => summary.getBoundingClientRect().height)))}px`
      );
    };
    const summaryObserver = new ResizeObserver(alignSummaries);
    summaries.forEach((summary) => summaryObserver.observe(summary));
    alignSummaries();
    const evidenceRows = [...root.querySelectorAll<HTMLElement>('[data-evidence-row]')];
    const priorityRows = [...root.querySelectorAll<HTMLElement>('[data-priority-row]')];
    let hoveredRow = -1;
    let focusedRow = -1;
    function highlightRows() {
      const active = hoveredRow >= 0 ? hoveredRow : focusedRow;
      [evidenceRows, priorityRows].forEach((rows) =>
        rows.forEach((row, index) => row.classList.toggle('is-linked', index === active))
      );
    }
    [evidenceRows, priorityRows].forEach((rows) =>
      rows.forEach((row, index) => {
        row.addEventListener('pointerenter', () => {
          hoveredRow = index;
          highlightRows();
        });
        row.addEventListener('pointerleave', () => {
          hoveredRow = -1;
          highlightRows();
        });
        row.addEventListener('focus', () => {
          focusedRow = index;
          highlightRows();
        });
        row.addEventListener('blur', () => {
          focusedRow = -1;
          highlightRows();
        });
      })
    );
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-brief]')];
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const index = Number(button.dataset.brief);
        const brief = briefs[index];
        const priorities = leadingPriorities(brief.weights);
        [evidenceRows, priorityRows].forEach((rows) =>
          rows.forEach((row, i) => row.classList.toggle('is-priority', priorities[i]))
        );
        const value = weightedScore(brief.weights).toFixed(1);
        buttons.forEach((other, otherIndex) => other.setAttribute('aria-pressed', String(otherIndex === index)));
        root.querySelector('[data-score]')!.textContent = value;
        root.querySelector('[data-mobile-score]')!.textContent = value;
        root.querySelector('[data-mobile-team]')!.textContent = brief.name;
        root.querySelector<HTMLElement>('[data-score-pin]')!.style.left = `${value}%`;
        root.querySelector('[data-score-note]')!.textContent = brief.note;
        root.querySelectorAll('[data-weight]').forEach((element, i) => {
          element.textContent = `${brief.weights[i]}%`;
        });
        root.querySelectorAll<HTMLElement>('[data-weight-bar]').forEach((element, i) => {
          element.style.width = `${brief.weights[i]}%`;
        });
        root.querySelector('[data-score-status]')!.textContent =
          `${brief.name}: ${value} out of 100. Interview evidence unchanged.`;
      })
    );
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    function selectTab(index: number) {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls')!)!;
        panel.hidden = !selected;
        panel.inert = !selected;
      });
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(index));
      tab.addEventListener('keydown', (event) => {
        const next =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? tabs.length - 1
              : event.key === 'ArrowRight'
                ? (index + 1) % tabs.length
                : event.key === 'ArrowLeft'
                  ? (index + tabs.length - 1) % tabs.length
                  : null;
        if (next === null) return;
        event.preventDefault();
        selectTab(next);
        tabs[next].focus();
      });
    });
    selectTab(0);
  }
</script>

<style>
  .candidate-page {
    color: var(--v58-ink);
    background: var(--v58-white);
    font-family: var(--v58-ui);
  }
  .c-wrap {
    width: min(100% - clamp(44px, 10vw, 144px), 1160px);
    margin-inline: auto;
  }
  .candidate-page :is(h1, h2) {
    font-family: var(--v58-display);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.08;
    margin: 0;
  }
  h1 {
    font-size: clamp(2.08rem, 4.48vw, 3.32rem);
  }
  h2 {
    font-size: clamp(2rem, 3.9vw, 3rem);
  }
  h3 {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 12px;
  }
  p {
    margin: 0;
  }
  .c-section {
    padding-block: clamp(76px, 10vw, 140px);
    scroll-margin-top: 80px;
  }
  .c-paper {
    background: var(--v58-paper);
  }
  .c-dark {
    background: var(--v58-charcoal);
    color: #fff;
  }
  .c-eyebrow {
    font: 400 0.56rem/1.5 var(--v58-mono);
    color: var(--v58-faint);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 1.28rem;
  }
  .c-eyebrow > span {
    color: var(--v58-red);
    margin-right: 0.6em;
  }
  .c-lead {
    color: var(--v58-muted);
    font-size: clamp(16px, 1.1vw, 19px);
    line-height: 1.55;
    max-width: 60ch;
  }
  .c-head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(32px, 3vw, 48px);
  }
  .c-head h2 {
    max-width: 22ch;
  }
  #controls .c-head,
  #when .c-head,
  #proof .c-head {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  #controls .c-lead,
  #when .c-lead,
  #proof .c-lead {
    max-width: 62ch;
  }
  .c-dark .c-lead,
  .c-dark .c-eyebrow,
  .c-dark .c-small {
    color: rgba(255, 255, 255, 0.65);
  }
  .c-hero {
    min-height: calc(100svh - 126px);
    padding-block: clamp(24px, 3.5vw, 44px);
    background: radial-gradient(1100px 520px at 50% 6%, rgba(218, 0, 7, 0.05), transparent 60%), #fff;
    display: flex;
    flex-direction: column;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .c-hero::before {
    content: '';
    position: absolute;
    inset: 22% 12%;
