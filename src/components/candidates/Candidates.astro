  .c-weights > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 172px;
    gap: 10px;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 5px 0;
    min-height: 36px;
  }
  .c-weights dt {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 14px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.8);
  }
  .c-weights dd {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .c-weights b {
