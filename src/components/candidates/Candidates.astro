    .c-presets button,
    .c-weights > div {
      scroll-margin-top: 180px;
    }
    .c-mobile-score > div {
      display: grid;
      gap: 4px;
    }
    .c-mobile-score span {
      font-size: 13px;
    }
    .c-mobile-score small {
      color: rgba(255, 255, 255, 0.65);
      font-size: 12px;
    }
    .c-mobile-score strong {
      white-space: nowrap;
      font: 500 28px/1.2 var(--v58-mono);
      font-variant-numeric: tabular-nums;
    }
