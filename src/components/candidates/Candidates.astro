  .c-comparison,
  .c-features,
  .c-control-grid,
  .c-quotes {
    display: grid;
    gap: 16px;
  }
  .c-comparison article,
  .c-control-grid article {
    background: #fff;
    padding: 1.55rem;
    border: 1px solid var(--v58-line);
