    .c-mobile-score {
      position: sticky;
      top: 72px;
      z-index: 2;
      background: var(--v58-charcoal);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 0;
      margin-bottom: 20px;
      border-block: 1px solid rgba(255, 255, 255, 0.15);
