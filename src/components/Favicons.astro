---
const ico = '/favicon.ico';
const svg = '/favicon.svg';
const png = '/favicon.png';
const png32 = '/favicon-32x32.png';
const png16 = '/favicon-16x16.png';
const apple180 = '/apple-touch-icon.png';
---

<!-- Standard ICO -->
<link rel="icon" href={ico} sizes="any" />

<!-- SVG -->
<link rel="icon" type="image/svg+xml" href={svg} />

<!-- PNG fallbacks -->
<link rel="icon" type="image/png" sizes="32x32" href={png} />
<link rel="icon" type="image/png" sizes="32x32" href={png32} />
<link rel="icon" type="image/png" sizes="16x16" href={png16} />

<!-- iOS -->
<link rel="apple-touch-icon" sizes="180x180" href={apple180} />

<!-- Safari pinned tab -->
<link rel="mask-icon" href={svg} color="#8D46E7" />
