---
import type { ImageMetadata } from 'astro';
import type { Post } from '~/types';

import placeholder from '~/assets/images/blog/placeholder.png';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
  layout?: 'long' | 'short';
  equalized?: boolean;
}

const { post, layout = 'short', equalized = false } = Astro.props;

const image = (await findImage(post.image)) as ImageMetadata | undefined;
const link = getPermalink(post.permalink, 'post');
const formatLabel = (value: string) =>
  value
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');

const metaLabel = post.category?.title ?? (post.tags?.[0]?.title ? formatLabel(post.tags[0].title) : undefined);

const toMinutes = (value: unknown): number | undefined => {
  if (typeof value === 'number' && Number.isFinite(value)) return Math.max(1, Math.round(value));
  if (typeof value === 'string') {
    const parsed = Number.parseFloat(value);
    if (Number.isFinite(parsed)) return Math.max(1, Math.round(parsed));
  }
  return undefined;
};

const readTime = toMinutes(post.readingTime);
---

<a
  href={link}
  data-astro-reload
  class={`group relative overflow-hidden rounded-[20px] border border-[#da0007]/15 bg-white transition-all duration-500 hover:-translate-y-1 hover:border-[#da0007]/35 hover:shadow-[0_18px_48px_-24px_rgba(218,0,7,0.28)] ${layout === 'long' ? `block ${equalized ? 'h-full min-h-0' : ''}` : `flex h-full min-h-0 flex-col`}`}
>
  {
    layout === 'long' ? (
      <div class="flex h-full flex-col lg:grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
        <div class="relative aspect-[4/3] overflow-hidden border-b border-black/5 bg-[#1a0000] lg:aspect-auto lg:min-h-full lg:border-b-0 lg:border-r lg:border-black/5">
          <img
            src={image?.src ?? placeholder.src}
            alt={post.title}
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#250003]/35 to-[#120001]/45 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
        </div>

        <div class="flex h-full flex-col p-6 lg:p-7">
          <div class="space-y-5">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-[12px] text-black/42">
              <span>{getFormattedDate(post.publishDate)}</span>
              <span class="text-black/25">·</span>
              {metaLabel && (
                <>
                  <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[#da0007]">{metaLabel}</span>
                </>
              )}
              {readTime && (
                <>
                  <span class="text-black/25">·</span>
                  <span>{readTime} min read</span>
                </>
              )}
            </div>

            <h3 class="blog-display max-w-[14ch] text-[1.85rem] font-[700] leading-[1.08] tracking-[-0.025em] text-black transition-colors duration-300 group-hover:text-[#da0007] lg:text-[2rem]">
              {post.title}
            </h3>

            {post.excerpt && (
              <p class="blog-body max-w-[44ch] text-[16px] leading-[1.75] text-black/58">{post.excerpt}</p>
            )}

            {Array.isArray(post.tags) && post.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-1.5">
                {post.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full border border-[#da0007]/20 bg-[#da0007]/[0.04] px-3 py-1 text-[10px] font-semibold text-[#da0007]">
                    {formatLabel(tag.title)}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    ) : (
      <>
        <div class="relative aspect-[16/10] w-full overflow-hidden border-b border-black/5 bg-[#1a0000]">
          <img
            src={image?.src ?? placeholder.src}
            alt={post.title}
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#250003]/35 to-[#120001]/45 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
        </div>

        <div class="flex flex-1 flex-col p-5 sm:p-6">
          <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-2 text-[12px] text-black/42">
            <span>{getFormattedDate(post.publishDate)}</span>
            <span class="text-black/25">·</span>
            {metaLabel && (
              <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[#da0007]">{metaLabel}</span>
            )}
            {readTime && (
              <>
                <span class="text-black/25">·</span>
                <span>{readTime} min read</span>
              </>
            )}
          </div>

          <h3 class="blog-display text-[1.15rem] font-[700] leading-[1.15] tracking-[-0.02em] text-black transition-colors duration-300 group-hover:text-[#da0007]">
            {post.title}
          </h3>

          {post.excerpt && <p class="blog-body mt-3 text-[15px] leading-[1.72] text-black/58">{post.excerpt}</p>}
        </div>
      </>
    )
  }
</a>
