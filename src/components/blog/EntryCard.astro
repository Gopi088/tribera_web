---
import type { ImageMetadata } from 'astro';
import type { Post } from '~/types';

import placeholder from '~/assets/images/blog/placeholder.png';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
  layout?: 'long' | 'short';
  equalized?: boolean;
}

const { post, layout = 'short', equalized = false } = Astro.props;

const image = (await findImage(post.image)) as ImageMetadata | undefined;
const link = getPermalink(post.permalink, 'post');
const categoryLabel = post.category?.title ?? 'tribera';

const toMinutes = (value: unknown): number | undefined => {
  if (typeof value === 'number' && Number.isFinite(value)) return Math.max(1, Math.round(value));
  if (typeof value === 'string') {
    const parsed = Number.parseFloat(value);
    if (Number.isFinite(parsed)) return Math.max(1, Math.round(parsed));
  }
  return undefined;
};

const readTime = toMinutes(post.readingTime);
---

<a
  href={link}
  class={`group relative overflow-hidden rounded-[18px] border border-[#da0007]/15 bg-white transition-all duration-500 hover:-translate-y-1.5 hover:border-[#da0007]/45 hover:shadow-[0_22px_55px_-24px_rgba(218,0,7,0.45)] ${layout === 'long' ? `block ${equalized ? 'h-full min-h-0' : 'lg:min-h-[1112px]'}` : `flex flex-col ${equalized ? 'h-full min-h-0' : 'h-[540px]'}`}`}
>
  {
    layout === 'long' ? (
      <div class="flex h-full flex-col lg:grid lg:grid-cols-2">
        <div class="relative min-h-[280px] overflow-hidden border-b border-black/5 bg-[#1a0000] lg:min-h-full lg:border-b-0 lg:border-r lg:border-black/5">
          <img
            src={image?.src ?? placeholder.src}
            alt={post.title}
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#250003]/35 to-[#120001]/45 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
        </div>

        <div class="flex h-full flex-col justify-between p-7 lg:p-8">
          <div class="space-y-6">
            <div class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-2 text-[13px] text-black/45">
              <span>{getFormattedDate(post.publishDate)}</span>
              <span class="text-black/25">·</span>
              <span class="rounded-md bg-[#da0007]/8 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.06em] text-[#da0007]">
                {categoryLabel}
              </span>
              {readTime && (
                <>
                  <span class="text-black/25">·</span>
                  <span>{readTime} min read</span>
                </>
              )}
            </div>

            <h3 class="text-[1.2rem] font-[700] leading-[1.2] tracking-[-0.01em] text-black transition-colors duration-300 group-hover:text-[#da0007]">
              {post.title}
            </h3>

            {post.excerpt && <p class="mt-4 text-[15px] leading-[1.7] text-black/60">{post.excerpt}</p>}

            {Array.isArray(post.tags) && post.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-1">
                {post.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full border border-[#da0007]/25 bg-[#da0007]/6 px-3 py-1 text-[11px] font-semibold text-[#da0007]">
                    {tag.title}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="pt-6">
            <div class="h-px w-full bg-black/10" />
            <p class="pt-4 text-[14px] font-medium text-black/55">{post.author ?? 'tribera'}</p>
          </div>
        </div>
      </div>
    ) : (
      <>
        <div class="relative h-[40%] min-h-[216px] w-full overflow-hidden border-b border-black/5 bg-[#1a0000]">
          <img
            src={image?.src ?? placeholder.src}
            alt={post.title}
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#250003]/35 to-[#120001]/45 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
        </div>

        <div class="flex flex-1 flex-col p-6">
          <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-2 text-[13px] text-black/45">
            <span>{getFormattedDate(post.publishDate)}</span>
            <span class="text-black/25">·</span>
            <span class="rounded-md bg-[#da0007]/8 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.06em] text-[#da0007]">
              {categoryLabel}
            </span>
            {readTime && (
              <>
                <span class="text-black/25">·</span>
                <span>{readTime} min read</span>
              </>
            )}
          </div>

          <h3 class="text-[1.2rem] font-[700] leading-[1.2] tracking-[-0.01em] text-black transition-colors duration-300 group-hover:text-[#da0007]">
            {post.title}
          </h3>

          {post.excerpt && <p class="mt-3 text-[15px] leading-[1.62] text-black/60">{post.excerpt}</p>}

          <div class="mt-auto pt-5">
            <div class="h-px w-full bg-black/10" />
            <p class="pt-3 text-[14px] font-medium text-black/55">{post.author ?? 'tribera'}</p>
          </div>
        </div>
      </>
    )
  }
</a>
