---
import type { Post } from '~/types';
import EntryCard from '~/components/blog/EntryCard.astro';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
const [featuredPost, ...otherPosts] = posts;
---

{
  posts.length > 0 ? (
    <>
      <div class="grid gap-8 lg:h-[1112px] xl:h-[1112px] lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:grid-rows-2">
        {featuredPost && (
          <div class="lg:row-span-2">
            <EntryCard post={featuredPost} layout="long" equalized={true} />
          </div>
        )}

        {otherPosts.slice(0, 2).map((post) => (
          <EntryCard post={post} layout="short" equalized={true} />
        ))}
      </div>

      {otherPosts.length > 2 && (
        <div class="mt-8 grid gap-8 lg:grid-cols-3">
          {otherPosts.slice(2).map((post) => (
            <EntryCard post={post} layout="short" />
          ))}
        </div>
      )}
    </>
  ) : (
    <div class="rounded-xl border border-black/10 bg-white p-8 text-center text-black/60">No posts published yet.</div>
  )
}
