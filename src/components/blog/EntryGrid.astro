---
import type { Post } from '~/types';
import EntryCard from '~/components/blog/EntryCard.astro';
export interface Props {
  posts: Array<Post>;
}
const { posts } = Astro.props;
---

{
  posts.length ? (
    <div class:list={['grid gap-6 items-stretch', posts.length === 1 ? 'max-w-xl' : 'md:grid-cols-2']}>
      {posts.map((post) => (
        <EntryCard post={post} layout="short" />
      ))}
    </div>
  ) : (
    <p class="rounded-xl border border-black/10 bg-white p-8 text-black/70">No posts published yet.</p>
  )
}
