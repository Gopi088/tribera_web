---
import { getPermalink } from '~/utils/permalinks';
export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}
const { prevUrl, nextUrl, prevText = 'Newer posts', nextText = 'Older posts' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <nav class="v9-pagination" aria-label="Article pages">
      {prevUrl && (
        <a class="btn btn--ghost" href={getPermalink(prevUrl)} rel="prev">
          <span aria-hidden="true">&larr;</span> {prevText}
        </a>
      )}
      {nextUrl && (
        <a class="btn btn--ghost" href={getPermalink(nextUrl)} rel="next">
          {nextText} <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </nav>
  )
}
