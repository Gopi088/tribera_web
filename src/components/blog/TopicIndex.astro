---
import type { Post } from '~/types';
import EditorialPage from '~/components/v58/EditorialPage.astro';
import HeroFilters from './HeroFilters.astro';
import EntryGrid from './EntryGrid.astro';
import Pagination from './Pagination.astro';
interface Props {
  title: string;
  slug: string;
  type: 'tag' | 'category';
  posts: Post[];
  prevUrl?: string;
  nextUrl?: string;
}
const { title, slug, type, posts, prevUrl, nextUrl } = Astro.props;
const displayTitle = title
  .split(/[-\s]+/)
  .map((word) => (word.toLowerCase() === 'ai' ? 'AI' : word.charAt(0).toUpperCase() + word.slice(1)))
  .join(' ');
---

<EditorialPage>
  <header class="hero" id="top">
    <div class="wrap">
      <p class="eyebrow">From the journal</p>
      <h1>{displayTitle}</h1>
      <p class="hero__p">Notes on hiring, assessment and the candidate experience.</p>
      <HeroFilters activeType={type} activeSlug={slug} />
    </div>
  </header>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
      <EntryGrid posts={posts} />
      <Pagination prevUrl={prevUrl} nextUrl={nextUrl} />
    </div>
  </section>
</EditorialPage>
<style>
  .eyebrow {
    text-transform: uppercase;
  }
  .hero .eyebrow::before {
    content: '\\';
    color: #da0007;
    margin-right: 0.7rem;
  }
</style>
