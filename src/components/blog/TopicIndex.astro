---
import type { Post } from '~/types';
import Content from '~/components/v9/content/Content.astro';
import HeroFilters from './HeroFilters.astro';
import FieldNotesList from './FieldNotesList.astro';
import Pagination from './Pagination.astro';
interface Props {
  title: string;
  slug: string;
  type: 'tag' | 'category';
  posts: Post[];
  prevUrl?: string;
  nextUrl?: string;
}
const { title, slug, type, posts, prevUrl, nextUrl } = Astro.props;
const displayTitle = title
  .split(/[-\s]+/)
  .map((word) => (word.toLowerCase() === 'ai' ? 'AI' : word.charAt(0).toUpperCase() + word.slice(1)))
  .join(' ');
---

<Content kind="blog">
  <header class="hero">
    <div class="wrap">
      <p class="eyebrow">From the journal</p>
      <h1>{displayTitle}</h1>
      <p class="hero__p">Notes on hiring, assessment and the candidate experience.</p>
      <HeroFilters activeType={type} activeSlug={slug} />
    </div>
  </header>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
      <FieldNotesList posts={posts} showFilters={false} />
      <Pagination prevUrl={prevUrl} nextUrl={nextUrl} />
    </div>
  </section>
</Content>
