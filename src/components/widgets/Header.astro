---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCandidateRoute = path.startsWith('/candidates');
const ctaHref = isCandidateRoute ? '/candidates#apply' : '#close';
const ctaLabel = isCandidateRoute ? 'Create profile' : 'Talk to us';
const isHome = path === '/';
const isCandidatesPage = path.startsWith('/candidates');
const isServicesPage = path === '/services';
const isBlogPage = path === '/blog' || path.startsWith('/blog/');
const isAboutPage = path === '/about';
const isContactPage = path === '/contact';
const isCareersPage = path === '/careers';
const isIndustriesPage = path.startsWith('/industries') || path.startsWith('/functions');
---

<nav class="nav" id="nav"><div class="wrap nav__in">
  <a class="logo" href="/">tribera<i>.</i></a>
  <span class="nav__sw">
    <a href="/" class:list={[isHome && 'is']}>I'm hiring</a>
    <a href="/candidates" class:list={[isCandidatesPage && 'is']}>I'm looking</a>
  </span>
  <span class="nav__links"><span class="dd">
    <button class="dd__t" aria-expanded="false" aria-haspopup="true">Coverage<i></i></button>
    <span class="dd__p" role="menu">
      <span class="dd__g">
        <span class="dd__c"><p class="dd__k">Industries</p><a href="/industries/banking-financial-services">Banking &amp; financial services</a><a href="/industries/enterprise-technology">Enterprise technology</a><a href="/industries/product-saas">Product &amp; SaaS</a><a href="/industries/ai-data">AI &amp; data</a><a href="/industries/cybersecurity">Cybersecurity</a><a href="/industries/healthcare-life-sciences">Healthcare &amp; life sciences</a><a href="/industries/pharmaceutical">Pharmaceutical</a><a href="/industries/manufacturing">Manufacturing</a><a href="/industries/industrial-engineering">Industrial &amp; engineering</a><a href="/industries/global-capability-centres">Global capability centres</a><a href="/industries/consumer-digital-commerce">Consumer &amp; digital commerce</a><a href="/industries/private-equity-portfolio">Private equity portfolio</a></span>
        <span class="dd__c"><p class="dd__k">Functions</p><a href="/functions/engineering-platform">Engineering &amp; platform</a><a href="/functions/data-analytics">Data &amp; analytics</a><a href="/functions/infrastructure-sre">Infrastructure &amp; SRE</a><a href="/functions/security">Security</a><a href="/functions/finance-risk">Finance &amp; risk</a><a href="/functions/product-design">Product &amp; design</a><a href="/functions/operations">Operations</a><a href="/functions/leadership">Leadership</a></span>
      </span>
      <span class="dd__f">Not listed? <a href="/contact">Ask us</a> — we say no when it is not our ground.</span>
    </span>
  </span><a class="nav__l" href="/services" aria-current={isServicesPage ? 'page' : undefined}>Services</a><a class="nav__l" href="/blog" aria-current={isBlogPage ? 'page' : undefined}>Blog</a><a class="nav__l" href="/about" aria-current={isAboutPage ? 'page' : undefined}>About</a><a class="nav__l" href="/contact" aria-current={isContactPage ? 'page' : undefined}>Contact</a></span>
  <span class="nav__end">
    <a class="nav__login" href="https://app.tribera.ai/auth/login">Log in</a>
    <a href={ctaHref} class="btn btn--light nav__cta" data-form-intent={!isCandidateRoute ? 'demo' : undefined} data-form-source={!isCandidateRoute ? 'header' : undefined}>{ctaLabel}</a>
    <button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navp">
      <span></span><span></span><span></span>
    </button>
  </span>
</div>
<div class="navp" id="navp"><div class="wrap navp__in">
  <p class="navp__k">Company</p>
  <a href="/services" aria-current={isServicesPage ? 'page' : undefined}>Services</a><a href="/blog" aria-current={isBlogPage ? 'page' : undefined}>Blog</a><a href="/about" aria-current={isAboutPage ? 'page' : undefined}>About</a><a href="/contact" aria-current={isContactPage ? 'page' : undefined}>Contact</a>
  <a href="/careers" aria-current={isCareersPage ? 'page' : undefined}>Careers</a>
  <a href="/industries" aria-current={isIndustriesPage ? 'page' : undefined}>Industries &amp; functions</a>
  <a href="https://app.tribera.ai/auth/login">Log in</a>
  <div class="navp__cta">
    <a href={ctaHref} class="btn btn--light">{ctaLabel}</a>
  </div>
</div></div></nav>

<script>
  (function(){
    var nav=document.getElementById('nav'), b=nav?.querySelector('.burger'),
        p=document.getElementById('navp');
    if(nav){
      var tick=function(){ nav.classList.toggle('stuck', scrollY>8); };
      addEventListener('scroll',tick,{passive:true}); tick();
    }
    if(b&&p){
      b.addEventListener('click',function(){
        var open=p.classList.toggle('open');
        b.classList.toggle('on',open);
        b.setAttribute('aria-expanded',String(open));
      });
      p.addEventListener('click',function(e){ if(e.target.tagName==='A'){
        p.classList.remove('open'); b.classList.remove('on'); b.setAttribute('aria-expanded','false'); }});
      addEventListener('keydown',function(e){ if(e.key==='Escape'&&p.classList.contains('open')){
        p.classList.remove('open'); b.classList.remove('on'); b.setAttribute('aria-expanded','false'); }});
    }
    var dds=[].slice.call(document.querySelectorAll('.dd'));
    if(!dds.length) return;
    function shut(except){ dds.forEach(function(d){
      if(d!==except){ d.classList.remove('open');
        var t=d.querySelector('.dd__t'); if(t) t.setAttribute('aria-expanded','false'); } }); }
    dds.forEach(function(d){
      var t=d.querySelector('.dd__t'), timer;
      t.addEventListener('click',function(e){
        e.preventDefault();
        var open=!d.classList.contains('open');
        shut(d); d.classList.toggle('open',open); t.setAttribute('aria-expanded',String(open));
      });
      d.addEventListener('mouseenter',function(){
        clearTimeout(timer); shut(d); d.classList.add('open'); t.setAttribute('aria-expanded','true'); });
      d.addEventListener('mouseleave',function(){
        timer=setTimeout(function(){ d.classList.remove('open');
          t.setAttribute('aria-expanded','false'); },140); });
      d.addEventListener('focusout',function(e){
        if(!d.contains(e.relatedTarget)){ d.classList.remove('open');
          t.setAttribute('aria-expanded','false'); } });
    });
    addEventListener('keydown',function(e){ if(e.key==='Escape') shut(null); });
    document.addEventListener('click',function(e){ if(!e.target.closest('.dd')) shut(null); });
  })();
</script>
