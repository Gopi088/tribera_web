---
import Logo from '~/components/Logo.astro';
import { Icon } from 'astro-icon/components';
import { headerData } from '~/navigation';
import { defaultCandidateFormIntent, formIntentConfigs } from '~/config/formIntents';
import { industries } from '~/data/industries';
import { jobFunctions } from '~/data/functions';
const navLinks = headerData.links.slice(2);
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const showBottomDivider = !['/blog', '/category', '/tag'].some((route) => pathname.startsWith(route));
const candidateIntentConfig = formIntentConfigs[defaultCandidateFormIntent];

---

<header class="sticky top-0 z-40 w-full" style="
    background: black;
  ">
  {
    showBottomDivider && (
      <div
        class="absolute bottom-0 left-0 right-0 h-px
              bg-gradient-to-r from-transparent via-white/10 to-transparent"
      />
    )
  }
  <div class="mx-auto max-w-7xl px-6 py-2.5 sm:py-2">
    <div class="flex items-center">
      <!-- LEFT: Logo -->
      <a href="/" data-astro-reload data-self-nav-target="/" class="flex items-center">
        <Logo variant="header" />
      </a>

      <!-- MOBILE HAMBURGER -->
      <button
        id="mobile-btn"
        class="md:hidden ml-auto inline-flex h-9 w-9 items-center justify-center flex-col gap-1.5 rounded-md hover:bg-white/5"
        aria-label="Open menu"
      >
        <span class="w-6 h-[2px] bg-white"></span>
        <span class="w-6 h-[2px] bg-white"></span>
        <span class="w-6 h-[2px] bg-white"></span>
      </button>

      <!-- RIGHT SIDE WRAPPER -->
      <div class="hidden md:flex items-center gap-5 ml-auto">
        <!-- Navigation -->
        <nav class="flex items-center gap-8 text-[11px] font-semibold">
          <!-- For Hiring Teams -->
          <div class="relative">
            <div class="flex items-center gap-1">
              <!-- PAGE LINK -->
              <a
                id="hiring-link"
                href="/"
                data-astro-reload
                data-self-nav-target="/"
                class="relative text-white/60 hover:text-white transition
      after:absolute after:left-0 after:-bottom-1
      after:h-[2px] after:w-0 after:bg-[#DA0007]
      after:transition-all after:duration-300
      hover:after:w-full"
              >
                For Hiring Teams
              </a>

              <!-- DROPDOWN TOGGLE -->
              <button id="hiring-btn" class="text-white/60 hover:text-white">
                <Icon name="tabler:chevron-down" class="w-3 h-3" />
              </button>
            </div>

            <div
              id="hiring-menu"
              class="hidden absolute left-1/2 top-full mt-4 w-56 -translate-x-1/2
    rounded-xl bg-white shadow-xl p-2 transition-all duration-200"
            >
              <a
                href="/#platform-overview"
                data-self-nav-target="/#platform-overview"
                class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
              >
                Platform Overview
              </a>

              <a
                href="/#how-it-works"
                data-self-nav-target="/#how-it-works"
                class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
              >
                How It Works
              </a>

              <a
                href="/#platform-performance"
                data-self-nav-target="/#platform-performance"
                class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
              >
                Plans
              </a>

              <a
                href="/#customer-stories"
                data-self-nav-target="/#customer-stories"
                class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
              >
                Customer Stories
              </a>
            </div>
          </div>

          <!-- FOR CANDIDATES -->
          <div class="relative">
            <div class="flex items-center gap-1">
              <a
                href="/candidates"
                data-astro-reload
                data-self-nav-target="/candidates"
                class="relative text-white/60 hover:text-white transition
      after:absolute after:left-0 after:-bottom-1
      after:h-[2px] after:w-0 after:bg-[#DA0007]
      after:transition-all after:duration-300
      hover:after:w-full"
              >
                For Candidates
              </a>

              <button id="candidate-btn" class="text-white/60 hover:text-white">
                <Icon name="tabler:chevron-down" class="w-3 h-3" />
              </button>
            </div>

            <div
              id="candidate-menu"
              class="hidden absolute left-1/2 top-full mt-4 w-56 -translate-x-1/2
    rounded-xl bg-white shadow-xl p-2 transition-all duration-200"
            >
              <a
                href="/candidates#signalSection"
                class="block px-4 py-2 rounded-lg text-black/50 text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
              >
                AI Signal
              </a>

              <a
                href="/candidates#why-tribera"
                class="block px-4 py-2 rounded-lg text-black/50 text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
              >
                How It Works
              </a>

              <a
                href="/candidates#interview"
                class="block px-4 py-2 rounded-lg text-black/50 text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
              >
                Timeline
              </a>

              <a
                href="/candidates#get-discovered"
                class="block px-4 py-2 rounded-lg text-black/50 text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
              >
                Get Discovered
              </a>
            </div>
          </div>
          <!-- INDUSTRIES -->
          <div class="relative">
            <div class="flex items-center gap-1">
              <a
                href="/industries"
                data-astro-reload
                class="relative text-white/60 hover:text-white transition
      after:absolute after:left-0 after:-bottom-1
      after:h-[2px] after:w-0 after:bg-[#DA0007]
      after:transition-all after:duration-300
      hover:after:w-full"
              >
                Industries
              </a>
              <button id="industries-btn" class="text-white/60 hover:text-white">
                <Icon name="tabler:chevron-down" class="w-3 h-3" />
              </button>
            </div>

            <div
              id="industries-menu"
              class="hidden absolute left-1/2 top-full mt-4 w-64 -translate-x-1/2
    rounded-xl bg-white shadow-xl p-2 transition-all duration-200"
            >
              {
                industries.map((industry) => (
                  <a
                    href={`/industries/${industry.slug}`}
                    class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
                  >
                    {industry.title}
                  </a>
                ))
              }
              <div class="mx-2 my-1 h-px bg-black/6"></div>
              <a
                href="/industries"
                data-astro-reload
                class="block px-4 py-2 text-[#DA0007] rounded-lg text-[12px] font-semibold hover:bg-red-50"
              >
                View All Industries →
              </a>
            </div>
          </div>

          <!-- FUNCTIONS -->
          <div class="relative">
            <div class="flex items-center gap-1">
              <a
                href="/functions"
                data-astro-reload
                class="relative text-white/60 hover:text-white transition
      after:absolute after:left-0 after:-bottom-1
      after:h-[2px] after:w-0 after:bg-[#DA0007]
      after:transition-all after:duration-300
      hover:after:w-full"
              >
                Functions
              </a>
              <button id="functions-btn" class="text-white/60 hover:text-white">
                <Icon name="tabler:chevron-down" class="w-3 h-3" />
              </button>
            </div>

            <div
              id="functions-menu"
              class="hidden absolute left-1/2 top-full mt-4 w-64 -translate-x-1/2
    rounded-xl bg-white shadow-xl p-2 transition-all duration-200"
            >
              {
                jobFunctions.map((fn) => (
                  <a
                    href={`/functions/${fn.slug}`}
                    class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]"
                  >
                    {fn.title}
                  </a>
                ))
              }
              <div class="mx-2 my-1 h-px bg-black/6"></div>
              <a
                href="/functions"
                data-astro-reload
                class="block px-4 py-2 text-[#DA0007] rounded-lg text-[12px] font-semibold hover:bg-red-50"
              >
                View All Functions →
              </a>
            </div>
          </div>

          <!-- Static links -->
          {
            navLinks.map(({ text, href }) => (
              <a
                href={href}
                data-astro-reload
                class="relative text-white/60 hover:text-white transition
    after:absolute after:left-0 after:-bottom-1
    after:h-[2px] after:w-0 after:bg-[#DA0007]
    after:transition-all after:duration-300
    hover:after:w-full"
              >
                {text}
              </a>
            ))
          }
        </nav>

        <!-- Right Buttons -->
        <div class="flex items-center gap-6">
          <a
            href="https://app.tribera.ai/auth/login"
            target="_blank"
            rel="noopener noreferrer"
            class="relative text-[#DA0007]
        after:absolute after:left-0 after:-bottom-1
        after:h-[2px] after:w-0 after:bg-[#DA0007]
        after:transition-all after:duration-300
        hover:after:w-full text-[11px] font-semibold"
          >
            Login
          </a>
          <button
            type="button"
            data-form-intent="demo"
            data-form-source="header_desktop"
            class="px-5 py-2 rounded-full tribera-primary-button text-[11px] font-semibold text-center inline-block"
          >
            Book a Demo
          </button>
          <div
            id="contactModal"
            class="fixed inset-0 z-[1200] hidden overflow-y-auto bg-black/55 px-4 py-6 sm:px-6 sm:py-8"
          >
            <div class="pointer-events-none flex min-h-full items-center justify-center">
              <div
                class="pointer-events-auto relative w-full max-w-[560px] overflow-hidden rounded-[30px] border border-white/10 bg-[#0a0a0a] px-6 pt-6 pb-5 text-white shadow-[0_28px_100px_rgba(0,0,0,0.45)] sm:px-8 sm:pt-8 sm:pb-6"
              >
                <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#DA0007]/80 to-transparent"></div>
                <div class="pointer-events-none absolute -left-20 top-0 h-52 w-52 rounded-full bg-[#DA0007]/12 blur-3xl"></div>
                <div class="pointer-events-none absolute -right-16 bottom-0 h-44 w-44 rounded-full bg-white/[0.04] blur-3xl"></div>
                <button
                  id="closeModal"
                  class="absolute right-4 top-4 z-20 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/[0.02] p-0 text-white/45 transition-colors duration-200 hover:border-[#DA0007]/35 hover:bg-[#DA0007]/12 hover:text-white/85"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.9">
                    <path d="M6 6L18 18" stroke-linecap="round"></path>
                    <path d="M18 6L6 18" stroke-linecap="round"></path>
                  </svg>
                </button>

                <form
                  id="candidateForm"
                  action="/.netlify/functions/candidate-profile"
                  method="POST"
                  enctype="multipart/form-data"
                  class="relative space-y-5"
                >
                  <input type="hidden" name="form_type" value={candidateIntentConfig.formType} data-form-type />
                  <input type="hidden" name="form_intent" value={defaultCandidateFormIntent} data-form-intent-input />
                  <input type="hidden" name="form_source" value="" data-form-source-input />
                  <input type="hidden" name="form_label" value="" data-form-label-input />
                  <input type="hidden" name="form_loaded_at" value="" data-form-loaded-at />
                  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

                  <div class="relative pb-1">
                    <p data-candidate-audience class="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#DA0007]">
                      {candidateIntentConfig.audienceLabel}
                    </p>
                    <h3
                      data-candidate-title
                      class="pr-12 text-[1.5rem] font-[640] leading-[1.02] tracking-[-0.035em] text-white sm:text-[1.8rem]"
                    >
                      {candidateIntentConfig.title}
                    </h3>
                    <p data-candidate-body class="mt-4 max-w-[28rem] text-[14px] leading-7 text-white/58 sm:text-[15px]">
                      {candidateIntentConfig.body}
                    </p>
                  </div>

                  <div class="space-y-3.5">
                    <div class="grid gap-3.5 sm:grid-cols-2 sm:gap-4">
                      <input
                        type="text"
                        name="name"
                        placeholder="Full name *"
                        autocomplete="name"
                        required
                        class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
                      />

                      <input
                        type="email"
                        name="email"
                        placeholder="Email address *"
                        autocomplete="email"
                        required
                        class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
                      />
                    </div>

                    <input
                      type="tel"
                      name="mobile"
                      placeholder="Mobile number (optional)"
                      autocomplete="tel"
                      class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
                    />
                  </div>

                  <input type="file" id="resumeInput" name="resume" accept=".pdf,.doc,.docx" class="hidden" />

                  <div class="space-y-3 border-t border-white/5 pt-4">
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                      <button
                        type="button"
                        id="uploadBtn"
                        class="w-full rounded-full border border-white/14 bg-white/[0.03] px-6 py-3 text-[14px] font-semibold text-white transition hover:border-[#DA0007]/50 hover:bg-[#DA0007]/10"
                      >
                        Upload Resume *
                      </button>

                      <button
                        type="submit"
                        id="submitBtn"
                        disabled
                        class="w-full rounded-full bg-[#DA0007] px-8 py-3 text-[14px] font-semibold text-white transition hover:bg-[#b80005] disabled:cursor-not-allowed disabled:opacity-45 sm:min-w-[12.75rem]"
                      >
                        {candidateIntentConfig.submitLabel}
                      </button>
                    </div>

                    <p id="fileName" class="min-h-[16px] break-words text-[12px] leading-5 text-white/45"></p>
                    <p id="candidateErrorMsg" class="hidden text-[13px] text-white/55"></p>
                  </div>
                </form>

                <div id="successMessage" class="hidden text-center">
                  <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#DA0007]/10">
                    <svg
                      viewBox="0 0 24 24"
                      class="w-7 h-7 text-[#DA0007]"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                    >
                      <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </div>

                  <h3 data-candidate-success-title class="text-[22px] font-[700] text-white">
                    {candidateIntentConfig.successTitle}
                  </h3>

                  <p data-candidate-success-body class="mt-3 text-[14px] leading-relaxed text-white/60">
                    {candidateIntentConfig.successBody}
                  </p>
                </div>
              </div>
            </div>
              <script>
                document.addEventListener('astro:page-load', () => {
                  const uploadBtn = document.getElementById('uploadBtn');
                  const resumeInput = document.getElementById('resumeInput');
                  const submitBtn = document.getElementById('submitBtn');
                  const fileName = document.getElementById('fileName');

                  if (
                    !(uploadBtn instanceof HTMLButtonElement) ||
                    !(resumeInput instanceof HTMLInputElement) ||
                    !(submitBtn instanceof HTMLButtonElement) ||
                    !(fileName instanceof HTMLElement)
                  ) {
                    return;
                  }
                  if (uploadBtn.dataset.bound === 'true') return;
                  uploadBtn.dataset.bound = 'true';

                  uploadBtn.addEventListener('click', () => {
                    resumeInput.click();
                  });

                  resumeInput.addEventListener('change', () => {
                    if (resumeInput.files && resumeInput.files.length > 0) {
                      submitBtn.disabled = false;
                      fileName.textContent = `Selected: ${resumeInput.files[0].name}`;
                    } else {
                      submitBtn.disabled = true;
                      fileName.textContent = '';
                    }
                  });
                });
              </script>
          </div>

          <script
            is:inline
            define:vars={{
              candidateIntentConfig,
              defaultCandidateFormIntent,
            }}
          >
            const candidateFormFailureMessage =
              'Something went wrong while submitting your profile. Please try again or email your resume to careers@tribera.ai.';

            function initModal() {
              const modal = document.getElementById('contactModal');
              const close = document.getElementById('closeModal');
              const form = document.getElementById('candidateForm');
              const success = document.getElementById('successMessage');
              const submitBtn = document.getElementById('submitBtn');
              const fileName = document.getElementById('fileName');
              const errorMsg = document.getElementById('candidateErrorMsg');
              const formLoadedAtInput = form.querySelector('[data-form-loaded-at]');
              const formTypeInput = form.querySelector('[data-form-type]');
              const formIntentInput = form.querySelector('[data-form-intent-input]');
              const formSourceInput = form.querySelector('[data-form-source-input]');
              const formLabelInput = form.querySelector('[data-form-label-input]');
              const audience = modal.querySelector('[data-candidate-audience]');
              const title = modal.querySelector('[data-candidate-title]');
              const body = modal.querySelector('[data-candidate-body]');
              const successTitle = modal.querySelector('[data-candidate-success-title]');
              const successBody = modal.querySelector('[data-candidate-success-body]');

              if (!form || !modal) return;

              // Modal markup is declared inside a desktop-only header container.
              // On mobile that container is `display: none`, so we move the modal
              // to `body` once to keep it renderable on all breakpoints.
              if (modal.dataset.portalized !== 'true') {
                document.body.appendChild(modal);
                modal.dataset.portalized = 'true';
              }

              const clearSuccessTimer = () => {
                if (!window.__triberaCandidateSuccessTimer) return;
                clearTimeout(window.__triberaCandidateSuccessTimer);
                window.__triberaCandidateSuccessTimer = null;
              };

              const closeModal = () => {
                clearSuccessTimer();
                modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
              };

              const openModal = () => {
                clearSuccessTimer();
                form.classList.remove('hidden');
                success?.classList.add('hidden');
                if (formLoadedAtInput instanceof HTMLInputElement) {
                  formLoadedAtInput.value = String(Date.now());
                }
                modal.dataset.lastOpenedAt = String(Date.now());
                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
              };

              const applyIntentConfig = (trigger) => {
                const source = trigger?.dataset.formSource || '';
                const label = (trigger?.dataset.formLabel || trigger?.textContent || '').trim();

                if (audience instanceof HTMLElement) audience.textContent = candidateIntentConfig.audienceLabel;
                if (title instanceof HTMLElement) title.textContent = candidateIntentConfig.title;
                if (body instanceof HTMLElement) body.textContent = candidateIntentConfig.body;
                if (successTitle instanceof HTMLElement) successTitle.textContent = candidateIntentConfig.successTitle;
                if (successBody instanceof HTMLElement) successBody.textContent = candidateIntentConfig.successBody;
                if (submitBtn instanceof HTMLButtonElement) submitBtn.textContent = candidateIntentConfig.submitLabel;
                if (formTypeInput instanceof HTMLInputElement) formTypeInput.value = candidateIntentConfig.formType;
                if (formIntentInput instanceof HTMLInputElement) formIntentInput.value = defaultCandidateFormIntent;
                if (formSourceInput instanceof HTMLInputElement) formSourceInput.value = source;
                if (formLabelInput instanceof HTMLInputElement) formLabelInput.value = label;
              };

              window.__triberaOpenCandidateModal = openModal;

              // Global delegated opener keeps working across Astro swaps and dynamic buttons.
              if (!window.__triberaCandidateModalDelegatedBound) {
                const delegatedOpenHandler = (e) => {
                  const target = e.target;
                  if (!(target instanceof Element)) return;
                  const trigger = target.closest('[data-form-intent="candidate"], #contactBtn, [data-create-profile]');
                  if (!(trigger instanceof HTMLElement)) return;
                  e.preventDefault?.();
                  e.stopPropagation?.();
                  applyIntentConfig(trigger);
                  window.__triberaOpenCandidateModal?.();
                };

                document.addEventListener('pointerup', delegatedOpenHandler, true);
                window.__triberaCandidateModalDelegatedBound = true;
              }

              if (close && close.dataset.modalCloseBound !== 'true') {
                close.dataset.modalCloseBound = 'true';
                close.addEventListener('click', closeModal);
              }

              // Close when clicking outside
              if (modal.dataset.modalOverlayBound !== 'true') {
                modal.dataset.modalOverlayBound = 'true';
                modal.addEventListener('click', (e) => {
                  if (e.target === modal) {
                    const justOpened = Date.now() - Number(modal.dataset.lastOpenedAt || 0) < 500;
                    if (justOpened) return;
                    closeModal();
                  }
                });
              }

              if (!window.__triberaCandidateModalEscBound) {
                document.addEventListener('keydown', (e) => {
                  if (e.key !== 'Escape') return;
                  if (modal.classList.contains('hidden')) return;
                  closeModal();
                });
                window.__triberaCandidateModalEscBound = true;
              }

              if (form.dataset.submitBound === 'true') return;
              form.dataset.submitBound = 'true';
              form.addEventListener('submit', async (e) => {
                e.preventDefault();

                const originalBtnText = submitBtn?.textContent || 'Submit';
                const formData = new FormData(form);

                errorMsg?.classList.add('hidden');
                if (submitBtn) {
                  submitBtn.disabled = true;
                  submitBtn.textContent = 'Submitting...';
                }

                try {
                  const res = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: { Accept: 'application/json' },
                  });

                  const isJson = res.headers.get('content-type')?.includes('application/json');
                  const result = isJson
                    ? await res.json()
                    : {
                        success: false,
                        message:
                          'Something went wrong while submitting your profile. Please try again or email your resume to careers@tribera.ai.',
                      };
                  if (!res.ok || !result.success) {
                    throw new Error(result.message || 'Submission failed');
                  }

                  form.classList.add('hidden');
                  success?.classList.remove('hidden');

                  clearSuccessTimer();
                  window.__triberaCandidateSuccessTimer = setTimeout(() => {
                    modal.classList.add('hidden');
                    form.reset();
                    if (formLoadedAtInput instanceof HTMLInputElement) {
                      formLoadedAtInput.value = String(Date.now());
                    }
                    if (submitBtn) submitBtn.disabled = true;
                    if (fileName) fileName.textContent = '';
                    form.classList.remove('hidden');
                    success?.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                  }, 3500);
                } catch (error) {
                  console.error('Candidate form submit failed:', error);
                  if (errorMsg) errorMsg.textContent = candidateFormFailureMessage;
                  errorMsg?.classList.remove('hidden');
                } finally {
                  if (submitBtn) {
                    submitBtn.textContent = originalBtnText;
                    const modalResumeInput = form.querySelector('#resumeInput');
                    if (!modalResumeInput?.files?.length) {
                      submitBtn.disabled = true;
                    }
                  }
                }
              });
            }

            document.addEventListener('astro:page-load', initModal);
            document.addEventListener('DOMContentLoaded', initModal);
          </script>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      class="hidden md:hidden absolute left-0 right-0 top-full z-50 border-t border-white/10 bg-black"
    >
      <nav class="px-5 py-5 flex flex-col gap-4 text-[13px] font-semibold">
        <a href="/" data-astro-reload data-self-nav-target="/" class="text-white/80 hover:text-white transition"
          >For Hiring Teams</a
        >
        <a
          href="/candidates"
          data-astro-reload
          data-self-nav-target="/candidates"
          class="text-white/80 hover:text-white transition">For Candidates</a
        >
        <!-- Industries mobile accordion -->
        <div>
          <button
            id="mobile-industries-btn"
            class="flex items-center justify-between w-full text-white/80 hover:text-white transition"
          >
            <span>Industries</span>
            <Icon name="tabler:chevron-down" class="w-4 h-4" id="mobile-industries-icon" />
          </button>
          <div id="mobile-industries-sub" class="hidden mt-2 ml-3 flex flex-col gap-2">
            {
              industries.map((industry) => (
                <a
                  href={`/industries/${industry.slug}`}
                  data-astro-reload
                  class="text-white/55 hover:text-white transition text-[12px]"
                >
                  {industry.title}
                </a>
              ))
            }
            <a href="/industries" data-astro-reload class="text-[#DA0007] text-[12px] font-semibold mt-1">
              View All →
            </a>
          </div>
        </div>
        <!-- Functions mobile accordion -->
        <div>
          <button
            id="mobile-functions-btn"
            class="flex items-center justify-between w-full text-white/80 hover:text-white transition"
          >
            <span>Functions</span>
            <Icon name="tabler:chevron-down" class="w-4 h-4" id="mobile-functions-icon" />
          </button>
          <div id="mobile-functions-sub" class="hidden mt-2 ml-3 flex flex-col gap-2">
            {
              jobFunctions.map((fn) => (
                <a
                  href={`/functions/${fn.slug}`}
                  data-astro-reload
                  class="text-white/55 hover:text-white transition text-[12px]"
                >
                  {fn.title}
                </a>
              ))
            }
            <a href="/functions" data-astro-reload class="text-[#DA0007] text-[12px] font-semibold mt-1">
              View All →
            </a>
          </div>
        </div>
        {
          navLinks.map(({ text, href }) => (
            <a href={href} data-astro-reload class="text-white/80 hover:text-white transition">
              {text}
            </a>
          ))
        }

        <div class="h-px bg-white/10 my-1"></div>

        <a
          href="https://app.tribera.ai/auth/login"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#DA0007] font-semibold"
        >
          Login
        </a>
        <button
          type="button"
          data-form-intent="demo"
          data-form-source="header_mobile"
          class="inline-flex items-center justify-center px-4 py-2 rounded-full tribera-primary-button text-[12px] font-semibold"
        >
          Book a Demo
        </button>
      </nav>
    </div>
  </div>
</header>

<script>
  function initHeaderMenus() {
    const win = window;

    const hiringBtn = document.getElementById('hiring-btn');
    const hiringMenu = document.getElementById('hiring-menu');

    const candidateBtn = document.getElementById('candidate-btn');
    const candidateMenu = document.getElementById('candidate-menu');

    const industriesBtn = document.getElementById('industries-btn');
    const industriesMenu = document.getElementById('industries-menu');

    const functionsBtn = document.getElementById('functions-btn');
    const functionsMenu = document.getElementById('functions-menu');

    const mobileBtn = document.getElementById('mobile-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    // Mobile accordion buttons
    const mobileIndustriesBtn = document.getElementById('mobile-industries-btn');
    const mobileIndustriesSub = document.getElementById('mobile-industries-sub');
    const mobileIndustriesIcon = document.getElementById('mobile-industries-icon');

    const mobileFunctionsBtn = document.getElementById('mobile-functions-btn');
    const mobileFunctionsSub = document.getElementById('mobile-functions-sub');
    const mobileFunctionsIcon = document.getElementById('mobile-functions-icon');

    const bindClickOnce = (el: HTMLElement | null, key: string, handler: (event: MouseEvent) => void) => {
      if (!(el instanceof HTMLElement)) return;
      if (el.dataset[key] === 'true') return;
      el.dataset[key] = 'true';
      el.addEventListener('click', handler);
    };

    const allDesktopMenus = [hiringMenu, candidateMenu, industriesMenu, functionsMenu];

    const closeAllDesktop = () => allDesktopMenus.forEach((m) => m?.classList.add('hidden'));

    bindClickOnce(hiringBtn, 'menuBound', (e) => {
      e.stopPropagation();
      const wasHidden = hiringMenu?.classList.contains('hidden');
      closeAllDesktop();
      if (wasHidden) hiringMenu?.classList.remove('hidden');
    });

    bindClickOnce(candidateBtn, 'menuBound', (e) => {
      e.stopPropagation();
      const wasHidden = candidateMenu?.classList.contains('hidden');
      closeAllDesktop();
      if (wasHidden) candidateMenu?.classList.remove('hidden');
    });

    bindClickOnce(industriesBtn, 'menuBound', (e) => {
      e.stopPropagation();
      const wasHidden = industriesMenu?.classList.contains('hidden');
      closeAllDesktop();
      if (wasHidden) industriesMenu?.classList.remove('hidden');
    });

    bindClickOnce(functionsBtn, 'menuBound', (e) => {
      e.stopPropagation();
      const wasHidden = functionsMenu?.classList.contains('hidden');
      closeAllDesktop();
      if (wasHidden) functionsMenu?.classList.remove('hidden');
    });

    bindClickOnce(mobileBtn, 'menuBound', (e) => {
      e.stopPropagation();
      mobileMenu?.classList.toggle('hidden');
    });

    // Mobile accordions
    bindClickOnce(mobileIndustriesBtn, 'menuBound', (e) => {
      e.stopPropagation();
      mobileIndustriesSub?.classList.toggle('hidden');
      if (mobileIndustriesIcon instanceof HTMLElement) {
        mobileIndustriesIcon.style.transform = mobileIndustriesSub?.classList.contains('hidden')
          ? 'rotate(0deg)'
          : 'rotate(180deg)';
      }
    });

    bindClickOnce(mobileFunctionsBtn, 'menuBound', (e) => {
      e.stopPropagation();
      mobileFunctionsSub?.classList.toggle('hidden');
      if (mobileFunctionsIcon instanceof HTMLElement) {
        mobileFunctionsIcon.style.transform = mobileFunctionsSub?.classList.contains('hidden')
          ? 'rotate(0deg)'
          : 'rotate(180deg)';
      }
    });

    const normalizePath = (path: string) => {
      const clean = path
        .split('#')[0]
        .replace(/\/index\.html$/, '')
        .replace(/\/+$/, '');
      return clean || '/';
    };

    const isSectionInFocus = (target: Element | null) => {
      if (!(target instanceof HTMLElement)) return false;

      const rect = target.getBoundingClientRect();
      const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      const visibleTop = Math.max(rect.top, 0);
      const visibleBottom = Math.min(rect.bottom, viewportHeight);
      const visibleHeight = Math.max(visibleBottom - visibleTop, 0);
      const targetHeight = Math.max(Math.min(rect.height, viewportHeight), 1);

      return visibleHeight / targetHeight >= 0.55;
    };

    const getAlignedTop = (target: Element | null) => {
      if (!(target instanceof HTMLElement)) return 0;

      const targetTop = target.getBoundingClientRect().top + window.scrollY;
      const scrollMarginTop = Number.parseFloat(window.getComputedStyle(target).scrollMarginTop);
      const offset = Number.isFinite(scrollMarginTop) ? scrollMarginTop : 88;
      return Math.max(targetTop - offset, 0);
    };

    const nudgeToSection = (target: Element | null) => {
      if (!(target instanceof HTMLElement)) return;

      const alignedTop = getAlignedTop(target);
      const overshootTop = Math.max(alignedTop - 36, 0);

      window.scrollTo({ top: overshootTop, behavior: 'smooth' });
      window.setTimeout(() => {
        window.scrollTo({ top: alignedTop, behavior: 'smooth' });
      }, 120);
    };

    const nudgeToTop = () => {
      const currentTop = window.scrollY;
      const overshootTop = Math.min(currentTop + 36, 36);

      window.scrollTo({ top: overshootTop, behavior: 'smooth' });
      window.setTimeout(() => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 120);
    };

    const scrollToHash = (hash: string) => {
      if (!hash) {
        if (window.scrollY <= 80) {
          nudgeToTop();
          return;
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }

      const target = document.getElementById(hash);
      if (!target) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }

      if (isSectionInFocus(target)) {
        nudgeToSection(target);
        return;
      }

      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    document.querySelectorAll('[data-self-nav-target]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const anchor = link;
      if (anchor.dataset.selfNavBound === 'true') return;
      anchor.dataset.selfNavBound = 'true';

      anchor.addEventListener('click', (e) => {
        const navTarget = anchor.dataset.selfNavTarget || '';
        const targetPath = normalizePath(navTarget);
        const currentPath = normalizePath(window.location.pathname);
        if (targetPath !== currentPath) return;

        e.preventDefault();
        hiringMenu?.classList.add('hidden');
        candidateMenu?.classList.add('hidden');
        mobileMenu?.classList.add('hidden');
        scrollToHash(navTarget.split('#')[1] || '');
      });
    });

    document.querySelectorAll('#mobile-menu a').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const anchor = link;
      if (anchor.dataset.menuBound === 'true') return;
      anchor.dataset.menuBound = 'true';
      anchor.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
      });
    });

    document.querySelectorAll('#hiring-menu a, #candidate-menu a, #industries-menu a, #functions-menu a').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const anchor = link;
      if (anchor.dataset.menuBound === 'true') return;
      anchor.dataset.menuBound = 'true';
      anchor.addEventListener('click', () => {
        closeAllDesktop();
      });
    });

    if (win.__triberaHeaderOutsideClick) {
      document.removeEventListener('click', win.__triberaHeaderOutsideClick);
    }

    const outsideClickHandler = (e: MouseEvent) => {
      const target = e.target;
      if (!(target instanceof Node)) return;
      if (
        !hiringMenu?.contains(target) &&
        !hiringBtn?.contains(target) &&
        !candidateMenu?.contains(target) &&
        !candidateBtn?.contains(target) &&
        !industriesMenu?.contains(target) &&
        !industriesBtn?.contains(target) &&
        !functionsMenu?.contains(target) &&
        !functionsBtn?.contains(target)
      ) {
        closeAllDesktop();
      }
      if (!mobileMenu?.contains(target) && !mobileBtn?.contains(target)) {
        mobileMenu?.classList.add('hidden');
      }
    };

    document.addEventListener('click', outsideClickHandler);
    win.__triberaHeaderOutsideClick = outsideClickHandler;
  }

  document.addEventListener('astro:page-load', initHeaderMenus);
  document.addEventListener('DOMContentLoaded', initHeaderMenus);
</script>
