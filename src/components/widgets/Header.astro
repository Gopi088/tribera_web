---
import Logo from '~/components/Logo.astro';
const isCandidateRoute = Astro.url.pathname.startsWith('/candidates');
const ctaHref = isCandidateRoute ? '/candidates#apply' : '#close';
const ctaLabel = isCandidateRoute ? 'Create profile' : 'Talk to us';
---

<header class="site-nav" id="header">
  <div class="site-nav__inner">
    <a href="/" aria-label="Tribera home" class="flex flex-none"><Logo variant="header" /></a>
    <nav class="site-nav__switch" aria-label="Audience">
      <a href="/" class:list={[Astro.url.pathname === '/' && 'is-active']}>I’m hiring</a>
      <a href="/candidates" class:list={[Astro.url.pathname.startsWith('/candidates') && 'is-active']}>I’m looking</a>
    </nav>
    <nav class="site-nav__links" aria-label="Main navigation">
      <details><summary>Coverage <i></i></summary><div class="site-nav__menu"><b>Industries</b><a href="/industries">All industries</a><a href="/industries/banking-financial-services">Financial services</a><a href="/industries/enterprise-technology">Enterprise technology</a><b>Functions</b><a href="/functions">All functions</a><a href="/functions/engineering">Engineering</a><a href="/functions/data">Data &amp; analytics</a></div></details>
      <a href="/services">Services</a><a href="/blog">Blog</a><a href="/about">About</a><a href="/contact">Contact</a>
    </nav>
    <div class="site-nav__end"><a class="site-nav__login" href="https://app.tribera.ai/auth/login">Log in</a><a class="site-nav__cta" href={ctaHref} data-form-intent={!isCandidateRoute ? 'demo' : undefined} data-form-source={!isCandidateRoute ? 'header' : undefined}>{ctaLabel}</a><button class="site-nav__toggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button></div>
  </div>
  <div class="site-nav__mobile" hidden>
    <a href="/industries">Coverage</a><a href="/services">Services</a><a href="/blog">Blog</a><a href="/about">About</a><a href="/contact">Contact</a><a href="/careers">Careers</a><a href="https://app.tribera.ai/auth/login">Log in</a><a href={ctaHref}>{ctaLabel}</a>
  </div>
</header>

<script>
  const header = document.querySelector('.site-nav');
  const toggle = header?.querySelector('.site-nav__toggle');
  const mobile = header?.querySelector('.site-nav__mobile');
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); mobile.hidden = open; });
</script>

<style>
  .site-nav{position:sticky;top:0;z-index:50;background:rgba(19,19,19,.94);color:#f3f3f0;border-bottom:1px solid rgba(255,255,255,.09);font-family:var(--font-sans,Inter,sans-serif)}.site-nav__inner{display:flex;align-items:center;gap:18px;max-width:1280px;margin:auto;padding:12px clamp(20px,4.5vw,48px);box-sizing:border-box}.site-nav__switch{display:flex;gap:3px;padding:3px;border:1px solid rgba(255,255,255,.08);border-radius:999px;background:rgba(255,255,255,.07)}.site-nav__switch a{padding:7px 14px;border-radius:99px;color:#6e6e68;text-decoration:none;font-size:13px;font-weight:600}.site-nav__switch a.is-active{background:#f3f3f0;color:#131313}.site-nav__switch a:not(.is-active):hover{background:transparent;color:#fff}.site-nav__links{display:flex;align-items:center;gap:0;margin-left:auto}.site-nav__links>a,.site-nav__links summary,.site-nav__login{padding:8px 10px;color:#9b9b95;text-decoration:none;font-size:13px;cursor:pointer;list-style:none;white-space:nowrap;border-radius:8px}.site-nav__links>a:hover,.site-nav__links summary:hover,.site-nav__login:hover{color:#fff;background:rgba(255,255,255,.05)}.site-nav__links summary::-webkit-details-marker{display:none}.site-nav__links details{position:relative}.site-nav__links summary i{display:inline-block;width:6px;height:6px;margin:0 0 3px 6px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:rotate(45deg)}.site-nav__menu{position:absolute;top:38px;left:-13px;width:210px;padding:12px;border:1px solid #393936;border-radius:10px;background:#20201e;box-shadow:0 18px 35px rgba(0,0,0,.35)}.site-nav__menu b{display:block;margin:4px 7px 8px;color:#da0007;font-size:10px;letter-spacing:.12em;text-transform:uppercase}.site-nav__menu a{display:block;padding:6px 7px;color:#bbb;text-decoration:none;font-size:12px}.site-nav__menu a:hover{color:#fff;background:#30302e;border-radius:5px}.site-nav__end{display:flex;align-items:center;gap:10px}.site-nav__cta{padding:9px 18px;border-radius:99px;background:#f3f3f0;color:#151515;text-decoration:none;font-size:13px;font-weight:700;box-shadow:0 1px 0 rgba(255,255,255,.55) inset,0 5px 18px rgba(0,0,0,.16);transition:transform .18s,box-shadow .2s}.site-nav__cta:hover{transform:translateY(-1px);box-shadow:0 1px 0 rgba(255,255,255,.55) inset,0 9px 24px rgba(0,0,0,.23)}.site-nav__toggle{display:none;padding:6px;border:0;background:none;color:#fff}.site-nav__toggle span{display:block;width:20px;height:1px;margin:5px;background:currentColor}.site-nav__mobile{padding:8px clamp(20px,4.5vw,48px) 18px;border-top:1px solid #2e2e2c}.site-nav__mobile a{display:block;padding:8px 0;color:#b7b7b1;text-decoration:none;font-size:14px}@media(max-width:1080px){.site-nav__links{display:none}.site-nav__toggle{display:block}.site-nav__login{display:none}}@media(max-width:620px){.site-nav__switch{display:none}.site-nav__inner{padding-block:10px}.site-nav__cta{padding:8px 11px}}
</style>
