---
import Logo from '~/components/Logo.astro';
import { Icon } from 'astro-icon/components';
import Announcement from '~/components/widgets/Announcement.astro';
import { headerData } from '~/navigation';
const navLinks = headerData.links.slice(2);
---

<header
  class="sticky top-0 z-40 w-full"
  style="
    background: black;
  "
>
<div class="absolute bottom-0 left-0 right-0 h-px
              bg-gradient-to-r from-transparent via-white/10 to-transparent">
  </div>

  <Announcement />

  <div class="mx-auto max-w-7xl px-2.5 py-2">
  <div class="flex items-center">

  <!-- LEFT: Logo -->
  <a href="/" data-reload class="flex items-center">
    <Logo />
  </a>

  <!-- MOBILE HAMBURGER -->
<button
  id="mobile-btn"
  class="md:hidden ml-auto flex flex-col gap-1.5"
  aria-label="Open menu"
>
  <span class="w-6 h-[2px] bg-white"></span>
  <span class="w-6 h-[2px] bg-white"></span>
  <span class="w-6 h-[2px] bg-white"></span>
</button>

  <!-- RIGHT SIDE WRAPPER -->
  <div class="hidden md:flex items-center gap-5 ml-auto">

    <!-- Navigation -->
    <nav class="flex items-center gap-8 text-[11px] font-semibold">

      <!-- For Hiring Teams -->
<div class="relative">
  <div class="flex items-center gap-1">

    <!-- PAGE LINK -->
    <a
      href="/" data-astro-reload
      class="relative text-white/60 hover:text-white transition
      after:absolute after:left-0 after:-bottom-1
      after:h-[2px] after:w-0 after:bg-[#DA0007]
      after:transition-all after:duration-300
      hover:after:w-full"
    >
      For Hiring Teams
    </a>

    <!-- DROPDOWN TOGGLE -->
    <button id="hiring-btn" class="text-white/60 hover:text-white">
      <Icon name="tabler:chevron-down" class="w-3 h-3" />
    </button>

  </div>

  <div
    id="hiring-menu"
    class="hidden absolute left-1/2 top-full mt-4 w-56 -translate-x-1/2
    rounded-xl bg-white shadow-xl p-2 transition-all duration-200"
  >
    <a href="/#candidateSection"
      class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]">
      Platform Overview
    </a>

    <a href="/#how-it-works"
      class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]">
      How It Works
    </a>

    <a href="/#platform-performance"
      class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]">
      Pricing
    </a>

    <a href="/#customer-stories"
      class="block px-4 py-2 text-black/50 rounded-lg text-[12px] hover:bg-red-50 hover:text-[#DA0007]">
      Customer Stories
    </a>
  </div>
</div>


<!-- FOR CANDIDATES -->
<div class="relative">
  <div class="flex items-center gap-1">

    <a
      href="/candidates" data-astro-reload
      class="relative text-white/60 hover:text-white transition
      after:absolute after:left-0 after:-bottom-1
      after:h-[2px] after:w-0 after:bg-[#DA0007]
      after:transition-all after:duration-300
      hover:after:w-full"
    >
      For Candidates
    </a>

    <button id="candidate-btn" class="text-white/60 hover:text-white">
      <Icon name="tabler:chevron-down" class="w-3 h-3" />
    </button>

  </div>

  <div
    id="candidate-menu"
    class="hidden absolute left-1/2 top-full mt-4 w-56 -translate-x-1/2
    rounded-xl bg-white shadow-xl p-2 transition-all duration-200"
  >
    <a href="/candidates#why-tribera"
      class="block px-4 py-2 rounded-lg text-black/50 text-[12px] hover:bg-red-50 hover:text-[#DA0007]">
      Why Tribera
    </a>

    <a href="/candidates#screening"
      class="block px-4 py-2 rounded-lg text-black/50 text-[12px] hover:bg-red-50 hover:text-[#DA0007]">
      Screening
    </a>

    <a href="/candidates#interview"
      class="block px-4 py-2 rounded-lg text-black/50 text-[12px] hover:bg-red-50 hover:text-[#DA0007]">
      Interview Prep
    </a>

    <a href="/candidates#get-discovered"
      class="block px-4 py-2 rounded-lg text-black/50 text-[12px] hover:bg-red-50 hover:text-[#DA0007]">
      Get Discovered
    </a>
  </div>
</div>
      <!-- Static links -->
     {navLinks.map(({ text, href }) => (
  <a
    href={href}
    data-astro-reload
    class="relative text-white/60 hover:text-white transition
    after:absolute after:left-0 after:-bottom-1
    after:h-[2px] after:w-0 after:bg-[#DA0007]
    after:transition-all after:duration-300
    hover:after:w-full"
  >
    {text}
  </a>
))}

    </nav>

    <!-- Right Buttons -->
    <div class="flex items-center gap-6">

      <a
        href="https://app.tribera.ai/auth/login"
        target="_blank"
        rel="noopener noreferrer"
        class="relative text-[#DA0007]
        after:absolute after:left-0 after:-bottom-1
        after:h-[2px] after:w-0 after:bg-[#DA0007]
        after:transition-all after:duration-300
        hover:after:w-full text-[11px] font-semibold"
      >
        Login
      </a>
<a
  href="mailto:sales@tribera.ai?subject=Get Started - Tribera&body=Hi Tribera Team,%0D%0A%0D%0AI would like to get started with Tribera."
  class="px-5 py-2 rounded-full bg-[#DA0007] text-white text-[11px] font-semibold hover:bg-red-700 transition text-center inline-block"
>
  Get Started
</a>
<div id="contactModal"
  class="fixed inset-0 bg-black/60 flex items-center justify-center hidden z-50">

  <div class="bg-white rounded-2xl p-8 w-[90%] max-w-lg relative">

    <button id="closeModal"
      class="absolute top-4 right-4 text-black/40 hover:text-black text-xl">
      ✕
    </button>

    <!-- FORM -->
  <form
    id="candidateForm"
    action="https://formsubmit.co/hello@tribera.ai"
    method="POST"
    enctype="multipart/form-data"
    class="space-y-5"
  >

  <input type="hidden" name="_subject" value="New Candidate Profile Submission - Tribera" />
  <input type="hidden" name="_captcha" value="false" />

  <h3 class="text-[20px] font-[600] text-black">
    Create Your Profile
  </h3>

  <!-- Name -->
  <div>
    <input
      type="text"
      name="name"
      placeholder="Full Name *"
      required
      class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]
      focus:border-[#DA0007] focus:outline-none"
    />
  </div>

  <!-- Email -->
  <div>
    <input
      type="email"
      name="email"
      placeholder="Email Address *"
      required
      class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]
      focus:border-[#DA0007] focus:outline-none"
    />
  </div>

  <!-- Mobile (Optional) -->
  <div>
    <input
      type="tel"
      name="mobile"
      placeholder="Mobile Number (Optional)"
      class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]
      focus:border-[#DA0007] focus:outline-none"
    />
  </div>

  <!-- Hidden File Input -->
  <input
    type="file"
    id="resumeInput"
    name="resume"
    accept=".pdf,.doc,.docx"
    class="hidden"
  />

  <!-- Upload + Submit Buttons -->
  <div class="flex gap-3">

    <!-- Upload Resume Button -->
    <button
      type="button"
      id="uploadBtn"
      class="flex-1 border border-[#DA0007] text-[#DA0007]
      py-3 rounded-lg text-[14px] font-semibold
      hover:bg-[#DA0007] hover:text-white transition">
      Upload Resume *
    </button>

    <!-- Submit Button -->
    <button
      type="submit"
      id="submitBtn"
      disabled
      class="flex-1 bg-[#DA0007]/40 text-white
      py-3 rounded-lg text-[14px] font-semibold
      cursor-not-allowed transition">
      Submit
    </button>

  </div>

  <!-- File Name Display -->
  <p id="fileName" class="text-[13px] text-black/60 hidden"></p>

</form>
<script>
document.addEventListener("astro:page-load", () => {

  const uploadBtn = document.getElementById("uploadBtn");
  const resumeInput = document.getElementById("resumeInput");
  const submitBtn = document.getElementById("submitBtn");
  const fileName = document.getElementById("fileName");

  uploadBtn?.addEventListener("click", () => {
    resumeInput?.click();
  });

  resumeInput?.addEventListener("change", () => {
    const fileInput = resumeInput as HTMLInputElement;
    if (fileInput?.files && fileInput.files.length > 0) {
      if (submitBtn) {
        (submitBtn as HTMLButtonElement).disabled = false;
        submitBtn.classList.remove("bg-[#DA0007]/40", "cursor-not-allowed");
        submitBtn.classList.add("bg-[#DA0007]", "hover:bg-red-700");
      }
      
      if (fileName) {
        fileName.textContent = fileInput.files[0].name;
        fileName.classList.remove("hidden");
      }
    }
  });

});
</script>

    <!-- THANK YOU STATE -->
    <div id="successMessage" class="hidden text-center">

      <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#DA0007]/10 flex items-center justify-center">
        <div class="w-6 h-6 bg-[#DA0007] rounded-full"></div>
      </div>

      <h3 class="text-[20px] font-[600] text-black">
        Thank You for Reaching Out 
      </h3>

      <p class="mt-3 text-[14px] text-black/60">
        Your profile has been submitted successfully.
        Our team will review and connect with you shortly.
      </p>

    </div>

  </div>
</div>



<script is:inline>
function initModal() {
  const modal = document.getElementById("contactModal");
  const btns = document.querySelectorAll("#contactBtn, [data-create-profile]");
  const close = document.getElementById("closeModal");
  const form = document.getElementById("candidateForm");
  const success = document.getElementById("successMessage");

  if (!form || !modal) return;
  if (modal.dataset.modalBound === "true") return;
  modal.dataset.modalBound = "true";

  btns.forEach(btn => {
    btn.addEventListener("click", () => {
      modal.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
    });
  });

  close.addEventListener("click", () => {
    modal.classList.add("hidden");
    document.body.classList.remove("overflow-hidden");
  });

  // ✅ CLOSE WHEN CLICK OUTSIDE
  modal.addEventListener("click", (e) => {
    if (e.target === modal) {
      modal.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);

    form.classList.add("hidden");
    success.classList.remove("hidden");

    fetch(form.action, {
      method: "POST",
      body: formData,
      headers: { Accept: "application/json" },
    }).catch(() => {
      console.error("Form submit failed");
    });

    setTimeout(() => {
      modal.classList.add("hidden");
      form.reset();
      form.classList.remove("hidden");
      success.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    }, 4000);
  });
}

document.addEventListener("astro:page-load", initModal);
document.addEventListener("DOMContentLoaded", initModal);
</script>






    </div>

  </div>

</div>

</div>

</div>

    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      class="hidden md:hidden fixed left-0 right-0 top-[76px] z-50 border-t border-white/10 bg-black/95 backdrop-blur-md"
    >
      <nav class="px-5 py-5 flex flex-col gap-4 text-[13px] font-semibold">
        <a href="/" data-astro-reload class="text-white/80 hover:text-white transition">For Hiring Teams</a>
        <a href="/candidates" data-astro-reload class="text-white/80 hover:text-white transition">For Candidates</a>
        {navLinks.map(({ text, href }) => (
          <a href={href} data-astro-reload class="text-white/80 hover:text-white transition">
            {text}
          </a>
        ))}

        <div class="h-px bg-white/10 my-1"></div>

        <a
          href="https://app.tribera.ai/auth/login"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#DA0007] font-semibold"
        >
          Login
        </a>
        <a
          href="mailto:sales@tribera.ai?subject=Get Started - Tribera&body=Hi Tribera Team,%0D%0A%0D%0AI would like to get started with Tribera."
          class="inline-flex items-center justify-center px-4 py-2 rounded-full bg-[#DA0007] text-white text-[12px] font-semibold"
        >
          Get Started
        </a>
      </nav>
    </div>

  </div>
</header>

<script>
function initHeaderMenus() {
  const win = window as Window & { __triberaHeaderMenusInit?: boolean };
  if (win.__triberaHeaderMenusInit) return;
  win.__triberaHeaderMenusInit = true;

  const hiringBtn = document.getElementById("hiring-btn");
  const hiringMenu = document.getElementById("hiring-menu");

  const candidateBtn = document.getElementById("candidate-btn");
  const candidateMenu = document.getElementById("candidate-menu");
  const mobileBtn = document.getElementById("mobile-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  hiringBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    hiringMenu?.classList.toggle("hidden");
    candidateMenu?.classList.add("hidden");
  });

  candidateBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    candidateMenu?.classList.toggle("hidden");
    hiringMenu?.classList.add("hidden");
  });

  mobileBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    mobileMenu?.classList.toggle("hidden");
  });

  // Close when dropdown link clicked
  document.querySelectorAll("#hiring-menu a, #candidate-menu a")
    .forEach(link => {
      link.addEventListener("click", () => {
        hiringMenu?.classList.add("hidden");
        candidateMenu?.classList.add("hidden");
      });
    });

  document.querySelectorAll("#mobile-menu a").forEach(link => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
    });
  });

  // Close when clicking outside
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!hiringMenu?.contains(target) &&
        !hiringBtn?.contains(target) &&
        !candidateMenu?.contains(target) &&
        !candidateBtn?.contains(target)) {
      hiringMenu?.classList.add("hidden");
      candidateMenu?.classList.add("hidden");
    }
    if (!mobileMenu?.contains(target) && !mobileBtn?.contains(target)) {
      mobileMenu?.classList.add("hidden");
    }
  });

}

document.addEventListener("astro:page-load", initHeaderMenus);
document.addEventListener("DOMContentLoaded", initHeaderMenus);
</script>
