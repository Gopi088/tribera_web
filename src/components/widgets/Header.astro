---
import Header from '~/components/v9/Header.astro';
import '~/assets/styles/v9/foundation.css';
import '~/assets/styles/v9/fonts.css';
import '~/assets/styles/v9/shared-chrome.css';
import { publicLinks } from '~/data/v9/preview-links';
import Analytics from '~/components/common/Analytics.astro';
import ProductionChat from '~/components/standalone/ProductionChat.astro';
const audience = Astro.url.pathname.startsWith('/candidates') ? 'candidate' : 'hiring';
---

<Header isolated {audience} activeRoute={Astro.url.pathname.replace(/\/$/, '') || '/'} linkOverrides={publicLinks} />
<Analytics />
<ProductionChat />
<script>
  import '../../scripts/v9/foundation';
</script>
