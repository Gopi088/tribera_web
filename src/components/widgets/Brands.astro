---
import Image from '~/components/common/Image.astro';
import type { Image as ImageType } from '~/types';

interface Props {
  title?: string;
  subtitle?: string;
  images?: ImageType[];
  mobileSubtitleSingleLine?: boolean;
  mobileLogoClass?: string;
  theme?: 'light' | 'dark';
}

const {
  title,
  subtitle,
  images = [],
  mobileSubtitleSingleLine = false,
  mobileLogoClass = '',
  theme = 'light',
} = Astro.props as Props;

const isDark = theme === 'dark';
---

<section class:list={['w-full py-2 overflow-hidden', isDark ? 'brands-surface-dark' : 'brands-surface-light']}>
  <div class="max-w-8xl mx-auto px-6">
    <!-- MAIN ROW -->
    <!-- MAIN ROW -->
    <div class="flex flex-col md:flex-row items-center md:items-center gap-8 mb-5 text-center md:text-left">
      <!-- LEFT TEXT -->
      <div class="min-w-[260px]">
        <h2
          class:list={[
            'text-[14px] md:text-[16px] font-semibold uppercase tracking-wide',
            isDark ? 'text-white/55' : 'text-gray-500',
          ]}
        >
          {title}
        </h2>

        <p
          class:list={[
            'text-[12px] md:text-[14px] mt-1',
            isDark ? 'text-white/35' : 'text-gray-400',
            mobileSubtitleSingleLine && 'brands-subtitle-mobile-single',
          ]}
          set:html={subtitle}
        />
      </div>

      <!-- RIGHT CAROUSEL -->
      <div class:list={['relative w-full overflow-hidden fade-left', isDark && 'brands-dark-fade']}>
        <div class="brand-track">
          <!-- LOOP 1 -->
          {
            images.map((image) => (
              <div class="brand-slide">
                <Image
                  src={image.src}
                  alt={image.alt || ''}
                  class={`h-10 w-auto object-contain grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition ${mobileLogoClass}`}
                  width={160}
                  height={60}
                />
              </div>
            ))
          }

          <!-- LOOP 2 -->
          {
            images.map((image) => (
              <div class="brand-slide">
                <Image
                  src={image.src}
                  alt={image.alt || ''}
                  class={`h-10 w-auto object-contain grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition ${mobileLogoClass}`}
                  width={160}
                  height={60}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .brand-track {
    display: flex;
    width: max-content;
    animation: scroll 65s linear infinite;
  }

  .brand-slide {
    flex-shrink: 0;
    margin-right: 56px;
    display: flex;
    align-items: center;
  }

  .fade-left {
    position: relative;
  }

  .fade-left::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 120px; /* controls fade width */
    height: 100%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to right, white 0%, rgba(255, 255, 255, 0.8) 40%, rgba(255, 255, 255, 0) 100%);
  }

  .fade-left::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to left, white 0%, rgba(255, 255, 255, 0.8) 40%, rgba(255, 255, 255, 0) 100%);
  }

  .brands-surface-dark {
    background: #000;
  }

  .brands-surface-light {
    background: #fff;
  }

  .brands-dark-fade.fade-left::before {
    background: linear-gradient(to right, #000 0%, rgba(0, 0, 0, 0.82) 30%, rgba(0, 0, 0, 0) 100%);
  }

  .brands-dark-fade.fade-left::after {
    background: linear-gradient(to left, #000 0%, rgba(0, 0, 0, 0.82) 30%, rgba(0, 0, 0, 0) 100%);
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 767px) {
    .brands-subtitle-mobile-single {
      white-space: nowrap;
      font-size: 11px;
    }

    :global(.brands-subtitle-mobile-single br) {
      display: none;
    }

    .brand-slide {
      margin-right: 28px;
    }

    :global(.brand-slide img) {
      height: 32px !important;
    }

    .fade-left::before,
    .fade-left::after {
      width: 12px;
    }
  }
</style>
