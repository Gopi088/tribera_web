<style>
  .reference-footer{background:#131313;color:#aaa;font-family:var(--font-sans,Inter,sans-serif)}.reference-footer__inner{max-width:1280px;margin:auto;padding-inline:clamp(20px,4.5vw,48px)}.reference-footer__top{display:grid;gap:32px;padding:55px 0 45px}.reference-footer__brand>a{display:inline-flex}.reference-footer__brand p{max-width:285px;margin:21px 0;color:#999;font-size:13px;line-height:1.6}.reference-footer__brand strong{color:#eaeae6}.reference-footer__brand>span{display:block;color:#da0007;font:11px ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}.reference-footer__brand small{display:block;margin-top:5px;font-size:12px}.reference-footer__brand small em{color:#eee;font-style:normal}.reference-footer__brand div{display:flex;gap:15px;margin-top:20px}.reference-footer a{color:#999;text-decoration:none}.reference-footer a:hover{color:#fff}.reference-footer nav{display:grid;align-content:start;gap:9px}.reference-footer nav b{margin-bottom:5px;color:#e5e5e1;font-size:12px}.reference-footer nav a{font-size:13px}.reference-footer__bar{display:flex;justify-content:space-between;gap:20px;padding:17px 0;border-top:1px solid #30302d;color:#73736e;font-size:11px}@media(min-width:700px){.reference-footer__top{grid-template-columns:2fr repeat(4,1fr)}}@media(max-width:699px){.reference-footer__bar{flex-direction:column}.reference-footer__top{grid-template-columns:repeat(2,1fr)}.reference-footer__brand{grid-column:1/-1}}
</style>
