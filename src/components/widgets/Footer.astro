---
import { Icon } from "astro-icon/components";

const { socialLinks = [], secondaryLinks = [] } = Astro.props;
---


<!-- function getHomePermalink(): string | URL | null | undefined {
throw new Error("Function not implemented.");
} -->

<footer class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-6">

    <!-- TOP SECTION -->
    <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr_1fr_1fr] gap-16 py-10">

      <!-- LEFT BRAND COLUMN -->
      <div>
        <div class="text-2xl text-[#da0007] font-semibold">
          tribera
        </div>

        <p class="mt-4 text-[12px] text-white/60 leading-relaxed max-w-md">
          Remember interviewing 8 candidates to hire 1? That stops here.
          We screen thousands. Our advisors interview the standouts.
          You get 3—all vetted, all qualified.
          Hiring that actually works, finally.
        </p>

        <!-- SOCIAL -->
        <div class="flex gap-5 mt-8">
          {socialLinks.map(({ ariaLabel, href, icon }) => (
            <a
              href={href}
              aria-label={ariaLabel}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 hover:text-[#da0007] transition"
            >
              <Icon name={icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>

      <!-- PRODUCT -->
      <div>
        <h4 class="text-[14px] uppercase tracking-wider font-[500] text-white mb-5">
          Product
        </h4>
        <ul class="space-y-3 text-[13px] text-white/60">
          <li><a href="/" class="hover:text-[#da0007] transition">Platform</a></li>
          <!-- <li><a href="services" class="hover:text-[#da0007] transition">Services</a></li> -->
          <li><a href="/#platform-performance" class="hover:text-[#da0007] transition">Pricing</a></li>
          <li><a href="/#customer-stories" class="hover:text-[#da0007] transition">Customers</a></li>
        </ul>
      </div>

      <!-- COMPANY -->
      <div>
        <h4 class="text-[14px] uppercase tracking-wider text-white mb-5">
          Company
        </h4>
        <ul class="space-y-3 text-[13px] text-white/60">
          <li><a href="/about" class="hover:text-[#da0007] transition">About</a></li>
          <li><a href="/blog" class="hover:text-[#da0007] transition">Blog</a></li>
          <!-- <li><a href="careers" class="hover:text-[#da0007] transition">Careers</a></li>
          <li><a href="contact" class="hover:text-[#da0007] transition">Contact</a></li> -->
        </ul>
      </div>

      <!-- LEGAL -->
      <div>
        <h4 class="text-[14px] uppercase tracking-wider text-white mb-5">
          Legal
        </h4>
        <ul class="space-y-3 text-[13px] text-white/60">
        {secondaryLinks.map(({ text, href }) => (
          <li>
            <a
              href={href}
              class="hover:text-[#da0007] transition"
            >
              {text}
            </a>
          </li>
        ))}
          <!-- <li><a href="#" class="hover:text-[#da0007] transition">Security</a></li>
          <li><a href="#" class="hover:text-[#da0007] transition">Data Protection</a></li> -->
        </ul>
      </div>

    </div>

    <!-- DIVIDER -->
    <div class="border-t border-white/10"></div>

    <!-- BOTTOM BAR -->
    <div class="py-6 text-sm text-white/40 flex flex-col md:flex-row justify-between gap-4">
      <div>
        © {new Date().getFullYear()} Tribera. All rights reserved.
      </div>

      <div class="flex gap-4">
        {secondaryLinks.map(({ text, href }) => (
          <a
            href={href}
            class="hover:text-[#da0007] transition"
          >
            {text}
          </a>
        ))}
      </div>
    </div>

  </div>
</footer>
