---
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <a class="logo" href="/" data-astro-reload>tribera<i>.</i></a>
        <p class="ft__line">
          <b>Hiring you can prove.</b> The AI reads the interview, a senior expert reads the person — and you make the call.
          One bar, every candidate, the proof behind every score.
        </p>
        <p class="ft__tribe">Tribe + Era</p>
        <p class="ft__bbb"><em>Belong</em><i></i>Build<i></i>Become</p>
        <div class="ft__social">
          <a href="https://linkedin.com/company/triberaai">LinkedIn</a>
          <a href="mailto:hello@tribera.ai">hello@tribera.ai</a>
        </div>
      </div>
      <nav class="ft__col" aria-label="For hiring teams">
        <p class="ft__ttl">For hiring teams</p>
        <a href="/#proof">How it works</a>
        <a href="/#funnel">In practice</a>
        <a href="/#results">Results</a>
        <a href="/#ways">How we work</a>
        <a href="/#experts">What we cover</a>
        <a href="/industries">Industries</a>
        <a href="/functions">Functions</a>
      </nav>
      <nav class="ft__col" aria-label="For candidates">
        <p class="ft__ttl">For candidates</p>
        <a href="/candidates#apply">Create your profile</a>
        <a href="/candidates">How it works</a>
        <a href="/careers#roles">Open roles</a>
        <a href="/candidates#controls">Privacy controls</a>
      </nav>
      <nav class="ft__col" aria-label="Company">
        <p class="ft__ttl">Company</p>
        <a href="/about">About</a>
        <a href="/blog">Blog</a>
        <a href="/careers">Careers</a>
        <a href="/contact">Contact</a>
        <a href="https://app.tribera.ai/auth/login">Log in</a>
      </nav>
      <nav class="ft__col" aria-label="Legal">
        <p class="ft__ttl">Legal</p>
        <a href="/security">Security</a>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/contact">Request a DPA</a>
      </nav>
    </div>
    <div class="ft__bar">
      <span>&copy; {year} Tribera &middot; Eragina Digital Solutions Private Limited</span>
      <span class="ft__bar-r">
        <span class="ft__made">Pune &middot; Bengaluru &middot; New Jersey</span>
        <a class="ft__up" href="#nav">Back to top <span aria-hidden="true">↑</span></a>
      </span>
    </div>
  </div>
</footer>

<style is:global>
  /* One footer contract wins over legacy route-local styles. */
  :root body footer.ft {
    --footer-muted: #9a9992;
    --footer-accent: #ff6b6f;
    isolation: isolate;
    background: #121212;
    color: var(--footer-muted);
    padding-block: clamp(48px, 5.5vw, 76px) 32px;
    font:
      400 14px/1.5 'Inter Tight',
      system-ui,
      sans-serif;
  }
  :root body footer.ft .wrap {
    width: min(calc(100% - clamp(44px, 10vw, 144px)), 1160px);
    max-width: none;
    margin-inline: auto;
    padding-inline: 0;
  }
  :root body footer.ft .ft__top {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }
  :root body footer.ft .ft__brand {
    grid-column: 1 / -1;
    min-width: 0;
  }
  :root body footer.ft .logo {
    font:
      800 26px/1 'Figtree',
      sans-serif;
    letter-spacing: -0.055em;
    color: #fff;
    text-decoration: none;
  }
  :root body footer.ft .logo i {
    color: #da0007;
    font: inherit;
  }
  :root body footer.ft .ft__line {
    max-width: 36ch;
    margin: 16px 0 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--footer-muted);
  }
  :root body footer.ft .ft__line b {
    display: block;
    margin-bottom: 6px;
    color: #fff;
    font-weight: 600;
  }
  :root body footer.ft .ft__tribe {
    margin: 16px 0 0;
    color: var(--footer-muted);
    font:
      400 12px/1.5 'JetBrains Mono',
      monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  :root body footer.ft .ft__bbb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 7px 0 0;
    color: #bdbdb7;
    font:
      700 15px/1.5 'Fraunces',
      Georgia,
      serif;
    white-space: nowrap;
  }
  :root body footer.ft .ft__bbb em {
    color: var(--footer-accent);
    font-style: normal;
  }
  :root body footer.ft .ft__bbb i {
    display: block;
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #4a4a44;
  }
  :root body footer.ft .ft__social {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 20px;
  }
  :root body footer.ft .ft__col {
    display: flex;
    flex-direction: column;
    gap: 11px;
    align-items: flex-start;
    min-width: 0;
  }
  :root body footer.ft .ft__ttl {
    margin: 0 0 5px;
    font:
      400 12px/1.5 'JetBrains Mono',
      monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--footer-accent);
  }
  :root body footer.ft :is(.ft__col a, .ft__social a, .ft__up) {
    font:
      400 14px/1.5 'Inter Tight',
      system-ui,
      sans-serif;
    color: #bdbdb7;
    text-decoration: none;
  }
  :root body footer.ft :is(.ft__col a, .ft__social a, .ft__up):is(:hover, :focus-visible) {
    color: #fff;
  }
  :root body footer.ft .ft__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
    margin-top: clamp(36px, 4vw, 56px);
    padding-top: 22px;
    border-top: 1px solid #33332e;
    color: var(--footer-muted);
    font-size: 12.5px;
  }
  :root body footer.ft .ft__bar-r {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 24px;
  }
  :root body footer.ft .ft__made {
    font:
      400 11px/1.5 'JetBrains Mono',
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (min-width: 1020px) {
    :root body footer.ft .ft__top {
      grid-template-columns: 1.5fr repeat(4, minmax(0, 0.9fr));
      gap: clamp(24px, 2.6vw, 44px);
    }
    :root body footer.ft .ft__brand {
      grid-column: auto;
    }
  }
</style>
