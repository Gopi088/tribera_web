---
import type { HTMLAttributes } from 'astro/types';
export interface Props extends HTMLAttributes<'article'> {
  ownership?: boolean;
}
const { ownership = false, class: className, ...attributes } = Astro.props;
---

<article {...attributes} class:list={['v58-evidence-card', { 'v58-evidence-card--owned': ownership }, className]}>
  <slot />
</article>

<style>
  .v58-evidence-card {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    padding: 1.25rem 1.3rem 1.3rem;
    border: 1px solid var(--v58-line);
    border-radius: 14px;
    background: var(--v58-white);
    color: var(--v58-ink);
    box-shadow: 0 20px 36px -28px rgba(19, 19, 19, 0.22);
  }
  .v58-evidence-card--owned {
    box-shadow:
      inset 0 3px var(--v58-red),
      0 20px 36px -28px rgba(19, 19, 19, 0.22);
  }
  .v58-evidence-card :global(p) {
    margin: 0;
    color: var(--v58-muted);
    font: 400 0.9rem/1.5 var(--v58-ui);
  }
</style>
