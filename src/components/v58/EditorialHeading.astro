---
import type { HTMLAttributes } from 'astro/types';
export interface Props extends HTMLAttributes<'h2'> {
  as?: 'h1' | 'h2' | 'h3';
}
const { as: Tag = 'h2', class: className, ...attributes } = Astro.props;
---

<Tag {...attributes} class:list={['v58-heading', `v58-heading--${Tag}`, className]}><slot /></Tag>

<style>
  .v58-heading {
    margin: 0;
    color: inherit;
    font-family: var(--v58-display);
    font-optical-sizing: auto;
    font-weight: var(--type-display-weight);
    letter-spacing: var(--type-display-tracking);
    line-height: var(--type-section-leading);
  }
  .v58-heading--h1 {
    font-size: var(--type-hero-size);
    line-height: var(--type-hero-leading);
  }
  .v58-heading--h2 {
    font-size: var(--type-section-size);
  }
  .v58-heading--h3 {
    font-size: var(--type-card-size);
    line-height: var(--type-card-leading);
  }
</style>
