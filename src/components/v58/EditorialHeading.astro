---
import type { HTMLAttributes } from 'astro/types';
export interface Props extends HTMLAttributes<'h2'> {
  as?: 'h1' | 'h2' | 'h3';
}
const { as: Tag = 'h2', class: className, ...attributes } = Astro.props;
---

<Tag {...attributes} class:list={['v58-heading', `v58-heading--${Tag}`, className]}><slot /></Tag>

<style>
  .v58-heading {
    margin: 0;
    color: inherit;
    font-family: var(--v58-display);
    font-optical-sizing: auto;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.08;
  }
  .v58-heading--h1 {
    font-size: clamp(2.08rem, 4.48vw, 3.32rem);
  }
  .v58-heading--h2 {
    font-size: clamp(2rem, 3.9vw, 3rem);
  }
  .v58-heading--h3 {
    font-size: 1.1rem;
    line-height: 1.6;
  }
</style>
