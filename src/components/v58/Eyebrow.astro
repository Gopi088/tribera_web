---
export interface Props {
  accent?: boolean;
}
const { accent = true } = Astro.props;
---

<p class="v58-eyebrow">{accent && <span aria-hidden="true">\</span>}<slot /></p>

<style>
  .v58-eyebrow {
    display: flex;
    gap: 0.6em;
    margin: 0 0 1.28rem;
    color: var(--v58-faint);
    font-family: var(--v58-mono);
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .v58-eyebrow span {
    color: var(--v58-red);
  }
</style>
