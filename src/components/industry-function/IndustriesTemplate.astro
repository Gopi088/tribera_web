---
interface Challenge { title: string; desc: string; tag?: string; items?: string[]; }
interface Role { title: string; level: string; }
interface WhyItem { title: string; desc: string; }
interface FAQ { q: string; a: string; }

interface Props {
  type: 'industry' | 'function';
  slug: string;
  badge: string;
  title: string;
  subtitle: string;
  overview: string;
  advisorLabel?: string;
  hiringChallenges: Challenge[];
  rolesWeHire: Role[];
  whyTribera: WhyItem[];
  faqs: FAQ[];
  ctaHeadline: string;
  ctaSubtext: string;
}

const {
  type,
  slug,
  badge,
  title,
  subtitle,
  overview,
  advisorLabel,
  hiringChallenges,
  rolesWeHire,
  whyTribera,
  faqs,
  ctaHeadline,
  ctaSubtext,
} = Astro.props;

const formSource = `${type}_${slug}`;

const words = title.split(' ');
const hasAmpersand = title.includes('&');
let firstLine: string, secondLine: string | null;
if (hasAmpersand) {
  firstLine = title.split('&')[0].trim();
  secondLine = '& ' + title.split('&')[1].trim();
} else if (words.length === 1) {
  firstLine = title;
  secondLine = null;
} else {
  const lastSpace = title.lastIndexOf(' ');
  firstLine = title.substring(0, lastSpace);
  secondLine = title.substring(lastSpace + 1);
}
---

<!-- ===== HERO ===== -->
<section class="relative min-h-[90vh] md:min-h-screen flex items-center justify-center overflow-hidden bg-black">
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-black"></div>

    <div
      class="absolute left-[-30%] md:left-[-15%] top-0 h-full w-[90%] md:w-[60%]
    bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.45),transparent_60%)]">
    </div>

    <div
      class="absolute right-[-30%] md:right-[-15%] top-0 h-full w-[90%] md:w-[60%]
    bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.45),transparent_60%)]">
    </div>
  </div>

  <div class="absolute inset-0 pointer-events-none">
    {Array.from({ length: 22 }).map(() => (
      <span class="absolute rounded-full bg-[#da0007]/80" style={`
        width:3px;height:3px;
        left:${12 + Math.random() * 76}%;
        top:${8 + Math.random() * 84}%;
        --float-x1:${(Math.random() * 44 - 22).toFixed(1)}px;
        --float-y1:${(Math.random() * 36 - 18).toFixed(1)}px;
        --float-x2:${(Math.random() * 52 - 26).toFixed(1)}px;
        --float-y2:${(Math.random() * 42 - 21).toFixed(1)}px;
        --float-x3:${(Math.random() * 60 - 30).toFixed(1)}px;
        --float-y3:${(Math.random() * 36 - 18).toFixed(1)}px;
        --float-x4:${(Math.random() * 48 - 24).toFixed(1)}px;
        --float-y4:${(Math.random() * 48 - 24).toFixed(1)}px;
        --float-x5:${(Math.random() * 56 - 28).toFixed(1)}px;
        --float-y5:${(Math.random() * 40 - 20).toFixed(1)}px;
        --float-x6:${(Math.random() * 50 - 25).toFixed(1)}px;
        --float-y6:${(Math.random() * 34 - 17).toFixed(1)}px;
        --float-scale1:${(1 + Math.random() * 0.28).toFixed(2)};
        --float-scale2:${(0.78 + Math.random() * 0.18).toFixed(2)};
        --float-scale3:${(1.02 + Math.random() * 0.22).toFixed(2)};
        --float-scale4:${(0.82 + Math.random() * 0.14).toFixed(2)};
        --float-scale5:${(1 + Math.random() * 0.2).toFixed(2)};
        --float-scale6:${(0.86 + Math.random() * 0.14).toFixed(2)};
        animation: float ${11 + Math.random() * 14}s ease-in-out infinite;
        animation-delay: -${(Math.random() * 18).toFixed(1)}s;
        box-shadow: 0 0 10px rgba(218,0,7,.6);
      `} />
    ))}
  </div>

  <div class="relative z-10 max-w-[1080px] mx-auto px-6 text-center">
    <div
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#da0007]/40 bg-white/[0.03] px-3.5 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/80"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-[#da0007]"></span>
      <span>{badge}</span>
    </div>

    <h1 class="font-[600] leading-[1.02] sm:leading-[1.08]">
      <span
        class="block whitespace-nowrap text-white text-[clamp(2.15rem,10.8vw,3rem)] sm:text-[clamp(2.8rem,6vw,5rem)] tracking-[-0.08em]"
      >
        {firstLine}
      </span>

      {secondLine && (
        <span
          class="block text-[clamp(2.45rem,12vw,3.4rem)] sm:text-[clamp(2.8rem,6vw,5rem)] text-[#da0007] tracking-[-0.08em]"
        >
          {secondLine}
        </span>
      )}
    </h1>

    <p
      class="mt-6 md:mt-8 text-white/60 text-[16px] md:text-[20px] max-w-2xl md:max-w-3xl mx-auto leading-relaxed px-2"
    >
      {subtitle}
    </p>

    <div class="mt-8 md:mt-12 flex flex-col sm:flex-row flex-wrap justify-center items-center gap-4 sm:gap-5">
      <div
        class="flex w-auto max-w-full flex-col items-center gap-1
                px-4 py-3
                rounded-xl
                border border-[#da0007]/40
                bg-[#da0007]/20
                text-center text-white
                sm:w-auto sm:flex-row sm:gap-2 sm:px-5 sm:text-left"
      >
        <span class="whitespace-nowrap text-[13px] font-[600] leading-tight text-white/90">
          <span class="text-[#da0007]">1:3</span> Selection Ratio Guarantee*
        </span>

        <span class="text-[11px] font-[550] leading-tight text-white/50">Interview 3, hire 1</span>
      </div>

      <button
        type="button"
        data-form-intent="demo"
        data-form-source={formSource}
        class="px-6 py-3 rounded-full
              bg-[#ff0000]
              text-white
              text-[13px]
              font-bold
              transition-all duration-300
              hover:bg-[#e00000]"
      >
        Book a demo
      </button>

      <a
        href="/contact"
        class="px-6 py-3 rounded-full
              bg-[#121212]
              border border-white/10
              text-white/80
              text-[13px]
              font-bold
              transition-all duration-300
              hover:border-white/20"
      >
        See How It Works →
      </a>
    </div>

    <p class="mt-8 md:mt-14 text-white/30 text-[12px] font-[550]">*We’ll walk you through it</p>
  </div>
</section>

<!-- ===== 2. HIRING CHALLENGES ===== -->
<section class="bg-[#f5f5f5] py-14 md:py-20" id="assess">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10">
    <div class="text-center mb-10 md:mb-12">
      <p class="text-[11px] tracking-[0.24em] font-semibold text-[#da0007] uppercase">
        Where {badge} hiring breaks
      </p>
      <h2
        class="mt-3 text-[34px] sm:text-[44px] lg:text-[55px] font-[700] text-black leading-[1.08] tracking-[-0.02em] max-w-3xl mx-auto"
      >
        Four things a generic screen misses
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-black/50 max-w-2xl mx-auto">
        {overview}
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {hiringChallenges.map((c, i) => (
        <div
          class="group relative rounded-xl bg-white p-4 md:p-5 border border-black/5 overflow-hidden
                 transition-all duration-500
                 hover:shadow-[0_20px_60px_-15px_rgba(218,0,7,0.20)]"
        >
          <div class="absolute top-0 left-0 h-[3px] w-0 bg-[#da0007] transition-all duration-700 group-hover:w-full" />
          <div class="relative z-10">
            {c.tag && (
              <span class="inline-block text-[10px] tracking-[0.1em] bg-[#da0007]/10 text-[#da0007] px-2 py-1 rounded-sm font-[700]">
                {c.tag}
              </span>
            )}
            <h3 class="mt-3 text-[17px] font-[600] text-black">{c.title}</h3>
            <p class="mt-2 text-[13px] text-black/60 leading-relaxed">{c.desc}</p>
            {c.items && c.items.length > 0 && (
              <ul class="mt-3 mb-4 space-y-2">
                {c.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="relative flex items-center justify-center w-[12px] h-[12px] mt-[5px] flex-shrink-0">
                      <span class="absolute w-[13px] h-[13px] rounded-full bg-[#da0007]/50 blur-[4px] opacity-80 glow-breathe" />
                      <span class="relative w-[9px] h-[9px] dot-breathe rounded-full bg-[#da0007]" />
                    </span>
                    <span class="text-[13px] text-black/70 transition-all duration-300 ease-out hover:translate-x-[4px] hover:text-black cursor-pointer">
                      {item}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== 3. ROLES ===== -->
<section class="band">
  <div class="wrap">
    <div class="sectionhead">
      <p class="eyebrow" data-rv>Roles we hire</p>
      <h2 class="h2" data-rv style="--d:70ms">Every level. Every mandate. One guarantee.</h2>
    </div>
    <div class="roles">
      {rolesWeHire.map((r, i) => (
        <article class="role" data-rv style={`--d:${i * 45}ms`}>
          <h3 class="role__t">{r.title}</h3>
          <p class="role__b">{r.level}</p>
        </article>
      ))}
    </div>
    <p class="rolesnote" data-rv>Not seeing your role? <a href="/contact">Tell us what you are hiring for &rarr;</a></p>
  </div>
</section>

<!-- ===== 4. COMPARISON ===== -->
<section class="band band--dark">
  <div class="wrap">
    <div class="sectionhead">
      <p class="eyebrow" data-rv>tribera vs alternatives</p>
      <h2 class="h2" data-rv style="--d:70ms">Why tribera wins in {badge}</h2>
      <p class="dek" data-rv style="--d:150ms">Not just software &mdash; a complete solution.</p>
    </div>
    <div class="cmp" data-rv>
      <table>
        <caption>Capability comparison for {title} hiring.</caption>
        <thead><tr>
          <th scope="col">Feature</th><th scope="col" class="own">tribera</th>
          <th scope="col">SaaS Tools</th><th scope="col">Traditional RPO</th>
        </tr></thead>
        <tbody>
          <tr>
            <th scope="row">{advisorLabel || `Domain Advisor Interviews`}</th><td><span class="pillcell"><span class="tick">&#10003;</span></span></td><td><span class="cross">&#10005;</span></td><td><span class="plaincell">Generalist only</span></td>
          </tr>
          <tr>
            <th scope="row">100+ Signal Analysis</th><td><span class="pillcell"><span class="tick">&#10003;</span></span></td><td><span class="cross">&#10005;</span></td><td><span class="cross">&#10005;</span></td>
          </tr>
          <tr>
            <th scope="row">1:3 Selection Guarantee*</th><td><span class="pillcell"><span class="tick">&#10003;</span></span></td><td><span class="cross">&#10005;</span></td><td><span class="cross">&#10005;</span></td>
          </tr>
          <tr>
            <th scope="row">Transcript-Scored Shortlists</th><td><span class="pillcell"><span class="tick">&#10003;</span></span></td><td><span class="cross">&#10005;</span></td><td><span class="cross">&#10005;</span></td>
          </tr>
          <tr>
            <th scope="row">Time to First Shortlist</th><td><span class="pillcell">36 hours</span></td><td><span class="plaincell">You do it</span></td><td><span class="plaincell">2-3 weeks</span></td>
          </tr>
          <tr>
            <th scope="row">Passive Talent Access</th><td><span class="pillcell"><span class="tick">&#10003;</span></span></td><td><span class="cross">&#10005;</span></td><td><span class="plaincell">Partial</span></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="ccards">
      {[
        { f: advisorLabel || `Domain Advisor Interviews`, t: 'check', s: '\u2717', r: 'Generalist only' },
        { f: '100+ Signal Analysis', t: 'check', s: '\u2717', r: '\u2717' },
        { f: '1:3 Selection Guarantee*', t: 'check', s: '\u2717', r: '\u2717' },
        { f: 'Transcript-Scored Shortlists', t: 'check', s: '\u2717', r: '\u2717' },
        { f: 'Time to First Shortlist', t: '36 hours', s: 'You do it', r: '2-3 weeks' },
        { f: 'Passive Talent Access', t: 'check', s: '\u2717', r: 'Partial' },
      ].map((row, i) => (
        <article class="ccard" data-rv style={`--d:${i * 55}ms`}>
          <h3 class="ccard__t">{row.f}</h3>
          <div class="ccard__r ccard__r--own"><span>tribera</span>{row.t === 'check' ? <span class="pillcell"><span class="tick">&#10003;</span></span> : <span class="pillcell">{row.t}</span>}</div>
          <div class="ccard__r"><span>SaaS Tools</span><span class="cross">&#10005;</span></div>
          <div class="ccard__r"><span>Traditional RPO</span>{row.r === '\u2717' ? <span class="cross">&#10005;</span> : <span class="plaincell">{row.r}</span>}</div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== 5. FAQ ===== -->
{
  faqs.length > 0 && (
    <section class="band band--off">
      <div class="wrap">
        <div class="sectionhead">
          <p class="eyebrow" data-rv>Questions</p>
          <h2 class="h2" data-rv style="--d:70ms">Common questions</h2>
        </div>
        <div class="faqs">
          {faqs.map((faq, i) => (
            <details class="faq" data-rv style={`--d:${i * 55}ms`}>
              <summary class="faq__q"><span>{faq.q}</span></summary>
              <p class="faq__a">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- ===== 6. CLOSER ===== -->
<section class="band closer" id="demo">
  <div class="wrap">
    <p class="eyebrow" data-rv>Get Started Today</p>
    <h2 class="h2" data-rv style="--d:70ms">{ctaHeadline}</h2>
    <p class="dek" data-rv style="--d:150ms">{ctaSubtext}</p>
    <a href="/contact"
       class="relative overflow-hidden mt-5 inline-flex items-center justify-center px-6 py-3 rounded-full tribera-primary-button font-bold text-[14px]"
       data-rv style="--d:220ms">
      <span class="relative z-10">See Platform Demo &rarr;</span>
    </a>
  </div>
</section>

<style is:inline>
:root{
  --black:#000;--near:#0A0A0A;--card-dark:#141414;--line-dark:rgba(255,255,255,.10);
  --white:#FFF;--off:#F5F5F5;--ink:#111;--grey:#6B6B6B;--grey-dark:rgba(255,255,255,.66);
  --hair:#E8E8E8;
  --red:#DA0007;--red-soft:#E1141B;--red-tint:#FDECEC;
  --display:"Figtree",-apple-system,BlinkMacSystemFont,sans-serif;
  --ui:"Inter Tight",-apple-system,BlinkMacSystemFont,sans-serif;
  --ease:cubic-bezier(.16,1,.3,1);
  --wrap:1200px;--gut:clamp(20px,5vw,40px);--band:clamp(72px,9vw,130px);--r:20px;
}
</style>

<style is:inline>
[data-rv]{opacity:0;transform:translateY(16px);transition:opacity .85s var(--ease),transform .85s var(--ease);transition-delay:var(--d,0ms);will-change:opacity,transform}
[data-rv].in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){[data-rv]{opacity:1;transform:none;transition:none}}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--red);text-align:center;margin:0 0 24px}
.h2{font-family:var(--display);font-weight:700;font-size:clamp(31px,4.6vw,58px);line-height:1.04;letter-spacing:-.038em;text-align:center;margin:0 auto;max-width:19ch}
.dek{font-size:clamp(16px,1.5vw,18px);line-height:1.6;color:var(--grey);text-align:center;max-width:64ch;margin:22px auto 0}
.band--dark .dek{color:var(--grey-dark)}
.sectionhead{margin-bottom:clamp(44px,5.5vw,72px)}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-inline:var(--gut)}
.band{padding-block:var(--band)}
.band--dark{background:var(--near);color:#fff}
.band--off{background:var(--off)}

@keyframes glow-breathe{0%,100%{opacity:.6;transform:scale(1)}50%{opacity:.9;transform:scale(1.1)}}
@keyframes dot-breathe{0%,100%{opacity:.6}50%{opacity:1}}
@media (prefers-reduced-motion:reduce){.glow-breathe,.dot-breathe{animation:none}}
.roles{display:grid;gap:20px}
@media(min-width:640px){.roles{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1000px){.roles{grid-template-columns:repeat(4,1fr)}}
.role{background:var(--off);border-radius:16px;padding:26px 24px}
.role__t{font-family:var(--display);font-weight:600;font-size:17px;line-height:1.3;margin:0 0 8px;color:var(--ink)}
.role__b{font-size:13.5px;color:var(--grey);margin:0}
.rolesnote{text-align:center;font-size:15px;color:var(--grey);margin:40px 0 0}
.rolesnote a{color:var(--red);text-decoration:none;font-weight:600}
.cmp{display:none;background:var(--card-dark);border:1px solid var(--line-dark);border-radius:var(--r);overflow:hidden}
.cmp table{width:100%;border-collapse:collapse}
.cmp caption{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.cmp th,.cmp td{padding:22px 26px;text-align:center}
.cmp thead th{font-size:15px;font-weight:600;color:rgba(255,255,255,.72);border-bottom:1px solid var(--line-dark)}
.cmp thead th:first-child{text-align:left;color:#fff}
.cmp thead th.own{color:var(--red);font-weight:700}
.cmp tbody th{text-align:left;font-size:15.5px;font-weight:400;color:#fff}
.cmp tbody tr+tr{border-top:1px solid var(--line-dark)}
@media(min-width:900px){.cmp{display:block}}
.pillcell{display:inline-flex;align-items:center;justify-content:center;min-width:118px;padding:13px 20px;background:rgba(218,0,7,.16);border:1px solid rgba(218,0,7,.34);border-radius:10px;color:var(--red);font-weight:600;font-size:14.5px}
.tick{font-size:17px;line-height:1}
.cross{color:rgba(255,255,255,.3);font-size:17px}
.plaincell{color:rgba(255,255,255,.72);font-size:15px}
.ccards{display:grid;gap:16px}
@media(min-width:900px){.ccards{display:none}}
.ccard{background:var(--card-dark);border:1px solid var(--line-dark);border-radius:16px;padding:22px 22px 10px}
.ccard__t{font-family:var(--display);font-weight:600;font-size:17px;margin:0 0 16px;color:#fff}
.ccard__r{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 0;border-top:1px solid var(--line-dark)}
.ccard__r span:first-child{font-size:14px;color:var(--grey-dark)}
.ccard__r--own{border-top-color:rgba(218,0,7,.4)}
.ccard__r--own span:first-child{color:var(--red);font-weight:600}
.ccard__r .pillcell{min-width:96px;padding:9px 16px}
.faqs{display:grid;gap:16px;max-width:880px;margin:0 auto}
.faq{background:#fff;border-radius:16px;box-shadow:0 2px 18px rgba(0,0,0,.05)}
.faq__q{list-style:none;cursor:pointer;display:flex;align-items:flex-start;justify-content:space-between;gap:22px;padding:26px 28px;font-family:var(--display);font-weight:600;font-size:clamp(16.5px,1.8vw,19px);line-height:1.35;letter-spacing:-.018em}
.faq__q::-webkit-details-marker{display:none}
.faq__q::after{content:"+";flex:none;color:var(--red);font-family:var(--ui);font-weight:500;font-size:25px;line-height:.9}
.faq[open] .faq__q::after{content:"\2212"}
.faq__a{padding:0 28px 28px;font-size:15.5px;line-height:1.68;color:var(--grey);margin:0;max-width:68ch}
.closer{text-align:center}
.closer .btn{margin-top:42px}
</style>

<script is:inline>
(function(){var r=window.matchMedia('(prefers-reduced-motion:reduce)').matches,i=[].slice.call(document.querySelectorAll('[data-rv]'));if(r){i.forEach(function(e){e.classList.add('in')});return}var t=false;function s(){t=false;var v=window.innerHeight;i=i.filter(function(e){if(e.getBoundingClientRect().top<v*0.92){e.classList.add('in');return false}return true});if(!i.length){window.removeEventListener('scroll',o);window.removeEventListener('resize',o)}}function o(){if(t)return;t=true;requestAnimationFrame(s)}window.addEventListener('scroll',o,{passive:true});window.addEventListener('resize',o);s()})();
</script>