---

interface Challenge { title: string; desc: string; }
interface Role { title: string; level: string; }
interface WhyItem { title: string; desc: string; }
interface FAQ { q: string; a: string; }

interface Props {
  type: 'industry' | 'function';
  slug: string;
  badge: string;
  title: string;
  subtitle: string;
  overview: string;
  hiringChallenges: Challenge[];
  rolesWeHire: Role[];
  whyTribera: WhyItem[];
  faqs: FAQ[];
  ctaHeadline: string;
  ctaSubtext: string;
}

const {
  type,
  slug,
  badge,
  title,
  subtitle,
  overview,
  hiringChallenges,
  rolesWeHire,
  whyTribera,
  faqs,
  ctaHeadline,
  ctaSubtext,
} = Astro.props;

const badgeLabel = type === 'industry' ? 'Industry Focus' : 'Function Focus';
const formSource = `${type}_${slug}`;
---

<!-- ===== HERO ===== -->
<section
  class="relative min-h-[90vh] md:min-h-screen flex items-start md:items-center justify-center overflow-hidden bg-black pt-20 pb-12 md:pb-0 md:pt-0"
>
  <!-- Background gradients — match homepage -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-black"></div>
    <div
      class="absolute left-[-30%] md:left-[-15%] top-0 h-full w-[90%] md:w-[60%]
             bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.45),transparent_60%)]"
    ></div>
    <div
      class="absolute right-[-30%] md:right-[-15%] top-0 h-full w-[90%] md:w-[60%]
             bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.45),transparent_60%)]"
    ></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(218,0,7,0.06),transparent_55%)]"
    ></div>
  </div>

  <!-- Dot pattern -->
  <div class="pointer-events-none absolute inset-0 bg-dotted-static opacity-70"></div>

  <!-- Floating particles -->
  <div class="absolute inset-0 pointer-events-none">
    {
      Array.from({ length: 20 }).map(() => (
        <span
          class="absolute rounded-full bg-[#da0007]/80"
          style={`
            width:3px;height:3px;
            left:${12 + Math.random() * 76}%;
            top:${8 + Math.random() * 84}%;
            --float-x1:${(Math.random() * 44 - 22).toFixed(1)}px;
            --float-y1:${(Math.random() * 36 - 18).toFixed(1)}px;
            --float-x2:${(Math.random() * 52 - 26).toFixed(1)}px;
            --float-y2:${(Math.random() * 42 - 21).toFixed(1)}px;
            --float-x3:${(Math.random() * 60 - 30).toFixed(1)}px;
            --float-y3:${(Math.random() * 36 - 18).toFixed(1)}px;
            --float-x4:${(Math.random() * 48 - 24).toFixed(1)}px;
            --float-y4:${(Math.random() * 48 - 24).toFixed(1)}px;
            --float-x5:${(Math.random() * 56 - 28).toFixed(1)}px;
            --float-y5:${(Math.random() * 40 - 20).toFixed(1)}px;
            --float-x6:${(Math.random() * 50 - 25).toFixed(1)}px;
            --float-y6:${(Math.random() * 34 - 17).toFixed(1)}px;
            --float-scale1:${(1 + Math.random() * 0.28).toFixed(2)};
            --float-scale2:${(0.78 + Math.random() * 0.18).toFixed(2)};
            --float-scale3:${(1.02 + Math.random() * 0.22).toFixed(2)};
            --float-scale4:${(0.82 + Math.random() * 0.14).toFixed(2)};
            --float-scale5:${(1 + Math.random() * 0.2).toFixed(2)};
            --float-scale6:${(0.86 + Math.random() * 0.14).toFixed(2)};
            animation: float ${11 + Math.random() * 14}s ease-in-out infinite;
            animation-delay: -${(Math.random() * 18).toFixed(1)}s;
            box-shadow: 0 0 10px rgba(218,0,7,.6);
          `}
        />
      ))
    }
  </div>

  <div class="relative z-10 mx-auto w-full max-w-4xl px-5 sm:px-8 lg:px-10 text-center">
    <!-- Badge pill -->
    <div
      class="inline-flex items-center gap-2 rounded-full border border-[#da0007]/50 bg-black/20
             px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/80
             backdrop-blur-sm sm:text-[12px]"
    >
      <span class="h-2 w-2 rounded-full bg-[#da0007]"></span>
      {badgeLabel}
    </div>

    <!-- Headline -->
    <h1
      class="mt-5 font-[600] leading-[1.02] tracking-[-0.05em] text-white
             text-[clamp(2.2rem,9vw,3.2rem)] sm:text-[clamp(2.6rem,6vw,4rem)] max-w-4xl mx-auto"
    >
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="mt-5 max-w-2xl mx-auto text-[15px] leading-relaxed text-white/50 sm:text-[17px] md:mt-6">
      {subtitle}
    </p>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <button
        type="button"
        data-form-intent="demo"
        data-form-source={formSource}
        class="px-7 py-3 rounded-full tribera-primary-button text-[13px] font-semibold"
      >
        Book a Demo
      </button>
      <a
        href="/contact"
        class="px-7 py-3 rounded-full border border-white/20 text-white/70 text-[13px]
               font-semibold transition hover:border-white/40 hover:text-white"
      >
        Talk to Us
      </a>
    </div>

    <!-- Trust bar -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-6">
      {
        [
          '1:3 Selection Guarantee',
          'First shortlist in 36 hours',
          'Advisor-interviewed candidates',
        ].map((item) => (
          <div class="flex items-center gap-2 text-[11px] text-white/40">
            <span class="h-1.5 w-1.5 rounded-full bg-[#da0007]"></span>
            {item}
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ===== OVERVIEW ===== -->
<section class="bg-black border-t border-white/5 py-14 md:py-20">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10">
    <div class="grid lg:grid-cols-[1fr_1.6fr] gap-10 lg:gap-16 items-start">
      <div>
        <p class="text-[11px] tracking-[0.24em] font-semibold text-[#da0007] uppercase">
          Overview
        </p>
        <h2
          class="mt-3 text-white font-[700] leading-[1.08] tracking-[-0.02em]
                 text-[34px] sm:text-[44px] lg:text-[55px]"
        >
          What makes {title} hiring different
        </h2>

        <!-- Stat callouts -->
        <div class="mt-8 grid grid-cols-2 gap-x-8 gap-y-5">
          {
            [
              { val: '1:3', label: 'Selection ratio guarantee' },
              { val: '36hrs', label: 'To first shortlist' },
              { val: '100+', label: 'AI signals per candidate' },
              { val: '89%', label: '12-month retention score' },
            ].map((s) => (
              <div>
                <div class="text-[28px] font-[700] leading-none tracking-tight text-[#da0007]">
                  {s.val}
                </div>
                <div class="mt-1 text-[11px] text-white/40 leading-snug">{s.label}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-[15px] leading-[1.85] text-white/55 sm:text-[16px]">
          {overview}
        </p>

        <!-- How it works inline -->
        <div
          class="relative mt-8 overflow-hidden rounded-xl border border-[#da0007]/30
                 bg-gradient-to-br from-[#1a0000] to-[#1e0000] p-5"
        >
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <div
              class="w-[180px] h-[180px]
                     bg-[radial-gradient(circle,rgba(218,0,7,0.7),transparent_70%)]
                     blur-[36px] opacity-40"
            ></div>
          </div>
          <div class="relative z-10 space-y-4">
            <p class="text-[11px] uppercase tracking-[0.2em] text-[#da0007] font-semibold">
              How every shortlist is built
            </p>
            {
              [
                { step: '01', text: 'AI screens 100+ signals — technical depth, project validity, behavioural patterns.' },
                { step: '02', text: 'A domain advisor runs a structured interview — scenario-based, not trivia.' },
                { step: '03', text: 'Three hire-ready candidates reach you — GREEN, with full reasoning.' },
              ].map((item) => (
                <div class="flex gap-4 items-start">
                  <span class="text-[#da0007] text-[13px] font-[700] mt-0.5 shrink-0">{item.step}</span>
                  <p class="text-[13px] text-white/70 leading-relaxed">{item.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== HIRING CHALLENGES ===== -->
<section class="bg-[#f5f5f5] py-14 md:py-20">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10">
    <p class="text-[11px] tracking-[0.24em] font-semibold text-[#da0007] uppercase mb-3">
      Hiring Challenges
    </p>
    <h2
      class="text-[34px] sm:text-[44px] lg:text-[55px] font-[700] text-black leading-[1.08] tracking-[-0.02em] max-w-2xl"
    >
      Where {title} hiring typically breaks down
    </h2>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        hiringChallenges.map((c, i) => (
          <div
            class="group relative overflow-hidden rounded-[24px] border border-black/5 bg-white p-6
                   transition-all duration-300
                   hover:-translate-y-1 hover:shadow-[0_18px_48px_-24px_rgba(218,0,7,0.20)]"
          >
            <div class="absolute left-0 top-0 h-[3px] w-0 bg-[#da0007] transition-all duration-500 group-hover:w-full" />
            <div class="relative z-10">
              <span class="inline-block rounded-sm bg-[#da0007]/10 px-2 py-1 text-[10px] font-[700] tracking-[0.1em] text-[#da0007]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 text-[21px] sm:text-[22px] font-semibold tracking-tight leading-tight text-black">{c.title}</h3>
              <p class="mt-2 text-black/60 text-[14px] leading-relaxed">{c.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ===== ROLES WE HIRE ===== -->
<section class="bg-black py-14 md:py-20">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10">
    <p class="text-[11px] tracking-[0.24em] font-semibold text-[#da0007] uppercase mb-3">
      Roles We Hire
    </p>
    <h2
      class="text-[34px] sm:text-[44px] lg:text-[55px] font-[700] leading-[1.08] tracking-[-0.02em] text-white max-w-xl"
    >
      Every level. Every mandate. One guarantee.
    </h2>

    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        rolesWeHire.map((r) => (
          <div
            class="group relative overflow-hidden rounded-[20px] border border-white/10
                   bg-gradient-to-b from-[#181818] to-[#0f0f0f] p-5
                   shadow-[0_20px_60px_rgba(0,0,0,0.6)]
                   transition-all duration-300
                   hover:-translate-y-1 hover:border-[#da0007]/30"
          >
            <div class="absolute inset-y-0 left-0 w-[3px] bg-[#da0007] opacity-70" />
            <div class="pl-3">
              <h3 class="text-[13px] font-[600] text-white leading-snug">{r.title}</h3>
              <p class="mt-1.5 text-[11px] text-white/40">{r.level}</p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-[13px] text-white/30">
      Don't see your exact role?{' '}
      <a href="/contact" class="text-[#da0007] hover:underline underline-offset-4 transition">
        Tell us what you need →
      </a>
    </p>
  </div>
</section>

<!-- ===== WHY TRIBERA ===== -->
<section class="bg-[#f5f5f5] py-14 md:py-20">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10">
    <p class="text-[11px] tracking-[0.24em] font-semibold text-[#da0007] uppercase mb-3">
      Why Tribera
    </p>
    <h2
      class="text-[34px] sm:text-[44px] lg:text-[55px] font-[700] text-black leading-[1.08] tracking-[-0.02em] max-w-2xl"
    >
      Built for {title} — not bolted on
    </h2>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        whyTribera.map((w) => (
          <div
            class="group relative overflow-hidden rounded-[24px] border border-black/5 bg-white p-6
                   transition-all duration-300
                   hover:-translate-y-1 hover:shadow-[0_18px_48px_-24px_rgba(218,0,7,0.20)]"
          >
            <div class="absolute left-0 top-0 h-[3px] w-0 bg-[#da0007] transition-all duration-500 group-hover:w-full" />
            <div class="relative z-10">
              <h3 class="text-[21px] sm:text-[22px] font-semibold tracking-tight leading-tight text-black">{w.title}</h3>
              <p class="mt-2 text-black/60 text-[14px] leading-relaxed">{w.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-black py-16 md:py-20">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-10 px-4">
      <p class="text-[10px] sm:text-[11px]
    tracking-[0.3em]
    text-[#da0007]
    uppercase
    font-medium">
        TRIBERA VS COMPETITORS
      </p>

      <h2
        class="mt-4
    font-semibold
    text-white
    leading-tight
    text-[28px]
    sm:text-[36px]
    md:text-[44px]
    lg:text-[52px]"
      >
        Why tribera wins
      </h2>

      <p class="mt-2
    text-white/50
    text-[14px]
    sm:text-[15px]
    max-w-xl
    mx-auto">
        Not just software — a complete solution.
      </p>
    </div>

    <div
      class="table-mobile md:hidden rounded-[16px] border border-white/10 bg-gradient-to-b from-[#1b1b1b] to-[#0d0d0d] p-3 sm:p-4 space-y-2.5"
    >
      {
        [
          { feature: 'Domain advisor interviews', tribera: 'check', saas: '✗', rpo: 'Generalist only' },
          { feature: 'AI signal validation (100+)', tribera: 'check', saas: '✗', rpo: '✗' },
          { feature: '1:3 selection guarantee', tribera: 'check', saas: '✗', rpo: '✗' },
          { feature: '36-hour first shortlist', tribera: '36 hours', saas: 'You source it', rpo: '2–4 weeks' },
          { feature: 'Passive talent access', tribera: 'check', saas: '✗', rpo: 'Partial' },
          { feature: 'Explainable hiring decisions', tribera: 'check', saas: '✗', rpo: '✗' },
        ].map((row, i) => (
          <article class={`group anim-slide-left delay-${i + 1}`}>
            <div
              class="relative overflow-hidden rounded-xl border border-white/10 bg-black/40 p-4
                     before:pointer-events-none before:absolute before:inset-x-5 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-[#da0007]/45 before:to-transparent
                     after:pointer-events-none after:absolute after:inset-x-0 after:top-0 after:h-14 after:bg-gradient-to-b after:from-[#da0007]/[0.05] after:to-transparent
                     transition-all duration-500 active:scale-[0.985] hover:translate-y-1
                     hover:border-[#da0007]/30 hover:shadow-[0_0_40px_rgba(225,6,0,0.15)]"
            >
              <h3 class="text-[15px] font-semibold text-white leading-snug">{row.feature}</h3>

              <div class="mt-3 space-y-2.5 text-[14px]">
                <div class="flex items-center justify-between rounded-lg border border-[#da0007]/40 bg-[#da0007]/15 px-3.5 py-2.5 shadow-[0_0_18px_rgba(218,0,7,0.15)]">
                  <span class="font-semibold text-[#da0007] text-[12px]">tribera</span>
                  {row.tribera === 'check' ? (
                    <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-md bg-[#da0007]/20 px-1.5 font-bold text-[#da0007]">
                      ✓
                    </span>
                  ) : (
                    <span class="font-semibold text-[#da0007] text-[14px]">{row.tribera}</span>
                  )}
                </div>

                <div class="flex items-center justify-between rounded-lg border border-white/15 bg-white/[0.03] px-3.5 py-2.5">
                  <span class="text-white/90 text-[12px]">SaaS Tools</span>
                  <span class={`${row.saas === '✗' ? 'text-white/55' : 'text-white'} text-[13px] font-medium`}>
                    {row.saas}
                  </span>
                </div>

                <div class="flex items-center justify-between rounded-lg border border-white/15 bg-white/[0.03] px-3.5 py-2.5">
                  <span class="text-white/90 text-[12px]">Traditional RPO</span>
                  <span class={`${row.rpo === '✗' ? 'text-white/55' : 'text-white'} text-[13px] font-medium`}>
                    {row.rpo}
                  </span>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div
      class="table-desktop hidden md:block overflow-x-auto rounded-[16px] border border-white/10 bg-gradient-to-b from-[#1b1b1b] to-[#0d0d0d]
             transition-all duration-500 hover:translate-y-1 hover:border-[#da0007]/30 hover:shadow-[0_0_40px_rgba(225,6,0,0.15)]"
    >
      <div class="min-w-[640px]">
        <div
          class="grid grid-cols-[1.45fr_0.65fr_0.95fr_1fr] px-6 md:px-10 py-4
                  text-[12px] md:text-[13px]
                  text-white/80
                  border-b border-white/10
                  bg-white/[0.02]
                  text-center gap-0"
        >
          <div class="text-left font-semibold text-white">Feature</div>

          <div class="font-semibold text-[#da0007]">tribera</div>

          <div class="font-semibold">SaaS Tools</div>

          <div class="font-semibold">Traditional RPO</div>
        </div>

        <div class="divide-y divide-white/5 text-white/60">
          {
            [
              { feature: 'Domain advisor interviews', tribera: 'check', saas: '✗', rpo: 'Generalist only' },
              { feature: 'AI signal validation (100+)', tribera: 'check', saas: '✗', rpo: '✗' },
              { feature: '1:3 selection guarantee', tribera: 'check', saas: '✗', rpo: '✗' },
              { feature: '36-hour first shortlist', tribera: '36 hours', saas: 'You source it', rpo: '2–4 weeks' },
              { feature: 'Passive talent access', tribera: 'check', saas: '✗', rpo: 'Partial' },
              { feature: 'Explainable hiring decisions', tribera: 'check', saas: '✗', rpo: '✗' },
            ].map((row, i) => (
              <div
                class={`grid grid-cols-[1.45fr_0.65fr_0.95fr_1fr]
                      gap-0
                      px-6 py-4 md:px-10
                      items-center text-center
                      hover:bg-[#da0007]/5 transition
                      anim-slide-left delay-${i + 1}`}
              >
                <div class="text-left text-[13px] md:text-[14px] text-white/60">{row.feature}</div>

                <div class="flex justify-center">
                  {row.tribera === 'check' ? (
                    <span class="relative flex items-center justify-center w-6 h-6 group">
                      <span
                        class="absolute w-5 h-5 rounded-full
                           bg-[#da0007]/20
                           shadow-[0_0_12px_rgba(218,0,7,.6),0_0_6px_rgba(218,0,7,.8)]
                           animate-[signalPulse_3s_ease-in-out_infinite]
                           transition-all duration-300
                           group-hover:animate-none
                           group-hover:scale-[1.3]
                           group-hover:shadow-[0_0_20px_rgba(218,0,7,.9),0_0_10px_rgba(218,0,7,1)]"
                      />

                      <span class="relative text-[#da0007] bg-[#da0007]/15 px-4 md:px-10 py-1.5 rounded-md font-bold text-sm">
                        ✓
                      </span>
                    </span>
                  ) : (
                    <span
                      class={`px-8 md:px-6 py-1.5 rounded-md text-[12px] md:text-[13px] font-medium
                              ${
                                row.tribera === '36 hours' || row.tribera === 'Per hire'
                                  ? 'bg-[#da0007]/15 text-[#da0007]'
                                  : ''
                              }`}
                    >
                      {row.tribera}
                    </span>
                  )}
                </div>

                <div class={`${row.saas === '✗' ? 'text-white/30' : 'text-[13px] md:text-[14px] text-white/60'}`}>
                  {row.saas}
                </div>

                <div class={`${row.rpo === '✗' ? 'text-white/30' : 'text-[13px] md:text-[14px] text-white/60'}`}>
                  {row.rpo}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== FAQs ===== -->
{
  faqs.length > 0 && (
    <section class="bg-[#f5f5f5] py-14 md:py-20">
      <div class="max-w-3xl mx-auto px-5 sm:px-8 lg:px-10">
        <p class="text-[11px] tracking-[0.24em] font-semibold text-[#da0007] uppercase mb-3">
          FAQ
        </p>
        <h2 class="text-[34px] sm:text-[44px] lg:text-[55px] font-[700] text-black leading-[1.08] tracking-[-0.02em] mb-10">
          Common questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq, i) => (
            <div
              class="group rounded-[20px] border border-black/5 bg-white overflow-hidden
                     shadow-[0_4px_16px_rgba(0,0,0,0.04)]"
            >
              <button
                type="button"
                class="faq-toggle w-full flex items-start justify-between gap-4 px-6 py-5 text-left"
                aria-expanded="false"
                aria-controls={`faq-body-${i}`}
              >
                <span class="text-[14px] font-[600] text-black leading-snug">{faq.q}</span>
                <span
                  class="faq-icon shrink-0 mt-0.5 flex h-6 w-6 items-center justify-center rounded-full
                         bg-[#da0007]/10 text-[#da0007] transition-transform duration-300 text-[14px]"
                >
                  +
                </span>
              </button>
              <div
                id={`faq-body-${i}`}
                class="faq-body hidden px-6 pb-5 text-[13px] leading-relaxed text-black/55"
              >
                {faq.a}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- ===== CTA ===== -->
<section class="relative bg-black py-16 md:py-24 overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(218,0,7,0.13),transparent_58%)]"
  ></div>
  <div class="pointer-events-none absolute inset-0 bg-dotted-static opacity-50"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-5 sm:px-8 text-center">
    <h2
      class="font-[700] leading-[1.08] tracking-[-0.02em] text-white
             text-[34px] sm:text-[44px] lg:text-[55px]"
    >
      {ctaHeadline}
    </h2>

    <p class="mt-5 text-[15px] leading-relaxed text-white/45 max-w-xl mx-auto">
      {ctaSubtext}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <button
        type="button"
        data-form-intent="demo"
        data-form-source={`${formSource}_cta`}
        class="px-8 py-3.5 rounded-full tribera-primary-button text-[13px] font-semibold"
      >
        Book a Demo
      </button>
      <a
        href="/about"
        class="text-white/45 text-[13px] font-semibold transition hover:text-white
               underline underline-offset-4"
      >
        Learn about tribera →
      </a>
    </div>

    <p class="mt-8 text-[11px] text-white/25">
      No retainer · per-hire pricing · first shortlist in 36 hrs
    </p>
  </div>
</section>

<script>
  function initFaqs() {
    document.querySelectorAll('.faq-toggle').forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.faqBound === 'true') return;
      btn.dataset.faqBound = 'true';

      btn.addEventListener('click', () => {
        const bodyId = btn.getAttribute('aria-controls');
        if (!bodyId) return;
        const body = document.getElementById(bodyId);
        const icon = btn.querySelector('.faq-icon');
        const expanded = btn.getAttribute('aria-expanded') === 'true';

        btn.setAttribute('aria-expanded', String(!expanded));
        body?.classList.toggle('hidden', expanded);
        if (icon instanceof HTMLElement) {
          icon.textContent = expanded ? '+' : '−';
          icon.style.transform = expanded ? 'rotate(0deg)' : 'rotate(45deg)';
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initFaqs);
  document.addEventListener('DOMContentLoaded', initFaqs);
</script>
