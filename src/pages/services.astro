---
import Layout from '~/layouts/PageLayout.astro';
const metadata = {
  title: 'Services',
  description:
    'Tribera provides AI-powered hiring services that bring clarity, signal, and judgment into recruitment decisions.',
};
---

<Layout metadata={metadata}>
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-black">
    <div
      class="absolute inset-0"
      style="
      background:
        radial-gradient(1400px 700px at -15% 50%, rgba(115,0,0,0.75), transparent 65%),
        radial-gradient(1400px 700px at 115% 50%, rgba(115,0,0,0.75), transparent 65%),
        linear-gradient(to bottom, #140000 0%, #000000 60%);
      background-color: #000000;
    "
    >
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 text-center">
      <h1 class="font-[600] leading-[1.05]">
        <span class="block text-white text-[clamp(2rem,6vw,5rem)]"> Platform + people. </span>

        <span class="block text-[#ff0000] text-[clamp(2rem,6vw,5rem)]"> Intelligence + execution. </span>
      </h1>

      <p class="mt-8 text-white/50 text-[20px] max-w-3xl mx-auto leading-relaxed">
        AI analyzes 100+ signals per candidate. Senior advisors conduct interviews and validate every decision.
        Permanent, contract, C2H, executive, or full RPO—human-reviewed with a 1:3 guarantee*.
      </p>

      <div class="mt-12 flex flex-col sm:flex-row justify-center items-center gap-6">
        <a
          href="/"
          class="inline-flex items-center justify-center
      px-6 py-3
      rounded-full
      tribera-primary-button
      text-[12px] font-semibold
      tracking-[0.2px]"
        >
          See How It Works →
        </a>

        <a
          href="/contact"
          class="inline-flex items-center justify-center
      px-6 py-3
      rounded-full
      text-white
      text-[12px] font-semibold
      bg-[#121212]
      border border-white/10
      transition-all duration-300
      hover:-translate-y-[2px]
      hover:text-white
      hover:border-white/20"
        >
          Book a Demo
        </a>
      </div>

      <div class="mt-10 flex justify-center">
        <div
          class="inline-flex items-center gap-3
      px-6 py-3
      rounded-xl
      border border-[#da0007]/40
      bg-black/30
      text-white/70
      text-[14px]"
        >
          <span
            class="w-5 h-5
        flex items-center justify-center
        rounded-full
        border-2 border-[#da0007]
        text-[#da0007]
        text-[18px]"
          >
            ✓
          </span>
          <strong class="text-[#da0007] font-bold">1:3</strong>

          <span class="text-[12px] font-semibold text-white/50"> Selection Ratio* Guarantee </span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f3f3f3] py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-[11px] tracking-[0.35em] font-[600] text-[#da0007] uppercase">WHAT WE DELIVER</p>

        <h2 class="mt-6 text-5xl md:text-6xl font-[600] text-black leading-tight">Choose your engagement model</h2>

        <p class="mt-6 text-[15px] text-black/50 max-w-2xl mx-auto">
          Project-based hiring or full RPO. Same quality, same 1:3 guarantee*.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              title: 'Permanent Hiring (FTE)',
              desc: 'End-to-end hiring for full-time roles. Vetted candidates ready for your final approval.',
            },
            {
              title: 'Contract & Fixed-Term',
              desc: 'C2H, FXT, project-based roles. Full compliance, seamless conversions.',
            },
            {
              title: 'Executive Search',
              desc: 'C-suite, VP-level, technical leadership. Deep assessments for high-stakes hires.',
            },
            {
              title: 'TA Strategy Consulting',
              desc: 'Skill DNA analysis, TA roadmaps, hiring frameworks that scale with growth.',
            },
            {
              title: 'Full RPO',
              desc: 'Outsource your entire TA function. Strategy, process, execution across all roles.',
            },
          ].map((card) => (
            <div
              class="group relative bg-white rounded-xl border border-black/5 p-8
                 transition-all duration-500 ease-out
                 hover:-translate-y-1
                 hover:shadow-[0_15px_40px_rgba(218,0,7,0.25)]"
            >
              <div
                class="absolute left-0 top-0 h-full w-[3px] bg-[#da0007]
                      rounded-l-xl
                      transition-all duration-500
                      group-hover:w-[5px]"
              ></div>

              <h3
                class="text-[18px] font-[600] text-black
                     transition-colors duration-300
                     group-hover:text-[#da0007]"
              >
                {card.title}
              </h3>

              <p class="mt-4 text-[14px] text-black/50 leading-relaxed">{card.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-16">
        <div class="bg-black rounded-2xl py-6 px-8 text-center text-white/80 text-[14px] shadow-lg">
          All services powered by 100+ signal AI analysis, senior advisor interviews, culture scoring, and explainable
          decisions.
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f3f3f3] py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-20">
        <p class="text-[11px] tracking-[0.35em] font-[600] text-[#da0007] uppercase">PLATFORM CAPABILITIES</p>

        <h2 class="mt-6 text-5xl md:text-6xl font-[600] text-black leading-tight">
          100+ signals. Human validation. Decisions you can defend.
        </h2>

        <p class="mt-6 text-[15px] text-black/50 max-w-2xl mx-auto">
          The only platform giving TA leaders AI intelligence AND senior advisors.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          [
            {
              tag: '100+ SIGNALS',
              title: 'Contextual Intelligence',
              desc: 'Beyond resumes—100+ signals from GitHub, Stack Overflow, projects, verified experience.',
              items: [
                'Multi-platform activity analysis',
                'Project depth verification',
                'Risk flags & credibility checks',
                'Self-taught talent discovery',
              ],
            },
            {
              tag: 'HUMAN-IN-LOOP',
              title: 'Senior Advisor Interviews',
              desc: 'Not just AI. Senior advisors conduct 25–30 min technical interviews and validate every decision.',
              items: [
                'Advisor-led technical panels',
                'Human review of AI scoring',
                'Explainable decision records',
                'Bias mitigation built-in',
              ],
            },
            {
              tag: 'SMART MATCHING',
              title: 'Culture & Behavioral Scoring',
              desc: 'Match candidates to your org culture, team dynamics, behavioral requirements.',
              items: [
                'Organization culture mapping',
                'Team fit analysis',
                'Communication style matching',
                'Retention prediction',
              ],
            },
            {
              tag: 'DATA-DRIVEN',
              title: 'Predictive Analytics',
              desc: "Know who'll succeed before you make an offer. Forecast retention, identify flight risks.",
              items: [
                'Retention probability modeling',
                'Performance prediction scoring',
                'Flight risk indicators',
                'Funnel optimization',
              ],
            },
            {
              tag: 'EXPLAINABLE',
              title: 'Auditable Decisions',
              desc: 'Every hire comes with detailed decision records you can defend to leadership.',
              items: [
                'Decision audit trails',
                'Explainable AI documentation',
                'Bias detection reports',
                'Compliance ready',
              ],
            },
            {
              tag: 'SCALABLE',
              title: 'Institutional Memory',
              desc: 'Your hiring decisions become reusable knowledge. Each evaluation refines your intelligence.',
              items: [
                'Judgment library (reusable logic)',
                'Cross-team knowledge sharing',
                'Continuous refinement',
                'Network effects compound',
              ],
            },
          ].map((card) => (
            <div
              class="group relative bg-white rounded-xl border border-black/5 p-8 overflow-hidden
         transition-all duration-500 ease-out
         hover:-translate-y-1
         hover:shadow-[0_15px_40px_rgba(218,0,7,0.08)]"
            >
              <div
                class="absolute top-0 left-0 h-[3px] w-0 bg-[#da0007]
                      transition-all duration-500
                      group-hover:w-full"
              ></div>

              <span
                class="inline-block text-[10px] tracking-[0.2em]
                       bg-[#da0007]/10 text-[#da0007]
                       px-2 py-1 rounded-sm font-[700]"
              >
                {card.tag}
              </span>

              <h3 class="mt-4 text-[17px] font-[600] text-black">{card.title}</h3>

              <p class="mt-3 text-[13px] text-black/60 leading-relaxed">{card.desc}</p>

              <ul class="mt-6 space-y-4">
                {card.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="relative mt-[6px] w-2 h-2 rounded-full bg-[#da0007] dot-glow" />

                    <span class="text-[13px] text-black/70 leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-black py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-[11px] tracking-[0.35em] text-[#da0007] uppercase font-semibold">INDUSTRIES WE SERVE</p>

        <h2 class="mt-6 text-5xl font-[650] text-white leading-tight">Tech talent across the sectors that matter</h2>

        <p class="mt-6 text-[15px] text-white/50">Same platform, same rigor. Adapted to your industry's needs.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {
          [
            {
              title: 'GCC (Global Capability Centers)',
              desc: 'Scale tech teams for captive units. 0–500 engineers with consistent quality.',
            },
            {
              title: 'BFSI (Banking, Financial Services)',
              desc: 'Fintech platforms, payment systems, risk analytics. Security-first mindsets.',
            },
            {
              title: 'IT Services & Consulting',
              desc: 'Client-facing engineers, solution architects, delivery teams. Consultants who execute.',
            },
            {
              title: 'Product & SaaS',
              desc: 'B2B platforms, cloud infrastructure, API development. Builders who ship fast.',
            },
            {
              title: 'E-commerce & Retail Tech',
              desc: 'Marketplace platforms, inventory systems, logistics tech. High-scale engineering.',
            },
            {
              title: 'Manufacturing & Industrial',
              desc: 'IoT, automation, embedded systems. Hardware-software integration expertise.',
            },
          ].map((item) => (
            <div
              class="group relative rounded-xl border border-white/10 
                 bg-gradient-to-r from-[#111] to-[#0c0c0c]
                 p-8 transition-all duration-500 ease-out
                 hover:border-[#da0007]/40 hover:translate-y-1
                 hover:shadow-[0_0_40px_rgba(218,0,7,0.15)]"
            >
              <span
                class="absolute left-0 top-0 h-full w-[3px] 
                   bg-transparent
                   group-hover:bg-[#da0007]
                   transition-all duration-500"
              />

              <h3
                class="text-lg font-semibold text-white 
                   transition-colors duration-300
                   group-hover:text-[#da0007]"
              >
                {item.title}
              </h3>

              <p class="mt-4 text-[14px] text-white/60 leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="bg-white py-16 md:py-20"
    x-data="{
    active: 0,
    steps: [
      {
        number: '01',
        title: 'Signal Collection',
        subtitle: 'AI analyzes 100+ signals'
      },
      {
        number: '02',
        title: 'Advisor Evaluation',
        subtitle: 'Senior advisors interview'
      },
      {
        number: '03',
        title: 'Audited Decision',
        subtitle: 'Bias audit & compliance'
      }
    ]
  }"
  >
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-center text-[10px] tracking-[0.3em] text-[#da0007] font-semibold mb-4">HOW THE PLATFORM WORKS</p>

      <h2
        class="text-center font-[600] text-black
               text-[clamp(2rem,5vw,2.5rem)]
               leading-[1.05] tracking-tight"
      >
        AI precision meets human intelligence
      </h2>

      <p class="mt-3 text-center text-black/60 text-[14px] max-w-2xl mx-auto">
        Three stages. Senior advisors at every step. Decisions you can defend.
      </p>

      <div class="mt-10 grid lg:grid-cols-2 gap-16 items-start">
        <div class="space-y-4">
          <template x-for="(step, index) in steps" x-bind:key="index">
            <div
              x-on:mouseenter="active = index"
              x-bind:class="active === index
              ? 'border-black/10 shadow-[0_20px_40px_rgba(0,0,0,0.15)] -translate-y-2 bg-white'
              : 'border-black/5 bg-white'"
              class="rounded-2xl border p-8 transition-all duration-300 ease-out cursor-pointer"
            >
              <p class="text-[12px] font-semibold text-[#da0007] mb-2" x-text="step.number"></p>

              <h3
                x-bind:class="active === index ? 'text-[#da0007]' : 'text-black'"
                class="text-[18px] font-[600] leading-[1.2] transition-colors duration-300"
                x-text="step.title"
              >
              </h3>

              <p class="text-[14px] text-black/50 mt-2" x-text="step.subtitle"></p>
            </div>
          </template>
        </div>

        <div>
          <span
            class="inline-block text-[11px] font-semibold tracking-widest
                       px-4 py-1 rounded-md bg-[#da0007]/10 text-[#da0007] mb-6"
          >
            <span x-text="'STAGE 0' + (active + 1)"></span>
          </span>

          <h3
            class="text-[clamp(2rem,5vw,2.5rem)] font-[600] text-black leading-[1.1] mb-6"
            x-text="[
                'Signal Collection & Analysis',
                'Human Advisor Deep Interview',
                'Audited & Defensible Decision'
              ][active]"
          >
          </h3>

          <p
            class="text-[15px] text-black/60 leading-relaxed mb-8"
            x-text="[
               'AI aggregates 100+ signals from GitHub, Stack Overflow, portfolios, and communication patterns.',
               'Senior advisors conduct structured technical interviews and validate AI scoring.',
               'Every hiring decision includes explainable documentation, audit trails, and compliance records.'
             ][active]"
          >
          </p>

          <ul class="space-y-4 text-[15px] text-black/70 font-medium">
            <template
              x-for="point in [
              [
                'Multi-platform activity analysis',
                'Contextual skill mapping',
                'Preliminary match scoring',
                'Self-taught talent discovery'
              ],
              [
                'Advisor-led technical panels',
                'Human review of AI scoring',
                'Explainable evaluation notes',
                'Bias mitigation framework'
              ],
              [
                'Decision audit trails',
                'Explainable AI documentation',
                'Compliance-ready records',
                'Defensible hiring reports'
              ]
            ][active]"
              x-bind:key="point"
            >
              <li class="flex gap-3 items-start">
                <span class="text-[#da0007] font-bold mt-[2px]">•</span>
                <span x-text="point"></span>
              </li>
            </template>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-[11px] tracking-[0.35em] text-[#da0007] uppercase font-semibold">INSTITUTIONAL MEMORY</p>

        <h2 class="mt-6 text-5xl font-semibold text-white leading-tight">
          Your hiring intelligence compounds over time
        </h2>

        <p class="mt-6 text-[15px] text-white/50 max-w-3xl mx-auto">
          Each hire builds your organization's hiring knowledge. This is the advantage that scales.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        {
          [
            {
              title: 'Reusable Logic',
              desc: 'Decision patterns become templates. What worked for Software Engineer #1 accelerates Engineer #50. Your hiring criteria auto-refine.',
            },
            {
              title: 'Cross-Org Learning',
              desc: "Network effects across 500+ companies. When one org discovers a great signal, the platform learns for everyone. Your quality improves from others' hiring.",
            },
            {
              title: 'Continuous Refinement',
              desc: 'Platform learns YOUR preferences. Culture fit gets more precise. Signal weighting adapts to your team. Every hire trains tribera to be better for you.',
            },
          ].map((item) => (
            <div
              class="group relative rounded-xl border border-white/10 
                 bg-gradient-to-r from-[#111] to-[#0c0c0c]
                 p-8 transition-all duration-500 ease-out
                 hover:border-[#da0007]/40
                 hover:shadow-[0_0_60px_rgba(218,0,7,0.15)]"
            >
              <span
                class="absolute left-0 top-0 h-full w-[3px] 
                   bg-transparent 
                   group-hover:bg-[#da0007] 
                   transition-all duration-500"
              />

              <h3
                class="text-lg font-semibold text-white 
                   transition-colors duration-300
                   group-hover:text-[#da0007]"
              >
                {item.title}
              </h3>

              <p class="mt-4 text-[14px] text-white/60 leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex justify-center">
        <div
          class="max-w-3xl text-center rounded-xl border border-white/10
                  bg-gradient-to-r from-[#111] to-[#0c0c0c]
                  px-10 py-8 text-white/70 text-[15px] leading-relaxed"
        >
          This isn't just a service—it's hiring infrastructure that gets exponentially better. SaaS platforms don't
          learn. Traditional RPOs don't share knowledge. tribera does both.
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f3f3f3] py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-[11px] tracking-[0.35em] text-[#da0007] uppercase font-semibold">GET STARTED TODAY</p>

      <h2 class="mt-6 text-6xl font-semibold text-black leading-tight">Ready to hire smarter?</h2>

      <p class="mt-6 text-[16px] text-black/50 max-w-2xl mx-auto leading-relaxed">
        Join 500+ tech teams using tribera. 100+ signals. 1:3 selection guarantee*. Get tech talent 2x faster.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-5">
        <button
          type="button"
          data-open-demo
          class="px-8 py-4 rounded-full tribera-primary-button text-[14px] font-semibold
                shadow-[0_8px_25px_rgba(218,0,7,0.3)]"
        >
          See Platform Demo →
        </button>

        <a
          href="/contact"
          class="px-8 py-4 rounded-full border border-black/20
                text-black text-[14px] font-medium
               
                transition-all duration-300"
        >
          Book a Demo
        </a>
      </div>
    </div>
  </section>
</Layout>
