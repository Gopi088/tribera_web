  </head>
  <body>
    <SiteHeader />
    <EditorialPage as="main">
      <header class="hero hero--bare" id="top">
        <div class="wrap">
          <div class="hero__top">
            <div class="hero__copy">
              <p class="eyebrow eyebrow--red" data-rv style="color:var(--red)">Contact</p>
              <h1 class="h1" data-rv style="--d:60ms;margin-bottom:clamp(16px,2vw,24px);white-space:nowrap">
                Tell us what you’re<br /><em>stuck on</em>.
              </h1>
              <p class="hero__p" data-rv style="--d:110ms">
                Not a form that goes into a queue. A named person reads it, including the answer that we’re not the
                right people for it. <b>The response times are below, with the people who answer.</b>
              </p>
              <p class="hero__p" data-rv style="--d:150ms">
                If you’d rather just see how one role ran before you write anything, that’s on the homepage and nobody
                will chase you for it.
              </p>
              <div class="btns" data-rv style="--d:190ms">
                <a href="#write" class="btn btn--light">Write to us</a>
                <a href="/" class="btn btn--wire">See how one role ran</a>
              </div>
            </div>
            <div class="hero__card" data-rv style="--d:150ms">
              <p class="feat__k">Who actually replies</p>
              <div class="reply">
                <span class="feat__glint"></span>
                <div class="reply__r">
                  <span class="reply__ph" id="ph-abhishek" aria-hidden="true"></span>
                  <div>
                    <p class="reply__n">Abhishek Prasad</p>
                    <p class="reply__w">Hiring teams, pricing, security reviews</p>
                  </div>
                  <span class="reply__t">&lt;24<i>hrs</i></span>
                </div>
                <div class="reply__r">
                  <span class="reply__ph" id="ph-akshata" aria-hidden="true"></span>
                  <div>
                    <p class="reply__n">Akshata Chandavarkar</p>
                    <p class="reply__w">Candidates, live mandates, anything on the bar itself</p>
                  </div>
                  <span class="reply__t">&lt;48<i>hrs</i></span>
                </div>
                <p class="reply__ft">
                  Two people, both founders. <b
                    >No shared inbox, no ticket number, and no sequence of five emails if you don’t reply to the first
                    one.</b
                  >
                </p>
              </div>
            </div>
          </div>
        </div>
      </header>

      <section class="band band--w" id="write">
        <div class="wrap">
          <div
            class="shead"
            style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px;margin-bottom:0"
          >
            <div>
              <p class="eyebrow eyebrow--red" data-rv>One form, two directions</p>
              <h2 class="h2" data-rv style="--d:60ms;max-width:none">Which side of it are you on?</h2>
            </div>
            <p class="dek" data-rv style="--d:100ms;max-width:none">
              The questions change depending on your answer, because
              <b>what we need to know about a role is nothing like what we need to know about a person.</b>
            </p>
          </div>
          <div class="cform" data-rv style="--d:140ms">
            <div class="cform__sw" role="tablist" aria-label="Who you are">
              <button class="cswx on" data-m="hire" role="tab" aria-selected="true">I’m hiring</button>
              <button class="cswx" data-m="look" role="tab" aria-selected="false">I’m looking</button>
            </div>
            <form
              class="cform__f"
              action="/.netlify/functions/site-inquiry"
              method="post"
              enctype="multipart/form-data"
            >
              <input type="hidden" name="form_type" value="contact" />
              <input type="hidden" name="form_loaded_at" />
              <input type="hidden" name="interest" value="Hiring Talent" />
              <input type="text" name="botcheck" tabindex="-1" autocomplete="off" hidden aria-hidden="true" />
              <div class="cf__g">
                <label class="cf"
                  ><span class="cf__k">First name</span>
                  <input
                    type="text"
                    name="first_name"
                    required
                    maxlength="80"
                    autocomplete="given-name"
                    placeholder="First name"
                  /></label
                >
                <label class="cf"
                  ><span class="cf__k">Last name</span>
                  <input
                    type="text"
                    name="last_name"
                    required
                    maxlength="80"
                    autocomplete="family-name"
                    placeholder="Last name"
                  /></label
                >
                <label class="cf"
                  ><span class="cf__k">Email</span>
                  <input type="email" name="email" required placeholder="your@email.com" /></label
                >
                <label class="cf" data-only="hire"
                  ><span class="cf__k">Company</span>
                  <input type="text" name="company" placeholder="Where you work" /></label
                >
                <label class="cf" data-only="hire"
                  ><span class="cf__k">The role you’re stuck on</span>
                  <input type="text" name="role" placeholder="Title, level, location" /></label
                >
                <label class="cf" data-only="look"
                  ><span class="cf__k">What you do</span>
                  <input type="text" name="stack" placeholder="Backend, data, risk, product..." /></label
                >
                <label class="cf" data-only="look"
                  ><span class="cf__k">Years in it</span>
                  <input type="text" name="years" placeholder="e.g. 7" /></label
                >
                <label class="cf cf--wide"
                  ><span class="cf__k" id="cfMsgK">What’s gone wrong so far</span>
                  <textarea
                    name="message"
                    rows="4"
                    id="cfMsg"
                    required
                    maxlength="3500"
                    placeholder="How long it’s been open, what you’ve tried, and what a good outcome looks like."
                  ></textarea></label
                >
              </div>
              <div class="cf__ft">
                <p class="cf__note" id="cfNote">
                  <b>Abhishek reads this one.</b> Expect a reply inside a day, and if we’re not right for it, he’ll say so
                  and point you somewhere better.
                </p>
                <button class="btn btn--light cf__go" type="submit">Send it<span class="apply__ar">→</span></button>
              </div>
              <p id="contactStatus" role="status" aria-live="polite" hidden></p>
            </form>
          </div>
        </div>
      </section>

      <section class="wrap band" id="after">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-rv>After you press send</p>
            <h2 class="h2" data-rv style="--d:60ms;max-width:none">No black boxes here either.</h2>
          </div>
          <p class="dek" data-rv style="--d:100ms;max-width:none">
            The same rule we apply to candidates applies to anyone who writes to us. <b
              >You will hear back either way, and quickly enough to be useful.</b
            >
          </p>
        </div>
        <div class="paths2" data-rv style="--d:140ms">
          <div class="pth">
            <p class="pth__k">If you’re hiring</p>
            <div class="pth__l">
              <div class="pth__s">
                <span class="pth__d">Same day</span><p class="pth__t">A person reads it</p>
                <p class="pth__x">Abhishek, usually within a few hours of it landing.</p>
              </div>
              <div class="pth__s">
                <span class="pth__d">Within a day</span><p class="pth__t">A real reply</p>
                <p class="pth__x">Either a time to talk, or an honest no with a reason.</p>
              </div>
              <div class="pth__s">
                <span class="pth__d">45 minutes</span><p class="pth__t">Intake call</p>
                <p class="pth__x">We learn your yes: the role, the manager, the bar.</p>
              </div>
              <div class="pth__s pth__s--end">
                <span class="pth__d">After intake · 36 hours</span><p class="pth__t">Three names</p>
                <p class="pth__x">Scored against the bar we set with you, with the reasoning.</p>
              </div>
            </div>
          </div>
          <div class="pth">
            <p class="pth__k">If you’re looking</p>
            <div class="pth__l">
              <div class="pth__s">
                <span class="pth__d">Within two days</span><p class="pth__t">Someone reads it</p>
                <p class="pth__x">Akshata, or a senior expert in your area. Not a screener.</p>
              </div>
              <div class="pth__s">
                <span class="pth__d">Straight away</span><p class="pth__t">Anonymous</p>
                <p class="pth__x">Nothing is visible to any company until you release it.</p>
              </div>
              <div class="pth__s">
                <span class="pth__d">Within a week</span><p class="pth__t">Half an hour</p>
                <p class="pth__x">With someone who has run what you run. You keep the score.</p>
              </div>
              <div class="pth__s pth__s--end">
                <span class="pth__d">Or not</span><p class="pth__t">An honest no</p>
                <p class="pth__x">If we don’t run mandates in your area, we say so on day one.</p>
              </div>
            </div>
          </div>
        </div>
        <p class="nofee" data-rv style="--d:160ms">
          It costs nothing either way, and there is no fee for candidates at any point. Companies pay us when they hire; <em
            >nobody else ever does.</em
          >
        </p>
      </section>
      <section class="band band--w" id="offices">
        <div class="wrap">
          <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
            <div>
              <p class="eyebrow eyebrow--red" data-rv>Where we are</p>
              <h2 class="h2" data-rv style="--d:60ms;max-width:none">Two rooms, both real.</h2>
            </div>
            <p class="dek" data-rv style="--d:100ms;max-width:none">
              Eragina Digital Solutions Private Limited.
              <b>If you would rather come and sit down, that is usually the better version anyway.</b>
            </p>
          </div>
          <div class="offs" data-rv style="--d:140ms">
            <div class="off">
              <p class="off__k">Pune · head office</p>
              <p class="off__a">505, Zenith Complex<br />KM Gandhi Marg<br />Pune, Maharashtra 411005</p>
              <a class="off__m" href="mailto:hello@tribera.ai">hello@tribera.ai</a>
            </div>
            <div class="off">
              <p class="off__k">Bengaluru · regional</p>
              <p class="off__a">IndiQube TownHub<br />100 Feet Road<br />Bengaluru, Karnataka 560038</p>
              <a class="off__m" href="mailto:hello@tribera.ai">hello@tribera.ai</a>
            </div>
            <div class="off off--who">
              <p class="off__k">Anything else</p>
              <p class="off__a">Press, partnerships, or a question that doesn’t fit a form.</p>
              <a class="off__m" href="https://linkedin.com/company/triberaai">LinkedIn</a>
              <a class="off__m" href="mailto:hello@tribera.ai">hello@tribera.ai</a>
            </div>
          </div>
        </div>
      </section>

      <section class="trust band" id="questions">
        <div class="wrap">
          <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
            <div>
              <p class="eyebrow" data-rv>Before you write</p>
              <h2 class="h2" data-rv style="--d:60ms;max-width:none">Six things people ask first.</h2>
            </div>
            <p class="trust__dek" data-rv style="--d:100ms;max-width:none">
              Answered here so you don’t have to spend an email on them. <b
                >We explain the commercial shape before either side commits to a search.</b
              >
            </p>
          </div>
          <div class="qas" data-rv style="--d:140ms">
            <details class="qa2">
              <summary class="qa2__q">How fast do you actually reply?<i></i></summary><p class="qa2__a">
                Inside a day for hiring teams, two for candidates. The named person above reads the message and replies
                either way.
              </p>
            </details><details class="qa2">
              <summary class="qa2__q">What does it cost?<i></i></summary><p class="qa2__a">
                It depends on the role, the hiring shape and the support involved. We explain the commercial terms in
                our reply and confirm them in writing before a search starts.
              </p>
            </details><details class="qa2">
              <summary class="qa2__q">Is there ever a fee for candidates?<i></i></summary><p class="qa2__a">
                No. Not now, not when you’re placed, not ever.
              </p>
            </details><details class="qa2">
              <summary class="qa2__q">Do you work outside India?<i></i></summary><p class="qa2__a">
                Yes. We support GCCs and global teams hiring into India, plus India-based teams hiring internationally.
                Our people sit in Pune and Bengaluru.
              </p>
            </details><details class="qa2">
              <summary class="qa2__q">Can you handle remote and hybrid roles?<i></i></summary><p class="qa2__a">
                Yes. The bar is set differently for them: remote roles weight written communication and self-direction
                more heavily, and we’ll say so in the rubric.
              </p>
            </details><details class="qa2">
              <summary class="qa2__q">What should I put in the message?<i></i></summary><p class="qa2__a">
                The role, the level, how long it’s been open and what you have already tried. Four sentences is plenty.
                We would rather have the honest version than a polished brief.
              </p>
            </details>
          </div>
        </div>
      </section>

      <section class="wrap band close" id="contact">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-rv>Either way</p>
            <h2 class="h2" data-rv style="max-width:none">Someone will write back.</h2>
          </div>
          <p class="dek" data-rv style="--d:60ms;max-width:none">
            That is the whole promise of this page, and it is the one thing we would be most embarrassed to get wrong. <b
              >Silence isn’t a process.</b
            >
          </p>
        </div>
        <p class="bbb2" data-rv><span>Belong</span><i></i><span>Build</span><i></i><span>Become</span></p>
        <p class="bbb2__s" data-rv>Tribe + Era. A hire only works if both sides were right about each other.</p>
      </section>
    </EditorialPage>
    <SiteFooter />
    <script>
      import { initReferenceInteractions } from '~/scripts/reference';

      initReferenceInteractions();
      (function () {
        const sw = document.querySelector<HTMLElement>('.cform__sw');
        if (!sw) return;
        const note = document.getElementById('cfNote'),
          msg = document.querySelector<HTMLTextAreaElement>('#cfMsg'),
          msgK = document.getElementById('cfMsgK');
        const COPY = {
          hire: {
            note: "<b>Abhishek reads this one.</b> Expect a reply inside a day, and if we're not right for it, he'll say so and point you somewhere better.",
            k: 'What’s gone wrong so far',
            ph: 'How long it’s been open, what you’ve tried, and what a good outcome looks like.',
          },
          look: {
            note: '<b>Akshata reads this one.</b> Two days at the outside, and nothing you send is visible to any company until you say so.',
            k: "What you're after",
            ph: 'What you build, what you want next, and anywhere you would rather we did not send you.',
          },
        };
        function set(m) {
          if (!sw || (m !== 'hire' && m !== 'look')) return;
          const interest = document.querySelector<HTMLInputElement>('.cform__f input[name="interest"]');
          if (interest) interest.value = m === 'look' ? 'Getting Hired' : 'Hiring Talent';
          sw.querySelectorAll<HTMLElement>('.cswx').forEach(function (b) {
            const on = b.dataset.m === m;
            b.classList.toggle('on', on);
            b.setAttribute('aria-selected', String(on));
          });
          document.querySelectorAll<HTMLElement>('.cf[data-only]').forEach(function (f) {
            f.classList.toggle('hide', f.dataset.only !== m);
            f.querySelectorAll('input').forEach((input) => {
              input.disabled = f.dataset.only !== m;
            });
          });
          if (note) note.innerHTML = COPY[m].note;
          if (msgK) msgK.textContent = COPY[m].k;
          if (msg) msg.placeholder = COPY[m].ph;
        }
        sw.addEventListener('click', function (e) {
          const b = e.target instanceof Element ? e.target.closest<HTMLElement>('.cswx') : null;
          if (b) set(b.dataset.m);
        });
        set('hire');
      })();
      const contactForm = document.querySelector<HTMLFormElement>('.cform__f');
      const loadedAt = contactForm?.querySelector<HTMLInputElement>('[name="form_loaded_at"]');
      if (loadedAt) loadedAt.value = String(Date.now());
      contactForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        if (button.disabled) return;
        const status = document.getElementById('contactStatus')!;
        const payload = new FormData(contactForm);
        const context = ['role', 'stack', 'years']
          .filter((key) => payload.get(key))
          .map((key) => `${key}: ${payload.get(key)}`)
          .join('\n');
        payload.set('message', [context, payload.get('message')].filter(Boolean).join('\n\n'));
        const original = button.textContent;
        button.disabled = true;
        button.textContent = 'Sending...';
        status.hidden = true;
        try {
          const response = await fetch(contactForm.action, {
            method: 'POST',
            body: payload,
            headers: { Accept: 'application/json' },
          });
          const result = await response.json();
          if (!response.ok || !result.success) {
            status.textContent =
              response.status >= 400 && response.status < 500 && typeof result.message === 'string'
                ? result.message
                : 'We could not send your message. Please try again or email hello@tribera.ai.';
            return;
          }
          status.textContent = 'Your message has been sent. Our team will be in touch.';
          contactForm.reset();
          if (loadedAt) loadedAt.value = String(Date.now());
          document.querySelector<HTMLButtonElement>('.cswx[data-m="hire"]')?.click();
        } catch {
          status.textContent = 'We could not send your message. Please try again or email hello@tribera.ai.';
        } finally {
          status.hidden = false;
          button.disabled = false;
          button.textContent = original;
        }
      });
    </script>
    <ReferenceNavStyles />
    <ContactSalesModal />
    <StandalonePrefetchScripts />
  </body>
