---
import ContactSalesModal from '../components/ContactSalesModal.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Contact tribera — a named person reads it</title>
<meta name="description" content="Tell us what you’re stuck on. A named founder reads it and replies inside a day, including the honest no. Offices in Pune and Bengaluru.">
    <link rel="preload" href="/fonts/figtree-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-400.woff2" as="font" type="font/woff2" crossorigin />
<style>
:root{
  --char:#131313;--char2:#1C1C1B;--char3:#282826;--cline:#2E2E2C;
  --paper:#F2F2F0;--warm:#EFEDE8;--card:#FFF;
  --ink:#111110;--ink2:#3B3B39;--grey:#6B6B67;--faint:#9C9C97;--hair:#E3E3DF;
  --onc:#F3F3F0;--onc2:#9B9B95;--onc3:#6E6E68;
  --red:#DA0007;--grn:#3FBE7C;
  --display:"Figtree",-apple-system,sans-serif;--ui:"Inter Tight",-apple-system,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
  --ease:cubic-bezier(.16,1,.3,1);--wrap:1280px;--gut:clamp(20px,4.5vw,48px);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--ui);font-size:16px;
  line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit}:focus-visible{outline:2px solid var(--red);outline-offset:3px}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-inline:var(--gut)}
.band{padding-block:clamp(48px,6vw,80px)}
.band--w{background:var(--card)}
.band--w .panel{background:#F4F4F2;border:1px solid #E9E9E5;
  box-shadow:none}
.band--w .panel:hover{box-shadow:0 4px 18px rgba(0,0,0,.04)}
.band--w .swap__row{border-top-color:#E4E4E0}
.band--w .swap__row:hover{background:#EDEDEA}
.band--w .tag--ai{background:#D2D2C8;color:#3B3B35}
.band--w .plan{border-top-color:#E4E4E0}
.band--w .plans__ft{border-top-color:#E4E4E0}
.band--t{padding-block:clamp(40px,5vw,64px)}
.panel{background:var(--card);border-radius:16px;
  padding:clamp(18px,2vw,28px) clamp(18px,2vw,28px);
  box-shadow:0 1px 3px rgba(0,0,0,.04),0 8px 28px rgba(0,0,0,.045);
  transition:box-shadow .35s var(--ease)}
.panel:hover{box-shadow:0 8px 34px rgba(0,0,0,.075)}
.panel--pledge{border-top:3px solid var(--red);border-radius:4px 4px 18px 18px}
.shead{display:grid;gap:16px}
@media(min-width:900px){
  .shead{grid-template-columns:1.1fr .9fr;gap:clamp(36px,4.5vw,80px);align-items:end}
  .shead > :last-child{padding-bottom:6px}
}
.shead .dek,.shead .fn__dek,.shead .buy__dek,.shead .cand__lede{margin-top:0;max-width:44ch}
.panel .swap__row{border-top-color:#EDEDE9}
.panel .swap__row:first-of-type{border-top:0}
.panel .swap__row:hover{background:#F7F7F5}
.panel .swap__row--keep{border-top:2px solid var(--red)}

.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.22em;text-transform:uppercase;
  color:var(--faint);margin:0 0 24px}
.eyebrow--red{color:var(--red)}
.h1{font-family:var(--display);font-weight:800;font-size:clamp(38px,6.2vw,78px);
  line-height:.97;letter-spacing:-.045em;margin:0}
.h2{font-family:var(--display);font-weight:700;font-size:clamp(30px,4.2vw,54px);
  line-height:1.04;letter-spacing:-.04em;margin:0;max-width:16ch}
.h3{font-family:var(--display);font-weight:700;font-size:17px;
  line-height:1.14;letter-spacing:-.03em;margin:0}
.dek{font-size:clamp(16px,1.7vw,20px);line-height:1.6;color:var(--grey);max-width:56ch;margin:clamp(22px,2.2vw,28px) 0 0}
.dek b{color:var(--ink);font-weight:600}
[data-rv]{opacity:0;transform:translateY(18px);
  transition:opacity .9s var(--ease),transform .9s var(--ease);transition-delay:var(--d,0ms)}
[data-rv].in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}
  [data-rv],[data-rv].in{opacity:1;transform:none;transition:none}
  .sq{transition:none!important}}

.btn{display:inline-flex;align-items:center;gap:10px;font-size:15px;font-weight:600;
  text-decoration:none;padding:15px 26px;border-radius:999px;border:1px solid transparent;
  transition:transform .18s var(--ease),background .2s,border-color .2s,color .2s,box-shadow .25s;
  cursor:pointer;line-height:1}
.btn:hover{transform:translateY(-1px)}
.btn--solid,.btn--dark{box-shadow:0 2px 14px rgba(0,0,0,.14)}
.btn--dark:hover,.btn--solid:hover{box-shadow:0 8px 24px rgba(0,0,0,.2)}
.btn::after{content:"→";font-size:14px;opacity:0;width:0;margin-left:-10px;
  transition:opacity .22s var(--ease),width .22s var(--ease),margin .22s var(--ease)}
.btn:hover::after{opacity:1;width:13px;margin-left:0}
.btn--plain::after{display:none}
.btn--light{background:var(--onc);color:var(--char)}
.btn--dark{background:var(--ink);color:#fff}
.btn--ghost{border-color:#D2D2CD;color:var(--ink)}.btn--ghost:hover{border-color:var(--ink)}
.btn--wire{border-color:rgba(255,255,255,.3);color:#fff}.btn--wire:hover{border-color:#fff}
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}

.logo{font-family:var(--display);font-weight:800;font-size:20px;letter-spacing:-.055em;
  text-decoration:none;color:var(--onc)}
.logo i{color:var(--red);font-style:normal}

.nav__r a{font-size:14px;color:var(--onc2);text-decoration:none;transition:color .2s}
.nav__r a:hover{color:#fff}
@media(max-width:720px){
  .nav__in{gap:12px}
  .nav__r{gap:10px}
  .nav__r .btn{padding:9px 15px;font-size:13.5px}
  .nav__r .btn::after{display:none}
}

/* HERO */
.hero{background:var(--char);color:var(--onc);padding-block:clamp(44px,5.6vw,80px) 0;
  overflow-x:clip;overflow:hidden}
.hero .eyebrow{color:var(--onc3)}
.hero h1{color:#fff}.hero h1 em{font-style:normal;color:var(--red)}
.hero__top{display:grid;gap:clamp(26px,3vw,44px);align-content:center;min-height:1576px}@media(min-width:330px){.hero__top{min-height:1496px}}@media(min-width:340px){.hero__top{min-height:1476px}}@media(min-width:360px){.hero__top{min-height:1461px}}@media(min-width:375px){.hero__top{min-height:1401px}}@media(min-width:390px){.hero__top{min-height:1321px}}@media(min-width:400px){.hero__top{min-height:1301px}}@media(min-width:420px){.hero__top{min-height:1286px}}@media(min-width:440px){.hero__top{min-height:1266px}}@media(min-width:460px){.hero__top{min-height:1216px}}@media(min-width:500px){.hero__top{min-height:1176px}}@media(min-width:550px){.hero__top{min-height:1161px}}@media(min-width:700px){.hero__top{min-height:1121px}}@media(min-width:800px){.hero__top{min-height:1126px}}@media(min-width:900px){.hero__top{min-height:1104px}}@media(min-width:1000px){.hero__top{min-height:727px}}@media(min-width:1100px){.hero__top{min-height:741px}}@media(min-width:1200px){.hero__top{min-height:749px}}@media(min-width:1240px){.hero__top{min-height:759px}}
@media(max-width:999px){.hero{padding-top:42px}.hero__top{min-height:0;align-content:start}.hero__top>*{min-width:0}.hero__card{width:100%;max-width:100%}}
@media(max-width:699px){.hero__top{gap:32px}.hero__copy .btns{display:grid;grid-template-columns:1fr;gap:10px}.hero__copy .btns .btn{justify-content:center;min-height:48px;width:100%}}
@media(min-width:1000px){.hero__top{grid-template-columns:.9fr 1.1fr;align-items:center;
  gap:clamp(44px,5.5vw,92px);width:calc(100% + 48px);margin-inline:-24px}}

.hero__copy .btns{margin-top:26px}
.hero .eyebrow{margin-bottom:16px}
.hero h1{max-width:18ch;font-size:clamp(36px,4.6vw,62px)}
.hero h1 + .hero__p{margin-top:18px}
@media(min-width:1000px){.hero h1{max-width:none}}
.hero__p{font-size:clamp(15.5px,1.45vw,17.5px);line-height:1.6;color:var(--onc2);max-width:46ch;margin:0}
.hero__p + .hero__p{margin-top:14px}
.hero__p b{color:#fff;font-weight:600}

.hero__card{perspective:1600px;position:relative}
.hero__card::before{content:"";position:absolute;inset:-14% -8% -18%;pointer-events:none;
  background:radial-gradient(58% 52% at 62% 34%,rgba(218,0,7,.14),transparent 70%);
  filter:blur(28px);opacity:.55;transition:opacity .8s var(--ease),transform .8s var(--ease)}
.hero__card.is-flipped::before{opacity:.85;transform:translateX(-6%)}
.tilt{transform-style:preserve-3d;-webkit-transform-style:preserve-3d;
  transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));
  transition:transform .5s var(--ease);will-change:transform}
.tilt.live{transition:transform .12s linear}
.ftabs{display:inline-flex;gap:2px;padding:3px;border-radius:999px;
  background:rgba(255,255,255,.06);border:1px solid var(--cline);margin-bottom:16px}
.ftab{font-family:var(--ui);font-size:12.5px;font-weight:600;padding:7px 15px;border:0;
  border-radius:999px;background:transparent;color:var(--onc2);cursor:pointer;
  transition:background .25s var(--ease),color .25s var(--ease)}
.ftab.is{background:var(--onc);color:var(--char)}
.ftab:not(.is):hover{color:#fff}
.ftab:focus-visible{outline:2px solid var(--red);outline-offset:2px}

.flip{position:relative;transform-style:preserve-3d;-webkit-transform-style:preserve-3d;
  transition:transform .9s cubic-bezier(.22,.85,.24,1);cursor:pointer}
.flip.is-b{transform:rotateY(180deg)}
.face{position:relative;border-radius:20px;overflow:hidden;
  background:linear-gradient(158deg,#232320 0%,#1A1A18 42%,#141413 100%);
  border:1px solid #33332E;
  box-shadow:0 1px 0 rgba(255,255,255,.06) inset,
             0 -1px 0 rgba(0,0,0,.5) inset,
             0 30px 70px rgba(0,0,0,.5),
             0 4px 14px rgba(0,0,0,.35);
  backface-visibility:hidden;-webkit-backface-visibility:hidden}
.face::after{content:"";position:absolute;inset:0;pointer-events:none;z-index:4;
  background:radial-gradient(420px circle at var(--mx,70%) var(--my,0%),
    rgba(255,255,255,.09),rgba(255,255,255,.03) 32%,transparent 58%);
  opacity:0;transition:opacity .45s var(--ease)}
.hero__card:hover .face::after{opacity:1}
.face__glint{position:absolute;top:0;left:8%;right:8%;height:1px;z-index:5;pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent)}
.face--b{position:absolute;inset:0;transform:rotateY(180deg)}
.face__hd{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 20px;
  border-bottom:1px solid var(--cline);font-family:var(--mono);font-size:10.5px;
  letter-spacing:.16em;text-transform:uppercase;color:var(--onc3)}
.face--b .face__hd{color:var(--red)}
.side{padding:clamp(17px,1.9vw,24px)}
.side__hd{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:15px}
.side__nm{font-family:var(--display);font-weight:700;font-size:20px;letter-spacing:-.028em;margin:0;color:#fff}
.side__sub{font-size:12.5px;color:var(--onc3);margin:5px 0 0}
.side__sub b{color:var(--grn);font-weight:600}
.rank{font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:var(--red)}
.vrd{margin:16px 0 6px;padding:13px 15px;border-radius:10px;
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.018));
  border:1px solid rgba(255,255,255,.09)}
.vrd__k{font-family:var(--mono);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--onc3);margin:0 0 8px}
.vrd__t{font-family:var(--display);font-weight:700;font-size:clamp(15.5px,1.45vw,18px);
  line-height:1.3;letter-spacing:-.022em;color:#fff;margin:0}
.scr{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex:none;min-width:112px}
.scr__n{display:flex;align-items:baseline;gap:3px}
.scr b{font-family:var(--mono);font-weight:700;font-size:28px;letter-spacing:-.045em;color:#fff;line-height:1}
.scr i{font-family:var(--mono);font-style:normal;font-size:11px;color:var(--onc3)}
.scale{position:relative;display:block;width:100%;height:4px;border-radius:2px;
  background:rgba(255,255,255,.1);margin-top:3px;overflow:visible}
.scale__sel{position:absolute;left:68%;right:0;top:0;bottom:0;border-radius:0 2px 2px 0;
  background:rgba(63,190,124,.4)}
.scale__pin{position:absolute;left:84%;top:-3px;width:2px;height:10px;border-radius:1px;
  background:var(--grn);box-shadow:0 0 8px rgba(63,190,124,.8)}
.scale__k{font-family:var(--mono);font-size:8.5px;letter-spacing:.08em;color:var(--onc3)}
.tiles{display:grid;grid-template-columns:repeat(6,1fr);gap:5px;margin-top:16px}
.tl{position:relative;display:flex;align-items:baseline;justify-content:space-between;
  padding:7px 8px 6px;border-radius:7px;cursor:default;
  background:rgba(255,255,255,calc(.028 + var(--s) * .036));
  border:1px solid rgba(255,255,255,calc(.05 + var(--s) * .022));
  transition:background .25s var(--ease),border-color .25s var(--ease),transform .2s var(--ease)}
.tl:hover,.tl:focus-visible{transform:translateY(-2px);border-color:rgba(255,255,255,.4);outline:none}
.tl i{font-family:var(--mono);font-style:normal;font-size:9px;letter-spacing:.06em;color:var(--onc3)}
.tl b{font-family:var(--mono);font-weight:700;font-size:14px;color:#fff;line-height:1}
.tl--low b{color:#E8A33D}
.tl--low{border-color:rgba(232,163,61,.3)}
.tiles__cap{font-size:11.5px;line-height:1.4;color:var(--onc3);margin:9px 0 0;min-height:16px;
  transition:color .2s}
.tiles__cap.is{color:var(--onc2)}
.rub{display:grid;gap:0;margin-top:14px;border-top:1px solid var(--cline)}
.rub__r{display:grid;grid-template-columns:14px 1fr auto;gap:10px;align-items:baseline;
  padding:5.5px 0;border-bottom:1px solid rgba(255,255,255,.045)}
.rub__k{font-family:var(--mono);font-size:9.5px;color:var(--red)}
.rub__n{font-size:12.5px;color:var(--onc2)}
.rub__p{font-family:var(--mono);font-size:11.5px;color:#fff}
.notes{margin-top:13px;border-top:1px solid var(--cline);padding-top:12px;display:grid;gap:9px}
.note{display:grid;grid-template-columns:58px 1fr;gap:12px;align-items:baseline}
.note__k{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--onc3)}
.note--warn .note__k{color:#E8A33D}
.note__v{font-size:12.5px;line-height:1.45;color:var(--onc2);margin:0}
.note--warn .note__v{color:#DAD4C7}
.pill{font-family:var(--mono);font-size:10.5px;font-weight:700;letter-spacing:.16em;
  padding:8px 13px;border-radius:8px;color:var(--grn);white-space:nowrap;
  background:linear-gradient(180deg,rgba(63,190,124,.2),rgba(63,190,124,.08));
  border:1px solid rgba(63,190,124,.42);
  box-shadow:0 0 22px rgba(63,190,124,.18),0 1px 0 rgba(255,255,255,.08) inset}
.sig{border-top:1px solid var(--cline)}
.sig__r{position:relative;padding:8.5px 0;cursor:default;transition:padding-left .3s var(--ease)}
.sig__r::before{content:"";position:absolute;left:0;top:14px;width:2px;height:0;
  background:var(--red);border-radius:2px;transition:height .3s var(--ease)}
.sig__r:hover,.sig__r:focus-within{padding-left:12px}
.sig__r:hover::before,.sig__r:focus-within::before{height:14px}
.sig__t{display:flex;justify-content:space-between;align-items:baseline;gap:14px}
.sig__l{font-size:13.5px;color:var(--onc2)}
.sig__v{font-family:var(--mono);font-size:13.5px;font-weight:500;color:#fff;white-space:nowrap;
  display:inline-flex;align-items:center;gap:9px}
.mtr{display:inline-grid;grid-template-columns:repeat(4,7px);gap:3px}
.mtr i{height:7px;border-radius:2px;background:rgba(255,255,255,.13)}
.mtr i.on{background:var(--grn);box-shadow:0 0 8px rgba(63,190,124,.5)}
.sig__w{display:grid;grid-template-rows:0fr;transition:grid-template-rows .42s var(--ease),opacity .32s var(--ease);opacity:0}
.sig__w>span{overflow:hidden;display:block;font-size:12.5px;line-height:1.5;color:var(--onc3)}
.sig__r:hover .sig__w,.sig__r:focus-within .sig__w{grid-template-rows:1fr;opacity:1}
.sig__r:hover .sig__w>span{padding-top:7px}
.face__ft{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;
  padding:11px 20px;border-top:1px solid var(--cline);background:rgba(0,0,0,.24);
  font-size:12px;color:var(--onc3)}
.lg{display:flex;gap:14px;font-family:var(--mono);font-size:10px;letter-spacing:.12em}
.lg i{font-style:normal;display:inline-flex;align-items:center;gap:5px}
.lg i::before{content:"";width:7px;height:7px;border-radius:2px;background:currentColor}
.lg--g{color:var(--grn)}.lg--y{color:#9B9B95}.lg--r{color:#DA0007}
@media(prefers-reduced-motion:reduce){
  .flip{transition:none}
  .face--b{transition:none}
}

.logos{border-top:1px solid var(--cline);padding-block:20px;margin-top:clamp(28px,3.4vw,46px)}
.logos{display:grid;gap:14px;align-items:baseline}
@media(min-width:820px){.logos{grid-template-columns:150px 1fr;gap:0 30px}}
.logos__l{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--onc3);margin:0}
.logos__vp{overflow:hidden;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
.logos__tk{display:flex;align-items:center;gap:34px;width:max-content;
  animation:logoscroll 78s linear infinite}
.logos__vp:hover .logos__tk,.logos__vp:focus-within .logos__tk{animation-play-state:paused}
@keyframes logoscroll{to{transform:translateX(calc(-50% - 17px))}}
.logos__dup{display:contents}
.logos__tk span{font-family:var(--display);font-weight:600;font-size:14.5px;color:#5C5C57;
  white-space:nowrap;transition:color .25s var(--ease);cursor:default}
.logos__tk span:hover{color:#B4B4AD}
@media(prefers-reduced-motion:reduce){
  .logos__vp{overflow-x:auto;-webkit-mask-image:none;mask-image:none}
  .logos__tk{animation:none}
}

.tag{font-family:var(--mono);font-size:9.5px;font-weight:500;letter-spacing:.14em;
  text-transform:uppercase;padding:5px 9px;border-radius:5px;white-space:nowrap;
  display:inline-block;border:1px solid transparent}
.tag--ai{background:#CFCFC5;color:#3B3B35}
.tag--adv{background:var(--ink);color:#fff}
.tag--you{background:transparent;color:var(--red);border-color:rgba(218,0,7,.45)}
.key{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;margin:0 0 2px;
  padding-bottom:14px;border-bottom:1px solid #EAEAE6}
.key__i{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--grey)}

.swap__lead{font-family:var(--display);font-weight:700;font-size:clamp(21px,2.7vw,34px);
  line-height:1.2;letter-spacing:-.034em;margin:0 0 clamp(20px,2.4vw,30px);max-width:24ch;
  color:var(--ink)}
.swap__lead em{font-style:normal;color:var(--red)}

.swap{margin-top:18px}
.swap__hd{display:none}
@media(min-width:900px){.swap__hd{display:grid;grid-template-columns:124px 1fr 1fr;gap:30px;padding-top:14px}
  .swap__hd span{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--faint)}
  .swap__hd span:last-child{padding-left:22px}}
.swap__row{display:grid;gap:7px 30px;padding:clamp(12px,1.4vw,16px) 0;
  border-top:1px solid var(--hair);align-items:baseline;
  transition:background .22s var(--ease)}
@media(min-width:900px){.swap__row{grid-template-columns:124px 1fr 1fr;align-items:baseline}}
.swap__row:hover{background:rgba(0,0,0,.028)}
@media(min-width:900px){.swap__row{margin-inline:-14px;padding-inline:14px;border-radius:8px}}
.swap__row:hover .swap__b{color:var(--ink)}
