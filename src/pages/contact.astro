---
import Layout from '~/layouts/PageLayout.astro';
import Brands from '~/components/widgets/Brands.astro';
const metadata = {
  title: 'Contact Us',
  description: 'Get in touch with Tribera to learn how our AI-powered hiring platform can help your team hire better.',
};
---

<Layout metadata={metadata}>
  <main>
    <section class="relative min-h-[90vh] md:min-h-screen flex items-center justify-center overflow-hidden bg-black">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-black"></div>

        <div
          class="absolute left-[-30%] md:left-[-15%] top-0 h-full w-[90%] md:w-[60%] bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.45),transparent_60%)]"
        >
        </div>

        <div
          class="absolute right-[-30%] md:right-[-15%] top-0 h-full w-[90%] md:w-[60%] bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.45),transparent_60%)]"
        >
        </div>
      </div>

      <div class="absolute inset-0 pointer-events-none">
        {
          Array.from({ length: 24 }).map((_, i) => (
            <span
              class="absolute rounded-full bg-[#da0007]/80"
              style={`
          width:${i % 4 === 0 ? 4 : 4}px;
          height:${i % 4 === 0 ? 4 : 4}px;
          left:${12 + Math.random() * 76}%;
          top:${8 + Math.random() * 84}%;
          --float-x1:${(Math.random() * 44 - 22).toFixed(1)}px;
          --float-y1:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x2:${(Math.random() * 52 - 26).toFixed(1)}px;
          --float-y2:${(Math.random() * 42 - 21).toFixed(1)}px;
          --float-x3:${(Math.random() * 60 - 30).toFixed(1)}px;
          --float-y3:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-y4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-x5:${(Math.random() * 56 - 28).toFixed(1)}px;
          --float-y5:${(Math.random() * 40 - 20).toFixed(1)}px;
          --float-x6:${(Math.random() * 50 - 25).toFixed(1)}px;
          --float-y6:${(Math.random() * 34 - 17).toFixed(1)}px;
          --float-scale1:${(1 + Math.random() * 0.28).toFixed(2)};
          --float-scale2:${(0.78 + Math.random() * 0.18).toFixed(2)};
          --float-scale3:${(1.02 + Math.random() * 0.22).toFixed(2)};
          --float-scale4:${(0.82 + Math.random() * 0.14).toFixed(2)};
          --float-scale5:${(1 + Math.random() * 0.2).toFixed(2)};
          --float-scale6:${(0.86 + Math.random() * 0.14).toFixed(2)};
          animation: float ${11 + Math.random() * 14}s ease-in-out infinite;
          animation-delay: -${(Math.random() * 18).toFixed(1)}s;
          box-shadow: 0 0 12px rgba(218,0,7,.6);
        `}
            />
          ))
        }
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center group">
        <h1
          class="font-semibold tracking-tight leading-tight text-white
               text-3xl sm:text-4xl md:text-5xl lg:text-6xl"
        >
          Let's talk about your<span class="sm:hidden"> </span><br class="hidden sm:block" />
          hiring
        </h1>

        <p class="mt-8 text-white/70 text-base sm:text-[20px] max-w-2xl mx-auto leading-relaxed">
          36 hours to first shortlist. Interview 3, hire 1. Our 1:3 guarantee*.
        </p>
      </div>
    </section>

    <section class="w-full px-6 md:px-8 py-8 md:py-10 gap-10 relative">
      <div class="pointer-events-none absolute inset-0 bg-dotted-static opacity-80"></div>

      <Brands
        title="Who We Work With"
        subtitle="Trusted by high-impact <br /> teams across industries"
        mobileSubtitleSingleLine={true}
        images={[
          { src: '~/assets/images/ICICBank.png', alt: 'ICICI Bank' },
          { src: '~/assets/images/Aeries.png', alt: 'Aeries' },
          { src: '~/assets/images/DSP_Mutual_Funds.png', alt: 'DSP Mutual Fund' },
          { src: '~/assets/images/Enpro.png', alt: 'Enpro' },
          { src: '~/assets/images/Volkwagen.png', alt: 'Volkswagen' },
          { src: '~/assets/images/UtkarshBank.png', alt: 'Utkarsh Bank' },
          { src: '~/assets/images/TechnologyHoldings.png', alt: 'TechnologyHoldings' },
          { src: '~/assets/images/Payu.png', alt: 'PayU' },
          { src: '~/assets/images/ICICISecurities.png', alt: 'ICICISecurities' },
          { src: '~/assets/images/SplashBI.png', alt: 'SplashBI' },
          { src: '~/assets/images/AegonLife.png', alt: 'AegonLife' },
        ]}
      />
    </section>

    <section class="bg-black text-white py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-10">
          <p class="text-[#da0007] text-[15px] font-semibold mb-2">The numbers</p>

          <h2 class="text-4xl sm:text-4xl font-semibold tracking-tight">Why companies choose tribera</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-5">
          {
            [
              {
                value: '36hrs',
                title: 'Average delivery',
                desc1: 'From brief to shortlist',
                desc2: 'Industry avg: 2 weeks',
              },
              {
                value: '3:1',
                title: 'Interview ratio',
                desc1: 'Interview 3, hire 1',
                desc2: 'Industry avg: 8:1',
              },
              {
                value: '<24hrs',
                title: 'Response time',
                desc1: 'Real humans, not bots',
                desc2: 'Personal replies guaranteed',
              },
            ].map((item, i) => (
              <div
                data-index={i}
                class="group relative rounded-xl p-6
                 bg-[#0b0b0b] border border-white/10
                 transition-all duration-500 ease-out
                 hover:border-[#da0007]/40"
              >
                <div
                  class="absolute inset-0 -z-10 opacity-0
                      bg-[#da0007] blur-[80px] rounded-2xl
                      transition-opacity duration-500
                      group-hover:opacity-20"
                />

                <h3 class="text-3xl flex justify-center font-semibold text-[#da0007] mb-2">{item.value}</h3>

                <p class="text-[15px] flex justify-center font-semibold mb-2">{item.title}</p>

                <p class="text-[13px] flex justify-center text-white/60">{item.desc1}</p>

                <p class="text-[11px] flex justify-center text-white/40 mt-2">{item.desc2}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-white py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-7">
          <p class="text-[#da0007] text-[15px] font-semibold mb-2">Choose your path</p>

          <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-black">How would you like to connect?</h2>

          <p class="mt-2 text-[15px] text-black/60">For hiring teams or candidates—pick what works best.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          {
            [
              {
                label: 'FOR HIRING TEAMS',
                title: 'Book a Demo',
                desc: '30-minute platform walkthrough',
                email: 'sales@tribera.ai',
                footerTitle: 'Abhishek responds <24hrs',
                footerSub: 'Shipped products at Micro Focus',
              },
              {
                label: 'FOR CANDIDATES',
                title: 'Submit Your Profile',
                desc: "Send resume, we'll match you with roles",
                email: 'careers@tribera.ai',
                footerTitle: 'Team reviews in 48hrs',
                footerSub: 'Only relevant roles',
              },
            ].map((item, i) => (
              <div data-index={i}>
                <p
                  class="inline-block text-[12px] tracking-[0.1em] font-semibold text-[#da0007]
          pb-2 mb-5 border-b border-black/20"
                >
                  {item.label}
                </p>

                <div
                  class="group relative rounded-xl p-5 overflow-hidden
                      bg-white border border-black/10
                      transition-all duration-500 ease-out
                      hover:shadow-xl hover:-translate-y-1"
                >
                  <div
                    class="absolute top-0 left-0 h-[2px] w-0
                        bg-[#da0007] rounded-t-2xl
                        transition-all duration-500
                        group-hover:w-full"
                  />

                  <h3 class="text-[20px] group-hover:text-[#da0007] transition duration-300 font-bold text-black mb-2">
                    {item.title}
                  </h3>

                  <p class="text-[15px] font-[600] text-black/60 mb-3">{item.desc}</p>

                  <p class="text-[11px] font-[500] text-black/40 tracking-wide ">EMAIL</p>

                  <a
                    href={`mailto:${item.email}`}
                    class="text-[13px] font-medium text-black mb-3 inline-block
         transition-colors duration-300
         hover:text-[#da0007]"
                  >
                    {item.email}
                  </a>

                  <div class="h-px bg-black/10 mb-6" />

                  <div class="flex items-start gap-3">
                    <div
                      class="w-8 h-8 rounded-full bg-[#da0007]/10
              flex items-center justify-center"
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#da0007"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M16 11a4 4 0 1 0-8 0" />
                        <path d="M12 15c-4 0-7 2-7 4h14c0-2-3-4-7-4z" />
                      </svg>
                    </div>

                    <div>
                      <p class="text-[15px] font-semibold text-black">{item.footerTitle}</p>
                      <p class="text-[13px] text-black/50">{item.footerSub}</p>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-black py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-10">
          <p class="text-[#da0007] text-[14px] font-semibold mb-2">What happens next</p>

          <h2 class="text-4xl font-semibold tracking-tight text-white">Here's the timeline</h2>

          <p class="mt-2 text-[15px] text-white/60">Clear expectations from first contact to hire.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-10">
          <div>
            <p class="text-[12px] tracking-[0.1em] font-[600] flex justify-center text-white/40 mb-8">
              FOR HIRING TEAMS
            </p>

            <div class="relative pl-16">
              <div class="absolute left-[22px] top-6 bottom-6 w-px bg-[#da0007]/40"></div>

              <div class="space-y-6">
                <div class="relative">
                  <div
                    class="absolute left-0 top-1 w-[44px] h-[44px]
                          rounded-full bg-[#da0007]/10
                          border-2 border-[#da0007]
                          flex items-center justify-center
                          text-[#da0007] font-semibold
                          hover:shadow-[0_6px_16px_rgba(218,0,7,0.25)]"
                  >
                    1
                  </div>

                  <div class="ml-16">
                    <p class="text-[11px] text-white/40 mb-1 font-[600] tracking-wide">TODAY</p>
                    <h3 class="font-bold text-[15px] text-white mb-1">You reach out</h3>
                    <p class="text-[12px] font-[600] text-white/60">Send email to sales@tribera.ai</p>
                  </div>
                </div>

                <div class="relative">
                  <div
                    class="absolute left-0 top-1 w-[44px] h-[44px]
                          rounded-full bg-[#da0007]/10 border-2 border-[#da0007]
                          flex items-center justify-center text-[#da0007]
                          font-semibold hover:shadow-[0_6px_16px_rgba(218,0,7,0.25)]"
                  >
                    2
                  </div>
                  <div class="ml-16">
                    <p class="text-[11px] text-white/40 mb-1 font-[600] tracking-wide">24 HOURS</p>
                    <h3 class="font-bold text-[15px] text-white mb-1">Abhishek responds</h3>
                    <p class="text-[12px] font-[600] text-white/60">Personal reply, not automated</p>
                  </div>
                </div>

                <div class="relative">
                  <div
                    class="absolute left-0 top-1 w-[44px] h-[44px]
                          rounded-full bg-[#da0007]/10 border-2 border-[#da0007]
                          flex items-center justify-center text-[#da0007]
                          font-semibold hover:shadow-[0_6px_16px_rgba(218,0,7,0.25)]"
                  >
                    3
                  </div>
                  <div class="ml-16">
                    <p class="text-[11px] text-white/40 mb-1 font-[600] tracking-wide">THIS WEEK</p>
                    <h3 class="font-bold text-[15px] text-white mb-1">Demo call (30min)</h3>
                    <p class="text-[12px] font-[600] text-white/60">See the platform in action</p>
                  </div>
                </div>

                <div class="relative">
                  <div
                    class="absolute left-0 top-1 w-[44px] h-[44px]
                          rounded-full bg-[#da0007]/10 border-2 border-[#da0007]
                          flex items-center justify-center text-[#da0007]
                          font-semibold hover:shadow-[0_6px_16px_rgba(218,0,7,0.25)]"
                  >
                    4
                  </div>
                  <div class="ml-16">
                    <p class="text-[11px] text-white/40 mb-1 font-[600] tracking-wide">36 HOURS</p>
                    <h3 class="font-bold text-[15px] text-white mb-1">First shortlist</h3>
                    <p class="text-[12px] font-[600] text-white/60">Vetted candidates ready</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div>
            <p class="text-[12px] flex justify-center font-[600] tracking-[0.1em] text-white/40 mb-8">FOR CANDIDATES</p>

            <div class="relative pl-16">
              <div class="absolute left-[22px] top-6 bottom-6 w-px bg-[#da0007]/40"></div>

              <div class="space-y-6">
                <div class="relative">
                  <div
                    class="absolute left-0 top-1 w-[44px] h-[44px]
                          rounded-full bg-[#da0007]/10 border-2 border-[#da0007]
                          flex items-center justify-center text-[#da0007]
                          font-semibold hover:shadow-[0_6px_16px_rgba(218,0,7,0.25)]"
                  >
                    1
                  </div>
                  <div class="ml-16">
                    <p class="text-[11px] text-white/40 font-[600] mb-1 tracking-wide">TODAY</p>
                    <h3 class="font-bold text-[15px] text-white mb-1">Submit profile</h3>
                    <p class="text-[12px] font-[600] text-white/60">Email careers@tribera.ai</p>
                  </div>
                </div>

                <div class="relative">
                  <div
                    class="absolute left-0 top-1 w-[44px] h-[44px]
                          rounded-full bg-[#da0007]/10 border-2 border-[#da0007]
                          flex items-center justify-center text-[#da0007]
                          font-semibold hover:shadow-[0_6px_16px_rgba(218,0,7,0.25)]"
                  >
                    2
                  </div>
                  <div class="ml-16">
                    <p class="text-[11px] text-white/40 mb-1 font-[600] tracking-wide">48 HOURS</p>
                    <h3 class="font-bold text-[15px] text-white mb-1">Team reviews</h3>
                    <p class="text-[12px] font-[600] text-white/60">Senior advisors assess fit</p>
                  </div>
                </div>

                <div class="relative">
                  <div
                    class="absolute left-0 top-1 w-[44px] h-[44px]
                          rounded-full bg-[#da0007]/10 border-2 border-[#da0007]
                          flex items-center justify-center text-[#da0007]
                          font-semibold hover:shadow-[0_6px_16px_rgba(218,0,7,0.25)]"
                  >
                    3
                  </div>
                  <div class="ml-16">
                    <p class="text-[11px] text-white/40 mb-1 font-[600] tracking-wide">1 WEEK</p>
                    <h3 class="font-bold text-[15px] text-white mb-1">Matched to roles</h3>
                    <p class="text-[12px] font-[600] text-white/60">Only relevant opportunities</p>
                  </div>
                </div>

                <div class="relative">
                  <div
                    class="absolute left-0 top-1 w-[44px] h-[44px]
                          rounded-full bg-[#da0007]/10 border-2 border-[#da0007]
                          flex items-center justify-center text-[#da0007]
                          font-semibold hover:shadow-[0_6px_16px_rgba(218,0,7,0.25)]"
                  >
                    4
                  </div>
                  <div class="ml-16">
                    <p class="text-[11px] text-white/40 mb-1 font-[600] tracking-wide">ONGOING</p>
                    <h3 class="font-bold text-[15px] text-white mb-1">Interview invites</h3>
                    <p class="text-[12px] font-[600] text-white/60">Companies reach out directly</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-10 flex justify-center">
        <div
          class="w-full max-w-2xl
              bg-[#da0007]/5
              border border-[#da0007]/20
              rounded-xl
              px-3 py-5 hover:shadow-md transition duration-500
              shadow-[0_8px_30px_rgba(0,0,0,0.04)]"
        >
          <div class="flex items-start gap-4">
            <div class="text-[#da0007]/30 text-5xl leading-none">“</div>

            <div>
              <p class="text-[14px] text-white/80 leading-relaxed mb-3">
                Contacted tribera on Monday. Had demo Tuesday. First shortlist Wednesday. Hired our backend lead Friday.
                The response time is real.
              </p>

              <div>
                <p class="font-semibold text-[13px] text-white">Priya Sinha</p>
                <p class="text-[12px] text-white/50">TA Director · SaaS Unicorn</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#f7f7f7] text-black py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-7">
          <p class="text-[#da0007] text-[14px] font-semibold mb-2">Our offices</p>

          <h2 class="text-3xl font-bold tracking-tight">Pune (HQ) • Bangalore</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {
            [
              {
                city: 'Pune',
                type: 'HEAD OFFICE',
                address: ['505, Zenith Complex, KM Gandhi Marg', 'Pune, Maharashtra 411005'],
                active: true,
              },
              {
                city: 'Bangalore',
                type: 'REGIONAL OFFICE',
                address: ['IndiQube TownHub, 100 Feet Road', 'Bengaluru, Karnataka 560038'],
                active: false,
              },
            ].map((office) => (
              <div
                class={`relative rounded-xl p-5 bg-white
          border border-black/10 overflow-hidden
          transition-all duration-300
          hover:border-[#da0007]/30`}
              >
                <div class="absolute left-0 top-0 h-full w-[2px] bg-[#da0007] rounded-l-xl" />

                <h3 class="text-[20px] font-semibold ">{office.city}</h3>

                <p class="text-[11px] font-[500] tracking-[0.1em] text-black/40 ">{office.type}</p>

                <div class="space-y-1 text-black/75 text-[15px] leading-relaxed">
                  {office.address.map((line, idx) => (
                    <p data-index={idx}>{line}</p>
                  ))}
                </div>

                <div class="my-6 h-px bg-black/10" />

                <p class="text-[13px] font-[500]">
                  <span class="text-[#da0007] font-medium">Email:</span>{' '}
                  <a href="mailto:contact@tribera.ai" class="hover:underline">
                    contact@tribera.ai
                  </a>
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-white py-12 md:py-16">
      <div class="max-w-3xl mx-auto px-6 sm:px-8">
        <div
          class="rounded-2xl border border-black/5 bg-white
                p-6 sm:p-6 lg:p-8
                shadow-xl"
        >
          <div class="text-center mb-5 sm:mb-6">
            <h2 class="text-xl font-bold text-black">Or Send us a message</h2>
            <p class="mt-2 text-black/60 text-[15px] font-[500]">
              Hiring managers and candidates—reach out and we'll respond within 24 hours.
            </p>
          </div>

          <div
            id="form-success"
            class="hidden mx-auto mb-6 max-w-xl rounded-lg border border-[#da0007]/25 bg-[#da0007]/5 text-center px-6 py-6"
          >
            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#DA0007]/10 flex items-center justify-center">
              <svg
                viewBox="0 0 24 24"
                class="w-7 h-7 text-[#DA0007]"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>

            <h4 class="text-[20px] font-[700] text-black">Message Sent</h4>

            <p class="mt-2 text-[14px] leading-relaxed text-black/60">
              Thanks for reaching out. Our team will get back to you within 24 hours.
            </p>
          </div>

          <p id="form-error" class="hidden mb-4 text-center text-[13px] text-black/60">
            Submission failed. Please try again in a moment.
          </p>

          <form id="contact-form" class="space-y-3 sm:space-y-4">
            <input type="hidden" name="access_key" value="f3c09cb0-6c94-405e-af37-4f01141d40bd" />
            <input type="hidden" name="subject" value="New Contact Form Submission - Tribera" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-[12px] font-bold tracking-widest text-black/60 mb-2"> FIRST NAME </label>
                <input
                  type="text"
                  name="first_name"
                  placeholder="John"
                  required
                  class="w-full rounded-xl border border-gray-200 px-4 py-3 text-[12px] font-[600]
                     focus:outline-none focus:border-[#da0007]/40
                     focus:ring-1 focus:ring-[#da0007]/40"
                />
              </div>

              <div>
                <label class="block text-[12px] font-bold tracking-widest text-black/60 mb-2"> LAST NAME </label>
                <input
                  type="text"
                  name="last_name"
                  placeholder="Doe"
                  required
                  class="w-full rounded-xl border border-gray-200 px-4 py-3 text-[12px] font-[600]
                     focus:outline-none focus:border-[#da0007]/40
                     focus:ring-1 focus:ring-[#da0007]/40"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-[12px] font-bold tracking-widest text-black/60 mb-2"> EMAIL </label>
                <input
                  type="email"
                  name="email"
                  placeholder="john@company.com"
                  required
                  class="w-full rounded-xl border border-gray-200 px-4 py-3 text-[12px] font-[600]
                     focus:outline-none focus:border-[#da0007]/40
                     focus:ring-1 focus:ring-[#da0007]/40"
                />
              </div>

              <div>
                <label class="block text-[12px] font-bold tracking-widest text-black/60 mb-2"> COMPANY </label>
                <input
                  type="text"
                  name="company"
                  placeholder="Your Company"
                  class="w-full rounded-xl border border-gray-200 px-4 py-3 text-[12px] font-[600]
                     focus:outline-none focus:border-[#da0007]/40
                     focus:ring-1 focus:ring-[#da0007]/40"
                />
              </div>
            </div>

            <div>
