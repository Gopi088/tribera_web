      <script is:inline>
        function attachContactFormHandler() {
          const form = document.getElementById('contact-form');
          const success = document.getElementById('form-success');
          const error = document.getElementById('form-error');

          if (!form || !success || !error) return;
          if (form.dataset.bound === 'true') return;
          form.dataset.bound = 'true';

          const customSelect = form.querySelector('[data-contact-select]');
          const customSelectInput = form.querySelector('[data-contact-select-input]');
          const customSelectTrigger = form.querySelector('[data-contact-select-trigger]');
          const customSelectLabel = form.querySelector('[data-contact-select-label]');
          const customSelectMenu = form.querySelector('[data-contact-select-menu]');
          const customSelectIcon = form.querySelector('[data-contact-select-icon]');
          const customSelectOptions = Array.from(form.querySelectorAll('[data-contact-select-option]'));

          const setSelectOpen = (open) => {
            if (!(customSelectTrigger instanceof HTMLButtonElement) || !(customSelectMenu instanceof HTMLDivElement)) return;
            customSelectTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
            customSelectMenu.classList.toggle('hidden', !open);
            customSelectTrigger.classList.toggle('border-[#da0007]/40', open);
            customSelectTrigger.classList.toggle('ring-1', open);
            customSelectTrigger.classList.toggle('ring-[#da0007]/40', open);
            customSelectIcon?.classList.toggle('rotate-180', open);
          };

          const setSelectValue = (value) => {
            if (!(customSelectInput instanceof HTMLInputElement) || !(customSelectLabel instanceof HTMLElement)) return;

            customSelectInput.value = value;
            customSelectLabel.textContent = value || 'Select an option';
            customSelectLabel.classList.toggle('text-black/45', !value);
            customSelectLabel.classList.toggle('text-black', Boolean(value));
            customSelectTrigger?.classList.toggle('border-[#da0007]/40', !value ? false : customSelectTrigger.getAttribute('aria-expanded') === 'true');

            customSelectOptions.forEach((option) => {
              if (!(option instanceof HTMLButtonElement)) return;
              const selected = option.dataset.value === value;
              option.classList.toggle('bg-[#da0007]/8', selected);
              option.classList.toggle('text-[#da0007]', selected);
              option.classList.toggle('text-black/70', !selected);
              option.setAttribute('aria-selected', selected ? 'true' : 'false');
            });
          };

          if (
            customSelect instanceof HTMLDivElement &&
            customSelectInput instanceof HTMLInputElement &&
            customSelectTrigger instanceof HTMLButtonElement &&
            customSelectLabel instanceof HTMLElement &&
            customSelectMenu instanceof HTMLDivElement
          ) {
            setSelectValue('');

            customSelectTrigger.addEventListener('click', () => {
              const isOpen = customSelectTrigger.getAttribute('aria-expanded') === 'true';
              setSelectOpen(!isOpen);
            });

            customSelectOptions.forEach((option) => {
              if (!(option instanceof HTMLButtonElement)) return;
              option.addEventListener('click', () => {
                setSelectValue(option.dataset.value || '');
                setSelectOpen(false);
              });
            });

            document.addEventListener('click', (event) => {
              const target = event.target;
              if (!(target instanceof Node)) return;
              if (customSelect.contains(target)) return;
              setSelectOpen(false);
            });

            document.addEventListener('keydown', (event) => {
              if (event.key === 'Escape') {
                setSelectOpen(false);
              }
            });
          }

          form.addEventListener('submit', async (e) => {
            e.preventDefault();

            error.classList.add('hidden');

            if (customSelectInput instanceof HTMLInputElement && !customSelectInput.value) {
              error.textContent = 'Please select what you are interested in.';
              error.classList.remove('hidden');
              customSelectTrigger?.focus();
              return;
            }

              const formData = new FormData(form);

            try {
              const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
              });

              const result = await res.json();

              if (result.success) {
                form.reset();
                setSelectValue('');
                setSelectOpen(false);
                form.classList.add('hidden');
                success.classList.remove('hidden');
                setTimeout(() => {
                  success.classList.add('hidden');
                  form.classList.remove('hidden');
                }, 4000);
              } else {
                error.textContent =
                  result.message ||
                  'Something went wrong while sending your message. Please try again or email hello@tribera.ai.';
                error.classList.remove('hidden');
              }
            } catch (err) {
              error.textContent =
                'Something went wrong while sending your message. Please try again or email hello@tribera.ai.';
              error.classList.remove('hidden');
              console.error('Contact form submit failed:', err);
            }
          });
        }

        document.addEventListener('DOMContentLoaded', attachContactFormHandler);
        document.addEventListener('astro:after-swap', attachContactFormHandler);
      </script>
    </section>

