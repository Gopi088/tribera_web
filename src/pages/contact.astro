      </div>

      <script is:inline>
        function attachContactFormHandler() {
          const form = document.getElementById('contact-form');
          const success = document.getElementById('form-success');
          const error = document.getElementById('form-error');

          if (!form || !success || !error) return;
          if (form.dataset.bound === 'true') return;
          form.dataset.bound = 'true';

          form.addEventListener('submit', async (e) => {
            e.preventDefault();

            error.classList.add('hidden');

            const formData = new FormData(form);

            try {
              const res = await fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                body: formData,
              });

              const result = await res.json();

              if (result.success) {
                form.reset();
                form.classList.add('hidden');
                success.classList.remove('hidden');
                setTimeout(() => {
                  success.classList.add('hidden');
                  form.classList.remove('hidden');
                }, 4000);
              } else {
                error.textContent = result.message || 'Submission failed. Please try again.';
                error.classList.remove('hidden');
              }
            } catch (err) {
              error.textContent = 'Network error. Please check your connection.';
              error.classList.remove('hidden');
              console.error('Web3Forms error:', err);
            }
          });
        }

        document.addEventListener('DOMContentLoaded', attachContactFormHandler);
        document.addEventListener('astro:after-swap', attachContactFormHandler);
      </script>
    </section>

