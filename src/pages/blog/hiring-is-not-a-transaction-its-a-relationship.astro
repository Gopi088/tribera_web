/* the list — editorial rows, not cards */
.posts{display:grid;border-top:1px solid var(--hair)}
.post{display:grid;gap:6px 26px;padding:clamp(20px,2.2vw,26px) 12px;margin-inline:-12px;
  border-bottom:1px solid var(--hair);border-radius:10px;text-decoration:none;color:inherit;
  align-items:start;transition:background .24s var(--ease),transform .26s var(--spring),opacity .26s}
@media(min-width:880px){.post{grid-template-columns:150px 1fr 78px}}
.posts:hover .post{opacity:.48}
.posts:hover .post:hover{opacity:1;background:rgba(0,0,0,.032);transform:translateX(3px)}
.post.hide{display:none}
.post__meta{display:grid;gap:4px}
.post__d{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;color:var(--ink2)}
