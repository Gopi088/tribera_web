---
import V9Layout from '~/layouts/V9Layout.astro';
import Content from '~/components/v9/content/Content.astro';
import { publicLinks } from '~/data/v9/preview-links';
import FieldNotesList from '~/components/blog/FieldNotesList.astro';
import { fetchPosts } from '../../utils/blog';

const posts = await fetchPosts();
const featuredPost = posts[0];
---

<V9Layout
  title="Field notes on hiring - tribera"
  description="Practical notes on hiring, expert assessment and the candidate experience. Clearer evidence for better decisions."
  headerLinkOverrides={publicLinks}
  footerLinkOverrides={publicLinks}
>
  <Content kind="blog">
    <header class="hero hero--bare">
      <div class="wrap">
        <div class="hero__top">
          <div class="hero__copy">
            <p class="eyebrow" data-v9-reveal>Field notes</p>
            <h1 class="h1" data-v9-reveal style="--d:60ms">
              Notes from the work.<br /><em>Not another hiring playbook.</em>
            </h1>
            <p class="hero__p" data-v9-reveal style="--d:110ms">
              We score every interview we run and keep the record for a defined period. These are the patterns that
              turned up often enough to be worth writing about: on hiring, on the people being hired, and on what a
              machine can and can’t read.
            </p>
            <p class="hero__p" data-v9-reveal style="--d:150ms">
              No thought leadership. Things we got wrong, numbers we can show, and the occasional argument.
            </p>
            <div class="btns" data-v9-reveal style="--d:190ms">
              <a href="#all" class="btn btn--light">Read the latest</a>
              <a href="#sub" class="btn btn--wire">Join the notification list</a>
            </div>
          </div>

          <div class="hero__card" data-v9-reveal style="--d:150ms">
            <p class="feat__k">Latest</p>
            <a class="feat" href={`/${featuredPost.permalink}`}>
              <span class="feat__glint"></span>
              <span class="feat__hd"
                ><time datetime={featuredPost.publishDate.toISOString()}
                  >{
                    featuredPost.publishDate.toLocaleDateString('en-GB', {
                      timeZone: 'UTC',
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })
                  }</time
                ><span>{featuredPost.category?.title}</span></span
              >
              <span class="feat__t">{featuredPost.title}</span>
              <span class="feat__x">{featuredPost.excerpt}</span>
              <span class="feat__ft"
                ><span class="feat__min">{featuredPost.readingTime} read</span>
                <span class="feat__go">Read it <i>→</i></span></span
              >
            </a>
          </div>
        </div>
      </div>
    </header>

    <section class="band band--w" id="all">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Everything we’ve published</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none">We publish when we have something to say.</h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms;max-width:none">
            Not a content calendar.<br /><b
              >Most of these came out of a mandate that taught us something we didn’t already know.</b
            >
          </p>
        </div>

        <FieldNotesList posts={posts} />
      </div>
    </section>

    <section class="trust band" id="sub">
      <div class="wrap">
        <div class="sub" style="text-align:center;display:flex;flex-direction:column;align-items:center">
          <p class="sub__k">Newsletter in preparation</p>
          <p class="sub__h">Get notified when it is ready.</p>
          <p class="sub__s">
            Leave your email and we will send one note when the field notes newsletter opens. No sequence, no webinar
            invitations.
          </p>
          <form
            class="apply__form"
            id="subscribeForm"
            data-newsletter-form
            action="/.netlify/functions/site-inquiry"
            method="post"
            enctype="multipart/form-data"
            style="display:flex;justify-content:center;width:fit-content;margin-inline:auto"
          >
            <input type="hidden" name="form_type" value="newsletter" />
            <input type="hidden" name="form_loaded_at" id="subscribeLoadedAt" />
            <input
              type="text"
              name="botcheck"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
              style="position:absolute;left:-9999px"
            />
            <div class="apply__row apply__row--2">
              <input
                class="apply__mail"
                type="email"
                name="email"
                required
                placeholder="your@email.com"
                aria-label="Your email address"
              />
              <button class="apply__go" type="submit" disabled>Notify me<span class="apply__ar">→</span></button>
            </div>
          </form>
          <noscript
            ><p class="apply__fine">
              For updates, email <a href="mailto:hello@tribera.ai?subject=Field%20notes%20notifications"
                >hello@tribera.ai</a
              >.
            </p></noscript
          >
          <p class="apply__fine" id="subscribeStatus" data-newsletter-status aria-live="polite">
            We never share the list.
          </p>
        </div>
      </div>
    </section>

    <script src="/scripts/newsletter-signup.js" defer is:inline></script>

    <section class="band band--w close" id="contact">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Two doors</p>
            <h2 class="h2" data-v9-reveal style="max-width:none">Two doors. Same room.</h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:60ms;max-width:none">
            Reading is one thing.<br />If you have a role you’re stuck on, or you’re the one being interviewed, both of
            those start the same way.
          </p>
        </div>
        <div class="doors" data-v9-reveal style="--d:110ms">
          <div class="door">
            <p class="door__k">If you’re hiring</p>
            <p class="door__t">Three names you’d take any of.</p>
            <p class="door__d">
              A hundred signals, a senior expert on each shortlisted person, and the reasoning behind every rank.
            </p>
            <p class="door__next"><span>Next</span> A 45-minute intake call. Three names back inside 36 hours.</p>
            <a href="/" class="btn btn--dark">See how one role ran</a>
          </div>
          <div class="door">
            <p class="door__k">If you’re looking</p>
            <p class="door__t">One conversation, then teams come to you.</p>
            <p class="door__d">
              Half an hour with someone who has done your job. Anonymous until you decide otherwise.
            </p>
            <p class="door__next"><span>Next</span> Fifteen minutes to set up, and you keep the score.</p>
            <a href="/candidates" class="btn btn--ghost">Create your profile</a>
          </div>
        </div>
        <p class="bbb2" data-v9-reveal><span>Belong</span><i></i><span>Build</span><i></i><span>Become</span></p>
        <p class="bbb2__s" data-v9-reveal>Tribe + Era. A hire only works if both sides were right about each other.</p>
      </div>
    </section>
  </Content>
</V9Layout>
