      /* ══ reading progress ══ */
      (function () {
        const bar = document.querySelector<HTMLElement>('.reading__f'),
          art = document.querySelector<HTMLElement>('.art');
        if (!bar || !art) return;
        function tick() {
          if (!art || !bar) return;
          const r = art.getBoundingClientRect(),
            vh = innerHeight;
          const total = r.height - vh * 0.4;
          const done = Math.min(Math.max(-r.top + vh * 0.4, 0), Math.max(total, 1));
          bar.style.width = (done / Math.max(total, 1)) * 100 + '%';
        }
        addEventListener('scroll', tick, { passive: true });
        addEventListener('resize', tick);
        tick();
      })();
    </script>
