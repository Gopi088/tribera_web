        font-weight: 700;
        font-size: 14px;
        color: #fff;
        line-height: 1;
      }
      .lt.low b {
        color: #e8a33d;
      }
      .verd__note {
        font-size: 12px;
        line-height: 1.45;
        color: var(--onc3);
        margin: 14px 0 0;
        padding-top: 12px;
