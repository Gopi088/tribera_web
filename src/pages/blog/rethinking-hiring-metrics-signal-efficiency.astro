      .dd.open .dd__t {
        color: #fff;
        background: rgba(255, 255, 255, 0.05);
      }
      .dd__t--q {
        font-size: 13.5px;
        color: var(--onc3);
        padding: 8px 6px;
      }
      .dd__t i {
        width: 7px;
        height: 7px;
        border-right: 1.4px solid currentColor;
        border-bottom: 1.4px solid currentColor;
        transform: rotate(45deg) translate(-1px, -1px);
        transition: transform 0.3s var(--spring);
      }
      .dd.open .dd__t i {
        transform: rotate(225deg) translate(-2px, -2px);
      }
      .dd__p {
        position: absolute;
        top: calc(100% + 10px);
        left: -8px;
        z-index: 60;
        background: rgba(24, 24, 22, 0.98);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.11);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition:
          opacity 0.24s var(--ease),
          transform 0.28s var(--spring),
          visibility 0.24s;
      }
      .dd.open .dd__p {
        opacity: 1;
        visibility: visible;
        transform: none;
      }
      .dd--r .dd__p {
        left: auto;
        right: -8px;
      }
      .dd__g {
        display: grid;
        grid-template-columns: 230px 210px;
        gap: 0 34px;
      }
      .dd__c {
        display: grid;
        align-content: start;
      }
