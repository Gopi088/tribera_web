        border: 1px solid rgba(63, 190, 124, 0.42);
        box-shadow: 0 0 22px rgba(63, 190, 124, 0.18);
      }
      .b-grey {
        color: #c9c9c3;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }
      .b-rej {
        color: #da0007;
        background: rgba(218, 0, 7, 0.12);
        border: 1px solid rgba(218, 0, 7, 0.4);
        box-shadow: 0 0 22px rgba(218, 0, 7, 0.16);
      }
      .verd__big {
        display: flex;
