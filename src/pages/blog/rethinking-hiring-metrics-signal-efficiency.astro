      .dd__t {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--ui);
        font-size: 14px;
        color: var(--onc2);
        background: transparent;
        border: 0;
        cursor: pointer;
        padding: 8px 12px;
        border-radius: 8px;
        transition:
          color 0.22s,
          background 0.22s;
      }
