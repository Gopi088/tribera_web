      .row__k {
        font-family: var(--mono);
        font-size: 9.5px;
        color: var(--red);
      }
      .row__n {
        font-size: 13px;
        color: var(--onc2);
      }
      .row__p {
        font-family: var(--mono);
        font-size: 12px;
        color: #fff;
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      .row.heavy .row__n {
        color: #fff;
      }
      .row input[type='range'] {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 20px;
        background: transparent;
        cursor: grab;
        margin: 0;
      }
      .row input[type='range']:active {
        cursor: grabbing;
      }
      .row input[type='range']::-webkit-slider-runnable-track {
        height: 4px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.12);
      }
      .row input[type='range']::-moz-range-track {
        height: 4px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.12);
      }
      .row input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--onc);
        margin-top: -5px;
        border: 0;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
        transition:
          background 0.2s,
          transform 0.15s;
      }
      .row input[type='range']::-moz-range-thumb {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--onc);
        border: 0;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
      }
      .row input[type='range']:hover::-webkit-slider-thumb {
        transform: scale(1.15);
      }
      .row.heavy input[type='range']::-webkit-slider-thumb {
        background: var(--red);
      }
      .row.heavy input[type='range']::-moz-range-thumb {
        background: var(--red);
      }
      .row input[type='range']:focus-visible {
        outline: 2px solid var(--red);
        outline-offset: 4px;
        border-radius: 4px;
      }
      .rows__ft {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 14px;
        padding-top: 12px;
        font-size: 12.5px;
        color: var(--onc3);
      }
      .rows__ft b {
        font-family: var(--mono);
        color: #fff;
      }
      .lab__foot {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(19px, 2.4vw, 30px);
        line-height: 1.25;
        letter-spacing: -0.032em;
        color: #fff;
        margin: clamp(30px, 3.6vw, 48px) 0 0;
        max-width: 26ch;
      }
      .lab__foot em {
        font-style: normal;
        color: var(--red);
      }

      /* ══ ADVISORS — figures, not paragraphs ══ */

      /* ══ COMPOUNDING RAMP ══ */
      .ramp {
        margin-top: 6px;
      }
      .ramp__g {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 26px 16px;
      }
      @media (min-width: 720px) {
        .ramp__g {
          grid-template-columns: repeat(4, 1fr);
          gap: clamp(12px, 1.6vw, 24px);
        }
      }
      .rp__slot {
        display: flex;
        align-items: flex-end;
        height: 132px;
        margin-bottom: 14px;
      }
      @media (min-width: 720px) {
        .rp__slot {
          height: 216px;
        }
      }
      .rk {
        display: block;
        width: 100%;
        max-width: 230px;
        height: calc(var(--h) * 0.62);
      }
      @media (min-width: 720px) {
        .rk {
          height: var(--h);
        }
      }
      .rk svg {
        width: 100%;
        height: 100%;
        display: block;
        overflow: visible;
      }
      .rk__ln,
      .rk__ht {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
      }
      .ramp.in .rk__ln {
        animation: drawbox 0.55s ease-out var(--d) forwards;
      }
      .ramp.in .rk__ln2 {
        animation-duration: 0.4s;
        animation-delay: calc(var(--d) + 0.28s);
      }
      .ramp.in .rk__ht {
        animation: drawbox 0.9s ease-out calc(var(--d) + 0.34s) forwards;
      }
      .ramp.in .rk__ht2 {
        animation-duration: 0.7s;
        animation-delay: calc(var(--d) + 0.5s);
      }
      @keyframes drawbox {
        to {
          stroke-dashoffset: 0;
        }
      }
      .rp__n {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--faint);
        margin: 0 0 6px;
      }
      .rp__acc {
        display: grid;
        gap: 1px;
        margin: 0 0 9px;
        padding-bottom: 9px;
        border-bottom: 1px solid var(--hair);
      }
      .rp__acc b {
        font-family: var(--mono);
        font-size: 13px;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.02em;
      }
      .rp__acc span {
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--faint);
      }
      .rp--last .rp__acc b {
        color: var(--red);
      }
      .rp--last .rp__n {
        color: var(--red);
      }
      .rp__t {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(14.5px, 1.5vw, 17px);
        letter-spacing: -0.022em;
        margin: 0 0 5px;
        line-height: 1.25;
      }
      .rp__d {
        font-size: 13px;
        line-height: 1.45;
        color: var(--grey);
        margin: 0;
      }
      @media (max-width: 479px) {
        .rp__d {
          display: none;
        }
      }
      .ramp__note {
        font-size: 14px;
        line-height: 1.55;
        color: var(--grey);
        margin: 26px 0 0;
        max-width: 62ch;
        opacity: 0;
        transition: opacity 0.6s var(--ease) 1.7s;
      }
      .ramp.in .ramp__note {
        opacity: 1;
      }
      .ramp__note b {
        color: var(--ink);
        font-weight: 600;
      }
      @media (prefers-reduced-motion: reduce) {
        .ramp .rk__ln,
        .ramp .rk__ht {
          stroke-dashoffset: 0;
          animation: none;
        }
        .ramp__note {
          opacity: 1;
          transition: none;
        }
      }
      .rp__n {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--faint);
        margin: 0 0 10px;
      }
      .rp__t {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(14.5px, 1.5vw, 17px);
        letter-spacing: -0.022em;
        margin: 14px 0 5px;
      }
      .rp__d {
        font-size: 13px;
        line-height: 1.45;
        color: var(--grey);
        margin: 0;
      }
      @media (prefers-reduced-motion: reduce) {
        .rp__bar {
          transform: none !important;
        }
      }
      .comp {
        margin-top: 0;
      }
      .comp__grid {
        display: grid;
        gap: 0;
        margin-top: clamp(30px, 3.4vw, 44px);
      }
      @media (min-width: 760px) {
        .comp__grid {
          grid-template-columns: repeat(4, 1fr);
          border-top: 0;
        }
      }
      .cs {
        padding: 22px 0;
        border-top: 1px solid var(--hair);
      }
      @media (min-width: 760px) {
        .cs {
          border-bottom: 0;
          border-top: 2px solid var(--hair);
          padding: 20px 22px 0 0;
        }
        .cs:last-child {
          border-top-color: var(--red);
        }
      }
      .cs__n {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--faint);
        margin: 0 0 10px;
      }
      .cs:last-child .cs__n {
        color: var(--red);
      }
      .cs__t {
        font-family: var(--display);
        font-weight: 700;
        font-size: 16.5px;
        letter-spacing: -0.022em;
        margin: 0 0 7px;
      }
      .cs__d {
        font-size: 14px;
        line-height: 1.55;
        color: var(--grey);
        margin: 0;
      }

      /* ══ BUYING ══ */
      .buy {
        background: var(--char);
        color: var(--onc);
      }
      .buy .eyebrow {
        color: var(--onc3);
      }
      .buy h2 {
        color: #fff;
      }
      .buy__dek {
        font-size: clamp(16px, 1.7vw, 20px);
        line-height: 1.62;
        color: var(--onc2);
        max-width: 54ch;
        margin: 22px 0 0;
      }
      .cmp {
        margin-top: clamp(26px, 3vw, 40px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: clamp(16px, 1.9vw, 24px) clamp(16px, 1.9vw, 26px);
        background: rgba(255, 255, 255, 0.012);
      }
      .cmp:hover .cmp__r:not(:hover) .seg.on {
        opacity: 0.55;
      }
      .cmp .cmp__r:hover .seg.on {
        opacity: 1;
      }
      .cmp__hd {
        display: none;
      }
      @media (min-width: 900px) {
        .cmp__hd {
          display: grid;
          grid-template-columns: 1fr 380px 1.2fr;
          gap: 0 clamp(22px, 2.6vw, 40px);
          padding: 0 12px 12px;
          margin-inline: -12px;
          align-items: end;
          border-bottom: 1px solid var(--cline);
        }
        .cmp__hd .trk {
          display: grid;
          grid-template-columns: 0.8fr 0.8fr 1.25fr 2.4fr;
          gap: 7px;
          max-width: 380px;
        }
        .cmp__hd .trk span {
          font-family: var(--mono);
          font-size: 9.5px;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: var(--onc3);
          text-align: center;
        }
        .cmp__hd .trk span::after {
          content: '';
          display: block;
          width: 1px;
          height: 7px;
          background: var(--cline);
          margin: 7px auto -8px;
        }
        .cmp__hd .trk span:last-child {
          color: var(--red);
        }
        .cmp__hd .trk span:last-child::after {
          background: rgba(218, 0, 7, 0.5);
        }
        .cmp__hd > span {
          font-family: var(--mono);
          font-size: 9.5px;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: var(--onc3);
        }
      }
      .cmp__r {
        display: grid;
        gap: 12px clamp(22px, 2.6vw, 40px);
        padding: clamp(15px, 1.8vw, 20px) 12px;
        margin-inline: -12px;
        border-radius: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        align-items: center;
        transition:
          background 0.22s var(--ease),
          transform 0.22s var(--ease);
      }
      .cmp__r:first-of-type {
        border-top: 0;
      }
      .cmp__r:hover {
        transform: translateX(2px);
      }
      @media (min-width: 900px) {
        .cmp__r {
          grid-template-columns: 1fr 380px 1.2fr;
        }
      }
      .cmp__r:hover {
        background: rgba(255, 255, 255, 0.045);
      }
      .cmp__n {
        font-size: 15.5px;
        color: var(--onc2);
      }
      .cmp__l {
        font-size: 14.5px;
        line-height: 1.45;
        color: var(--onc3);
      }
      .trk {
        display: grid;
        grid-template-columns: 0.8fr 0.8fr 1.25fr 2.4fr;
        gap: 7px;
        align-items: center;
        max-width: 380px;
      }
      .seg {
        position: relative;
        height: 9px;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.09);
        transition:
          background 0.3s var(--ease),
          border-color 0.3s var(--ease),
          opacity 0.3s var(--ease);
      }
      .seg.on {
        background: #8e8e87;
        border-color: #8e8e87;
      }
      .cmp__r:hover .seg.on {
        background: #c9c9c2;
        border-color: #c9c9c2;
      }
      /* four of them hit a wall. one doesn’t. */
      .cmp__r:not(.cmp__r--us) .seg.last::after {
        content: '';
        position: absolute;
        right: -6px;
        top: -7px;
        bottom: -7px;
        width: 2px;
        border-radius: 1px;
        background: rgba(255, 255, 255, 0.28);
      }
      .cmp__r--us .seg.on {
        background: #d6d6cf;
        border-color: #d6d6cf;
