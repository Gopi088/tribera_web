---
import Layout from '~/layouts/PageLayout.astro';
import { industries } from '~/data/industries';

const metadata = {
  title: 'Industries — tribera',
  description:
    'AI-validated, advisor-interviewed talent across every major industry. Tribera delivers three hire-ready candidates in 36 hours — with a 1:3 selection guarantee.',
  robots: { index: true, follow: true },
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="relative min-h-[90vh] md:min-h-screen flex items-center justify-center overflow-hidden bg-black">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-black"></div>
      <div class="absolute left-[-30%] md:left-[-15%] top-0 h-full w-[90%] md:w-[60%]
                  bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.45),transparent_60%)]"></div>
      <div class="absolute right-[-30%] md:right-[-15%] top-0 h-full w-[90%] md:w-[60%]
                  bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.45),transparent_60%)]"></div>
    </div>

    <div class="absolute inset-0 pointer-events-none">
      {Array.from({ length: 22 }).map(() => (
        <span class="absolute rounded-full bg-[#da0007]/80" style={`
          width:3px;height:3px;
          left:${12 + Math.random() * 76}%;
          top:${8 + Math.random() * 84}%;
          --float-x1:${(Math.random() * 44 - 22).toFixed(1)}px;
          --float-y1:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x2:${(Math.random() * 52 - 26).toFixed(1)}px;
          --float-y2:${(Math.random() * 42 - 21).toFixed(1)}px;
          --float-x3:${(Math.random() * 60 - 30).toFixed(1)}px;
          --float-y3:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-y4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-x5:${(Math.random() * 56 - 28).toFixed(1)}px;
          --float-y5:${(Math.random() * 40 - 20).toFixed(1)}px;
          --float-x6:${(Math.random() * 50 - 25).toFixed(1)}px;
          --float-y6:${(Math.random() * 34 - 17).toFixed(1)}px;
          --float-scale1:${(1 + Math.random() * 0.28).toFixed(2)};
          --float-scale2:${(0.78 + Math.random() * 0.18).toFixed(2)};
          --float-scale3:${(1.02 + Math.random() * 0.22).toFixed(2)};
          --float-scale4:${(0.82 + Math.random() * 0.14).toFixed(2)};
          --float-scale5:${(1 + Math.random() * 0.2).toFixed(2)};
          --float-scale6:${(0.86 + Math.random() * 0.14).toFixed(2)};
          animation: float ${11 + Math.random() * 14}s ease-in-out infinite;
          animation-delay: -${(Math.random() * 18).toFixed(1)}s;
          box-shadow: 0 0 10px rgba(218,0,7,.6);
        `} />
      ))}
    </div>

    <div class="relative z-10 max-w-[1080px] mx-auto px-6 text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#da0007]/40 bg-white/[0.03] px-3.5 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/80">
        <span class="h-1.5 w-1.5 rounded-full bg-[#da0007]"></span>
        <span>Industries</span>
      </div>

      <h1 class="font-[600] leading-[1.02] sm:leading-[1.08]">
        <span class="block whitespace-nowrap text-white text-[clamp(2.15rem,10.8vw,3rem)] sm:text-[clamp(2.8rem,6vw,5rem)] tracking-[-0.08em]">
          Domain-first hiring,
        </span>
        <span class="block text-[clamp(2.45rem,12vw,3.4rem)] sm:text-[clamp(2.8rem,6vw,5rem)] text-[#da0007] tracking-[-0.08em]">
          across every industry.
        </span>
      </h1>

      <p class="mt-6 md:mt-8 text-white/60 text-[16px] md:text-[20px] max-w-2xl md:max-w-3xl mx-auto leading-relaxed px-2">
        Tribera advisors bring the domain context your sector demands. Shortlists arrive already calibrated to your world — not just your job description.
      </p>

      <div class="mt-8 md:mt-12 flex flex-col sm:flex-row flex-wrap justify-center items-center gap-4 sm:gap-5">
        <div class="flex w-auto max-w-full flex-col items-center gap-1 px-4 py-3 rounded-xl border border-[#da0007]/40 bg-[#da0007]/20 text-center text-white sm:w-auto sm:flex-row sm:gap-2 sm:px-5 sm:text-left">
          <span class="whitespace-nowrap text-[13px] font-[600] leading-tight text-white/90">
            <span class="text-[#da0007]">1:3</span> Selection Ratio Guarantee*
          </span>
          <span class="text-[11px] font-[550] leading-tight text-white/50">Interview 3, hire 1</span>
        </div>

        <button type="button" data-form-intent="demo" data-form-source="industries_index_hero"
          class="px-6 py-3 rounded-full bg-[#ff0000] text-white text-[13px] font-bold transition-all duration-300 hover:bg-[#e00000]">
          Book a Demo
        </button>

        <a href="/contact"
          class="px-6 py-3 rounded-full bg-[#121212] border border-white/10 text-white/80 text-[13px] font-bold transition-all duration-300 hover:border-white/20">
          Talk to Us
        </a>
      </div>

      <p class="mt-8 md:mt-14 text-white/30 text-[12px] font-[550]">*We'll walk you through it</p>
    </div>
  </section>

  <!-- Grid -->
  <section class="bg-[#f5f5f5] py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((industry) => (
          <a
            href={`/industries/${industry.slug}`}
            class="group flex flex-col rounded-[24px] border border-black/5 bg-white p-6
                   shadow-[0_8px_28px_rgba(0,0,0,0.05)] transition-all duration-500
                   hover:shadow-[0_20px_50px_rgba(0,0,0,0.10)] hover:border-[#da0007]/20
                   overflow-hidden relative"
          >
            <div class="absolute top-0 left-0 h-[3px] w-0 bg-[#da0007] transition-all duration-700 group-hover:w-full" />
            <span class="inline-block text-[10px] tracking-[0.1em] bg-[#da0007]/10 text-[#da0007] px-2 py-1 rounded-sm font-[700] mb-4 self-start">
              {industry.badge}
            </span>
            <h2 class="text-[15px] font-[700] text-black tracking-tight">{industry.title}</h2>
            <p class="mt-2 text-[13px] leading-relaxed text-black/50 flex-1">{industry.subtitle}</p>
            <span class="mt-5 text-[12px] font-semibold text-[#da0007] group-hover:underline underline-offset-4 transition">
              Explore →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative bg-black py-16 md:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(218,0,7,0.10),transparent_60%)]"></div>
    <div class="pointer-events-none absolute inset-0 bg-dotted-static opacity-50"></div>
    <div class="relative z-10 max-w-2xl mx-auto px-5 sm:px-8 text-center">
      <h2 class="text-[34px] sm:text-[44px] lg:text-[55px] font-[700] leading-[1.08] tracking-[-0.02em] text-white">
        Don't see your industry?
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-white/45">
        We cover more ground than we list. Tell us your sector and mandate — we'll tell you
        honestly whether we're the right fit.
      </p>
      <div class="mt-7">
        <a href="/contact"
           class="inline-block px-8 py-3.5 rounded-full tribera-primary-button text-[13px] font-semibold">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>
