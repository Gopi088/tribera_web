---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { getStaticPathsIndustries } from '~/data/industries';
import type { Industry } from '~/data/industries';
import PageTemplate from '~/components/industry-function/PageTemplate.astro';

export const prerender = true;

export const getStaticPaths = (() => {
  return getStaticPathsIndustries();
}) satisfies GetStaticPaths;

const { industry } = Astro.props as { industry: Industry };

const metadata = {
  title: `${industry.title} Hiring — tribera`,
  description: industry.subtitle,
  robots: { index: true, follow: true },
};
---

<Layout metadata={metadata}>
  <PageTemplate
    type="industry"
    slug={industry.slug}
    badge={industry.badge}
    title={industry.title}
    subtitle={industry.subtitle}
    overview={industry.overview}
    hiringChallenges={industry.hiringChallenges}
    rolesWeHire={industry.rolesWeHire}
    whyTribera={industry.whyTribera}
    faqs={industry.faqs}
    ctaHeadline={industry.ctaHeadline}
    ctaSubtext={industry.ctaSubtext}
  />
</Layout>
