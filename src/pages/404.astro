---
import Layout from '~/layouts/V9Layout.astro';
import Content from '~/components/v9/content/Content.astro';
import { publicLinks } from '~/data/v9/preview-links';
---

<Layout
  title="Page not found | Tribera"
  description="Find your way back to Tribera for hiring teams and candidates."
  noindex
  robotsFollow
  headerLinkOverrides={publicLinks}
  footerLinkOverrides={publicLinks}
>
  <Content>
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">404 / Page not found</p>
        <h1>This page isn't here.<br />Let's find your next step.</h1>
        <p class="hero__p">Looking for help with a role, or your next opportunity? Start here.</p>
        <div class="btns">
          <a class="btn" href="/">I'm hiring</a><a class="btn btn--ghost" href="/candidates"
            >I'm looking for a role &rsaquo;</a
          >
        </div>
      </div>
    </section>
  </Content>
</Layout>
