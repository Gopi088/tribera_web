---
import V9Layout from '~/layouts/V9Layout.astro';
import Content from '~/components/v9/content/Content.astro';
import { publicLinks } from '~/data/v9/preview-links';
import { functionSeries, comparison } from '~/data/chart-series';
const initialChart = comparison(functionSeries['engineering-platform'], functionSeries['data-analytics'], true);
---

<V9Layout
  title="Functions — different functions, different priorities — tribera"
  description="Eight functions, eight different bars. The method is identical everywhere; the weighting comes from your function."
  headerLinkOverrides={publicLinks}
  footerLinkOverrides={publicLinks}
>
  <Content kind="functions">
    <header class="hero hero--bare">
      <div class="wrap">
        <div class="hero__top">
          <div class="hero__copy">
            <p class="eyebrow" data-v9-reveal>Functions</p>
            <h1 class="h1" data-v9-reveal style="--d:60ms">Different functions.<br /><em>Different priorities.</em></h1>
            <p class="hero__p" data-v9-reveal style="--d:110ms">
              A data lead and a head of infrastructure need different strengths.<br />The method is identical
              everywhere.<br /><b>The weighting is not.</b>
            </p>
            <p class="hero__p" data-v9-reveal style="--d:150ms">
              Our first question is never the job description.<br />It’s what your function punishes when you get it
              wrong.
            </p>
            <div class="btns" data-v9-reveal style="--d:190ms">
              <a href="#all" class="btn btn--light">See the eight</a>
              <a href="/contact" class="btn btn--wire">Ask about yours</a>
            </div>
          </div>
          <div class="hero__card" data-v9-reveal style="--d:150ms">
            <p class="feat__k">One title, any two functions</p>
            <div class="cmpw">
              <span class="feat__glint"></span>
              <div class="cmpw__sel">
                <label class="sel"
                  ><span>Function A</span>
                  <select id="secA" disabled data-series={JSON.stringify(functionSeries)} data-scale="relative"
                    ><option value="engineering-platform" selected>Engineering & platform</option><option
                      value="data-analytics">Data & analytics</option
                    ><option value="infrastructure-sre">Infrastructure & SRE</option><option value="security"
                      >Security</option
                    ><option value="finance-risk">Finance & risk</option><option value="product-design"
                      >Product & design</option
                    ><option value="operations">Operations</option><option value="leadership">Leadership</option
                    ></select
                  ></label
                >
                <label class="sel sel--b"
                  ><span>Function B</span>
                  <select id="secB" disabled
                    ><option value="engineering-platform">Engineering & platform</option><option
                      value="data-analytics"
                      selected>Data & analytics</option
                    ><option value="infrastructure-sre">Infrastructure & SRE</option><option value="security"
                      >Security</option
                    ><option value="finance-risk">Finance & risk</option><option value="product-design"
                      >Product & design</option
                    ><option value="operations">Operations</option><option value="leadership">Leadership</option
                    ></select
                  ></label
                >
              </div>
              <div class="cmpw__g">
                {
                  initialChart.rows.map((row, i) => (
                    <div class:list={['bw', { key: row.key }]} id={`bw${i}`}>
                      <span class="bw__n">{row.name}</span>
                      <span class="bw__pair">
                        <span class="bw__b">
                          <span class="bw__f" id={`fa${i}`} style={`width:${row.widthA}%`} />
                        </span>
                        <span class="bw__b">
                          <span class="bw__f bw__f--b" id={`fb${i}`} style={`width:${row.widthB}%`} />
                        </span>
                      </span>
                      <span class="bw__v">
                        <>
                          <i id={`va${i}`}>{row.a}</i>
                          <b id={`vb${i}`}>{row.b}</b>
                        </>
                      </span>
                    </div>
                  ))
                }
              </div>
              <p class="cmpw__ft" id="cmpFt">{initialChart.note}</p>
              <p class="cmpw__ft" id="comparisonHint">
                Showing the default comparison. Enable JavaScript to change selections.
              </p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="band band--w" id="all">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Where we run mandates</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none">Eight functions, eight different bars.</h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms;max-width:none">
            The six bars on each card illustrate that function’s priorities:
            <b>the tall red one is what it punishes hardest when someone gets it wrong.</b><br />Scan them and the
            clusters show up on their own.
          </p>
        </div>
        <div class="inds2" data-v9-reveal style="--d:140ms">
          <a class="ind" href="/functions/engineering-platform"
            ><svg class="isp" viewBox="0 0 66 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              ><rect x="0" y="2" width="7" height="24" rx="2" fill="#DA0007"></rect><rect
                x="11"
                y="5.7"
                width="7"
                height="20.3"
                rx="2"
                fill="#C6C2B8"></rect><rect x="22" y="16.8" width="7" height="9.2" rx="2" fill="#C6C2B8"></rect><rect
                x="33"
                y="9.4"
                width="7"
                height="16.6"
                rx="2"
                fill="#C6C2B8"></rect><rect x="44" y="16.8" width="7" height="9.2" rx="2" fill="#C6C2B8"></rect><rect
                x="55"
                y="13.1"
                width="7"
                height="12.9"
                rx="2"
                fill="#C6C2B8"></rect></svg
            ><span class="ind__hd"
              ><span class="ind__n">Engineering & platform</span><span class="ind__ar" aria-hidden="true">→</span></span
            ><span class="ind__x"
              >Engineers hired on what shipped and what broke — not what the CV says they built.</span
            ><span class="ind__w"><i>Weighted heaviest</i>Core depth, and what it cost to ship</span></a
          ><a class="ind" href="/functions/data-analytics"
            ><svg class="isp" viewBox="0 0 66 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              ><rect x="0" y="2" width="7" height="24" rx="2" fill="#DA0007"></rect><rect
                x="11"
                y="6"
                width="7"
                height="20"
                rx="2"
                fill="#C6C2B8"></rect><rect x="22" y="16" width="7" height="10" rx="2" fill="#C6C2B8"></rect><rect
                x="33"
                y="10"
                width="7"
                height="16"
                rx="2"
                fill="#C6C2B8"></rect><rect x="44" y="8" width="7" height="18" rx="2" fill="#C6C2B8"></rect><rect
                x="55"
                y="12"
                width="7"
                height="14"
                rx="2"
                fill="#C6C2B8"></rect></svg
            ><span class="ind__hd"
              ><span class="ind__n">Data & analytics</span><span class="ind__ar" aria-hidden="true">→</span></span
            ><span class="ind__x">People who move business numbers, not people who move charts.</span><span
              class="ind__w"><i>Weighted heaviest</i>Whether the number moved after the slide</span
            ></a
          ><a class="ind" href="/functions/infrastructure-sre"
            ><svg class="isp" viewBox="0 0 66 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              ><rect x="0" y="9.4" width="7" height="16.6" rx="2" fill="#C6C2B8"></rect><rect
                x="11"
                y="2"
                width="7"
                height="24"
                rx="2"
                fill="#DA0007"></rect><rect x="22" y="13.1" width="7" height="12.9" rx="2" fill="#C6C2B8"></rect><rect
                x="33"
                y="14.9"
                width="7"
                height="11.1"
                rx="2"
                fill="#C6C2B8"></rect><rect x="44" y="14.9" width="7" height="11.1" rx="2" fill="#C6C2B8"></rect><rect
                x="55"
                y="9.4"
                width="7"
                height="16.6"
                rx="2"
                fill="#C6C2B8"></rect></svg
            ><span class="ind__hd"
              ><span class="ind__n">Infrastructure & SRE</span><span class="ind__ar" aria-hidden="true">→</span></span
            ><span class="ind__x">The people you call at 3am, validated before we send them.</span><span class="ind__w"
              ><i>Weighted heaviest</i>Reliability owned, not rotated</span
            ></a
          ><a class="ind" href="/functions/security"
            ><svg class="isp" viewBox="0 0 66 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              ><rect x="0" y="14.9" width="7" height="11.1" rx="2" fill="#C6C2B8"></rect><rect
                x="11"
                y="14.9"
                width="7"
                height="11.1"
                rx="2"
                fill="#C6C2B8"></rect><rect x="22" y="2" width="7" height="24" rx="2" fill="#DA0007"></rect><rect
                x="33"
                y="16.8"
                width="7"
                height="9.2"
                rx="2"
                fill="#C6C2B8"></rect><rect x="44" y="7.5" width="7" height="18.5" rx="2" fill="#C6C2B8"></rect><rect
                x="55"
                y="20.5"
                width="7"
                height="5.5"
                rx="2"
                fill="#C6C2B8"></rect></svg
            ><span class="ind__hd"
              ><span class="ind__n">Security</span><span class="ind__ar" aria-hidden="true">→</span></span
            ><span class="ind__x">Incident behaviour, not certifications — validated before your room.</span><span
              class="ind__w"><i>Weighted heaviest</i>Incident behaviour over certifications</span
            ></a
          ><a class="ind" href="/functions/finance-risk"
            ><svg class="isp" viewBox="0 0 66 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              ><rect x="0" y="5.7" width="7" height="20.3" rx="2" fill="#C6C2B8"></rect><rect
                x="11"
                y="14.9"
                width="7"
                height="11.1"
                rx="2"
                fill="#C6C2B8"></rect><rect x="22" y="2" width="7" height="24" rx="2" fill="#DA0007"></rect><rect
                x="33"
                y="13.1"
                width="7"
                height="12.9"
                rx="2"
                fill="#C6C2B8"></rect><rect x="44" y="9.4" width="7" height="16.6" rx="2" fill="#C6C2B8"></rect><rect
                x="55"
                y="18.6"
                width="7"
                height="7.4"
                rx="2"
                fill="#C6C2B8"></rect></svg
            ><span class="ind__hd"
              ><span class="ind__n">Finance & risk</span><span class="ind__ar" aria-hidden="true">→</span></span
            ><span class="ind__x">Controllers and CFO-track leaders who have closed hard months.</span><span
              class="ind__w"><i>Weighted heaviest</i>The control that held in a bad month</span
            ></a
          ><a class="ind" href="/functions/product-design"
            ><svg class="isp" viewBox="0 0 66 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              ><rect x="0" y="5.2" width="7" height="20.8" rx="2" fill="#C6C2B8"></rect><rect
                x="11"
                y="18"
                width="7"
                height="8"
                rx="2"
                fill="#C6C2B8"></rect><rect x="22" y="19.6" width="7" height="6.4" rx="2" fill="#C6C2B8"></rect><rect
                x="33"
                y="11.6"
                width="7"
                height="14.4"
                rx="2"
                fill="#C6C2B8"></rect><rect x="44" y="19.6" width="7" height="6.4" rx="2" fill="#C6C2B8"></rect><rect
                x="55"
                y="2"
                width="7"
                height="24"
                rx="2"
                fill="#DA0007"></rect></svg
            ><span class="ind__hd"
              ><span class="ind__n">Product & design</span><span class="ind__ar" aria-hidden="true">→</span></span
            ><span class="ind__x">Taste, evidence and refusal — the product decisions that stand up to scrutiny.</span
            ><span class="ind__w"><i>Weighted heaviest</i>What they refused, in the words they used</span></a
          ><a class="ind" href="/functions/operations"
            ><svg class="isp" viewBox="0 0 66 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              ><rect x="0" y="3.8" width="7" height="22.2" rx="2" fill="#C6C2B8"></rect><rect
                x="11"
                y="16.8"
                width="7"
                height="9.2"
                rx="2"
                fill="#C6C2B8"></rect><rect x="22" y="9.4" width="7" height="16.6" rx="2" fill="#C6C2B8"></rect><rect
                x="33"
                y="2"
                width="7"
                height="24"
                rx="2"
                fill="#DA0007"></rect><rect x="44" y="16.8" width="7" height="9.2" rx="2" fill="#C6C2B8"></rect><rect
                x="55"
                y="14.9"
                width="7"
                height="11.1"
                rx="2"
                fill="#C6C2B8"></rect></svg
            ><span class="ind__hd"
              ><span class="ind__n">Operations</span><span class="ind__ar" aria-hidden="true">→</span></span
            ><span class="ind__x">The leaders who run the recovery when it stops running to plan.</span><span
              class="ind__w"><i>Weighted heaviest</i>What the plan missed first</span
            ></a
          ><a class="ind" href="/functions/leadership"
            ><svg class="isp" viewBox="0 0 66 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              ><rect x="0" y="9.4" width="7" height="16.6" rx="2" fill="#C6C2B8"></rect><rect
                x="11"
                y="18.6"
                width="7"
                height="7.4"
                rx="2"
                fill="#C6C2B8"></rect><rect x="22" y="11.2" width="7" height="14.8" rx="2" fill="#C6C2B8"></rect><rect
                x="33"
                y="7.5"
                width="7"
                height="18.5"
                rx="2"
                fill="#C6C2B8"></rect><rect x="44" y="16.8" width="7" height="9.2" rx="2" fill="#C6C2B8"></rect><rect
                x="55"
                y="2"
                width="7"
                height="24"
                rx="2"
                fill="#DA0007"></rect></svg
            ><span class="ind__hd"
              ><span class="ind__n">Leadership</span><span class="ind__ar" aria-hidden="true">→</span></span
            ><span class="ind__x">The decision with no cover, and the count afterwards.</span><span class="ind__w"
              ><i>Weighted heaviest</i>The decision nobody else would take</span
            ></a
          >
        </div>
      </div>

      <section class="fn band" id="same">
        <div class="wrap">
          <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
            <div>
              <p class="eyebrow eyebrow--red" data-v9-reveal>What doesn’t move</p>
              <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none">The method is the same in all eight.</h2>
            </div>
            <p class="fn__dek" data-v9-reveal style="--d:100ms;max-width:none">
              Function context changes the weighting, the questions and who does the interviewing. <b
                >It never changes how the decision gets made, or who makes it.</b
              >
            </p>
          </div>
          <div class="steps" data-v9-reveal style="--d:140ms">
            <div class="step">
              <span class="step__n">01</span>
              <span class="step__t">Experience checked <em class="own">engine</em></span>
              <span class="step__d">Read before anyone picks up the phone, everywhere.</span>
            </div>
            <div class="step">
              <span class="step__n">02</span>
              <span class="step__t">Thirty minutes with a peer <em class="own">expert</em></span>
              <span class="step__d"
                >Someone who has worked your function, with questions shaped by the role and the candidate's experience.</span
              >
            </div>
            <div class="step">
              <span class="step__n">03</span>
              <span class="step__t">Scored against your bar <em class="own">engine</em></span>
              <span class="step__d">The rubric is yours. The function only sets its starting position.</span>
            </div>
            <div class="step">
              <span class="step__n">04</span>
              <span class="step__t">You decide <em class="own own--you">yours</em></span>
              <span class="step__d">Three who clear your bar, with the reasoning behind each rank.</span>
            </div>
          </div>
          <p class="fn__line" style="text-align:center;margin-inline:auto;max-width:none" data-v9-reveal>
            Eight functions. One way of <em>making the call</em>.
          </p>
        </div>
      </section>

      <section class="wrap band close" id="contact">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Not listed</p>
            <h2 class="h2" data-v9-reveal style="max-width:none">We cover more than we list, but not everything.</h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:60ms;max-width:none">
            Tell us the function and the mandate.
            <b>If it isn’t our ground we will say so on the first call</b>, which is cheaper for both of us than finding
            out in week three.
          </p>
        </div>
        <div class="btns" data-v9-reveal style="--d:110ms;justify-content:center;display:flex">
          <a href="/contact" class="btn btn--dark">Ask about your function</a>
          <a href="/industries" class="btn btn--ghost">Browse by industry</a>
        </div>
      </section>
    </section>

    <script>
      import { initComparison } from '~/scripts/charts';

      initComparison();
      document.addEventListener('astro:page-load', initComparison);
    </script>
  </Content>
</V9Layout>
