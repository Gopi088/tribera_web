---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { getStaticPathsFunctions } from '~/data/functions';
import type { JobFunction } from '~/data/functions';
import PageTemplate from '~/components/industry-function/PageTemplate.astro';

export const prerender = true;

export const getStaticPaths = (() => {
  return getStaticPathsFunctions();
}) satisfies GetStaticPaths;

const { jobFunction } = Astro.props as { jobFunction: JobFunction };

const metadata = {
  title: `${jobFunction.title} Hiring — tribera`,
  description: jobFunction.subtitle,
  robots: { index: true, follow: true },
};
---

<Layout metadata={metadata}>
  <PageTemplate
    type="function"
    slug={jobFunction.slug}
    badge={jobFunction.badge}
    icon={jobFunction.icon}
    title={jobFunction.title}
    subtitle={jobFunction.subtitle}
    overview={jobFunction.overview}
    hiringChallenges={jobFunction.hiringChallenges}
    rolesWeHire={jobFunction.rolesWeHire}
    whyTribera={jobFunction.whyTribera}
    faqs={jobFunction.faqs}
    ctaHeadline={jobFunction.ctaHeadline}
    ctaSubtext={jobFunction.ctaSubtext}
  />
</Layout>
