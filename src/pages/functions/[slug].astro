---
import V9Layout from '~/layouts/V9Layout.astro';
import Content from '~/components/v9/content/Content.astro';
import { publicLinks } from '~/data/v9/preview-links';
import { getStaticPathsFunctions } from '~/data/function-pages';
import type { FunctionPageData } from '~/data/function-pages';

export const prerender = true;

export const getStaticPaths = getStaticPathsFunctions;

const { fw } = Astro.props as { fw: FunctionPageData };
---

<V9Layout
  title={fw.title}
  description={fw.description}
  headerLinkOverrides={publicLinks}
  footerLinkOverrides={publicLinks}
>
  <Content kind="functions">
    <header class="hero hero--bare">
      <div class="wrap">
        <div class="hero__top">
          <div class="hero__copy">
            <p class:list={['eyebrow', fw.slug === 'engineering-platform' && 'eyebrow--red']} data-v9-reveal>
              {fw.heroEyebrow}
            </p>
            <h1 class="h1" data-v9-reveal style="--d:60ms" set:html={fw.heroH1} />
            {fw.heroPs.map((p, i) => <p class="hero__p" data-v9-reveal style={`--d:${110 + i * 40}ms`} set:html={p} />)}
            <div class="btns" data-v9-reveal style="--d:190ms">
              <a href="/contact" class="btn btn--light">Brief a role</a>
              <a href="#asks" class="btn btn--wire">See what we ask</a>
            </div>
          </div>
          <div class="hero__card" data-v9-reveal style="--d:150ms">
            <p class="feat__k">Example priorities for this function</p>
            <div class="cmpw">
              <span class="feat__glint"></span>
              <div class="cmpw__g">
                {
                  fw.bars.map((b) => (
                    <div class:list={['bw', { key: b.key }]}>
                      <>
                        <span class="bw__n">{b.n}</span>
                        <span class="bw__b">
                          <span class="bw__f" style={`--w:${b.v}`} />
                        </span>
                        <span class="bw__v">{b.v}</span>
                      </>
                    </div>
                  ))
                }
              </div>
              <p class="cmpw__ft">
                Example weights, not a fixed hiring standard. Your hiring manager sets the priorities for the role.
              </p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="band band--w" id="misses">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Where a generic screen breaks</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;">{fw.missH2}</h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms">
            A CV lists experience. An expert conversation explores the decisions, trade-offs and outcomes behind it.
          </p>
        </div>
        <div class="miss" data-v9-reveal style="--d:140ms">
          {
            fw.misses.map((miss) => (
              <div class="mis">
                <>
                  <span class="mis__n">{miss.n}</span>
                  <div>
                    <>
                      <p class="mis__t">{miss.t}</p>
                      <p class="mis__k">{miss.k}</p>
                      <p class="mis__x">{miss.x}</p>
                      <p class="mis__w">{miss.w}</p>
                    </>
                  </div>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="wrap band" id="asks">
      <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
        <div>
          <p class="eyebrow eyebrow--red" data-v9-reveal>What we actually ask</p>
          <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;">
            Three questions, and what a thin answer sounds like.
          </h2>
        </div>
        <p class="dek" data-v9-reveal style="--d:100ms">
          These examples show what we explore. The actual questions follow the candidate's experience and the
          requirements of your role.
        </p>
      </div>
      <div class="qqs" data-v9-reveal style="--d:140ms">
        {
          fw.qqs.map((qq, i) => (
            <div class="qq">
              <>
                <p class="qq__q">
                  <span>Q{i + 1}</span>
                  {qq.q}
                </p>
                <div class="qq__g">
                  <>
                    <div class="qq__b qq__b--weak">
                      <>
                        <span class="qq__k">{qq.thinT}</span>
                        <p class="qq__v">{qq.thin}</p>
                      </>
                    </div>
                    <div class="qq__b qq__b--for">
                      <>
                        <span class="qq__k">{qq.forT}</span>
                        <p class="qq__v">{qq.for}</p>
                      </>
                    </div>
                  </>
                </div>
              </>
            </div>
          ))
        }
      </div>
      <p
        class="cases__ft"
        style="color:var(--grey);max-width:96ch;margin-inline:auto;text-align:center"
        set:html={fw.casesFt}
      />
    </section>

    <section class="band band--w" id="roles">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Roles we run here</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;">Different levels. Your hiring bar.</h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms">
            We agree the requirements with your hiring manager. Your team interviews the shortlist and makes the hiring
            decision.
          </p>
        </div>
        <div class="rles" data-v9-reveal style="--d:140ms">
          {
            fw.roles.map((r) => (
              <div class="rle">
                <>
                  <p class="rle__n">{r.n}</p>
                  <p class="rle__l">{r.l}</p>
                </>
              </div>
            ))
          }
        </div>
        <p class="rles__ft" data-v9-reveal>
          Not seeing yours? <a href="/contact">Tell us what you’re hiring for</a>, and we will say honestly whether it
          is our ground.
        </p>
      </div>
    </section>

    <section class="trust band" id="who">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow" data-v9-reveal>Who does the interviewing</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;">Operators, not recruiters.</h2>
          </div>
          <p class="trust__dek" data-v9-reveal style="--d:100ms">
            The distinction this whole page rests on.
            <b>Every interview here is run by someone who has held the job</b>, and they only interview on ground they
            have actually worked.
          </p>
        </div>
        <div class="tr2" data-v9-reveal style="--d:140ms">
          {
            fw.benchT ? (
              <div class="tr2__c">
                <>
                  <p class="tr2__k">{fw.benchT}</p>
                  <ul class="tr2__l">
                    {fw.bench.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </>
              </div>
            ) : (
              <ul class="tr2__l">
                {fw.bench.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )
          }
          <div class="tr2__c">
            <p class="tr2__k">What that changes</p><ul class="tr2__l">
              <li>The follow-up lands, because they know where the answer usually thins</li>
              <li>Titles get read against scope, not against a salary band</li>
              <li><b>A weak answer gets a second chance</b> before it gets a low score</li>
              <li>The write-up is in the language your hiring manager already uses</li>
            </ul>
          </div>
        </div>
        <p
          class="trust__ft"
          style="max-width:100ch;margin-inline:auto;text-align:center"
          data-v9-reveal
          set:html={fw.trustFt}
        />
      </div>
    </section>

    <section class="wrap band" id="faq">
      <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
        <div>
          <p class="eyebrow eyebrow--red" data-v9-reveal>Before you brief us</p>
          <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;">Three things teams ask first.</h2>
        </div>
        <p class="dek" data-v9-reveal style="--d:100ms">
          Answered here so the first call can be about your role rather than about us.
        </p>
      </div>
      <div class="qas qas--l" data-v9-reveal style="--d:140ms">
        {
          fw.faqs.map((f) => (
            <details class="qa2">
              <>
                <summary class="qa2__q">
                  {f.q}
                  <i />
                </summary>
                <p class="qa2__a">{f.a}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>

    <section class="fn band close" id="contact">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow" data-v9-reveal style="color:var(--red)">Start here</p>
            <h2 class="h2" data-v9-reveal style="max-width:none">Tell us the role. Three names in 36 hours.</h2>
          </div>
          <p class="fn__dek" data-v9-reveal style="--d:60ms;max-width:none" set:html={fw.closeDek} />
        </div>
        <div class="btns" data-v9-reveal style="--d:110ms;justify-content:center;display:flex;margin-top:16px">
          <a href="/contact" class="btn btn--light">Brief a role</a>
          <a href="/functions" class="btn btn--wire">Other functions</a>
        </div>
      </div>
    </section>

    <section class="band band--w" id="why">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Why tribera</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;">We hire like you think.</h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms">
            Our process is shaped by the mandates we run and the people we hire.
            <b>Every step is designed to find the right person, not just any person.</b>
          </p>
        </div>
        <p class="bbb2" data-v9-reveal><span>Belong</span><i></i><span>Build</span><i></i><span>Become</span></p>
        <p class="bbb2__s" data-v9-reveal>Tribe + Era. A hire only works if both sides were right about each other.</p>
      </div>
    </section>
  </Content>
</V9Layout>
