---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { getStaticPathsFunctions } from '~/data/functions';
import type { JobFunction } from '~/data/functions';
import { Icon } from 'astro-icon/components';

export const prerender = true;

export const getStaticPaths = (() => {
  return getStaticPathsFunctions();
}) satisfies GetStaticPaths;

const { jobFunction } = Astro.props as { jobFunction: JobFunction };

const metadata = {
  title: `${jobFunction.title} Hiring — tribera`,
  description: jobFunction.shortDescription,
  robots: { index: true, follow: true },
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-black pt-24 pb-16 sm:pt-28 sm:pb-20 md:min-h-[72vh] md:flex md:items-center">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-black"></div>
      <div
        class="absolute left-[-28%] md:left-[-14%] top-0 h-full w-[88%] md:w-[58%]
               bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.40),transparent_62%)]"
      ></div>
      <div
        class="absolute right-[-28%] md:right-[-14%] top-0 h-full w-[88%] md:w-[58%]
               bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.30),transparent_62%)]"
      ></div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(218,0,7,0.07),transparent_52%)] opacity-80"
      ></div>
    </div>

    <div class="pointer-events-none absolute inset-0 bg-dotted-static opacity-70"></div>

    <div class="absolute inset-0 pointer-events-none">
      {
        Array.from({ length: 16 }).map(() => (
          <span
            class="absolute rounded-full bg-[#da0007]/80"
            style={`
              width:3px;height:3px;
              left:${12 + Math.random() * 76}%;
              top:${8 + Math.random() * 84}%;
              --float-x1:${(Math.random() * 44 - 22).toFixed(1)}px;
              --float-y1:${(Math.random() * 36 - 18).toFixed(1)}px;
              --float-x2:${(Math.random() * 52 - 26).toFixed(1)}px;
              --float-y2:${(Math.random() * 42 - 21).toFixed(1)}px;
              --float-x3:${(Math.random() * 60 - 30).toFixed(1)}px;
              --float-y3:${(Math.random() * 36 - 18).toFixed(1)}px;
              --float-x4:${(Math.random() * 48 - 24).toFixed(1)}px;
              --float-y4:${(Math.random() * 48 - 24).toFixed(1)}px;
              --float-x5:${(Math.random() * 56 - 28).toFixed(1)}px;
              --float-y5:${(Math.random() * 40 - 20).toFixed(1)}px;
              --float-x6:${(Math.random() * 50 - 25).toFixed(1)}px;
              --float-y6:${(Math.random() * 34 - 17).toFixed(1)}px;
              --float-scale1:${(1 + Math.random() * 0.28).toFixed(2)};
              --float-scale2:${(0.78 + Math.random() * 0.18).toFixed(2)};
              --float-scale3:${(1.02 + Math.random() * 0.22).toFixed(2)};
              --float-scale4:${(0.82 + Math.random() * 0.14).toFixed(2)};
              --float-scale5:${(1 + Math.random() * 0.2).toFixed(2)};
              --float-scale6:${(0.86 + Math.random() * 0.14).toFixed(2)};
              animation: float ${11 + Math.random() * 14}s ease-in-out infinite;
              animation-delay: -${(Math.random() * 18).toFixed(1)}s;
              box-shadow: 0 0 10px rgba(218,0,7,.6);
            `}
          />
        ))
      }
    </div>

    <div class="relative z-10 mx-auto w-full max-w-6xl px-5 sm:px-8 lg:px-10">
      <a
        href="/functions"
        class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-white/35 transition hover:text-white/60 sm:text-[12px]"
      >
        <span class="text-[#da0007]">←</span>
        All Functions
      </a>

      <div class="mt-5 max-w-3xl sm:mt-6">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-[#da0007]/50 bg-black/20
                 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/80
                 backdrop-blur-sm sm:text-[12px]"
        >
          {jobFunction.icon && <Icon name={jobFunction.icon} class="w-3.5 h-3.5 text-[#da0007]" />}
          Function Focus
        </div>

        <h1
          class="mt-5 text-[38px] font-[700] leading-[1.05] tracking-tight text-white sm:text-[50px] lg:text-[64px]"
        >
          {jobFunction.title}
        </h1>

        <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-white/50 sm:text-[17px] md:mt-6">
          {jobFunction.shortDescription}
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <button
            type="button"
            data-form-intent="demo"
            data-form-source={`function_${jobFunction.slug}`}
            class="px-7 py-3 rounded-full tribera-primary-button text-[13px] font-semibold"
          >
            Book a Demo
          </button>
          <a
            href="/contact"
            class="px-7 py-3 rounded-full border border-white/20 text-white/70 text-[13px]
                   font-semibold transition hover:border-white/40 hover:text-white"
          >
            Talk to Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Tribera for this function -->
  <section class="relative bg-[#f5f5f5] py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10">
      <p class="text-[11px] uppercase tracking-[0.22em] text-[#da0007] font-semibold mb-3">
        Why Tribera
      </p>
      <h2
        class="text-[26px] sm:text-[32px] font-[700] tracking-tight text-black leading-tight max-w-xl"
      >
        Precision hiring for {jobFunction.title}
      </h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            {
              icon: 'tabler:radar',
              title: 'Role-Calibrated AI Signal',
              body: `Our AI validates candidates specifically against the competencies and signals that matter for ${jobFunction.title} — not generic job-board matching.`,
            },
            {
              icon: 'tabler:user-check',
              title: 'Function-Expert Advisors',
              body: `Every candidate is interviewed by a Tribera advisor with direct ${jobFunction.title} experience — ensuring nuanced, domain-aware evaluation.`,
            },
            {
              icon: 'tabler:clock',
              title: '36-Hour Shortlists',
              body: 'Three hire-ready candidates in 36 hours. No lengthy sourcing cycles before you see a single qualified name.',
            },
            {
              icon: 'tabler:shield-check',
              title: '1:3 Hiring Guarantee',
              body: 'Interview three, hire one — guaranteed. We absorb the risk of a weak pipeline so your team only spends time on real decisions.',
            },
            {
              icon: 'tabler:refresh',
              title: 'Feedback-Driven Calibration',
              body: 'Every round of feedback sharpens our model. We adapt to your bar in real time — not after three bad hires.',
            },
            {
              icon: 'tabler:network',
              title: 'Passive Talent Access',
              body: `Deep relationships with passive talent in ${jobFunction.title} mean we reach people who will never apply on a job board.`,
            },
          ].map((card) => (
            <div class="rounded-[24px] border border-black/5 bg-white p-6 shadow-[0_8px_28px_rgba(0,0,0,0.05)]">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#da0007]/8 mb-4">
                <Icon name={card.icon} class="w-5 h-5 text-[#da0007]" />
              </div>
              <h3 class="text-[14px] font-[700] text-black tracking-tight">{card.title}</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-black/55">{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative bg-black py-16 md:py-20 overflow-hidden">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(218,0,7,0.12),transparent_60%)]"
    ></div>
    <div class="relative z-10 max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-[11px] uppercase tracking-[0.22em] text-[#da0007] font-semibold mb-4">
        Get Started
      </p>
      <h2 class="text-[28px] sm:text-[38px] font-[700] tracking-tight text-white leading-tight">
        Ready to hire for {jobFunction.title}?
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-white/45 max-w-xl mx-auto">
        Tell us the role. Three vetted, advisor-interviewed candidates — in your inbox within 36 hours.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <button
          type="button"
          data-form-intent="demo"
          data-form-source={`function_cta_${jobFunction.slug}`}
          class="px-8 py-3.5 rounded-full tribera-primary-button text-[13px] font-semibold"
        >
          Book a Demo
        </button>
        <a
          href="/about"
          class="text-white/50 text-[13px] font-semibold transition hover:text-white underline underline-offset-4"
        >
          Learn about Tribera →
        </a>
      </div>
    </div>
  </section>
</Layout>
