  <script>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var items = [].slice.call(document.querySelectorAll('[data-rv], #marks'));
      if (reduce) {
        items.forEach(function (el) { el.classList.add('in'); });
        var g = document.getElementById('marks');
        if (g) g.classList.add('done');
        return;
      }
      var ticking = false;
      function sweep() {
        ticking = false;
        var vh = window.innerHeight;
        items = items.filter(function (el) {
          if (el.getBoundingClientRect().top < vh * 0.92) {
            el.classList.add('in');
            if (el.id === 'marks') setTimeout(function () { el.classList.add('done'); }, 1250);
            return false;
          }
          return true;
        });
        if (!items.length) {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        }
      }
      function onScroll() { if (ticking) return; ticking = true; requestAnimationFrame(sweep); }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      sweep();
    })();

    (function () {
      var grid = document.getElementById('marks');
      var out = document.getElementById('readout');
      if (!grid || !out) return;

      var IDLE = 'Hover any mark to trace a profile';
      var SEQ = ["s1", "s2", "s3", "s4", "s5", "s6"];
      var WHAT = {"s1": "Eliminated at AI screen", "s2": "HR interviewed &middot; not shortlisted", "s3": "Domain interviewed &middot; not selected", "s4": "Cleared domain &middot; scored below the top three", "s5": "Hire-ready &middot; you chose another", "s6": "Hire-ready &middot; the one you chose"};
      var REACHED = {"s1": "126 sourced and AI-screened", "s2": "30 cleared the AI screen", "s3": "14 shortlisted for domain interview", "s4": "7 cleared the domain interview", "s5": "3 scored highest &mdash; all three hireable", "s6": "1 you chose"};
      var TINT = {"s1": "#DDDDDD", "s2": "#C2C2C2", "s3": "#9C9C9C", "s4": "#6E6E6E", "s5": "#111111", "s6": "#DA0007"};

      var marks = [].slice.call(grid.querySelectorAll('.mk'));
      var stages = [].slice.call(document.querySelectorAll('.stage'));
      var locked = null;

      function say(stage, idx, cumulative) {
        if (!stage) { out.className = 'readout'; out.textContent = IDLE; return; }
        out.className = 'readout is-live';
        out.innerHTML = '<span class="rd-dot" style="background:' + TINT[stage] + '"></span>' +
          (cumulative ? REACHED[stage] : '<b>Profile ' + idx + '</b> &middot; ' + WHAT[stage]);
      }

      function filter(stage) {
        if (!stage) {
          grid.classList.remove('is-filtered');
          marks.forEach(function (m) { m.classList.remove('hit'); });
          stages.forEach(function (s) { s.classList.remove('is-active'); });
          return;
        }
        var floor = SEQ.indexOf(stage);
        grid.classList.add('is-filtered');
        marks.forEach(function (m) {
          m.classList.toggle('hit', SEQ.indexOf(m.dataset.s) >= floor);
        });
        stages.forEach(function (s) { s.classList.toggle('is-active', s.dataset.stage === stage); });
      }

      grid.addEventListener('pointerover', function (e) {
        var m = e.target.closest('.mk');
        if (!m || locked) return;
        say(m.dataset.s, m.dataset.i);
        stages.forEach(function (s) { s.classList.toggle('is-active', s.dataset.stage === m.dataset.s); });
      });
      grid.addEventListener('pointerleave', function () {
        if (locked) return;
        say(null);
        stages.forEach(function (s) { s.classList.remove('is-active'); });
      });

      stages.forEach(function (s) {
        var st = s.dataset.stage;
        s.addEventListener('pointerenter', function () { if (!locked) { filter(st); say(st, null, true); } });
        s.addEventListener('pointerleave', function () { if (!locked) { filter(null); say(null); } });
        function toggle(ev) {
          ev.preventDefault();
          locked = (locked === st) ? null : st;
          filter(locked);
          say(locked, null, true);
        }
        s.addEventListener('click', toggle);
        s.addEventListener('keydown', function (ev) {
          if (ev.key === 'Enter' || ev.key === ' ') toggle(ev);
          if (ev.key === 'Escape') { locked = null; filter(null); say(null); }
        });
      });
    })();
  </script>

