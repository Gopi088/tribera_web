/* ══ COMPOUNDING RAMP ══ */
.ramp {
  margin-top: 6px;
}
.ramp__g {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 26px 16px;
}
@media (min-width: 720px) {
  .ramp__g {
    grid-template-columns: repeat(4, 1fr);
