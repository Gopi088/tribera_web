  border-radius: 6px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}
.desk__fill {
  display: block;
  height: 100%;
  border-radius: 6px;
  transform-origin: left;
  transform: scaleX(0);
  transition: transform 1.1s var(--ease);
}
.desk.in .desk__fill {
  transform: scaleX(1);
}
.desk__bar--frag {
  display: flex;
  gap: 3px;
  background: transparent;
  border: 0;
  padding: 0;
  overflow: visible;
}
.desk__bar--frag span {
  display: block;
  height: 12px;
  border-radius: 3px;
  background: #4e4e47;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s var(--ease);
}
.desk__bar--frag span:nth-child(2n) {
  background: #5c5c54;
}
.desk__bar--frag span:nth-child(3n) {
