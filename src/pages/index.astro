/* ══ RATIO drawn ══ */
.hg__mid {
  display: grid;
  justify-items: center;
  gap: 16px;
}
.cost {
  width: 100%;
  max-width: 270px;
  margin-top: 4px;
  padding-top: 16px;
  border-top: 1px solid var(--hair);
}
.cost__r {
  display: grid;
  grid-template-columns: 52px 1fr auto;
  gap: 10px;
  align-items: center;
  padding: 5px 0;
}
.cost__k {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--faint);
  text-align: right;
}
.cost__r--us .cost__k {
  color: var(--red);
}
.cost__b {
  height: 8px;
  border-radius: 4px;
  background: #e7e4dc;
  overflow: hidden;
}
.cost__f {
  display: block;
  height: 100%;
  width: var(--w);
  border-radius: 4px;
  background: #b4b0a6;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.9s var(--ease);
}
.cost.in .cost__f {
  transform: scaleX(1);
}
.cost__r--us .cost__f {
  background: var(--red);
  transition-delay: 0.25s;
}
.cost__v {
  font-family: var(--mono);
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
}
.cost__v i {
  font-style: normal;
  font-size: 10px;
  font-weight: 400;
  color: var(--faint);
  margin-left: 3px;
}
.cost__r--us .cost__v {
  color: var(--red);
}
.cost__ft {
  font-size: 12px;
  line-height: 1.5;
  color: var(--grey);
  margin: 12px 0 0;
  text-align: left;
}
.cost__ft b {
  color: var(--ink);
}
.ratio {
  display: grid;
  gap: 9px;
  width: 100%;
  max-width: 270px;
}
.ratio__r {
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 10px;
  align-items: center;
}
.ratio__k {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--faint);
  text-align: right;
}
.ratio__r--us .ratio__k {
  color: var(--red);
}
.ratio__sq {
  display: flex;
  gap: 5px;
}
.ratio__sq i {
  display: block;
  width: 17px;
  height: 17px;
  border-radius: 4px;
  background: #dcd9d1;
}
.ratio__sq i.hit {
  background: var(--ink);
}
.ratio__r--us .ratio__sq i {
  background: #e8e4da;
}
.ratio__r--us .ratio__sq i.hit {
  background: var(--red);
  box-shadow: 0 0 0 3px rgba(218, 0, 7, 0.16);
}
.ratio__ft {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--faint);
  margin: 0;
}

