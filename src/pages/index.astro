  }
}
@media (min-width: 980px) {
  .grid {
    grid-template-columns: repeat(18, 1fr);
    gap: 7px;
  }
}
.sq {
  position: relative;
  aspect-ratio: 1/1;
  border-radius: 19%;
  background: #3a3a37;
  transition:
    opacity 0.45s var(--ease),
    transform 0.32s var(--ease),
    box-shadow 0.2s var(--ease);
}
.sq.g1 {
  background: #3b3b36;
}
.sq.g2 {
  background: #57574f;
}
.sq.g3 {
  background: #85857c;
}
.sq.g4 {
  background: #d6d6cf;
}
.sq.g5 {
  background: var(--red);
  box-shadow: 0 0 0 1px rgba(218, 0, 7, 0.5);
}
.sq.out {
  opacity: 0.34;
  transform: scale(0.66);
}
.sq.g5.out {
  opacity: 0.55;
  transform: none;
}
/* hover trace — subtle */
.grid.peek .sq {
  opacity: 0.16;
}
.grid.peek .sq.co {
  opacity: 1;
  transform: none;
}
.grid.peek .sq.co.out {
  opacity: 0.85;
}
.grid .sq:hover {
  transform: none;
  z-index: 3;
  box-shadow:
    0 0 0 2px rgba(255, 255, 255, 0.9),
    0 2px 10px rgba(0, 0, 0, 0.55);
}
.grid .sq.g5:hover {
  box-shadow:
    0 0 0 2px #fff,
    0 0 14px rgba(218, 0, 7, 0.8);
}
.grid.peek .sq.co:hover {
  transform: none;
}

