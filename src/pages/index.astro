  <!-- ═══ CLOSE: two doors, same room ═══ -->
  <section class="wrap band" id="close">
    <div class="shead">
      <h2 class="h2" data-rv style="max-width:13ch">Two doors.<br />Same room.</h2>
      <p class="dek" data-rv style="--d:60ms">
        One of you is hiring and one of you is looking, and the whole job is the same either way —
        <b>putting the two who should be in a conversation into one</b>, and giving both of them a reason
        to trust it. Tell us which side you're on.
      </p>
    </div>
    <div class="doors">
      {
        doors.map(([title, body, nextDesc, ctaLabel, ctaHref, ctaClass], i) => (
          <div class="door" data-rv style={`--d:${i * 60}ms`}>
            <h3 class="h3">{title}</h3>
            <p>{body}</p>
            <p class="door__next">
              <span>Next</span> {nextDesc}
            </p>
            <a href={ctaHref} class:list={['btn', ctaClass]}>
              {ctaLabel}
            </a>
          </div>
        ))
      }
    </div>

    <p class="bbb2" data-rv><span>Belong</span><i></i><span>Build</span><i></i><span>Become</span></p>
    <p class="bbb2__s" data-rv>Tribe + Era. A hire only works if both sides were right about each other.</p>
  </section>

  <div class="stickcta" id="stickcta">
    <div class="wrap stickcta__in">
      <p><b>Looking for a role?</b><span>One conversation, and you stop applying.</span></p>
      <a href="#apply" class="btn btn--dark" style="padding:10px 20px;font-size:14px">Start now</a>
    </div>
  </div>
  </main>
</Layout>

<style is:global>
:root {
