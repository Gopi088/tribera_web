}
.ft__made {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

/* ══ MICRO-INTERACTIONS ══ */
/* signal rows grow a marker as they open */
.sig__r {
  position: relative;
  padding-left: 0;
  transition: padding-left 0.3s var(--ease);
}
.sig__r::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14px;
  width: 2px;
  height: 0;
  background: var(--red);
  border-radius: 2px;
  transition: height 0.3s var(--ease);
}
.sig__r:hover,
.sig__r:focus-within {
  padding-left: 12px;
}
.sig__r:hover::before,
.sig__r:focus-within::before {
  height: 14px;
}
.side {
  transition: background 0.3s var(--ease);
}
.side:hover {
  background: rgba(255, 255, 255, 0.018);
}

/* verdict pill breathes once when it arrives */
.duo.in .pill {
  animation: beat 2.2s var(--ease) 0.5s 1 both;
}
@keyframes beat {
  0% {
    box-shadow: 0 0 0 0 rgba(63, 190, 124, 0.35);
  }
  55% {
    box-shadow: 0 0 0 8px rgba(63, 190, 124, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(63, 190, 124, 0);
  }
}

/* client names come up on hover */
.logos__r span {
  transition: color 0.25s var(--ease);
  cursor: default;
}
.logos__r span:hover {
  color: #b4b4ad;
}

/* tags become filters */
.tag {
  transition:
    transform 0.18s var(--ease),
    box-shadow 0.25s var(--ease);
}
.key__i {
  cursor: pointer;
  padding: 5px 8px;
  margin: -5px -8px;
  border-radius: 999px;
  transition: background 0.2s var(--ease);
  outline: none;
}
.key__i:hover,
.key__i:focus-visible {
  background: rgba(0, 0, 0, 0.045);
}
.key__i:focus-visible {
  box-shadow: 0 0 0 2px var(--red);
}
.key__i:hover .tag,
.key__i:focus-visible .tag {
  transform: translateY(-1px);
}
.swap .swap__row {
  transition:
    background 0.22s var(--ease),
    opacity 0.28s var(--ease);
}
.swap.dim .swap__row:not(.hit) {
  opacity: 0.52;
}
.swap .swap__row.hit {
  background: rgba(0, 0, 0, 0.04);
}
.band--w .swap__row.hit,
.panel .swap__row.hit {
  background: #eeeeea;
}
.swap .swap__row.hit .tag {
  transform: translateY(-1px);
  box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
}
.swap .swap__row--keep.hit .tag {
  box-shadow: 0 0 0 3px rgba(218, 0, 7, 0.18);
}

/* guarantee + figures answer the cursor */
.gz__i .gz__k,
.adv__n {
  transition: color 0.25s var(--ease);
}
.gz__i:hover .gz__k {
  color: var(--red);
}
.tr {
  transition: background 0.22s var(--ease);
}
.tr:not(.tr--h):hover {
  background: rgba(255, 255, 255, 0.035);
}
@media (min-width: 800px) {
  .tr {
    margin-inline: -14px;
    padding-inline: 14px;
    border-radius: 8px;
  }
}

/* chips lift */

/* ══ NAV audience pill ══ */

.nav__sw a {
  font-size: 13px;
  padding: 6px 13px;
  border-radius: 999px;
  color: var(--onc2);
  text-decoration: none;
  white-space: nowrap;
  transition:
    background 0.2s,
    color 0.2s;
}

.nav__sw a:hover:not(.is) {
  color: #fff;
}

/* ══ APPLY card ══ */
.apply {
  margin-top: clamp(38px, 4.6vw, 60px);
  background: var(--char);
  border-radius: 20px;
  padding: clamp(26px, 3.4vw, 44px);
  color: var(--onc);
}
.apply__k {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--red);
  margin: 0 0 14px;
}
.apply__h {
  font-family: var(--display);
  font-weight: 700;
  font-size: clamp(23px, 2.9vw, 36px);
  line-height: 1.1;
  letter-spacing: -0.034em;
  color: #fff;
  margin: 0;
  max-width: 20ch;
}
.apply__s {
  font-size: 15.5px;
  line-height: 1.55;
  color: var(--onc2);
  margin: 14px 0 0;
  max-width: 48ch;
}
.apply__form {
  display: grid;
  gap: 10px;
  margin-top: clamp(22px, 2.6vw, 30px);
}
.apply__row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.apply__file {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 22px;
  border-radius: 999px;
  background: var(--onc);
  color: var(--char);
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
  transition: transform 0.18s var(--ease);
}
.apply__file:hover {
  transform: translateY(-1px);
}
.apply__file input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
.apply__or {
  display: flex;
  align-items: center;
  color: var(--onc3);
  font-size: 13.5px;
  padding: 0 4px;
}
.apply__ar {
  display: inline-block;
  transition: transform 0.3s var(--spring);
}
.apply__go:hover .apply__ar {
  transform: translateX(3px);
}
.apply__url,
.apply__mail {
  flex: 1;
  min-width: 220px;
  background: transparent;
  border: 1px solid var(--cline);
  border-radius: 999px;
  padding: 14px 20px;
  color: #fff;
  font-family: var(--ui);
  font-size: 15px;
  outline: none;
  transition:
    border-color 0.2s,
    box-shadow 0.2s;
}
.apply__url::placeholder,
.apply__mail::placeholder {
  color: var(--onc3);
}
.apply__url:focus,
.apply__mail:focus {
  border-color: var(--onc2);
}
.apply__mail {
  border-color: rgba(255, 255, 255, 0.28);
}
.apply__mail:focus {
  border-color: #fff;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
}
.apply__mail:invalid:not(:placeholder-shown) {
  border-color: rgba(224, 72, 78, 0.6);
}
.apply__row--2 {
  align-items: stretch;
}
.apply__go {
  padding: 15px 28px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  border-radius: 999px;
  border: 0;
  background: var(--red);
  color: #fff;
  font-family: var(--ui);
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
  white-space: nowrap;
  transition:
    transform 0.18s var(--ease),
    background 0.2s;
}
.apply__go:hover {
  transform: translateY(-1px);
  background: #c10006;
}
.apply__fine {
  font-size: 13px;
  color: var(--onc3);
  margin: 18px 0 0;
}
.apply__fine b {
  color: var(--onc);
  font-weight: 600;
}

/* ══ sticky candidate CTA ══ */
.stickcta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  transform: translateY(110%);
  transition: transform 0.4s var(--ease);
  background: rgba(19, 19, 19, 0.94);
  backdrop-filter: blur(12px);
  border-top: 1px solid var(--cline);
}
.stickcta.show {
  transform: none;
}
.stickcta__in {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 0;
}
.stickcta p {
  margin: 0;
  font-size: 14px;
  color: var(--onc2);
  flex: 1;
  line-height: 1.35;
}
.stickcta p b {
  color: #fff;
  font-weight: 600;
  display: block;
}
@media (max-width: 560px) {
  .stickcta p b {
    font-size: 14px;
  }
  .stickcta p span {
    display: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .stickcta {
    transition: none;
  }
}

/* ══ SECTION RHYTHM — the header owns the gap below it ══ */
.shead {
  margin-bottom: clamp(30px, 3.6vw, 52px);
}
.shead + * {
  margin-top: 0;
}
.shead + .ramp {
  margin-top: 0;
}

/* ══ THE SMALL RETURNS — press, spring, and group awareness ══ */
:root {
  --spring: cubic-bezier(0.34, 1.42, 0.64, 1);
}

/* 1. everything you can press, presses back */
.btn,
.ftab,
.pre,
.vseg,
.step,
.tl,
.lt,
.chip,
.key__i,
.inds__g span,
.qc,
.door,
.who__ph,
.xp,
.cmp__r,
.sig__r,
.swap__row {
  transition-timing-function: var(--spring);
}
.btn:active,
.ftab:active,
.pre:active,
.vseg:active,
.tl:active,
.lt:active,
.chip:active,
.key__i:active,
.inds__g span:active,
.qc:active {
  transform: scale(0.965);
  transition-duration: 0.08s;
}
.door:active,
.panel:active {
  transform: scale(0.995);
  transition-duration: 0.1s;
}
.step:active {
  transform: translateX(3px);
  transition-duration: 0.08s;
}
.flip:active {
  transform: scale(0.99);
}
.flip.is-b:active {
  transform: rotateY(180deg) scale(0.99);
}

/* 2. text links sweep instead of just changing colour */
.ft__col a,
.ft__social a,
.expect__lk,
.plans__ft a,
.chip__lk {
  position: relative;
}
.ft__col a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: -3px;
  height: 1px;
  background: currentColor;
  opacity: 0.5;
  transition: right 0.34s var(--spring);
}
.ft__col a:hover::after {
  right: 0;
}

/* 3. the dot in the wordmark notices you */
.logo i {
  display: inline-block;
  transition:
    transform 0.4s var(--spring),
    color 0.3s;
}
.logo:hover i {
  transform: translateY(-2px) scale(1.25);
}

/* 4. grouped tiles become aware of each other */
.bench__g:hover .xp {
  opacity: 0.55;
}
.bench__g:hover .xp:hover {
  opacity: 1;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  z-index: 2;
  position: relative;
}
.tiles:hover .tl {
  opacity: 0.6;
}
.tiles:hover .tl:hover {
  opacity: 1;
}
.whos__g:hover .who {
  opacity: 0.55;
}
.whos__g:hover .who:hover {
  opacity: 1;
}
.bench__g .xp,
.tiles .tl,
.whos .who {
  transition:
    opacity 0.28s var(--ease),
    transform 0.28s var(--spring),
    box-shadow 0.28s var(--ease),
    background 0.22s var(--ease);
}

/* 5. inputs lift a hair when they take focus */
.apply__url:focus,
.apply__mail:focus {
  transform: translateY(-1px);
}
.apply__url,
.apply__mail {
  transition:
    border-color 0.2s,
    box-shadow 0.2s,
    transform 0.3s var(--spring);
}

/* 6. the switcher settles rather than snapping */
.ftab,
.nav__sw a {
  transition:
    background 0.32s var(--spring),
    color 0.22s,
    transform 0.2s var(--spring);
}
.nav__sw a:active {
  transform: scale(0.94);
}

@media (prefers-reduced-motion: reduce) {
  .btn:active,
  .ftab:active,
  .pre:active,
  .vseg:active,
  .tl:active,
  .lt:active,
  .chip:active,
  .key__i:active,
  .qc:active,
  .door:active,
  .panel:active,
  .step:active,
  .flip:active,
  .logo:hover i {
    transform: none;
  }
  .ft__col a::after {
    transition: none;
  }
}

/* the four boxes are there to be compared — so let them be */
.ramp__g .rp {
  transition:
    opacity 0.3s var(--ease),
    transform 0.34s var(--spring);
}
.ramp__g:hover .rp {
  opacity: 0.42;
}
.ramp__g:hover .rp:hover {
  opacity: 1;
  transform: translateY(-4px);
}
.rp__acc b {
  transition: color 0.25s var(--ease);
}
.ramp__g:hover .rp:hover .rp__acc b {
  color: var(--red);
}
.rp .rk__ht,
.rp .rk__ln {
  transition: stroke-opacity 0.3s var(--ease);
}
.ramp__g:hover .rp:hover .rk__ht {
  stroke-opacity: 1;
}
@media (prefers-reduced-motion: reduce) {
  .ramp__g:hover .rp {
    opacity: 1;
  }
  .ramp__g:hover .rp:hover {
    transform: none;
  }
}

/* ══ THE LAB: the tiles and the sliders are the same instrument ══ */
.lt {
  cursor: default;
  outline: none;
}
.lt.lit {
  border-color: rgba(255, 255, 255, 0.55);
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.09);
  transform: translateY(-2px);
}
.lt.low.lit {
  border-color: rgba(232, 163, 61, 0.7);
  box-shadow: 0 0 0 3px rgba(232, 163, 61, 0.16);
}
.lt.heavy.lit {
  border-color: rgba(218, 0, 7, 0.75);
  box-shadow: 0 0 0 3px rgba(218, 0, 7, 0.2);
}
.row {
  margin-inline: -10px;
  padding-inline: 10px;
  border-radius: 8px;
  transition: background 0.24s var(--ease);
}
.row.lit {
  background: rgba(255, 255, 255, 0.05);
}
.row.lit .row__n {
  color: #fff;
}
.row.lit .row__p {
  color: #fff;
}
.row.lit .row__k {
  color: #fff;
}
@media (prefers-reduced-motion: reduce) {
  .lt.lit {
    transform: none;
  }
}

/* ══ HOW WE ENGAGE: tracing the path ══ */
.cg {
  transition:
    opacity 0.28s var(--ease),
    transform 0.3s var(--spring);
}
.cg__bar {
  transition:
    background 0.3s var(--ease),
    transform 0.34s var(--spring);
  transform-origin: left;
}
.cg__g:hover .cg {
  opacity: 0.45;
}
.cg__g:hover .cg:hover {
  opacity: 1;
  transform: translateY(-3px);
}
.cg__g:hover .cg:hover .cg__bar {
  background: var(--red);
  transform: scaleY(1.6);
}
.cg__w {
  transition: color 0.28s var(--ease);
}
.cg__g:hover .cg:hover .cg__w {
  color: var(--red);
}

/* ══ THE 1:3 HINGE: each side lights its own ratio ══ */
.hinge > div {
  transition: opacity 0.28s var(--ease);
}
.hinge:hover > div {
  opacity: 0.5;
}
.hinge:hover > div:hover,
.hinge:hover > .hg__mid {
  opacity: 1;
}
.ratio__r {
  transition: opacity 0.28s var(--ease);
}
.hinge > div:first-child:hover ~ .hg__mid .ratio__r--us {
  opacity: 0.35;
}
.hinge > div:last-child:hover ~ .hg__mid .ratio__r {
  opacity: 0.35;
}
.ratio__sq i {
  opacity: 0;
  transition:
    transform 0.3s var(--spring),
    background 0.25s var(--ease);
}
.hinge.in .ratio__sq i {
  animation: sqin 0.34s var(--ease) both;
}
@keyframes sqin {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.hinge.in .ratio__r--us .ratio__sq i {
  animation-delay: 0.5s;
}
.hinge.in .ratio__sq i:nth-child(1) {
  animation-delay: 0.05s;
}
.hinge.in .ratio__sq i:nth-child(2) {
  animation-delay: 0.11s;
}
.hinge.in .ratio__sq i:nth-child(3) {
  animation-delay: 0.17s;
}
.hinge.in .ratio__sq i:nth-child(4) {
