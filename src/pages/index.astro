  .rp__slot {
    height: 216px;
  }
}
.rk {
  display: block;
  width: 100%;
  max-width: 230px;
  height: calc(var(--h) * 0.62);
}
@media (min-width: 720px) {
  .rk {
    height: var(--h);
  }
}
.rk svg {
  width: 100%;
  height: 100%;
  display: block;
  overflow: visible;
}
.rk__ln,
.rk__ht {
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
}
.ramp.in .rk__ln {
  animation: drawbox 0.55s ease-out var(--d) forwards;
}
.ramp.in .rk__ln2 {
  animation-duration: 0.4s;
  animation-delay: calc(var(--d) + 0.28s);
