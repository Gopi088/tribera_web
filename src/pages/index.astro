---
import Layout from '~/layouts/PageLayout.astro';
import Brands from '~/components/widgets/Brands.astro';
import { Icon } from '~/components/common/icon-module';
const metadata = {
  title: 'tribera — 3 vetted candidates in 36 hours | 1:3 hiring guarantee',
  description:
    'Senior advisors interview. AI validates. You get 3 hire-ready candidates — guaranteed 1:3 selection ratio. Trusted by leading Indian GCCs, top-tier services, and startups',
  ignoreTitleTemplate: true,
};

const customerstories = [
  {
    quote:
      '32 Java engineers in 4 months. Our team struggled for 8. The 1:3 ratio is real—interviewed 11, made 8 offers, all accepted.',
    name: 'Head of Talent',
    company: 'SaaS Company',
  },
  {
    quote:
      'Unlike mass applications, tribera matches you to roles where you actually fit.The Interview felt like a real conversation, not interrogation.',
    name: 'Co-founder',
    company: 'AI Startup',
  },
  {
    quote:
      'Reduced our ratio from 9:1 to 3:1 in Q1. Saved 200+ manager hours. We focus on real signal over inflated resume',
    name: 'VP Engineering',
    company: 'Enterprise Tech',
  },
  {
    quote:
      'Got 3 interview calls in one week—all relevant to my skills. No spam. Advisor prepped me well. Landed my dream role.',
    name: 'People Ops Lead',
    company: 'Product Company',
  },
  {
    quote:
      'Closed 4 senior platform hires in 6 weeks after 3 failed agency cycles. Structured evaluation changed how our managers assess talent.',
    name: 'CTO',
    company: 'Fintech Company',
  },
  {
    quote:
      'Brought discipline to our hiring—clear role patterns, sharper interviews, zero random profiles. Decision time dropped 40%.',
    name: 'Director – Talent Acquisition',
    company: 'Global Capability Center',
  },
];

const comparisonRows = [
  { feature: '100+ Signal Analysis', tribera: 'check', saas: '✗', rpo: '✗' },
  { feature: 'Technical Deep-Dive Interviews', tribera: 'check', saas: '✗', rpo: 'Surface only' },
  { feature: '1:3 Selection Guarantee*', tribera: 'check', saas: '✗', rpo: '✗' },
  { feature: 'Explainable AI Decisions', tribera: 'check', saas: 'Partial', rpo: '✗' },
  { feature: 'Time to First Shortlist', tribera: '36 hours', saas: 'You do it', rpo: '2-3 weeks' },
  { feature: 'Pricing Model', tribera: 'Per hire', saas: 'Monthly fee', rpo: '% of salary' },
];
---

<Layout metadata={metadata}>
  <section class="relative min-h-[90vh] md:min-h-screen flex items-center justify-center overflow-hidden bg-black">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-black"></div>

      <div
        class="absolute left-[-30%] md:left-[-15%] top-0 h-full w-[90%] md:w-[60%]
      bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.45),transparent_60%)]"
      >
      </div>

      <div
        class="absolute right-[-30%] md:right-[-15%] top-0 h-full w-[90%] md:w-[60%]
      bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.45),transparent_60%)]"
      >
      </div>
    </div>

    <div class="absolute inset-0 pointer-events-none">
      {
        Array.from({ length: 22 }).map(() => (
          <span
            class="absolute rounded-full bg-[#da0007]/80"
            style={`
          width:3px;
          height:3px;
          left:${12 + Math.random() * 76}%;
          top:${8 + Math.random() * 84}%;
          --float-x1:${(Math.random() * 44 - 22).toFixed(1)}px;
          --float-y1:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x2:${(Math.random() * 52 - 26).toFixed(1)}px;
          --float-y2:${(Math.random() * 42 - 21).toFixed(1)}px;
          --float-x3:${(Math.random() * 60 - 30).toFixed(1)}px;
          --float-y3:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-y4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-x5:${(Math.random() * 56 - 28).toFixed(1)}px;
          --float-y5:${(Math.random() * 40 - 20).toFixed(1)}px;
          --float-x6:${(Math.random() * 50 - 25).toFixed(1)}px;
          --float-y6:${(Math.random() * 34 - 17).toFixed(1)}px;
          --float-scale1:${(1 + Math.random() * 0.28).toFixed(2)};
          --float-scale2:${(0.78 + Math.random() * 0.18).toFixed(2)};
          --float-scale3:${(1.02 + Math.random() * 0.22).toFixed(2)};
          --float-scale4:${(0.82 + Math.random() * 0.14).toFixed(2)};
          --float-scale5:${(1 + Math.random() * 0.2).toFixed(2)};
          --float-scale6:${(0.86 + Math.random() * 0.14).toFixed(2)};
          animation: float ${11 + Math.random() * 14}s ease-in-out infinite;
          animation-delay: -${(Math.random() * 18).toFixed(1)}s;
          box-shadow: 0 0 10px rgba(218,0,7,.6);
        `}
          />
        ))
      }
    </div>

    <div class="relative z-10 max-w-[1080px] mx-auto px-6 text-center">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#da0007]/40 bg-white/[0.03] px-3.5 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/80"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#da0007]"></span>
        <span>Pre-screened. Advisor-interviewed. Hire-ready.</span>
      </div>
      <h1 class="font-[600] leading-[1.02] sm:leading-[1.08]">
        <span
          class="block whitespace-nowrap text-white text-[clamp(2.15rem,10.8vw,3rem)] sm:text-[clamp(2.8rem,6vw,5rem)] tracking-[-0.08em]"
        >
          AI finds the signal.
        </span>

        <span
          class="block text-[clamp(2.45rem,12vw,3.4rem)] sm:text-[clamp(2.8rem,6vw,5rem)] text-[#da0007] tracking-[-0.08em]"
        >
          Advisors validate.
        </span>

        <span class="block text-[clamp(2.45rem,12vw,3.4rem)] sm:text-[clamp(2.8rem,6vw,5rem)] tracking-[-0.08em]">
          <!-- <span class="text-[#da0007]">them.</span> -->
          <span class="text-white"> You hire.</span>
        </span>
      </h1>

      <p
        class="mt-6 md:mt-8 text-white/60 text-[16px] md:text-[20px] max-w-2xl md:max-w-3xl mx-auto leading-relaxed px-2"
      >
        Hundreds screened. Three shortlisted. All ready to hire.
      </p>

      <div class="mt-8 md:mt-12 flex flex-col sm:flex-row flex-wrap justify-center items-center gap-4 sm:gap-5">
        <div
          class="flex w-auto max-w-full flex-col items-center gap-1
                  px-4 py-3
                  rounded-xl
                  border border-[#da0007]/40
                  bg-[#da0007]/20
                  text-center text-white
                  sm:w-auto sm:flex-row sm:gap-2 sm:px-5 sm:text-left"
        >
          <span class="whitespace-nowrap text-[13px] font-[600] leading-tight text-white/90">
            <span class="text-[#da0007]">1:3</span> Selection Ratio Guarantee*
          </span>

          <span class="text-[11px] font-[550] leading-tight text-white/50">Interview 3, hire 1</span>
        </div>

        <button
          type="button"
          data-form-intent="demo"
          data-form-source="homepage_hero"
          class="px-6 py-3 rounded-full
                bg-[#ff0000]
                text-white
                text-[13px]
                font-bold
                transition-all duration-300
                hover:bg-[#e00000]"
        >
          Book a Demo
        </button>

        <a
          href="#how-it-works"
          class="px-6 py-3 rounded-full
                bg-[#121212]
                border border-white/10
                text-white/80
                text-[13px]
                font-bold
                transition-all duration-300
                hover:border-white/20"
        >
          See How It Works →
        </a>
      </div>

      <p class="mt-8 md:mt-14 text-white/30 text-[12px] font-[550]">*We'll walk you through it</p>
    </div>
  </section>

  <section class="w-full px-6 md:px-8 py-6 md:py-10 gap-10 relative">
    <div class="pointer-events-none absolute inset-0 bg-dotted-static opacity-80"></div>

    <Brands
      title="Who We Work With"
      subtitle="Trusted by high-impact <br /> teams across industries"
      mobileSubtitleSingleLine={true}
      images={[
        { src: '~/assets/images/ICICBank.png', alt: 'ICICI Bank' },
        { src: '~/assets/images/Aeries.png', alt: 'Aeries' },
        { src: '~/assets/images/DSP_Mutual_Funds.png', alt: 'DSP Mutual Fund' },
        { src: '~/assets/images/Enpro.png', alt: 'Enpro' },
        { src: '~/assets/images/Volkwagen.png', alt: 'Volkswagen' },
        { src: '~/assets/images/UtkarshBank.png', alt: 'Utkarsh Bank' },
        { src: '~/assets/images/TechnologyHoldings.png', alt: 'TechnologyHoldings' },
        { src: '~/assets/images/Payu.png', alt: 'PayU' },
        { src: '~/assets/images/ICICISecurities.png', alt: 'ICICISecurities' },
        { src: '~/assets/images/SplashBI.png', alt: 'SplashBI' },
        { src: '~/assets/images/AegonLife.png', alt: 'AegonLife' },
      ]}
    />
  </section>

  <section id="platform-overview" class="bg-black px-6 sm:px-10 lg:px-20 py-12 md:py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-[1fr_1.3fr] gap-12 lg:gap-20 items-center">
      <div>
        <p class="text-[11px] tracking-[0.1em] font-[550] text-[#da0007] uppercase">How it works</p>

        <h2 class="text-white font-[650] leading-[1]
                 text-[clamp(1.5rem,5vw,2rem)]">
          We run the interview. You make the decision.
        </h2>

        <p class="mt-4 text-white/50 max-w-lg text-[15px] leading-relaxed">
          AI eliminates unqualified profiles before a single human hour is spent. A senior advisor interviews the
          standouts. You get three decision-ready candidates — in 36 hours.
        </p>

        <div
          class="relative mt-6 max-w-xl overflow-hidden rounded-xl
            border border-[#da0007]/40
            bg-gradient-to-br from-[#1a0000] to-[#2a0000]
            p-5 sm:p-5 text-white"
        >
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <div
              class="w-[200px] h-[200px]
                bg-[radial-gradient(circle,rgba(218,0,7,0.9),transparent_70%)]
                blur-[40px]
                animate-[redInnerGlow_4s_ease-in-out_infinite]"
            >
            </div>
          </div>

          <div class="relative z-10 text-[13px] font-[400] leading-relaxed text-white/85">
            <p>
              <span class="text-[#da0007] text-[14px] font-[500]">Before this card reached you</span>
            </p>

            <p class="mt-5 text-[13px] font-[400] text-white/85">
              AI screened 100+ signals — RED profiles eliminated before any human time was spent. A senior domain
              advisor ran a structured interview — 20+ role-specific questions, independently scored. AI then produced a
              composite verdict across all three layers. Every score is auditable, attributable, and reusable.
            </p>
          </div>
        </div>

        <div class="mt-3 divide-y divide-white/10">
          {
            [
              {
                title: 'One clear verdict — GREEN, GREY, or RED',
                desc: 'No ambiguity. You know whether to interview before you open the profile.',
              },
              {
                title: '100+ signals — not just what they claimed',
                desc: 'GitHub activity, project depth, Stack Overflow — what they actually built, verified.',
              },
              {
                title: 'Will they fit your team — and stay?',
                desc: 'Culture alignment, communication style, 12-month retention likelihood scored upfront.',
              },
              {
                title: 'Joining probability before you make an offer',
                desc: 'Know offer acceptance likelihood, performance potential, and team integration fit.',
              },
            ].map((item) => (
              <div class="candidate-signal-item group flex gap-4 items-start py-3 transition duration-300">
                <span
                  class="candidate-signal-icon mt-1 w-5 h-5 rounded-full bg-[#da0007]/20 text-[#da0007]
                         flex items-center justify-center text-[13px] font-semibold"
                >
                  ✓
                </span>

                <div>
                  <h4 class="candidate-signal-title text-white font-[550] text-[15px]">{item.title}</h4>
                  <p class="text-white/50 text-[13px] mt-1 max-w-xs">{item.desc}</p>
                </div>
              </div>
            ))
          }
        </div>

        <a
          href="#how-it-works"
          class="mt-6 inline-flex items-center text-[13px] font-semibold text-white/85 transition-colors duration-300 hover:text-[#da0007]"
        >
          See how we build your shortlist →
        </a>
      </div>

      <div
        class="flex
            justify-start
            lg:justify-center
            items-start
            perspective-[1024px]
            mt-12 lg:mt-0"
      >
        <div class="group transform-gpu animate-[floatCard_6s_ease-in-out_infinite]">
          <div
            class="transition-transform duration-700 ease-out
                [transform:rotateX(4deg)_rotateY(-10deg)]
                group-hover:[transform:rotateX(0deg)_rotateY(0deg)]"
          >
            <div
              id="candidateScorecard"
              class="relative w-full max-w-[678px] overflow-hidden
                  border-x border-b border-black/6 bg-[#f3f3f3]
                  shadow-[0_28px_80px_rgba(0,0,0,0.16)]"
            >
              <div class="absolute inset-x-0 top-0 h-[6px] bg-[#da0007]"></div>

              <div class="px-7 pb-4 pt-6 sm:px-8 sm:pb-5 sm:pt-7">
                <div class="mb-4 flex items-center justify-between">
                  <div class="text-[11px] font-semibold uppercase tracking-[0.42em] text-black/45">Your shortlist</div>

                  <div class="flex items-center gap-2.5">
                    <div class="flex items-center gap-1.5">
                      <span class="h-2 w-2 rounded-full bg-[#9b9b9b]"></span>
                      <span class="h-2 w-2 rounded-full bg-[#9b9b9b]"></span>
                      <span class="h-2 w-2 rounded-full bg-[#da0007]"></span>
                    </div>
                    <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-black/45">3 of 3</span>
                  </div>
                </div>

                <div>
                  <div class="text-[38px] leading-none tracking-[-0.04em] sm:text-[44px] font-semibold text-black">
                    Bharat R.
                  </div>
                  <p class="mt-5 text-[15px] text-black/58 sm:text-[16px]">Microservices · 6+ yrs · Bengaluru</p>

                  <span
                    class="mt-5 inline-flex rounded-full bg-[#da0007] px-7 py-2.5 text-[10px] font-bold uppercase tracking-[0.14em] text-white"
                  >
                    Strong Yes
                  </span>
                </div>

                <div class="mt-6 h-px w-full bg-black/12"></div>

                <div class="mb-2 bg-white/70 border border-black/[0.03] p-4 rounded-[8px]">
                  <div class="text-[11px] tracking-wide font-medium text-black/35 uppercase mb-2">Overall Verdict</div>

                  <div class="text-3xl font-bold text-[#da0007] leading-none">GREEN</div>

                  <p class="mt-2 text-[13px] text-black/60 leading-snug">
                    Excellent technical depth with 6+ years in microservices. Available in 2 weeks.
                  </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  {
                    [
                      ['Technical', '3.8/4', '95%'],
                      ['Role Fit', '92%', '90%'],
                      ['Join Prob', '87%', '87%'],
                      ['Retention', '89%', '89%'],
                    ].map(([label, value, width]) => (
                      <div class="rounded-[8px] bg-white/70 border border-black/[0.03] p-3.5">
                        <div class="text-[11px] font-medium tracking-wide text-black/35 uppercase">{label}</div>

                        <div class="text-2xl font-semibold mt-1 text-black leading-none">{value}</div>

                        <div class="mt-2 h-[3px] bg-slate-300 rounded-full overflow-hidden">
                          <div
                            class="h-full bg-[#da0007] w-0 transition-all duration-[1400ms] ease-[cubic-bezier(0.22,1,0.36,1)] metric-bar"
                            data-width={width}
                          />
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="proof" class="bg-[#f5f5f5]">
    <div class="wrap" style="max-width:1200px;margin-inline:auto;padding-inline:clamp(20px,5vw,40px);padding-block:clamp(72px,9vw,130px)">
      <div class="head" style="margin-bottom:clamp(44px,5.5vw,72px)">
        <p class="eyebrow" style="font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:#DA0007;text-align:center;margin:0 0 24px" data-rv>The proof</p>
        <h2 class="h2" style="font-family:Figtree,'Inter Tight',-apple-system,BlinkMacSystemFont,sans-serif;font-weight:700;font-size:clamp(31px,4.6vw,58px);line-height:1.04;letter-spacing:-.038em;text-align:center;margin:0 auto;max-width:19ch;--d:70ms" data-rv>You interview three. We evaluated 126.</h2>
        <p class="dek" style="font-size:clamp(16px,1.5vw,18px);line-height:1.6;color:#6B6B6B;text-align:center;max-width:64ch;margin:22px auto 0;--d:150ms" data-rv>1:3 is the number you see at the end. This is one mandate at full size &mdash; every mark is a real profile, and every stage narrows on evidence. Until the last one, which is yours.</p>
      </div>

      <div class="card" style="background:#fff;border-radius:20px;box-shadow:0 2px 30px rgba(0,0,0,.07);overflow:hidden;max-width:1060px;margin:0 auto;--d:60ms" data-rv>
        <div class="card__bar" style="height:5px;background:linear-gradient(90deg,#DDDDDD 0% 76.19%,#C2C2C2 76.19% 88.889%,#9C9C9C 88.889% 94.444%,#6E6E6E 94.444% 97.619%,#111111 97.619% 99.206%,#DA0007 99.206% 100%)"></div>
        <div class="card__in" style="padding:clamp(26px,3.6vw,46px)">
          <p class="card__lbl" style="font-size:11.5px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6B6B6B;margin:0 0 28px;text-align:center">One mandate &middot; sourced to signed</p>

          <div class="marks" id="marks" role="img" aria-label="126 profiles: 96 eliminated at AI screen, 16 after HR interview, 7 after domain interview, 4 scored below the top three, 3 reached the client, all hireable, 1 chosen." style="display:grid;grid-template-columns:repeat(14,1fr);gap:8px 7px;margin-bottom:14px">
            {Array.from({length:96},(_,i)=>(<span class="mk mk--s1" data-s="s1" data-i={i+1} style={`height:26px;border-radius:3px;background:#DDDDDD;--d:${Math.round(i*3.4)}ms`}></span>))}
            {Array.from({length:16},(_,i)=>(<span class="mk mk--s2" data-s="s2" data-i={97+i} style={`height:26px;border-radius:3px;background:#C2C2C2;--d:${326+Math.round(i*3.2)}ms`}></span>))}
            {Array.from({length:7},(_,i)=>(<span class="mk mk--s3" data-s="s3" data-i={113+i} style={`height:26px;border-radius:3px;background:#9C9C9C;--d:${380+Math.round(i*3.5)}ms`}></span>))}
            {Array.from({length:4},(_,i)=>(<span class="mk mk--s4" data-s="s4" data-i={120+i} style={`height:26px;border-radius:3px;background:#6E6E6E;--d:${404+Math.round(i*3.3)}ms`}></span>))}
            {Array.from({length:2},(_,i)=>(<span class="mk mk--s5" data-s="s5" data-i={124+i} style={`height:26px;border-radius:3px;background:#111111;--d:${558+i*3}ms`}></span>))}
            <span class="mk mk--s6" data-s="s6" data-i="126" style="height:26px;border-radius:3px;background:#DA0007;--d:565ms"></span>
          </div>
          <p class="axis" style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;font-size:11.5px;color:#6B6B6B;letter-spacing:.06em;margin:0 0 36px"><span>126 sourced</span><span class="readout" id="readout" style="flex:1;text-align:center;color:#A6A6A6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Hover any mark to trace a profile</span><span>1 hired</span></p>

          <div class="stages" style="display:grid;gap:26px;border-top:1px solid #E8E8E8;padding-top:36px">
            <div class="stage" data-stage="s1" tabindex="0" data-rv style="--d:0ms;border-radius:12px;padding:14px;margin:-14px;transition:background .28s ease;outline:none">
              <span class="stage__track" style="display:block;height:3px;background:#ECECEC;border-radius:2px;overflow:hidden;margin-bottom:18px"><i class="stage__fill stage__fill--s1" style="display:block;height:100%;width:100%;min-width:2px;border-radius:2px;background:#DDDDDD;transition:width 1.05s cubic-bezier(.16,1,.3,1)"></i></span>
              <p class="stage__n" style="font-family:Figtree,'Inter Tight',-apple-system,BlinkMacSystemFont,sans-serif;font-weight:700;font-size:clamp(28px,3vw,38px);line-height:1;letter-spacing:-.036em;margin:0 0 9px">126</p>
              <p class="stage__l" style="font-size:13px;font-weight:600;margin:0 0 7px;letter-spacing:-.005em;line-height:1.35">Sourced &amp; AI-screened</p>
              <p class="stage__d" style="font-size:12.5px;line-height:1.5;color:#6B6B6B;margin:0">100+ signals per profile. RED profiles eliminated before a single human minute is spent.</p>
            </div>
            <div class="stage" data-stage="s2" tabindex="0" data-rv style="--d:80ms;border-radius:12px;padding:14px;margin:-14px;transition:background .28s ease;outline:none">
              <span class="stage__track" style="display:block;height:3px;background:#ECECEC;border-radius:2px;overflow:hidden;margin-bottom:18px"><i class="stage__fill stage__fill--s2" style="display:block;height:100%;width:23.81%;min-width:2px;border-radius:2px;background:#C2C2C2;transition:width 1.05s cubic-bezier(.16,1,.3,1)"></i></span>
              <p class="stage__n" style="font-family:Figtree,'Inter Tight',-apple-system,BlinkMacSystemFont,sans-serif;font-weight:700;font-size:clamp(28px,3vw,38px);line-height:1;letter-spacing:-.036em;margin:0 0 9px">30</p>
              <p class="stage__l" style="font-size:13px;font-weight:600;margin:0 0 7px;letter-spacing:-.005em;line-height:1.35">Cleared AI &middot; HR interview</p>
              <p class="stage__d" style="font-size:12.5px;line-height:1.5;color:#6B6B6B;margin:0">A Talent Advisor runs a structured HR conversation &mdash; motivation, notice, comp, authenticity.</p>
            </div>
            <div class="stage" data-stage="s3" tabindex="0" data-rv style="--d:160ms;border-radius:12px;padding:14px;margin:-14px;transition:background .28s ease;outline:none">
              <span class="stage__track" style="display:block;height:3px;background:#ECECEC;border-radius:2px;overflow:hidden;margin-bottom:18px"><i class="stage__fill stage__fill--s3" style="display:block;height:100%;width:11.11%;min-width:2px;border-radius:2px;background:#9C9C9C;transition:width 1.05s cubic-bezier(.16,1,.3,1)"></i></span>
