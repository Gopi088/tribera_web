/* two-sided Decision Package */
.hero__card {
  perspective: 1600px;
  position: relative;
}
/* ambient light behind the object */
.hero__card::before {
  content: "";
  position: absolute;
  inset: -14% -8% -18%;
  pointer-events: none;
  background: radial-gradient(58% 52% at 62% 34%, rgba(218, 0, 7, 0.14), transparent 70%);
  filter: blur(28px);
  opacity: 0.55;
  transition:
    opacity 0.8s var(--ease),
    transform 0.8s var(--ease);
}
.hero__card.is-flipped::before {
  opacity: 0.85;
  transform: translateX(-6%);
}
.tilt {
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  transition: transform 0.5s var(--ease);
  will-change: transform;
}
.tilt.live {
  transition: transform 0.12s linear;
}
.ftabs {
  display: inline-flex;
  gap: 2px;
  padding: 3px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--cline);
  margin-bottom: 16px;
}
.ftab {
  font-family: var(--ui);
  font-size: 12.5px;
  font-weight: 600;
  padding: 7px 15px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--onc2);
  cursor: pointer;
  transition:
    background 0.25s var(--ease),
    color 0.25s var(--ease);
}
.ftab.is {
  background: var(--onc);
  color: var(--char);
}
.ftab:not(.is):hover {
  color: #fff;
}
.ftab:focus-visible {
  outline: 2px solid var(--red);
  outline-offset: 2px;
}

.flip {
  position: relative;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.9s cubic-bezier(0.22, 0.85, 0.24, 1);
  cursor: pointer;
}
.flip.is-b {
  transform: rotateY(180deg);
}
.face {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(158deg, #232320 0%, #1a1a18 42%, #141413 100%);
  border: 1px solid #33332e;
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 0.06) inset,
    0 -1px 0 rgba(0, 0, 0, 0.5) inset,
    0 30px 70px rgba(0, 0, 0, 0.5),
    0 4px 14px rgba(0, 0, 0, 0.35);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
/* specular highlight that follows the pointer */
.face::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 4;
  background: radial-gradient(
    420px circle at var(--mx, 70%) var(--my, 0%),
    rgba(255, 255, 255, 0.09),
    rgba(255, 255, 255, 0.03) 32%,
    transparent 58%
  );
  opacity: 0;
  transition: opacity 0.45s var(--ease);
}
.hero__card:hover .face::after {
  opacity: 1;
}
/* the lit top edge of a physical card */
.face__glint {
  position: absolute;
  top: 0;
  left: 8%;
  right: 8%;
  height: 1px;
  z-index: 5;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
}
.face--b {
  position: absolute;
  inset: 0;
  transform: rotateY(180deg);
}
.face__hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 12px 20px;
  border-bottom: 1px solid var(--cline);
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--onc3);
}
.face--b .face__hd {
  color: var(--red);
}
.side {
  padding: clamp(17px, 1.9vw, 24px);
}
.side__hd {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 15px;
}
.side__nm {
  font-family: var(--display);
  font-weight: 700;
  font-size: 20px;
  letter-spacing: -0.028em;
  margin: 0;
  color: #fff;
}
.side__sub {
  font-size: 12.5px;
  color: var(--onc3);
  margin: 5px 0 0;
}
.side__sub b {
  color: var(--grn);
  font-weight: 600;
}
.rank {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.16em;
  color: var(--red);
}
.vrd {
  margin: 16px 0 6px;
  padding: 13px 15px;
  border-radius: 10px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018));
  border: 1px solid rgba(255, 255, 255, 0.09);
}
.vrd__k {
  font-family: var(--mono);
  font-size: 9.5px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--onc3);
  margin: 0 0 8px;
}
.vrd__t {
  font-family: var(--display);
  font-weight: 700;
  font-size: clamp(15.5px, 1.45vw, 18px);
  line-height: 1.3;
  letter-spacing: -0.022em;
  color: #fff;
  margin: 0;
}
.scr {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  flex: none;
  min-width: 112px;
}
.scr__n {
  display: flex;
  align-items: baseline;
  gap: 3px;
}
.scr b {
  font-family: var(--mono);
  font-weight: 700;
  font-size: 28px;
  letter-spacing: -0.045em;
  color: #fff;
  line-height: 1;
}
.scr i {
  font-family: var(--mono);
  font-style: normal;
  font-size: 11px;
  color: var(--onc3);
}
.scale {
  position: relative;
  display: block;
  width: 100%;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.1);
  margin-top: 3px;
  overflow: visible;
}
.scale__sel {
  position: absolute;
  left: 68%;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 0 2px 2px 0;
  background: rgba(63, 190, 124, 0.4);
}
.scale__pin {
  position: absolute;
  left: 84%;
  top: -3px;
  width: 2px;
  height: 10px;
  border-radius: 1px;
  background: var(--grn);
  box-shadow: 0 0 8px rgba(63, 190, 124, 0.8);
}
.scale__k {
  font-family: var(--mono);
  font-size: 8.5px;
  letter-spacing: 0.08em;
  color: var(--onc3);
}
.tiles {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 5px;
  margin-top: 16px;
}
.tl {
  position: relative;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 7px 8px 6px;
  border-radius: 7px;
  cursor: default;
  background: rgba(255, 255, 255, calc(0.028 + var(--s) * 0.036));
  border: 1px solid rgba(255, 255, 255, calc(0.05 + var(--s) * 0.022));
  transition:
    background 0.25s var(--ease),
    border-color 0.25s var(--ease),
    transform 0.2s var(--ease);
}
.tl:hover,
.tl:focus-visible {
  transform: translateY(-2px);
  border-color: rgba(255, 255, 255, 0.4);
  outline: none;
}
.tl i {
  font-family: var(--mono);
  font-style: normal;
  font-size: 9px;
  letter-spacing: 0.06em;
  color: var(--onc3);
}
.tl b {
  font-family: var(--mono);
  font-weight: 700;
  font-size: 14px;
  color: #fff;
  line-height: 1;
}
.tl--low b {
  color: #e8a33d;
}
.tl--low {
  border-color: rgba(232, 163, 61, 0.3);
}
.tiles__cap {
  font-size: 11.5px;
  line-height: 1.4;
  color: var(--onc3);
  margin: 9px 0 0;
  min-height: 16px;
  transition: color 0.2s;
}
.tiles__cap.is {
  color: var(--onc2);
}
.rub {
  display: grid;
  gap: 0;
  margin-top: 14px;
  border-top: 1px solid var(--cline);
}
.rub__r {
  display: grid;
  grid-template-columns: 14px 1fr auto;
  gap: 10px;
  align-items: baseline;
  padding: 5.5px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.045);
}
.rub__k {
  font-family: var(--mono);
  font-size: 9.5px;
  color: var(--red);
}
.rub__n {
  font-size: 12.5px;
  color: var(--onc2);
}
.rub__p {
  font-family: var(--mono);
  font-size: 11.5px;
  color: #fff;
}
.notes {
  margin-top: 13px;
  border-top: 1px solid var(--cline);
  padding-top: 12px;
  display: grid;
  gap: 9px;
}
.note {
  display: grid;
  grid-template-columns: 58px 1fr;
  gap: 12px;
  align-items: baseline;
}
.note__k {
  font-family: var(--mono);
  font-size: 9.5px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--onc3);
}
.note--warn .note__k {
  color: #e8a33d;
}
.note__v {
  font-size: 12.5px;
  line-height: 1.45;
  color: var(--onc2);
  margin: 0;
}
.note--warn .note__v {
  color: #dad4c7;
}
.pill {
  font-family: var(--mono);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.16em;
  padding: 8px 13px;
  border-radius: 8px;
  color: var(--grn);
  white-space: nowrap;
  background: linear-gradient(180deg, rgba(63, 190, 124, 0.2), rgba(63, 190, 124, 0.08));
  border: 1px solid rgba(63, 190, 124, 0.42);
  box-shadow:
    0 0 22px rgba(63, 190, 124, 0.18),
    0 1px 0 rgba(255, 255, 255, 0.08) inset;
}
.sig {
  border-top: 1px solid var(--cline);
}
.sig__r {
  position: relative;
  padding: 8.5px 0;
  cursor: default;
  transition: padding-left 0.3s var(--ease);
}
.sig__r::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14px;
  width: 2px;
  height: 0;
  background: var(--red);
  border-radius: 2px;
  transition: height 0.3s var(--ease);
}
.sig__r:hover,
.sig__r:focus-within {
  padding-left: 12px;
}
.sig__r:hover::before,
.sig__r:focus-within::before {
  height: 14px;
}
.sig__t {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 14px;
}
.sig__l {
  font-size: 13.5px;
  color: var(--onc2);
}
.sig__v {
  font-family: var(--mono);
  font-size: 13.5px;
  font-weight: 500;
  color: #fff;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 9px;
}
.mtr {
  display: inline-grid;
  grid-template-columns: repeat(4, 7px);
  gap: 3px;
}
.mtr i {
  height: 7px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.13);
}
.mtr i.on {
  background: var(--grn);
  box-shadow: 0 0 8px rgba(63, 190, 124, 0.5);
}
.sig__w {
  display: grid;
  grid-template-rows: 0fr;
  transition:
    grid-template-rows 0.42s var(--ease),
    opacity 0.32s var(--ease);
  opacity: 0;
}
.sig__w > span {
  overflow: hidden;
  display: block;
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--onc3);
}
.sig__r:hover .sig__w,
.sig__r:focus-within .sig__w {
  grid-template-rows: 1fr;
  opacity: 1;
}
.sig__r:hover .sig__w > span {
  padding-top: 7px;
}
.face__ft {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 11px 20px;
  border-top: 1px solid var(--cline);
  background: rgba(0, 0, 0, 0.24);
  font-size: 12px;
  color: var(--onc3);
}
.lg {
  display: flex;
  gap: 14px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
}
.lg i {
  font-style: normal;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.lg i::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 2px;
  background: currentColor;
}
.lg--g {
  color: var(--grn);
}
.lg--y {
  color: #9b9b95;
}
.lg--r {
  color: #e0484e;
}
@media (prefers-reduced-motion: reduce) {
  .flip {
    transition: none;
  }
  .face--b {
    transition: none;
  }
}

.logos {
  border-top: 1px solid var(--cline);
  padding-block: 20px;
  margin-top: clamp(28px, 3.4vw, 46px);
}
.logos {
  display: grid;
  gap: 14px;
  align-items: baseline;
}
@media (min-width: 820px) {
  .logos {
    grid-template-columns: 150px 1fr;
    gap: 0 30px;
  }
}
.logos__l {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--onc3);
  margin: 0;
}
.logos__vp {
  overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
}
.logos__tk {
  display: flex;
  align-items: center;
  gap: 34px;
  width: max-content;
  animation: logoscroll 78s linear infinite;
}
.logos__vp:hover .logos__tk,
.logos__vp:focus-within .logos__tk {
  animation-play-state: paused;
}
@keyframes logoscroll {
  to {
    transform: translateX(calc(-50% - 17px));
  }
}
.logos__dup {
  display: contents;
}
.logos__tk span {
  font-family: var(--display);
  font-weight: 600;
  font-size: 14.5px;
  color: #5c5c57;
  white-space: nowrap;
  transition: color 0.25s var(--ease);
  cursor: default;
}
.logos__tk span:hover {
  color: #b4b4ad;
}

@media (prefers-reduced-motion: reduce) {
  .logos__vp {
    overflow-x: auto;
    -webkit-mask-image: none;
    mask-image: none;
  }
  .logos__tk {
    animation: none;
  }
}

/* ══ SIGNAL TAGS ══ */
.tag {
  font-family: var(--mono);
  font-size: 9.5px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 5px 9px;
  border-radius: 5px;
  white-space: nowrap;
  display: inline-block;
  border: 1px solid transparent;
}
.tag--ai {
  background: #cfcfc5;
  color: #3b3b35;
}
.tag--adv {
  background: var(--ink);
  color: #fff;
}
.tag--you {
  background: transparent;
  color: var(--red);
  border-color: rgba(218, 0, 7, 0.45);
}
.key {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 18px;
  align-items: center;
  margin: 0 0 2px;
  padding-bottom: 14px;
  border-bottom: 1px solid #eaeae6;
}
.key__i {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 12.5px;
  color: var(--grey);
}

/* the answer, before the evidence */
.swap__lead {
  font-family: var(--display);
  font-weight: 700;
  font-size: clamp(21px, 2.7vw, 34px);
  line-height: 1.2;
  letter-spacing: -0.034em;
  margin: 0 0 clamp(20px, 2.4vw, 30px);
  max-width: 24ch;
  color: var(--ink);
}
.swap__lead em {
  font-style: normal;
  color: var(--red);
}
.hours {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8px 20px;
  margin: 0 0 clamp(22px, 2.6vw, 32px);
  padding-bottom: clamp(20px, 2.4vw, 28px);
  border-bottom: 1px solid var(--hair);
}
.hours__n {
  display: flex;
  align-items: baseline;
  gap: 6px;
  flex: none;
}
.hours__n b {
  font-family: var(--mono);
  font-weight: 700;
  font-size: clamp(34px, 4vw, 50px);
  letter-spacing: -0.05em;
  color: var(--red);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.hours__n i {
  font-family: var(--mono);
  font-style: normal;
  font-size: 11px;
  color: var(--faint);
}
.hours__d {
  font-size: 14.5px;
  line-height: 1.55;
  color: var(--grey);
  max-width: 46ch;
}
.hours__d b {
  color: var(--ink);
  font-weight: 600;
}

/* ══ SWAP ══ */
.swap {
  margin-top: 18px;
}
.swap__hd {
  display: none;
}
@media (min-width: 900px) {
  .swap__hd {
    display: grid;
    grid-template-columns: 124px 1fr 1fr;
    gap: 30px;
    padding-top: 14px;
  }
  .swap__hd span {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .swap__hd span:last-child {
    padding-left: 22px;
  }
}
.swap__row {
  display: grid;
  gap: 7px 30px;
  padding: clamp(12px, 1.4vw, 16px) 0;
  border-top: 1px solid var(--hair);
  align-items: baseline;
  transition: background 0.22s var(--ease);
}
@media (min-width: 900px) {
  .swap__row {
    grid-template-columns: 124px 1fr 1fr;
    align-items: baseline;
  }
}
.swap__row:hover {
  background: rgba(0, 0, 0, 0.028);
}
@media (min-width: 900px) {
  .swap__row {
    margin-inline: -14px;
    padding-inline: 14px;
    border-radius: 8px;
  }
}
.swap__row:hover .swap__b {
  color: var(--ink);
}
.swap__row:hover .swap__b::before {
  background: var(--ink);
  box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.07);
}
.swap__row--keep {
  border-top: 2px solid var(--red);
  margin-top: 2px;
}
.swap__row--keep .swap__b {
  color: var(--ink);
}
.swap__row--keep .tag--you {
  border-color: var(--red);
}
.swap__row--keep .swap__a {
  text-decoration: none;
  color: var(--ink2);
}
.swap__row--keep .swap__b::before {
  background: var(--red);
  box-shadow: 0 0 0 3px rgba(218, 0, 7, 0.13);
}
.swap__a {
  font-size: clamp(13.5px, 1.35vw, 15px);
  color: #a9a9a2;
  line-height: 1.4;
  text-decoration: line-through;
  text-decoration-color: #d5d5d0;
  text-decoration-thickness: 1px;
}
.swap__b {
  font-family: var(--display);
  font-weight: 700;
  font-size: clamp(16px, 1.75vw, 19.5px);
  line-height: 1.32;
  letter-spacing: -0.024em;
  position: relative;
  padding-left: 22px;
  color: var(--ink);
  transition: color 0.22s;
}
.swap__b::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.58em;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #cfcbc1;
  box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.03);
  transition:
    background 0.22s,
    box-shadow 0.22s;
}

/* ══ FUNNEL ══ */
.fn {
  background: var(--char);
  color: var(--onc);
}
.fn .eyebrow {
  color: var(--onc3);
}
.fn h2 {
  color: #fff;
}
