---
import Layout from '~/layouts/PageLayout.astro';

// This page mirrors the reference design build (tribera-home.html): same sections,
// same class names, same CSS and interaction logic. Repeated list-like content
// (dimensions, rows, chips, cards) is pulled into the data below and rendered with
// .map(), the way the rest of the site's pages are written. One-off illustrations
// (the hero decision card, the compounding-ramp sparkline art, the tally chart) stay
// as plain markup since there's nothing to generalise about a single hand-drawn shape.
const metadata = {
  title: 'tribera — every name comes with its reasons',
  description:
    "No candidate is bad — there's a yes for you and a no somewhere else. It starts with your culture and narrows to the manager, the project, the people they'd sit beside. Interview three, hire one.",
  ignoreTitleTemplate: true,
};

// ── Hero decision card: the same 11 dimensions drive both faces of the card
// (scored tiles on "the verdict", weighted rubric on "the bar") and seed the Lab's
// "as briefed" preset further down the page.
const scoreDimensions: [string, string, number, number][] = [
  ['A', 'Core networking, TCP/IP', 5, 6.25],
  ['B', 'Routing and BGP depth', 5, 6.25],
  ['C', 'Data-centre networks', 3, 6.25],
  ['D', 'Hybrid, DCI and WAN', 4, 3.75],
  ['E', 'Troubleshooting and RCA', 5, 6.25],
  ['F', 'Performance and optimisation', 4, 5.0],
  ['G', 'Change and runbook discipline', 4, 5.0],
  ['H', 'ISP and carrier coordination', 4, 2.5],
  ['I', 'Operations and ownership', 4, 3.75],
  ['J', 'Linux, scripting, automation', 2, 1.25],
  ['K', 'Authenticity', 4, 3.75],
];

// Client logos in the marquee under the hero. Rendered twice (once `aria-hidden`)
// so the CSS animation can loop seamlessly.
const clientLogos = [
  'Flipkart', 'Myntra', 'Heineken', 'Volkswagen', 'Mizuho', 'ICICI Bank',
  'Publicis Sapient', 'Capco', 'PayU', 'DSP Mutual Fund', 'ICICI Securities',
  'Utkarsh Bank', 'Aeries', 'SplashBI', 'Aegon Life', 'Enpro',
];

// "What leaves your desk": who owns each job today vs. from Monday.
const deskRows = [
  ['ai', 'Machine', 'Reading 126 profiles to find five', 'All 126 read, on 100+ signals'],
  ['advisor', 'Advisor', 'Eight interviews to make one hire', 'Forty run by us. You do three.'],
  ['advisor', 'Advisor', 'Four panels asking the same four questions', 'One recorded conversation, shared'],
  ['ai', 'Machine', 'No record of why you passed last time', 'Every verdict written down and kept'],
  ['advisor', 'Advisor', 'Sixty days of notice-period silence', 'An expert with them until day one'],
  ['you', 'Stays yours', 'Deciding who joins your team', "Yours. We'd be the wrong partner if we wanted it."],
];

// The funnel: what 126 profiles actually turn into. `owner` marks the two stages
// that stay tribera's work; `theirs` marks the two the hiring team owns.
const funnelSteps = [
  [1, 126, 'Sourced and screened', 'Sourced and screened', 'tribera', false,
    'Everything the requirement returned, screened on 100+ signals'],
  [2, 40, 'Interviewed by an expert', 'Interviewed by an expert', 'tribera', false,
    'Thirty structured minutes on questions written for them. Recorded and scored.'],
  [3, 14, 'Cleared the bar', 'Cleared the bar', 'tribera', false,
    'Judged on their answers, not on who interviewed them'],
  [4, 5, 'Sent to the hiring team', 'Sent to them', 'their first hour', true,
    'Ranked, all five hireable. The first names the team ever saw.'],
  [5, 2, 'They hired two', 'They hired two', 'their call', true,
    'Five interviews, two hires. At eight-to-one that costs sixteen.'],
];

// Each case study's punchline is split into a plain lead-in and a bolded close,
// matching the emphasis in the reference copy (e.g. "...2 selects. **1 hire.**").
const caseStudies = [
  ['AI security · engineering', 'Bengaluru', '50+ profiles over six months, no hire',
    '4 interviews. 2 selects. ', '1 hire.'],
  ['Capital markets · GCC', 'Singapore', 'Agencies sending CVs, not candidates',
    '38 days. Full team placed. ', 'Zero mismatch at six months.'],
  ['Leadership · digital consulting', 'India delivery', '15 senior roles, one 30-day window',
    '', 'All 15 closed inside it.'],
];

const expertise = [
  ['Backend & platform', '11 yrs'],
  ['Data & analytics', '9 yrs'],
  ['SRE & infrastructure', '13 yrs'],
  ['Cybersecurity', '14 yrs'],
  ['AI & machine learning', '9 yrs'],
  ['Networks & DC', '12 yrs'],
  ['Finance & transformation', '15 yrs'],
  ['Risk & compliance', '13 yrs'],
  ['Capital markets', '12 yrs'],
  ['Product & design', '10 yrs'],
  ['Supply chain & manufacturing', '14 yrs'],
  ['Leadership & GCC build-out', '18 yrs'],
];

const industries = [
  'Banking & financial services', 'Enterprise technology', 'Product & SaaS', 'AI & data',
  'Cybersecurity', 'Healthcare & life sciences', 'Pharmaceutical', 'Manufacturing',
  'Industrial & engineering', 'Global capability centres', 'Consumer & digital commerce',
  'Private equity portfolio',
];

const leaders = [
  ['/akshata.png', 'AC', 'Akshata Chandavarkar', 'Founder & CEO',
    'Twenty years of enterprise hiring across GCCs, BFSI and deep-tech. Ran talent acquisition at GCC scale, then built the tool she needed.'],
  ['/abhishek.png', 'AP', 'Abhishek Prasad', 'Co-founder & CBO',
    'Two decades building products used by millions. Built the signal engine — what a CV hides, join probability, retention.'],
  ['/pranav.png', 'PG', 'Pranav Gandhi', 'Chief Success Officer',
    'Twenty years scaling companies from nothing. Runs client delivery and the quality bar behind every mandate.'],
];

// The Lab's preset buttons; the weight sets themselves live in the script since
// they only ever feed the interactive rubric, not the page's static content.
const labPresets = [
  ['brief', 'As briefed', true],
  ['auto', 'Automation first', false],
  ['fabric', 'Fabric depth first', false],
  ['ops', 'The day job', false],
];

// "Everyone here does something real": four stages (find, screen, interview, write
// the verdict) and how far each kind of provider actually gets through them.
const compareRows: [string, string, number, string, boolean][] = [
  ['Job boards', 'Stops after finding', 1, 'You read everything, judge everything, alone.', false],
  ['AI screening tools', 'Stops after screening', 2, 'Everything a machine can’t see.', false],
  ['Contingency agencies', 'Stops after the interview', 3, 'Eight interviews a hire, and no reasons.', false],
  ['RPO', 'Stops after the interview', 3, 'The judgment you just outsourced.', false],
  ['tribera', 'Goes all the way', 4, 'You decide. That’s the only part left.', true],
];

// Voices marquee. Rendered twice back-to-back so the CSS scroll loops seamlessly.
const testimonials = [
  ['ta', '32 Java engineers in four months. Our team had struggled for eight. Interviewed 11, made 8 offers, all accepted.', 'Head of Talent', 'SaaS company'],
  ['cd', 'Three interview calls in one week — all relevant to my stack. No spam. The expert prepped me before each one.', 'Senior backend engineer', '6 yrs'],
  ['ta', "Our ratio went from 9:1 to 3:1 in a quarter. That's two hundred manager hours we got back.", 'VP Engineering', 'Enterprise tech'],
  ['cd', 'It matched me to roles where I actually fit. The interview felt like a technical discussion, not an interrogation.', 'Full-stack engineer', 'AI startup'],
  ['ta', 'Four senior platform hires in six weeks, after three failed agency cycles.', 'CTO', 'Fintech'],
  ['cd', 'My profile stayed private the whole time. I only spoke to teams that were serious.', 'Engineering manager', 'Enterprise platform'],
  ['ta', 'Clear role patterns, sharper interviews, zero random profiles. Decision time dropped forty per cent.', 'Director, Talent Acquisition', 'Global capability centre'],
  ['cd', 'The score breakdown was the useful part. I knew exactly what to work on before the next round.', 'Senior platform engineer', 'Cloud infrastructure'],
];

// "How we engage" timeline and the three headline stats under it.
const engageSteps = [
  ['Day 0', '45 min', 'Intake call', 'We learn your yes — the role, the manager, the culture, the bar.', 'You brief · we listen'],
  ['36 hours', 'shortlist', 'Three names', 'Decision-ready candidates, each scored and explained.', 'We deliver · you review'],
  ['Week 1', 'interviews', 'Your panel runs it', 'You meet three, not twelve — and we prep your panel with the rubric.', 'You interview · we support'],
  ['At offer', 'close', 'Risk flagged first', 'Join-probability and offer-risk surfaced before you extend.', 'You decide · we de-risk'],
  ['Safety net', 'SLA', 'If it falls through', 'Drop-out or no-show, we restart free and go priority queue.', 'Guaranteed in writing'],
];

const engageStats = [
  ['36', 'hrs', 'from the intake call to three names, scored and explained'],
  ['3', 'people', 'is the whole ask of your panel, not twelve'],
  ['~90', '%', 'of the briefs we take on, we close'],
];

const engageNotes = [
  ['Your recruiter still owns the relationship',
    "We arm your team. We don't replace them, and we don't touch the candidate relationship you own."],
  ['Fits your ATS',
    "Shortlists export to Workday, Greenhouse, Lever and SuccessFactors — or to a shared workspace if you'd rather."],
];

// Trust & compliance: two lists of assurances, plus the three-step "who can
// actually decide" ladder.
// List items are stored with their emphasis markup intact (one bold phrase each,
// at most) and rendered with `set:html`, matching the reference's inline <b> tags.
const compliance: [string, string[]][] = [
  ['Data and consent · DPDP Act', [
    'Candidate consent captured before any evaluation',
    'Data resident in India, encrypted in transit and at rest',
    'Purpose-limited — transcripts held on a defined clock, then purged',
    'Right to access, correct and erase, honoured',
  ]],
  ['Fair and defensible AI', [
    'Human in the loop by design — <b>the AI never auto-rejects</b>',
    'Every score explainable: rubric, evidence, transcript',
    'Signals are role-relevant only; protected attributes excluded',
    'Adverse impact reviewed, rubrics audited',
  ]],
];

const decisionPath: [string, string, string, string, boolean][] = [
  ['01', 'The engine surfaces', 'Scores, ranks and explains. <b>It cannot reject anyone.</b>', 'machine', false],
  ['02', 'An expert judges', 'A person reads the transcript and writes the verdict, in their own words.', 'human', false],
  ['03', 'You decide', 'Every hire and every no is yours. We never make one on your behalf.', 'yours', true],
];

// For candidates: the four things they can count on, every time.
const candidateExpectations = [
  ["You'll hear back", "With the actual reason. Silence isn't a process."],
  ['One conversation, not six', 'Recorded, scored, and it travels with you.'],
  ['Anonymous until you say so', 'Block any company. Pause in one click.'],
  ['We check the team too', 'Headcount, rounds, how fast they decide.'],
];

// Close: the two doors, hiring vs. looking.
const doors = [
  ["I'm hiring",
    "Tell us one role you're stuck on. We'll come back with how we'd run it, what the shortlist would look like, and what it costs — before you commit to anything.",
    'A 45-minute intake call. Three names back inside 36 hours, each scored against a bar we set with you.',
    'Talk to us', '#close', 'btn--dark'],
  ["I'm looking",
    "Fifteen minutes to set up a profile, then a real conversation with an expert. If there's no fit, you'll hear that too — with the reason.",
    'Fifteen minutes to set up. An expert calls within a week, and you keep the score whatever happens after that.',
    'Create your profile', '#apply', 'btn--ghost'],
];
---

<Layout metadata={metadata}>
  <main class="tribera-home">
  <header class="hero" id="top">
    <div class="wrap">
      <div class="hero__top">
        <div class="hero__copy">
          <p class="eyebrow" data-rv>Fifty senior experts. Thirty minutes each.</p>
          <h1 class="h1" data-rv style="--d:60ms">Every name comes<br />with its <em>reasons</em>.</h1>
          <p class="hero__p" data-rv style="--d:110ms">
            No candidate is bad — there's a yes for you and a no somewhere else. It starts with your
            culture and narrows from there: the manager, the project, the people they'd sit beside.
            <b>AI reads the signals; a senior expert reads the person.</b>
          </p>
          <p class="hero__p" data-rv style="--d:150ms">
            <b
              >If you're hiring, that's three names you'd take any of. If you're looking, it's the
              half-hour that replaces the other eight.</b
            >
          </p>
          <div class="btns" data-rv style="--d:190ms">
            <a href="#run" class="btn btn--light">See how one role ran</a>
            <a href="#candidates" class="btn btn--wire">I'm looking</a>
          </div>
        </div>

        <!-- Decision Package: a two-sided card. Front is the verdict on one candidate,
             back is the weighted rubric that produced it. Tabs flip it; pointer-move tilts it
             (see the hero card scripts at the bottom of the page). -->
        <div class="hero__card" data-rv style="--d:230ms">
          <div class="ftabs" role="tablist" aria-label="Decision Package sides">
            <button class="ftab is" id="tabA" role="tab" aria-selected="true" aria-controls="faceA">
              The verdict
            </button>
            <button class="ftab" id="tabB" role="tab" aria-selected="false" aria-controls="faceB">
              The bar
            </button>
          </div>
          <div class="tilt" id="tilt">
            <div class="flip" id="flip">
              <div class="face" id="faceA" role="tabpanel" aria-labelledby="tabA">
                <span class="face__glint"></span>
                <div class="face__hd">
                  <span>Decision Package <span class="rank">· 1 of 3</span></span>
                  <span>Network Engineer · Bengaluru</span>
                </div>
                <div class="side">
                  <div class="side__hd">
                    <div>
                      <p class="side__nm">Bharat R</p>
                      <p class="side__sub">7.5 yrs · Oracle Cloud Infrastructure · <b>available immediately</b></p>
                    </div>
                    <span class="scr">
                      <span class="scr__n"><b>42.00</b><i>/50</i></span>
                      <span class="pill">SELECT</span>
                      <span class="scale" aria-hidden="true">
                        <span class="scale__sel"></span><span class="scale__pin"></span>
                      </span>
                      <span class="scale__k">Select starts at 34</span>
                    </span>
                  </div>
                  <div class="vrd">
                    <p class="vrd__k">Recommended for the technical round</p>
                    <p class="vrd__t">
                      The first candidate on this role to describe a performance problem he measured
                      either side of the fix — and the only one to answer both core checks in full.
                    </p>
                  </div>
                  <div class="tiles" id="tiles">
                    {
                      scoreDimensions.map(([letter, name, score]) => (
                        <span
                          class:list={['tl', score <= 2 && 'tl--low']}
                          style={`--s:${score}`}
                          data-n={name}
                          data-s={score}
                          tabindex="0"
                        >
                          <i>{letter}</i>
                          <b>{score}</b>
                        </span>
                      ))
                    }
                  </div>
                  <p class="tiles__cap" id="tilesCap">Eleven dimensions, scored out of five, weighted to your brief</p>
                  <div class="notes">
                    <div class="note note--warn">
                      <span class="note__k">Open</span>
                      <p class="note__v">
                        Data-centre depth is described rather than demonstrated — both worked examples
                        are routing-policy failures, not fabric work.
                      </p>
                    </div>
                    <div class="note">
                      <span class="note__k">Heard</span>
                      <p class="note__v">
                        Stumbled on the /28, corrected himself, and worked from the method rather than
                        from memory.
                      </p>
                    </div>
                  </div>
                </div>
                <div class="face__ft">
                  <span>Recorded call · transcript on request</span>
                  <span class="lg"><i class="lg--g">SELECT</i><i class="lg--y">GREY</i><i class="lg--r">REJECT</i></span>
                </div>
              </div>

              <div class="face face--b" id="faceB" role="tabpanel" aria-labelledby="tabB" aria-hidden="true">
                <span class="face__glint"></span>
                <div class="face__hd">
                  <span>The bar <span class="rank">· weighted to 50</span></span>
                  <span>Set from your brief</span>
                </div>
                <div class="side">
                  <div class="side__hd">
                    <div>
                      <p class="side__nm">What this role demands</p>
                      <p class="side__sub">A hands-on operations role, not a design role · <b>automation is good-to-have</b></p>
                    </div>
                  </div>
                  <div class="rub">
                    {
                      scoreDimensions.map(([letter, name, , weight]) => (
                        <div class="rub__r">
                          <span class="rub__k">{letter}</span>
                          <span class="rub__n">{name}</span>
                          <span class="rub__p">{weight.toFixed(2)}</span>
                        </div>
                      ))
                    }
                  </div>
                  <div class="notes">
                    <div class="note">
                      <span class="note__k">Bands</span>
                      <p class="note__v">
                        <b>Select</b> 34–50 · <b>Grey</b> 28–33 · <b>Reject</b> below 28. Grey is not a
                        soft no — it names what to test.
                      </p>
                    </div>
                    <div class="note note--warn">
                      <span class="note__k">Yours</span>
                      <p class="note__v">
                        The weighting is our reading of your brief. Tell us if your priorities sit
                        differently and we recalibrate.
                      </p>
                    </div>
                  </div>
                </div>
                <div class="face__ft">
                  <span>Same bar applied to every candidate</span>
                  <span class="lg"><i class="lg--g">SELECT</i><i class="lg--y">GREY</i><i class="lg--r">REJECT</i></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="logos">
        <p class="logos__l">Mandates run for</p>
        <div class="logos__vp">
          <div class="logos__tk">
            {clientLogos.map((name) => <span>{name}</span>)}
            <span aria-hidden="true" class="logos__dup">
              {clientLogos.map((name) => <span>{name}</span>)}
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══ SWAP: what leaves your desk ═══ -->
  <section class="band band--w" id="desk">
    <div class="wrap">
      <div class="shead">
        <div>
          <p class="eyebrow" data-rv>What leaves your desk</p>
          <h2 class="h2" data-rv style="--d:60ms">Most of hiring is work you never chose to do.</h2>
        </div>
        <p class="dek" data-rv style="--d:100ms">
          Nobody joined talent acquisition to read six hundred CVs a quarter. Here's who does each part
          now.
        </p>
      </div>

      <p class="swap__lead" data-rv style="--d:110ms">
        Six jobs sit on your desk today.<br /><em>Five of them stop being yours.</em>
      </p>

      <div class="hours" id="hours" data-rv style="--d:120ms">
        <span class="hours__n"><b id="hrsN">0</b><i>hrs a week</i></span>
        <span class="hours__d">
          is roughly what those five take off a team running four open roles.
          <b>The sixth is the one you were hired to do.</b>
        </span>
      </div>

      <div class="panel" data-rv style="--d:140ms">
        <div class="key">
          <span class="key__i"><span class="tag tag--ai">Machine</span> pattern work, at volume</span>
          <span class="key__i"><span class="tag tag--adv">Advisor</span> anything needing a view</span>
          <span class="key__i"><span class="tag tag--you">Stays yours</span> the call itself</span>
        </div>

        <div class="swap">
          <div class="swap__hd"><span>Who does it</span><span>Yours today</span><span>From Monday</span></div>

          {
            deskRows.map(([kind, tag, before, after], i) => (
              <div class:list={['swap__row', i === deskRows.length - 1 && 'swap__row--keep']}>
                <span class:list={['tag', `tag--${kind}`]}>{tag}</span>
                <p class="swap__a">{before}</p>
                <p class="swap__b">{after}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FUNNEL: one role, start to finish ═══ -->
  <section class="fn band" id="run">
    <div class="wrap">
      <div class="shead">
        <div>
          <p class="eyebrow" data-rv>One role, start to finish</p>
          <h2 class="h2" data-rv style="--d:60ms">Nobody shows you the funnel.</h2>
        </div>
        <p class="fn__dek" data-rv style="--d:100ms">
          A backend role in Bengaluru, open nine months, no hire. We took the same requirement back to
          market and <b>126 profiles came back.</b> Every square below is one of them —
          <b>and the team saw five.</b>
        </p>
      </div>

      <div class="fn__grid">
        <div>
          <div class="stick">
            <!-- The 126-square grid itself is generated by script (see the funnel script
                 below) so the "which stage did each person stop at" hover works without
                 126 near-identical elements living in the markup. -->
            <div class="field" id="field">
              <div class="field__hd"><span id="fieldLbl">Sourced and screened</span><span>126 in play</span></div>
              <p class="field__n" id="fieldN">126</p>
              <div class="grid" id="grid" aria-hidden="true"></div>
              <p class="field__ft" id="fieldFt">Every square is one person we actually looked at.</p>
            </div>

            <div class="desk">
              <p class="desk__k">Of those 126, what reaches you</p>
              <div class="desk__r">
                <span class="desk__n">The usual way</span>
                <span class="desk__bar desk__bar--frag">
                  {[17, 8, 24, 6, 13, 9, 14, 9].map((flex) => <span style={`flex:${flex}`} />)}
                </span>
                <span class="desk__v">126 <i>all of them, to sort</i></span>
              </div>
              <div class="desk__r desk__r--us">
                <span class="desk__n">tribera</span>
                <span class="desk__bar"><span class="desk__fill desk__fill--us"></span></span>
                <span class="desk__v">5 <i>the ones worth your afternoon</i></span>
              </div>
              <p class="desk__ft">
                Put a requirement out and 126 come back — never in one pile, but in threes and fives from
                agencies, boards, referrals and inbound, over weeks.
                <b>Reading all of them was the job. We did that part and sent the best five.</b>
              </p>
            </div>
          </div>
        </div>

        <div class="steps" id="steps">
          {
            funnelSteps.slice(0, 3).map(([n, count, lbl, title, owner, isYours, desc]) => (
              <div class:list={['step', n === 1 && 'on']} data-n={n} data-count={count} data-lbl={lbl}>
                <span class="step__n">{count}</span>
                <span class="step__t">
                  {title} <em class:list={['own', isYours && 'own--you']}>{owner}</em>
                </span>
                <span class="step__d">{desc}</span>
              </div>
            ))
          }
          <p class="step__gap"><span>Everything above happened before they saw a single name</span></p>
          {
            funnelSteps.slice(3).map(([n, count, lbl, title, owner, isYours, desc]) => (
              <div class="step" data-n={n} data-count={count} data-lbl={lbl}>
                <span class="step__n">{count}</span>
                <span class="step__t">
                  {title} <em class:list={['own', isYours && 'own--you']}>{owner}</em>
                </span>
                <span class="step__d">{desc}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="fn__close">
        <p class="fn__line" data-rv>
          They weren't picking the best of five.<br />They were picking <em>between</em> five.
        </p>
        <p class="fn__math" data-rv style="--d:80ms">
          Roughly <b>38 hours</b> stayed with their team — the 126 CV screens at four minutes each, and
          the 40 expert calls at forty-five minutes including write-up. That is what handling the market's
          response to one requirement actually costs. Your rates will differ. The shape won't.
        </p>
      </div>

      <div class="cases" data-rv>
        <p class="cases__k">Three more, same shape</p>
        <div class="cases__g">
          {
            caseStudies.map(([role, location, before, afterPlain, afterBold]) => (
              <div class="cs2">
                <p class="cs2__k">
                  {role}
                  <span>{location}</span>
                </p>
                <p class="cs2__b">{before}</p>
                <p class="cs2__a">
                  {afterPlain}
                  <b>{afterBold}</b>
                </p>
              </div>
            ))
          }
        </div>
        <p class="cases__ft">
          Different functions, different countries, one method —
          <b>read everything, interview properly, send few.</b> Named versions of all four are in the deck.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ EXPERTS: the people who make the call ═══ -->
  <section class="wrap band" id="experts">
    <div class="shead">
      <div>
        <p class="eyebrow eyebrow--red" data-rv>The people who make the call</p>
        <h2 class="h2" data-rv style="--d:60ms">Fifty senior experts. One bar — yours.</h2>
      </div>
      <p class="dek" data-rv style="--d:100ms">
        A verdict is only worth what the person behind it is worth. Not fifty recruiters —
        <b>fifty people who have done the job</b>, across engineering, finance, operations and leadership.
      </p>
    </div>

    <div class="bench" data-rv style="--d:140ms">
      <div class="bench__g">
        {
          expertise.map(([field, years]) => (
            <div class="xp">
              <b>{field}</b>
              <span>{years}</span>
            </div>
          ))
        }
        <div class="xp xp--more">
          <b>+38 more</b>
          <span>across engineering, finance, operations and leadership</span>
        </div>
      </div>
      <p class="bench__note">
        Each one interviews only in the ground they have actually worked, on questions the engine writes
        from the role and the candidate's own CV.
        <b>The engine works both ends. The expert does the part in between.</b>
      </p>

      <div class="inds">
        <p class="inds__k">Industries we run mandates in</p>
        <div class="inds__g">{industries.map((name) => <span>{name}</span>)}</div>

        <div class="whos">
          <p class="whos__k">And the people the bench answers to</p>
          <div class="whos__g">
            {
              leaders.map(([photo, initials, name, role, bio]) => (
                <div class="who">
                  <span class="who__ph" aria-hidden="true" style={`background-image:url(${photo})`}>
                    {initials}
                  </span>
                  <div>
                    <p class="who__n">{name}</p>
                    <p class="who__r">{role}</p>
                    <p class="who__d">{bio}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE LAB: the bar is yours, literally ═══ -->
  <section class="lab band" id="lab">
    <div class="wrap">
      <div class="shead">
        <div>
          <p class="eyebrow" data-rv>The bar is yours — literally</p>
          <h2 class="h2" data-rv style="--d:60ms">Move the weightings. Watch the verdict move.</h2>
        </div>
        <p class="lab__dek" data-rv style="--d:100ms">
          A real rubric from a real role. The weights come from your context —
          <b style="color:#fff">your culture, the manager's taste, the shape of the project, the team
          they'd join</b>
          — and you can move any of them. Same interview, same answers, different bar. Weight automation
          hard enough and he stops being a hire.
        </p>
      </div>

      <!-- Everything below is rendered by the lab script: it owns its own copy of the
           eleven dimensions (D) so the sliders, tiles and verdict can recompute live
           without re-rendering the page. #labRows / #labTiles start empty on purpose. -->
      <div class="lab__grid" data-rv style="--d:140ms">
        <div class="verd">
          <div class="verd__who">
            <div>
              <p class="verd__nm">Bharat R</p>
              <p class="verd__sub">Network Engineer · 7.5 yrs · available immediately</p>
            </div>
            <span class="verd__band b-sel" id="labBand">SELECT</span>
          </div>
          <div class="verd__big"><b id="labScore">42.00</b><i>/ 50</i></div>
          <div class="verd__track">
            <span class="verd__grey"></span><span class="verd__sel"></span>
            <span class="verd__pin" id="labPin" style="left:84%"></span>
          </div>
          <div class="verd__ax"><span>0</span><span>REJECT · 28 · GREY · 34 · SELECT</span><span>50</span></div>
          <div class="verd__tiles" id="labTiles" />
          <p class="verd__note" id="labNote">
            As briefed: fundamentals, troubleshooting and performance carry the weight. Automation is
            deliberately weighted so it cannot carry a profile.
          </p>
        </div>

        <div class="ctrl">
          <div class="ctrl__hd">
            {
              labPresets.map(([key, label, isDefault]) => (
                <button class:list={['pre', isDefault && 'on']} data-pre={key}>
                  {label}
                </button>
              ))
            }
          </div>
          <div class="rows" id="labRows" />
          <div class="rows__ft">
            <span>Weights total <b id="labTotal">50.00</b></span>
            <span>Points are weight × score ÷ 5</span>
          </div>
        </div>
      </div>

      <p class="lab__foot" data-rv>
        Tell us your priorities sit differently — <em>and this is what we recalibrate.</em>
      </p>
    </div>
  </section>

