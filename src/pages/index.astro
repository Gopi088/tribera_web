  <script>
    const setupProofCardScroll = () => {
      window.__triberaProofCardScrollCleanup?.();

      const grid = document.querySelector('[data-proof-grid]');
      const selectionCard = document.getElementById('proofSelectionCard');
      const efficiencyCard = document.getElementById('proofInterviewEfficiencyCard');
      const scrollCompression = 0.9;

      if (
        !(grid instanceof HTMLElement) ||
        !(selectionCard instanceof HTMLElement) ||
        !(efficiencyCard instanceof HTMLElement)
      ) {
        return;
      }

      let ticking = false;
      let baseSelectionOffset = 0;
      let baseEfficiencyOffset = 0;

      const syncProofOffsets = () => {
        const gridRect = grid.getBoundingClientRect();
        const selectionRect = selectionCard.getBoundingClientRect();
        const efficiencyRect = efficiencyCard.getBoundingClientRect();

        baseSelectionOffset = Math.max(0, selectionRect.top - gridRect.top);
        baseEfficiencyOffset = Math.max(0, efficiencyRect.top - gridRect.top);
      };

      const updateProofCardPosition = () => {
        ticking = false;

        if (window.innerWidth < 1024) {
          selectionCard.style.transform = '';
          return;
        }

        const gridRect = grid.getBoundingClientRect();
        const gridTop = gridRect.top + window.scrollY;
        const targetOffset = Math.max(0, baseEfficiencyOffset - baseSelectionOffset);
        const cardTopInDocument = gridTop + baseSelectionOffset;
        const startScroll = cardTopInDocument + selectionCard.offsetHeight - window.innerHeight;
        const scrollDistance = Math.max(targetOffset * scrollCompression, 1);
        const endScroll = startScroll + scrollDistance;

        if (endScroll <= startScroll) {
          selectionCard.style.transform = '';
          return;
        }

        const progress = Math.min(Math.max((window.scrollY - startScroll) / (endScroll - startScroll), 0), 1);
        const availableSpace = Math.max(0, grid.scrollHeight - baseSelectionOffset - selectionCard.offsetHeight);
        const maxTranslate = Math.min(targetOffset, availableSpace);

        selectionCard.style.transform = `translate3d(0, ${maxTranslate * progress}px, 0)`;
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateProofCardPosition);
      };

      const handleResize = () => {
        syncProofOffsets();
        requestUpdate();
      };

      syncProofOffsets();
      updateProofCardPosition();

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', handleResize);

      window.__triberaProofCardScrollCleanup = () => {
        window.removeEventListener('scroll', requestUpdate);
        window.removeEventListener('resize', handleResize);
        selectionCard.style.transform = '';
        window.__triberaProofCardScrollCleanup = undefined;
      };
    };

    document.addEventListener('astro:before-swap', () => {
      window.__triberaProofCardScrollCleanup?.();
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupProofCardScroll, { once: true });
    } else {
      setupProofCardScroll();
    }
  </script>

  <section id="what-makes-us-different" class="bg-black py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-6">
