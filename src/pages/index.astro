---
import Layout from '~/layouts/PageLayout.astro';
import V58Home from '~/components/home/v58/Home.astro';

const metadata = {
  title: 'tribera - three candidates, every one worth the interview',
  description:
    'We source, screen and interview against the bar your hiring manager sets, then send three candidates worth interviewing, with evidence behind every score.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <V58Home />
</Layout>

<style is:global>
  body {
    font-family: var(--v58-ui);
    font-size: 16px;
    line-height: 1.6;
  }
  :focus-visible {
    outline: 2px solid var(--v58-red);
    outline-offset: 3px;
  }
</style>
