  }
}
.vol__nm {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--red);
  margin: 0 0 10px;
}
.vol__v {
  font-family: var(--display);
  font-weight: 800;
  font-size: clamp(30px, 3.6vw, 46px);
  letter-spacing: -0.045em;
  line-height: 1;
  margin: 0 0 12px;
  color: #fff;
}
.vol__v span {
  font-family: var(--ui);
  font-weight: 400;
  font-size: 14px;
  letter-spacing: 0;
  color: var(--onc3);
}
.vol__d {
  font-size: 15px;
  line-height: 1.55;
  color: var(--onc2);
  margin: 0 0 24px;
  max-width: 34ch;
  min-height: calc(2 * 1.55em);
}
.vol__pts {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0;
}
.vol__pts li {
  position: relative;
  padding: 13px 0 13px 22px;
  font-size: 15px;
  line-height: 1.45;
