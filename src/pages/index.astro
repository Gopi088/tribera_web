/* ══ VOICES marquee ══ */
.mq {
  overflow: hidden;
  margin-top: clamp(30px, 3.6vw, 46px);
  padding-top: clamp(10px, 1.4vw, 18px);
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
}
.mq__t {
  display: flex;
  gap: 16px;
  width: max-content;
  padding-inline: var(--gut);
  animation: mqrun 68s linear infinite;
}
.mq:hover .mq__t,
.mq:focus-within .mq__t {
  animation-play-state: paused;
}
@keyframes mqrun {
  to {
    transform: translateX(calc(-50% - 8px));
  }
}
.qc {
  flex: none;
  width: 330px;
  margin: 0;
  background: #f4f4f2;
  border: 1px solid #e9e9e5;
  border-radius: 14px;
  padding: 20px 20px 18px;
  display: flex;
  flex-direction: column;
  transition:
    transform 0.25s var(--ease),
    box-shadow 0.25s var(--ease),
    background 0.25s;
}
.qc:hover {
  transform: translateY(-3px);
  background: #fff;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
}
.qc__tag {
  align-self: flex-start;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  padding: 5px 9px;
  border-radius: 5px;
  margin-bottom: 14px;
}
.qc--ta .qc__tag {
  background: var(--ink);
  color: #fff;
}
.qc--cd .qc__tag {
  background: transparent;
  color: var(--red);
  border: 1px solid rgba(218, 0, 7, 0.42);
}
.qc__q {
  font-size: 15px;
  line-height: 1.5;
  color: var(--ink2);
  margin: 0 0 auto;
  font-family: var(--display);
  font-weight: 500;
  letter-spacing: -0.012em;
}
.qc__a {
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid #e4e4de;
  display: grid;
  gap: 2px;
}
.qc__a b {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink);
}
.qc__a span {
  font-size: 12.5px;
  color: var(--grey);
}
@media (prefers-reduced-motion: reduce) {
  .mq {
    overflow-x: auto;
    -webkit-mask-image: none;
    mask-image: none;
  }
  .mq__t {
    animation: none;
  }
}

/* ══ CLOSE ══ */
.doors {
  display: grid;
  gap: 18px;
  margin-top: clamp(36px, 4.4vw, 56px);
}
@media (min-width: 760px) {
  .doors {
    grid-template-columns: repeat(2, 1fr);
  }
}
.door {
  background: var(--card);
  border-radius: 18px;
  padding: clamp(26px, 3.2vw, 40px);
  box-shadow: 0 2px 24px rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  transition:
    box-shadow 0.3s,
    transform 0.3s var(--ease);
}
.door:hover {
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.09);
  transform: translateY(-2px);
}
.door p {
  color: var(--grey);
  font-size: 15.5px;
  line-height: 1.6;
  margin: 12px 0 0;
  flex: 1;
}
.door .btn {
  align-self: flex-start;
  margin-top: 24px;
}
.bbb2 {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin: clamp(48px, 5.5vw, 76px) 0 0;
  padding-top: clamp(30px, 3.4vw, 44px);
  border-top: 1px solid var(--hair);
}
.bbb2 span {
  font-family: var(--display);
  font-weight: 800;
  font-size: clamp(20px, 2.4vw, 30px);
  letter-spacing: -0.038em;
  color: var(--ink);
}
.bbb2 span:first-child {
  color: var(--red);
}
.bbb2 i {
  display: block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #cfcbc1;
}
.bbb2__s {
  text-align: center;
  font-size: 14px;
  line-height: 1.55;
  color: var(--grey);
  margin: 14px auto 0;
  max-width: 44ch;
}

.ft {
  background: var(--char);
  color: var(--onc3);
  padding-block: clamp(48px, 5.5vw, 76px) 32px;
  font-size: 14px;
}
.ft__top {
  display: grid;
  gap: clamp(30px, 3.4vw, 44px);
}
@media (min-width: 760px) {
  .ft__top {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1020px) {
  .ft__top {
    grid-template-columns: 1.5fr repeat(4, 0.9fr);
    gap: clamp(24px, 2.6vw, 44px);
  }
}
.ft__brand .logo {
  color: var(--onc);
}
.ft__line {
  font-size: 14.5px;
  line-height: 1.55;
  color: var(--onc3);
  margin: 16px 0 0;
  max-width: 36ch;
}
.ft__line b {
  color: var(--onc);
  font-weight: 600;
  display: block;
  margin-bottom: 6px;
}
.ft__tribe {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--faint);
  margin: 16px 0 0;
}
.ft__bbb {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: nowrap;
  white-space: nowrap;
  font-family: var(--display);
  font-weight: 700;
  font-size: 15px;
  letter-spacing: -0.02em;
  color: var(--onc2);
