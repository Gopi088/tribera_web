    border-color 0.3s var(--ease);
}
.vseg i {
  font-style: normal;
  font-size: 10.5px;
  letter-spacing: 0.12em;
  color: var(--onc3);
  transition: color 0.3s;
}
.vseg:hover span {
  background: rgba(255, 255, 255, 0.14);
}
.vseg.is span {
