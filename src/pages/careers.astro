---
import V9Layout from '~/layouts/V9Layout.astro';
import Content from '~/components/v9/content/Content.astro';
import { publicLinks } from '~/data/v9/preview-links';
import { CAREER_ROLES, CAREER_DIMENSIONS } from '~/data/careers';
---

<V9Layout
  title="Careers — we publish the bar we hire you against — tribera"
  description="Roles in Bengaluru. The scorecard for each is published on this page before you apply, and you get your scores whether or not we make an offer."
  headerLinkOverrides={publicLinks}
  footerLinkOverrides={publicLinks}
>
  <Content kind="careers">
    <header class="hero hero--bare">
      <div class="wrap">
        <div class="hero__top">
          <div class="hero__copy">
            <p class="eyebrow" data-v9-reveal style="color:var(--red)">Careers</p>
            <h1 class="h1" data-v9-reveal style="--d:60ms;max-width:none;margin-bottom:clamp(16px,2vw,24px)">
              We publish the bar<br />we hire <em>you</em> against.
            </h1>
            <p class="hero__p" data-v9-reveal style="--d:110ms">
              We spend our days telling other companies that a hiring bar should be written down before anyone is
              interviewed.
              <b>It would be strange not to do it to ourselves.</b>
            </p>
            <p class="hero__p" data-v9-reveal style="--d:150ms">
              <span data-role-count>7</span> roles, all onsite in Bengaluru. The scorecard for each one is on this page, before
              you apply.
            </p>
            <div class="btns" data-v9-reveal style="--d:190ms">
              <a href="#roles" class="btn btn--light">See the roles</a>
              <a href="#how" class="btn btn--wire">How we hire</a>
            </div>
          </div>
          <div class="hero__card" data-v9-reveal style="--d:150ms">
            <p class="feat__k">The scorecard for this role</p>
            <div class="cmpw">
              <span class="feat__glint"></span>
              <div class="cmpw__sel cmpw__sel--one">
                <label class="sel"
                  ><span>Role</span><select id="roleSel" disabled
                    >{CAREER_ROLES.map((role) => <option value={role.slug}>{role.title}</option>)}</select
                  ></label
                >
              </div>
              <div class="cmpw__g">
                {
                  CAREER_DIMENSIONS.map((name, index) => (
                    <div class="bw">
                      <>
                        <span class="bw__n">{name}</span>
                        <span class="bw__b">
                          <span class="bw__f" id={`cf${index}`} style={`width:${CAREER_ROLES[0].w[index]}%`} />
                        </span>
                        <span class="bw__v" id={`cv${index}`}>
                          {CAREER_ROLES[0].w[index]}%
                        </span>
                      </>
                    </div>
                  ))
                }
              </div>
              <p class="cmpw__ft" id="roleFt">{CAREER_ROLES[0].blurb}</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="band band--w" id="roles">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Open roles</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;margin-bottom:clamp(16px,2vw,24px)">
              <span data-role-count>7</span>, across
              <span data-dept-count>3</span>
              <span data-team-word>teams</span>.
            </h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms;max-width:none;text-align:center">
            Pune and Bengaluru, with people in both. The roles open right now are in the Bengaluru office, in
            Indiranagar, where somebody makes filter coffee at about four.
          </p>
        </div>
        <div class="rfilt" id="rfilt" role="group" aria-label="Department">
          {
            ['All', ...new Set(CAREER_ROLES.map((role) => role.dept))].map((dept) => (
              <button
                type="button"
                disabled
                class:list={['rfb', { on: dept === 'All' }]}
                data-department={dept}
                aria-pressed={dept === 'All'}
              >
                {dept}
              </button>
            ))
          }
        </div>
        <div class="rgrid" id="rgrid" data-v9-reveal style="--d:140ms">
          {
            CAREER_ROLES.map((role) => (
              <a class="rc" href={`/careers/${role.slug}/`} data-department={role.dept}>
                <div class="rc__top">
                  <>
                    <h3 class="rc__t">{role.title}</h3>
                    <span class="rc__ar" aria-hidden="true">
                      &#8594;
                    </span>
                  </>
                </div>
                <>
                  <p class="rc__d">{role.dept}</p>
                  <p class="rc__b">{role.blurb}</p>
                  <p class="rc__m">
                    {role.loc} · {role.type} · {role.exp}
                  </p>
                </>
              </a>
            ))
          }
        </div>
        <p class="rgrid__none" id="rnone">Nothing open in that team right now.</p>
      </div>
    </section>

    <section class="cand band" id="what">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>What it is actually like</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;margin-bottom:clamp(16px,2vw,24px)">
              You will know everyone here by Friday.
            </h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms;max-width:none">
            Small enough that there is no layer between you and the people who decide things. <b
              >That is the best part of the job and occasionally the hardest.</b
            >
          </p>
        </div>
        <div class="whats" data-v9-reveal style="--d:140ms">
          <div class="wt">
            <span class="wt__n">01</span>
            <p class="wt__t">You will be in a client conversation early</p>
            <p class="wt__x">
              Not observing one. Whether you are an intern or a delivery partner, you will be in the room while it
              matters and someone senior will be beside you.
            </p>
          </div>
          <div class="wt">
            <span class="wt__n">02</span>
            <p class="wt__t">We argue about hiring decisions in the open</p>
            <p class="wt__x">
              At least one a week, usually with the whole company in earshot. If you dislike being disagreed with in
              front of people, this will be uncomfortable.
            </p>
          </div>
          <div class="wt">
            <span class="wt__n">03</span>
            <p class="wt__t">The work is apprenticeship-shaped</p>
            <p class="wt__x">
              Reading people is learned by sitting next to someone who is good at it. That is why the roles are onsite,
              and why we say so up front rather than at offer stage.
            </p>
          </div>
          <div class="wt">
            <span class="wt__n">04</span>
            <p class="wt__t">Nobody here scores well on everything</p>
            <p class="wt__x">
              Including the founders, who are scored on the same six dimensions and know their own weak ones. It is the
              whole argument for writing a bar down before you interview.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap band" id="how">
      <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
        <div>
          <p class="eyebrow eyebrow--red" data-v9-reveal>How we hire</p>
          <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;margin-bottom:clamp(16px,2vw,24px)">
            The same process we sell.
          </h2>
        </div>
        <p class="dek" data-v9-reveal style="--d:100ms;max-width:none">
          If we ran a worse process for ourselves than the one we ask clients to pay for, <b
            >you would be right to notice.</b
          >
        </p>
      </div>
      <div class="hsteps" data-v9-reveal style="--d:140ms">
        <div class="hs">
          <span class="hs__d">Within 3 days</span><p class="hs__t">A reply either way</p>
          <p class="hs__x">
            Including a no, with a reason. Silence is the thing we complain about publicly; we do not get to do it here.
          </p>
        </div>
        <div class="hs">
          <span class="hs__d">45 minutes</span><p class="hs__t">One conversation</p>
          <p class="hs__x">
            With someone who has done the job you are applying for. Questions shaped by the role and your experience.
          </p>
        </div>
        <div class="hs">
          <span class="hs__d">Same week</span><p class="hs__t">Your scores, shared</p>
          <p class="hs__x">
            Against the scorecard above, with the dimension you came out weakest on named.
            <b>You get it whether or not we make an offer.</b>
          </p>
        </div>
        <div class="hs hs--end">
          <span class="hs__d">Two weeks, typically</span><p class="hs__t">A decision</p>
          <p class="hs__x">
            One panel round, then an answer. No take-home that eats your weekend, no fifth interview to break a tie we
            should have broken earlier.
          </p>
        </div>
      </div>
      <p class="cases__ft" style="color:var(--grey);max-width:74ch">
        Three of the seven roles are entry level or internships. <span style="color:var(--ink)"
          >Those get the same process and the same written feedback</span
        >. The people with the least leverage in a hiring process are the ones it usually treats worst.
      </p>
    </section>

    <section class="trust band" id="fit">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow" data-v9-reveal>Not seeing your fit</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;margin-bottom:clamp(16px,2vw,24px)">
              Write anyway, but write specifically.
            </h2>
          </div>
          <p class="trust__dek" data-v9-reveal style="--d:100ms;max-width:none">
            A note that says you are interested in opportunities is hard to act on. <b
              >Tell us what you would want to own here and why you think you would be good at it.</b
            > Four sentences is plenty.
          </p>
        </div>
        <div class="btns" data-v9-reveal style="--d:140ms;justify-content:center;display:flex">
          <a href="mailto:careers@tribera.ai" class="btn btn--light">careers@tribera.ai</a>
          <a href="/about" class="btn btn--wire">Read about us first</a>
        </div>
        <p class="trust__ft" data-v9-reveal style="text-align:center">
          Every message is read by one of the three founders. If we cannot help, we will tell you that rather than
          leaving it open.
        </p>
      </div>
    </section>

    <section class="band band--w" id="contact">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>Either way</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;margin-bottom:clamp(16px,2vw,24px)">
              Someone will write back.
            </h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms;max-width:none">
            That is the whole promise of this page, and it is the one thing we would be most embarrassed to get wrong. <b
              >Silence isn’t a process.</b
            >
          </p>
        </div>
        <p class="bbb2" data-v9-reveal><span>Belong</span><i></i><span>Build</span><i></i><span>Become</span></p>
        <p class="bbb2__s" data-v9-reveal>Tribe + Era. A hire only works if both sides were right about each other.</p>
      </div>
    </section>

    <script>
      import { CAREER_ROLES } from '~/data/careers';
      const roleSelect = document.querySelector<HTMLSelectElement>('#roleSel');
      if (roleSelect) roleSelect.disabled = false;
      document.querySelectorAll<HTMLButtonElement>('#rfilt button').forEach((button) => {
        button.disabled = false;
      });
      roleSelect?.addEventListener('change', () => {
        const role = CAREER_ROLES.find((role) => role.slug === roleSelect.value);
        if (!role) return;
        role.w.forEach((weight, index) => {
          const bar = document.getElementById(`cf${index}`);
          const value = document.getElementById(`cv${index}`);
          if (bar) bar.style.width = `${weight}%`;
          if (value) value.textContent = `${weight}%`;
        });
        const note = document.getElementById('roleFt');
        if (note) note.textContent = role.blurb;
      });
      document.querySelectorAll<HTMLButtonElement>('#rfilt button').forEach((button) =>
        button.addEventListener('click', () => {
          document.querySelectorAll('#rfilt button').forEach((item) => {
            item.classList.toggle('on', item === button);
            item.setAttribute('aria-pressed', String(item === button));
          });
          document.querySelectorAll<HTMLElement>('#rgrid .rc').forEach((card) => {
            card.hidden = button.dataset.department !== 'All' && card.dataset.department !== button.dataset.department;
          });
        })
      );
    </script>
  </Content>
</V9Layout>
