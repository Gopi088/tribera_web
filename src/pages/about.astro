/* ══ SIGNAL TAGS ══ */
.tag{font-family:var(--mono);font-size:9.5px;font-weight:500;letter-spacing:.14em;
  text-transform:uppercase;padding:5px 9px;border-radius:5px;white-space:nowrap;
