---
import Layout from '~/layouts/PageLayout.astro';
import ReferenceNavStyles from '~/components/standalone/ReferenceNavStyles.astro';

const metadata = {
  title: 'About tribera \u2014 this industry gave us everything',
  description: 'We read two hundred thousand interviews before we let anyone use it. Why tribera exists, what we hold to, and the three people who walked away from everything to build it.',
};
---

<Layout metadata={metadata}>
<ReferenceNavStyles />
<header class="hero hero--bare" id="top">
  <div class="wrap">
    <div class="hero__top">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--red" data-rv>About tribera</p>
        <h1 class="h1" data-rv style="--d:60ms">This industry gave us <em>everything</em>.</h1>
        <p class="hero__p" data-rv style="--d:110ms">Twenty years each. Sixty between us: the mandates,
        the misses, the hires that worked and the ones that quietly didn’t.
        <b>tribera is how we give some of it back.</b></p>
        <p class="hero__p" data-rv style="--d:150ms">It’s also why we spent a year reading two hundred thousand
        interviews before letting anyone outside the three of us use it.</p>
        <div class="btns" data-rv style="--d:190ms">
          <a href="#story" class="btn btn--light">How it started</a>
          <a href="#team" class="btn btn--wire">The three of us</a>
        </div>
      </div>
      <div class="hero__card" data-rv style="--d:150ms">
        <p class="feat__k">June 2024 → May 2025 · twelve months</p>
