  <script is:inline>
    function runWhenDirectionalTriggerReady(callback, attempts = 30) {
      if (typeof window.__triberaDirectionalTrigger === 'function') {
        callback();
        return;
      }

      if (attempts <= 0) {
        return;
      }

      window.requestAnimationFrame(() => {
        runWhenDirectionalTriggerReady(callback, attempts - 1);
      });
    }

    function initAboutProgressBars() {
      const card = document.getElementById('priya-tribera-card');
      if (!(card instanceof HTMLElement)) return;
      if (card.dataset.progressBound === 'true') return;
      card.dataset.progressBound = 'true';

      const fills = Array.from(card.querySelectorAll('.about-progress-fill'));
      const metricValues = Array.from(card.querySelectorAll('.about-metric-value'));
      if (!fills.length) return;

      let fillTimeouts = [];
      let metricFrame = null;

      const animate = () => {
        fillTimeouts.forEach((timeoutId) => window.clearTimeout(timeoutId));
        fillTimeouts = [];

        fills.forEach((fill, index) => {
          if (!(fill instanceof HTMLElement)) return;
          const targetWidth = fill.dataset.targetWidth;
          if (!targetWidth) return;

          const timeoutId = window.setTimeout(() => {
            fill.style.width = targetWidth;
          }, index * 140);
          fillTimeouts.push(timeoutId);
        });

        if (metricFrame) {
          window.cancelAnimationFrame(metricFrame);
        }

        const targets = metricValues.map((metric) => {
          if (!(metric instanceof HTMLElement)) return 0;
          const targetValue = Number(metric.dataset.targetValue || '0');
          metric.textContent = '0';
          return Number.isFinite(targetValue) ? targetValue : 0;
        });

        const startTime = performance.now();
        const countConfig = window.__triberaCountAnimationConfig || { durationMs: 1200, steps: 72 };
        const duration = countConfig.durationMs;

        const tick = (now) => {
          const progress = Math.min((now - startTime) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);

          metricValues.forEach((metric, index) => {
            if (!(metric instanceof HTMLElement)) return;
            const nextValue = Math.round(targets[index] * eased);
            metric.textContent = String(nextValue);
          });

          if (progress < 1) {
            metricFrame = window.requestAnimationFrame(tick);
            return;
          }

          metricFrame = null;
        };

        metricFrame = window.requestAnimationFrame(tick);
      };

      const reset = () => {
        fillTimeouts.forEach((timeoutId) => window.clearTimeout(timeoutId));
        fillTimeouts = [];
        if (metricFrame) {
          window.cancelAnimationFrame(metricFrame);
          metricFrame = null;
        }

        fills.forEach((fill) => {
          if (!(fill instanceof HTMLElement)) return;
          fill.style.width = '0';
        });

        metricValues.forEach((metric) => {
          if (!(metric instanceof HTMLElement)) return;
          metric.textContent = '0';
        });
      };

      if (typeof card.__aboutProgressCleanup === 'function') {
        card.__aboutProgressCleanup();
      }

      reset();
      card.__aboutProgressCleanup = window.__triberaDirectionalTrigger({
        element: card,
        onEnter: animate,
        onExit: reset,
        thresholds: {
          mobile: {
            downEnter: 0.72,
            upEnter: 0.38,
            topExit: 0.08,
            bottomExit: 0.92,
          },
          desktop: {
            downEnter: 0.58,
            upEnter: 0.34,
            topExit: 0.14,
            bottomExit: 0.84,
          },
        },
      });
    }

    function bootAboutProgressBars() {
      runWhenDirectionalTriggerReady(initAboutProgressBars);
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      bootAboutProgressBars();
    } else {
      document.addEventListener('DOMContentLoaded', bootAboutProgressBars, { once: true });
    }

    document.addEventListener('astro:page-load', bootAboutProgressBars);
  </script>
  <script is:inline>
    function initFounderReveal() {
      const founderCards = Array.from(document.querySelectorAll('[data-founder-card]'));
      if (!founderCards.length) return;

      founderCards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        if (typeof card.__founderRevealCleanup === 'function') {
          card.__founderRevealCleanup();
        }
        card.classList.remove('is-visible');

        card.__founderRevealCleanup = window.__triberaDirectionalTrigger({
          element: card,
          onEnter: () => card.classList.add('is-visible'),
          onExit: () => card.classList.remove('is-visible'),
          thresholds: {
            mobile: {
              downEnter: 0.7,
              upEnter: 0.42,
              topExit: 0.08,
              bottomExit: 0.94,
            },
            desktop: {
              downEnter: 0.62,
              upEnter: 0.38,
              topExit: 0.12,
              bottomExit: 0.9,
            },
          },
        });
      });
    }

    function bootFounderReveal() {
      runWhenDirectionalTriggerReady(initFounderReveal);
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      bootFounderReveal();
    } else {
      document.addEventListener('DOMContentLoaded', bootFounderReveal, { once: true });
    }

    document.addEventListener('astro:page-load', bootFounderReveal);
  </script>
  <style>
    .about-founder-reveal {
      opacity: 0;
      transform: translate3d(0, 22px, 0);
      transition:
        opacity 560ms ease,
        transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }

    .about-founder-reveal.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }

    @media (prefers-reduced-motion: reduce) {
      .about-founder-reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
