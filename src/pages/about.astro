.wn__c{display:block;width:100%;height:auto;max-width:480px}
.wn__p{stroke-dasharray:1;stroke-dashoffset:1;
  transition:stroke-dashoffset 1.3s cubic-bezier(.25,.8,.35,1)}
.wn.in .wn__p{stroke-dashoffset:0}
.wn.in .wn__p--q{transition-delay:.3s}
.wn__key{display:grid;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--cline)}
.wn__key span{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--onc3)}
.wn__key i{width:16px;height:2.5px;border-radius:2px;flex:none}
.wk1{background:#8E8A80}.wk2{background:var(--red)}
.wn__t{display:grid;border-top:1px solid var(--cline)}
.wn__s{display:grid;gap:6px;padding:17px 0;border-bottom:1px solid var(--cline);
  transition:opacity .26s var(--ease),transform .26s var(--spring)}
.wn__t:hover .wn__s{opacity:.5}
.wn__t:hover .wn__s:hover{opacity:1;transform:translateX(3px)}
.wn__n{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--onc3)}
.wn__s--end .wn__n{color:var(--red)}
.wn__st{font-family:var(--display);font-weight:700;font-size:clamp(17px,1.8vw,20px);
  letter-spacing:-.028em;color:#fff;margin:0}
.wn__sx{font-size:14px;line-height:1.6;color:var(--onc3);margin:0;max-width:56ch;text-wrap:pretty;
  transition:color .24s var(--ease)}
.wn__t:hover .wn__s:hover .wn__sx{color:var(--onc2)}
.wn__sx b{color:#fff;font-weight:600}

.facts{display:grid;gap:22px 34px}
@media(min-width:700px){.facts{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1040px){.facts{grid-template-columns:repeat(4,1fr)}}
.fct{display:grid;gap:5px;align-content:start;padding-top:16px;border-top:2px solid #DCD8CE;
  transition:opacity .28s var(--ease),border-top-color .28s var(--ease),transform .26s var(--spring)}
.facts:hover .fct{opacity:.5}
.facts:hover .fct:hover{opacity:1;border-top-color:var(--red);transform:translateY(-2px)}
.fct__n{font-family:var(--mono);font-weight:700;font-size:clamp(30px,3.6vw,44px);letter-spacing:-.05em;
  line-height:1;color:var(--ink);margin:0}
.facts:hover .fct:hover .fct__n{color:var(--red)}
.fct__k{font-family:var(--mono);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--faint);margin:4px 0 3px}
.fct__x{font-size:13.5px;line-height:1.55;color:var(--grey);margin:0;max-width:32ch;text-wrap:pretty}
.facts__ft{font-size:14.5px;line-height:1.65;color:var(--grey);margin:clamp(24px,2.8vw,34px) 0 0;
  padding-top:clamp(18px,2.2vw,26px);border-top:1px solid var(--hair);max-width:76ch;text-wrap:pretty}
.facts__ft a{color:var(--red);text-decoration:none;border-bottom:1px solid rgba(218,0,7,.35)}
.facts__ft a:hover{border-color:var(--red)}
.wn__g{display:block}

/* the clients, as names rather than a logo wall */
.clients{margin-top:clamp(26px,3vw,38px);padding-top:clamp(20px,2.4vw,28px);
  border-top:1px solid var(--hair)}
.clients__k{font-family:var(--mono);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--red);margin:0 0 14px}
.clients__g{display:flex;flex-wrap:wrap;gap:8px}
