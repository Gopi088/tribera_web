/* act markers give the eye a place to rest without cutting a word */



.ltr__q em{font-style:italic;color:var(--red)}

/* the letter: one display statement, then two quiet columns beneath it */
.ltr{max-width:none;margin:0}
.ltr__k{font-family:var(--mono);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--red);margin:0 0 clamp(18px,2vw,26px)}

