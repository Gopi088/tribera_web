/* ══ SWAP ══ */
.swap{margin-top:18px}
.swap__hd{display:none}
@media(min-width:900px){.swap__hd{display:grid;grid-template-columns:124px 1fr 1fr;gap:30px;padding-top:14px}
  .swap__hd span{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--faint)}
  .swap__hd span:last-child{padding-left:22px}}
.swap__row{display:grid;gap:7px 30px;padding:clamp(12px,1.4vw,16px) 0;
  border-top:1px solid var(--hair);align-items:baseline;
  transition:background .22s var(--ease)}
@media(min-width:900px){.swap__row{grid-template-columns:124px 1fr 1fr;align-items:baseline}}
.swap__row:hover{background:rgba(0,0,0,.028)}
@media(min-width:900px){.swap__row{margin-inline:-14px;padding-inline:14px;border-radius:8px}}
.swap__row:hover .swap__b{color:var(--ink)}
.swap__row:hover .swap__b::before{background:var(--ink);box-shadow:0 0 0 3px rgba(0,0,0,.07)}
.swap__row--keep{border-top:2px solid var(--red);margin-top:2px}
.swap__row--keep .swap__b{color:var(--ink)}
.swap__row--keep .tag--you{border-color:var(--red)}
.swap__row--keep .swap__a{text-decoration:none;color:var(--ink2)}
.swap__row--keep .swap__b::before{background:var(--red);box-shadow:0 0 0 3px rgba(218,0,7,.13)}
.swap__a{font-size:clamp(13.5px,1.35vw,15px);color:#A9A9A2;line-height:1.4;
  text-decoration:line-through;text-decoration-color:#D5D5D0;text-decoration-thickness:1px}
.swap__b{font-family:var(--display);font-weight:700;font-size:clamp(16px,1.75vw,19.5px);
  line-height:1.32;letter-spacing:-.024em;position:relative;padding-left:22px;
  color:var(--ink);transition:color .22s}
.swap__b::before{content:"";position:absolute;left:0;top:.58em;width:9px;height:9px;
  border-radius:50%;background:#CFCBC1;box-shadow:0 0 0 3px rgba(0,0,0,.03);transition:background .22s,box-shadow .22s}

/* ══ FUNNEL ══ */
.fn{background:var(--char);color:var(--onc)}
