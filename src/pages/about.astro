.tag--ai{background:#CFCFC5;color:#3B3B35}
.tag--adv{background:var(--ink);color:#fff}
.tag--you{background:transparent;color:var(--red);border-color:rgba(218,0,7,.45)}
.key{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;margin:0 0 2px;
  padding-bottom:14px;border-bottom:1px solid #EAEAE6}
.key__i{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--grey)}

/* the answer, before the evidence */
.swap__lead{font-family:var(--display);font-weight:700;font-size:clamp(21px,2.7vw,34px);
  line-height:1.2;letter-spacing:-.034em;margin:0 0 clamp(20px,2.4vw,30px);max-width:24ch;
  color:var(--ink)}
