  }
  setStage(1);

  /* hover trace — subtle, on squares and on the step text */
  function peek(n, mode){
    if(!grid) return;
    const reached = mode !== 'stopped';
    grid.classList.add('peek');
    sqs.forEach(function(s){
      const d=+s.dataset.drop;
      s.classList.toggle('co', reached ? d>=n : d===n);
    });
    fF.innerHTML='<i style="background:'+DOT[n]+'"></i>'+(reached?REACH:STOP)[n];
  }
  function unpeek(){
    if(!grid) return;
    grid.classList.remove('peek');
    sqs.forEach(function(s){ s.classList.remove('co'); });
    fF.innerHTML=REST[stage];
  }
  if(grid){
    grid.addEventListener('mouseover',function(e){
      const s=e.target.closest('.sq'); if(s) peek(+s.dataset.drop,'stopped');
    });
    grid.addEventListener('mouseleave',unpeek);
  }

  const steps=[].slice.call(document.querySelectorAll('.step'));
  let userTook=false;
  steps.forEach(function(st){
    const n=+st.dataset.n;
    st.setAttribute('tabindex','0');
    st.setAttribute('role','button');
    function take(){ userTook=true; mark(n); }
    st.addEventListener('mouseenter',function(){ take(); peek(n,'reached'); });
    st.addEventListener('mouseleave',unpeek);
    st.addEventListener('focus',function(){ take(); peek(n,'reached'); });
    st.addEventListener('blur',unpeek);
    st.addEventListener('click',take);
    st.addEventListener('keydown',function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); take(); }
    });
  });

  function mark(n){
    steps.forEach(function(s){ s.classList.toggle('on', +s.dataset.n === n); });
    setStage(n);
  }

  /* it narrows itself once when you arrive — then it’s yours to poke at */
  const fn=document.getElementById('run');
  let played=false;
  if(fn && steps.length && 'IntersectionObserver' in window){
    new IntersectionObserver(function(es,ob){
      es.forEach(function(e){
        if(!e.isIntersecting || played) return;
        played=true; ob.disconnect();
        if(reduce){ mark(5); return; }
        [2,3,4,5].forEach(function(n,i){
          setTimeout(function(){ if(!userTook) mark(n); }, 900 + i*780);
        });
      });
    },{threshold:.35}).observe(fn);
  } else if(steps.length){ mark(5); }

  const io=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
  },{threshold:.14,rootMargin:'0px 0px -8% 0px'});
  document.querySelectorAll('[data-rv]').forEach(function(el){io.observe(el);});

  /* signal tags act as filters over the table */
  const swap=document.querySelector('.swap'), keyBar=document.querySelector('.key');
  if(swap && keyBar){
    const rows=[].slice.call(swap.querySelectorAll('.swap__row'));
    function apply(k){
      if(!k){ swap.classList.remove('dim');
        rows.forEach(function(r){ r.classList.remove('hit'); }); return; }
      const want=k.querySelector('.tag').textContent.trim().toLowerCase();
      swap.classList.add('dim');
      rows.forEach(function(r){
        const t=r.querySelector('.tag');
        r.classList.toggle('hit', !!t && t.textContent.trim().toLowerCase()===want);
      });
    }
    keyBar.querySelectorAll('.key__i').forEach(function(k){
      k.setAttribute('tabindex','0'); k.setAttribute('role','button');
      k.addEventListener('mouseenter',function(){ apply(k); });
    });
    /* one authority for clearing — the bar itself */
    keyBar.addEventListener('mouseleave',function(){ apply(null); });
    keyBar.addEventListener('focusin',function(e){
      const k=e.target.closest('.key__i'); apply(k||null);
    });
    keyBar.addEventListener('focusout',function(e){
      if(!keyBar.contains(e.relatedTarget)) apply(null);
    });
  }

  /* the tally draws once, slowly, then the three land at speed */
  const fan=document.querySelector('.fan'), tN=document.getElementById('tallyN');
  if(fan){
    new IntersectionObserver(function(es,ob){
      es.forEach(function(e){
        if(!e.isIntersecting) return;
        ob.disconnect();
        if(reduce) return;
        fan.classList.add('go');
        if(!tN) return;
        let t0=null;
        const DUR=1800;
        tN.textContent='0';
        requestAnimationFrame(function step(ts){
          if(t0===null) t0=ts;
          const u=Math.min((ts-t0)/DUR,1);
          tN.textContent=Math.round(Math.pow(u,1/0.62)*140);
          if(u<1) requestAnimationFrame(step); else tN.textContent='140';
        });
      });
    },{threshold:.35}).observe(fan);
  }

  const deskBlk=document.querySelector('.desk');
  if(deskBlk) new IntersectionObserver(function(es,ob){
    es.forEach(function(e){ if(e.isIntersecting){ deskBlk.classList.add('in'); ob.disconnect(); } });
  },{threshold:.4}).observe(deskBlk);

  const ramp=document.getElementById('ramp');
  if(ramp) new IntersectionObserver(function(es,ob){
    es.forEach(function(e){ if(e.isIntersecting){ ramp.classList.add('in'); ob.disconnect(); } });
  },{threshold:.3}).observe(ramp);

  /* nav switcher reflects where you are */
  const cand=document.getElementById('candidates'),
      sw=[].slice.call(document.querySelectorAll('.nav__sw a')),
      bar=document.getElementById('stickcta'),
      applyBox=document.getElementById('apply');
  if(cand && sw.length){
    new IntersectionObserver(function(es){
      es.forEach(function(e){
        const inCand=e.isIntersecting;
        sw[0].classList.toggle('is',!inCand);
        sw[1].classList.toggle('is',inCand);
      });
    },{threshold:.18}).observe(cand);
  }

  /* sticky apply bar: only while the candidate section is on screen,
     and never on top of the apply card itself */
  if(cand && bar && applyBox){
    let inSection=false, atForm=false;
    function sync(){ bar.classList.toggle('show', inSection && !atForm); }
    new IntersectionObserver(function(es){
      es.forEach(function(e){ inSection=e.isIntersecting; sync(); });
    },{threshold:.12}).observe(cand);
    new IntersectionObserver(function(es){
      es.forEach(function(e){ atForm=e.isIntersecting; sync(); });
    },{threshold:.3}).observe(applyBox);
  }

  /* a filename is better feedback than a silent upload */
  const fileIn=document.querySelector('.apply__file input');
  if(fileIn) fileIn.addEventListener('change',function(){
    const lbl=fileIn.parentNode.querySelector('span');
    if(fileIn.files && fileIn.files[0]) lbl.textContent=fileIn.files[0].name;
  });
})();

  /* ══ the chalk marks draw themselves in ══ */
  (function(){
    const j=document.querySelector('.jrny'); if(!j) return;
    new IntersectionObserver(function(es,ob){
      es.forEach(function(e){ if(e.isIntersecting){ j.classList.add('in'); ob.disconnect(); } });
    },{threshold:.3}).observe(j);
  })();

  /* ══ the signature writes itself once ══ */
  (function(){
    const l=document.querySelector('.ltr'); if(!l) return;
    new IntersectionObserver(function(es,ob){
      es.forEach(function(e){ if(e.isIntersecting){ l.classList.add('in'); ob.disconnect(); } });
    },{threshold:.25}).observe(l);
  })();

  /* ══ FIGURES: bars fill and numbers count, once, on arrival ═══════════════
     Generic and defensive — it animates whatever is on the page and does
     nothing where those elements do not exist. */
  (function(){
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* every element on the site whose content is a figure worth arriving */
    const FIGS = ['.bw__v','.sc__v','.fd__n','.av__p','.av__cv','.estat__n','.cstat__n',
                '.nine__n b','.ratio__n','.hrs__n','.big__n','.stat__n','.us__v',
                '.grp__c','.dept__c','.rfb i','.fchip i','.dlv__c','.pth__d em',
                '.cmp__v','.tally__n','.hours','.mult__n','.vol__n','.labcard__n b','.fct__n'].join(',');

    function parse(t){
      const m = String(t).match(/^(\D*?)([\d,]+(?:\.\d+)?)(.*)$/);
      if(!m) return null;
      const n = parseFloat(m[2].replace(/,/g,''));
      if(!isFinite(n) || n === 0) return null;
      return { pre:m[1], n:n, post:m[3], dec:(m[2].split('.')[1]||'').length,
               grouped:m[2].indexOf(',') > -1 };
    }

    function count(el){
      if(el.dataset.counted) return;
      const f = parse(el.textContent.trim());
      if(!f) return;
      el.dataset.counted = '1';
      if(reduce) return;
      let t0 = null;
      const dur = f.n > 999 ? 1000 : 800;
      function fmt(v){
        const s = f.dec ? v.toFixed(f.dec)
                      : (f.grouped ? Math.round(v).toLocaleString('en-IN') : String(Math.round(v)));
        return f.pre + s + f.post;
      }
      function step(ts){
        if(!t0) t0 = ts;
        const p = Math.min((ts - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(f.n * e);
        if(p < 1) requestAnimationFrame(step);
        else el.textContent = fmt(f.n);
      }
      el.textContent = fmt(0);
      requestAnimationFrame(step);
    }

    /* bars declared with --w start at zero and fill in place */
    function fill(el){
      if(el.dataset.filled) return;
      el.dataset.filled = '1';
      const w = el.style.getPropertyValue('--w');
      if(!w) return;
      if(reduce){ el.style.width = w; return; }
      el.style.width = '0';
      el.style.transition = 'width .85s cubic-bezier(.22,.9,.3,1)';
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){ el.style.width = w; });
      });
    }

    function watch(nodes, fn, threshold){
      if(!nodes.length) return;
      const io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(!e.isIntersecting) return;
          fn(e.target);
          io.unobserve(e.target);
        });
      }, { threshold: threshold || 0.4, rootMargin: '0px 0px -40px 0px' });
      nodes.forEach(function(n){ io.observe(n); });
    }

    function start(){
      watch([].slice.call(document.querySelectorAll(FIGS)), count, 0.6);
      watch([].slice.call(document.querySelectorAll('[style*="--w:"]')), fill, 0.25);
    }

    if(document.readyState === 'loading')
      document.addEventListener('DOMContentLoaded', start);
    else start();

    /* anything rendered after load — role cards, filtered lists — still counts */
    window.TRIBERA_REANIMATE = start;
  })();

  /* ══ the two curves draw once ══ */
  (function(){
    const w=document.querySelector('.wn'); if(!w) return;
    new IntersectionObserver(function(es,ob){
      es.forEach(function(e){ if(e.isIntersecting){ w.classList.add('in'); ob.disconnect(); } });
    },{threshold:.3}).observe(w);
  })();

</script>
</Layout>
