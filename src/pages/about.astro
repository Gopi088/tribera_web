/* the expand control, centred and stable at every width */
.rest__pl{position:relative;width:28px;height:28px;border-radius:50%;
  border:1px solid #45453E;flex:none;justify-self:end;
  transition:border-color .24s var(--ease),background .24s var(--ease),transform .26s var(--spring)}
.rest__pl::before,.rest__pl::after{content:"";position:absolute;left:50%;top:50%;
  background:#9C9C97;border-radius:1px;
  transition:transform .3s var(--spring),background .2s}
.rest__pl::before{width:11px;height:1.5px;transform:translate(-50%,-50%)}
.rest__pl::after{width:1.5px;height:11px;transform:translate(-50%,-50%)}
.rest:hover .rest__pl{border-color:var(--red);background:rgba(218,0,7,.14);transform:scale(1.08)}
.rest:hover .rest__pl::before,.rest:hover .rest__pl::after{background:var(--red)}
.rest.op .rest__pl{border-color:var(--red);background:var(--red)}
.rest.op .rest__pl::before,.rest.op .rest__pl::after{background:#fff}
.rest.op .rest__pl::after{transform:translate(-50%,-50%) scaleY(0)}

@media(min-width:1060px){
  .rest__hd{position:relative;grid-template-columns:196px 1fr 100px 92px 116px 28px;
    align-items:center}
}
@media(max-width:1059px){
  /* the control aligns with the name, and the meta runs inline */
  .rest__hd{position:relative;grid-template-columns:1fr 28px;
    grid-template-areas:"name ctrl" "text text" "meta meta";
    gap:8px 14px;padding:16px 12px;align-items:start}
  .rest__n{grid-area:name}
  .rest__pl{grid-area:ctrl;position:static;margin-top:2px}
  .rest__x{grid-area:text}
  .rest__t,.rest__p,.rest__h{grid-area:meta;display:inline}
  .rest__t::after,.rest__p::after{content:"  ·  ";opacity:.4}
  .rest__hd::after{display:none}
}

