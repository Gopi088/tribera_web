@keyframes volin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

.incl{margin-top:clamp(28px,3.2vw,42px);padding-top:clamp(20px,2.4vw,28px);
  border-top:1px solid var(--cline)}
.incl__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--onc3);margin:0 0 16px}
.incl__g{display:grid;gap:12px 26px}
@media(min-width:760px){.incl__g{grid-template-columns:repeat(4,1fr)}}
.incl__g span{position:relative;padding-left:20px;font-size:14px;line-height:1.45;color:var(--onc2)}
.incl__g span::before{content:"";position:absolute;left:0;top:.44em;width:8px;height:8px;
  border-radius:50%;background:var(--red)}


/* ══ EXPERT BENCH ══ */
.bench{margin-top:clamp(28px,3.2vw,44px)}
.bench__g{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--hair);
  border:1px solid var(--hair);border-radius:14px;overflow:hidden}
@media(min-width:620px){.bench__g{grid-template-columns:repeat(3,1fr)}}
@media(min-width:920px){.bench__g{grid-template-columns:repeat(4,1fr)}}
.xp{background:var(--card);padding:15px 16px;display:grid;gap:4px;
  transition:background .22s var(--ease)}
.xp:hover{background:#FAFAF8}
.xp b{font-family:var(--display);font-weight:600;font-size:14.5px;letter-spacing:-.018em}
.xp span{font-family:var(--mono);font-size:11px;color:var(--faint)}
.bench__ft{display:grid;gap:10px;margin-top:18px}
@media(min-width:820px){.bench__ft{grid-template-columns:auto 1fr;gap:28px;align-items:baseline}}
.bench__more{font-size:14.5px;color:var(--grey);margin:0;white-space:nowrap}
.bench__more b{color:var(--red);font-family:var(--mono);font-weight:700}
.bench__note{font-size:14px;line-height:1.5;color:var(--grey);margin:0;max-width:60ch}
.inds{margin-top:clamp(24px,2.8vw,36px);padding-top:clamp(18px,2.2vw,24px);
  border-top:1px solid var(--hair)}
.inds__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--faint);margin:0 0 14px}
.inds__g{display:flex;flex-wrap:wrap;gap:8px}
.inds__g span{font-size:13px;line-height:1.3;padding:7px 12px;border-radius:999px;
  border:1px solid var(--hair);color:var(--ink2);background:var(--card);
  transition:border-color .2s var(--ease),transform .18s var(--ease)}
.inds__g span:hover{border-color:#CFCBC1;transform:translateY(-1px)}


/* ══ WHO — founders, with slots for real photographs ══ */
.whos{margin-top:clamp(30px,3.4vw,46px);padding-top:clamp(24px,2.8vw,32px);border-top:1px solid var(--hair)}
.whos__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--faint);margin:0 0 18px}
.whos__g{display:grid;gap:24px}
@media(min-width:820px){.whos__g{grid-template-columns:repeat(3,1fr);gap:clamp(24px,2.8vw,44px);
  align-items:start}}
.who{display:grid;grid-template-columns:74px 1fr;gap:16px;align-items:start}
.who__ph{width:74px;height:74px;border-radius:50%;display:grid;place-items:center;
  background-color:#E7E5DE;border:1px solid var(--hair);overflow:hidden;
  font-family:var(--mono);font-size:0;color:transparent;
  background-size:112%;background-position:center 12%;background-repeat:no-repeat;
  box-shadow:0 1px 3px rgba(0,0,0,.06);
  transition:box-shadow .3s var(--ease),transform .3s var(--ease)}
.who:hover .who__ph{transform:translateY(-2px);
  box-shadow:0 0 0 3px rgba(218,0,7,.14),0 6px 16px rgba(0,0,0,.1)}
.who__n{font-family:var(--display);font-weight:700;font-size:16px;letter-spacing:-.022em;margin:0;
  white-space:nowrap}
.who__r{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--red);margin:4px 0 8px}
.who__d{font-size:13.5px;line-height:1.55;color:var(--grey);margin:0;
  min-height:calc(3 * 1.55em);text-wrap:pretty}

/* ══ RATIO drawn ══ */
.hg__mid{display:grid;justify-items:center;gap:16px}
.ratio{display:grid;gap:9px;width:100%;max-width:270px}
.ratio__r{display:grid;grid-template-columns:56px 1fr;gap:10px;align-items:center}
.ratio__k{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--faint);text-align:right}
.ratio__r--us .ratio__k{color:var(--red)}
.ratio__sq{display:flex;gap:5px}
.ratio__sq i{display:block;width:17px;height:17px;border-radius:4px;background:#DCD9D1}
.ratio__sq i.hit{background:var(--ink)}
.ratio__r--us .ratio__sq i{background:#E8E4DA}
.ratio__r--us .ratio__sq i.hit{background:var(--red);box-shadow:0 0 0 3px rgba(218,0,7,.16)}
.ratio__ft{font-family:var(--mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--faint);margin:0}

/* ══ CANDIDATE TIMELINE ══ */
.tl2__g{display:grid;gap:22px 24px}
@media(min-width:720px){.tl2__g{grid-template-columns:repeat(4,1fr);gap:0 22px}}
.tl2{display:grid;gap:7px;align-content:start}
.tl2__bar{display:block;height:4px;border-radius:2px;background:#DDDAD2;margin-bottom:8px}
.tl2:last-child .tl2__bar{background:var(--red)}
.tl2__d{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--ink2);margin:0}
.tl2__d i{font-style:normal;color:var(--faint)}
.tl2:last-child .tl2__d{color:var(--red)}
.tl2__t{font-family:var(--display);font-weight:700;font-size:16px;letter-spacing:-.022em;margin:0}
.tl2__p{font-size:13.5px;line-height:1.45;color:var(--grey);margin:0}



/* ══ TRUST ══ */
.trust{background:var(--char);color:var(--onc)}
.trust .eyebrow{color:var(--red)}
.trust h2{color:#fff}
.trust__dek{font-size:clamp(16px,1.7vw,20px);line-height:1.6;color:var(--onc2);max-width:44ch;margin:0}
.trust__dek b{color:#fff;font-weight:600}
.tr2{display:grid;gap:26px 44px}
@media(min-width:820px){.tr2{grid-template-columns:repeat(2,1fr)}}
.tr2__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--onc3);margin:0 0 6px;padding-bottom:12px;border-bottom:1px solid var(--cline)}
.tr2__l{list-style:none;margin:0;padding:0;display:grid}
.tr2__l li{position:relative;padding:12px 0 12px 22px;font-size:14.5px;line-height:1.45;
  color:var(--onc2);border-bottom:1px solid rgba(255,255,255,.055)}
.tr2__l li:last-child{border-bottom:0}
.tr2__l li::before{content:"";position:absolute;left:0;top:1.15em;width:8px;height:8px;
  border-radius:50%;background:#4E4E47}
.tr2__l li b{color:#fff;font-weight:600}
.tr2__l li:has(b)::before{background:var(--red)}
.qa{margin-top:clamp(30px,3.6vw,46px);padding-left:22px;border-left:2px solid var(--red)}
.qa__q{font-size:15px;color:var(--onc3);margin:0 0 8px;font-style:italic}
.qa__a{font-family:var(--display);font-weight:700;font-size:clamp(19px,2.3vw,28px);line-height:1.25;
  letter-spacing:-.03em;color:#fff;margin:0;max-width:26ch}
.qa__a em{font-style:normal;color:var(--red)}
.trust__ft{font-size:13.5px;line-height:1.6;color:var(--onc3);margin:clamp(26px,3vw,40px) 0 0;
  padding-top:clamp(18px,2.2vw,26px);border-top:1px solid var(--cline);max-width:72ch;text-align:center;
  margin-left:auto;margin-right:auto}

/* ══ THE CHOREOGRAPHY ══ */
.cg__g{display:grid;gap:26px 24px}
@media(min-width:760px){.cg__g{grid-template-columns:repeat(5,1fr);gap:0 20px}}
.cg{display:grid;gap:6px;align-content:start}
.cg__bar{display:block;height:4px;border-radius:2px;background:#DDDAD2;margin-bottom:10px}
.cg:last-child .cg__bar{background:var(--red)}
.cg__d{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--ink2);margin:0}
.cg__d i{font-style:normal;color:var(--faint)}
.cg:last-child .cg__d{color:var(--red)}
.cg__t{font-family:var(--display);font-weight:700;font-size:16px;letter-spacing:-.022em;margin:0}
.cg__p{font-size:13.5px;line-height:1.45;color:var(--grey);margin:0}
.cg__w{font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--faint);margin:6px 0 0;padding-top:8px;border-top:1px solid var(--hair)}
.cg__notes{display:grid;gap:18px 40px;margin-top:clamp(28px,3.2vw,44px);
  padding-top:clamp(20px,2.4vw,28px);border-top:1px solid var(--hair)}
@media(min-width:760px){.cg__notes{grid-template-columns:repeat(2,1fr)}}
.cg__k{font-family:var(--display);font-weight:700;font-size:15.5px;letter-spacing:-.02em;margin:0 0 5px;
  position:relative;padding-left:20px}
.cg__k::before{content:"";position:absolute;left:0;top:.44em;width:8px;height:8px;border-radius:50%;
  background:var(--red)}
.cg__v{font-size:13.5px;line-height:1.5;color:var(--grey);margin:0;padding-left:20px}

/* ══ VOICES marquee ══ */
.mq{overflow:hidden;margin-top:clamp(30px,3.6vw,46px);
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.mq__t{display:flex;gap:16px;width:max-content;padding-inline:var(--gut);
  animation:mqrun 68s linear infinite}
.mq:hover .mq__t,.mq:focus-within .mq__t{animation-play-state:paused}
@keyframes mqrun{to{transform:translateX(calc(-50% - 8px))}}
.qc{flex:none;width:330px;margin:0;background:#F4F4F2;border:1px solid #E9E9E5;
  border-radius:14px;padding:20px 20px 18px;display:flex;flex-direction:column;
  transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s}
.qc:hover{transform:translateY(-3px);background:#fff;box-shadow:0 10px 30px rgba(0,0,0,.07)}
.qc__tag{align-self:flex-start;font-family:var(--mono);font-size:9px;letter-spacing:.16em;
  text-transform:uppercase;padding:5px 9px;border-radius:5px;margin-bottom:14px}
.qc--ta .qc__tag{background:var(--ink);color:#fff}
.qc--cd .qc__tag{background:transparent;color:var(--red);border:1px solid rgba(218,0,7,.42)}
.qc__q{font-size:15px;line-height:1.5;color:var(--ink2);margin:0 0 auto;
  font-family:var(--display);font-weight:500;letter-spacing:-.012em}
.qc__a{margin-top:18px;padding-top:14px;border-top:1px solid #E4E4DE;display:grid;gap:2px}
.qc__a b{font-size:13.5px;font-weight:600;color:var(--ink)}
.qc__a span{font-size:12.5px;color:var(--grey)}
@media (prefers-reduced-motion:reduce){
  .mq{overflow-x:auto;-webkit-mask-image:none;mask-image:none}
  .mq__t{animation:none}
}

/* ══ CLOSE ══ */
.doors{display:grid;gap:18px;margin-top:clamp(36px,4.4vw,56px)}
@media(min-width:760px){.doors{grid-template-columns:repeat(2,1fr)}}
.door{background:var(--card);border-radius:18px;padding:clamp(26px,3.2vw,40px);
  box-shadow:0 2px 24px rgba(0,0,0,.05);display:flex;flex-direction:column;
  transition:box-shadow .3s,transform .3s var(--ease)}
.door:hover{box-shadow:0 12px 40px rgba(0,0,0,.09);transform:translateY(-2px)}
.door p{color:var(--grey);font-size:15.5px;line-height:1.6;margin:12px 0 0;flex:1}
.door .btn{align-self:flex-start;margin-top:24px}
.bbb2{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px;
  margin:clamp(48px,5.5vw,76px) 0 0;padding-top:clamp(30px,3.4vw,44px);border-top:1px solid var(--hair)}
.bbb2 span{font-family:var(--display);font-weight:800;font-size:clamp(20px,2.4vw,30px);
  letter-spacing:-.038em;color:var(--ink)}
.bbb2 span:first-child{color:var(--red)}
.bbb2 i{display:block;width:5px;height:5px;border-radius:50%;background:#CFCBC1}
.bbb2__s{text-align:center;font-size:14px;line-height:1.55;color:var(--grey);
  margin:14px auto 0;max-width:44ch}

.ft{background:var(--char);color:var(--onc3);padding-block:clamp(48px,5.5vw,76px) 32px;font-size:14px}
.ft__top{display:grid;gap:clamp(30px,3.4vw,44px)}
@media(min-width:760px){.ft__top{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1020px){.ft__top{grid-template-columns:1.5fr repeat(4,.9fr);gap:clamp(24px,2.6vw,44px)}}
.ft__brand .logo{color:var(--onc)}
.ft__line{font-size:14.5px;line-height:1.55;color:var(--onc3);margin:16px 0 0;max-width:36ch}
.ft__line b{color:var(--onc);font-weight:600;display:block;margin-bottom:6px}
.ft__tribe{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--faint);margin:16px 0 0}
.ft__bbb{display:flex;align-items:center;gap:10px;flex-wrap:nowrap;white-space:nowrap;
  font-family:var(--display);font-weight:700;font-size:15px;letter-spacing:-.02em;
  color:var(--onc2);margin:7px 0 0}
.ft__bbb em{font-style:normal;color:var(--red)}
.ft__bbb i{display:block;width:4px;height:4px;border-radius:50%;background:#4A4A44;flex:none}
.ft__social{display:flex;flex-wrap:wrap;gap:18px;margin-top:20px}
.ft__social a{font-size:13.5px;color:var(--onc2);text-decoration:none;
  border-bottom:1px solid var(--cline);padding-bottom:3px;transition:color .2s,border-color .2s}
.ft__social a:hover{color:#fff;border-color:var(--onc2)}
.ft__col{display:flex;flex-direction:column;gap:11px;align-items:flex-start}
.ft__ttl{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--red);margin:0 0 5px}
.ft__col a{font-size:14px;color:var(--onc2);text-decoration:none;transition:color .2s,transform .2s}
.ft__col a:hover{color:#fff;transform:translateX(2px)}
.ft__bar{display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between;align-items:baseline;
  margin-top:clamp(36px,4vw,56px);padding-top:22px;border-top:1px solid var(--cline);
  font-size:12.5px;color:var(--onc3)}
.ft__made{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase}

/* ══ MICRO-INTERACTIONS ══ */
/* signal rows grow a marker as they open */
.sig__r{position:relative;padding-left:0;transition:padding-left .3s var(--ease)}
.sig__r::before{content:"";position:absolute;left:0;top:14px;width:2px;height:0;
  background:var(--red);border-radius:2px;transition:height .3s var(--ease)}
.sig__r:hover,.sig__r:focus-within{padding-left:12px}
.sig__r:hover::before,.sig__r:focus-within::before{height:14px}
.side{transition:background .3s var(--ease)}
.side:hover{background:rgba(255,255,255,.018)}

/* verdict pill breathes once when it arrives */
.duo.in .pill{animation:beat 2.2s var(--ease) .5s 1 both}
@keyframes beat{0%{box-shadow:0 0 0 0 rgba(63,190,124,.35)}
  55%{box-shadow:0 0 0 8px rgba(63,190,124,0)}100%{box-shadow:0 0 0 0 rgba(63,190,124,0)}}

/* client names come up on hover */
.logos__r span{transition:color .25s var(--ease);cursor:default}
.logos__r span:hover{color:#B4B4AD}

/* tags become filters */
.tag{transition:transform .18s var(--ease),box-shadow .25s var(--ease)}
.key__i{cursor:pointer;padding:5px 8px;margin:-5px -8px;border-radius:999px;
  transition:background .2s var(--ease);outline:none}
.key__i:hover,.key__i:focus-visible{background:rgba(0,0,0,.045)}
.key__i:focus-visible{box-shadow:0 0 0 2px var(--red)}
.key__i:hover .tag,.key__i:focus-visible .tag{transform:translateY(-1px)}
.swap .swap__row{transition:background .22s var(--ease),opacity .28s var(--ease)}
.swap.dim .swap__row:not(.hit){opacity:.52}
.swap .swap__row.hit{background:rgba(0,0,0,.04)}
.band--w .swap__row.hit,.panel .swap__row.hit{background:#EEEEEA}
.swap .swap__row.hit .tag{transform:translateY(-1px);box-shadow:0 0 0 3px rgba(0,0,0,.08)}
.swap .swap__row--keep.hit .tag{box-shadow:0 0 0 3px rgba(218,0,7,.18)}

/* guarantee + figures answer the cursor */
.gz__i .gz__k,.adv__n{transition:color .25s var(--ease)}
.gz__i:hover .gz__k{color:var(--red)}
.tr{transition:background .22s var(--ease)}
.tr:not(.tr--h):hover{background:rgba(255,255,255,.035)}
@media(min-width:800px){.tr{margin-inline:-14px;padding-inline:14px;border-radius:8px}}

/* chips lift */


/* ══ NAV audience pill ══ */

.nav__sw a{font-size:13px;padding:6px 13px;border-radius:999px;color:var(--onc2);
  text-decoration:none;white-space:nowrap;transition:background .2s,color .2s}

.nav__sw a:hover:not(.is){color:#fff}


/* ══ APPLY card ══ */
.apply{margin-top:clamp(38px,4.6vw,60px);background:var(--char);border-radius:20px;
  padding:clamp(26px,3.4vw,44px);color:var(--onc)}
.apply__k{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--red);margin:0 0 14px}
.apply__h{font-family:var(--display);font-weight:700;font-size:clamp(23px,2.9vw,36px);
  line-height:1.1;letter-spacing:-.034em;color:#fff;margin:0;max-width:20ch}
.apply__s{font-size:15.5px;line-height:1.55;color:var(--onc2);margin:14px 0 0;max-width:48ch}
.apply__form{display:grid;gap:10px;margin-top:clamp(22px,2.6vw,30px)}
.apply__row{display:flex;flex-wrap:wrap;gap:10px}
.apply__file{display:inline-flex;align-items:center;gap:10px;padding:14px 22px;border-radius:999px;
  background:var(--onc);color:var(--char);font-weight:600;font-size:15px;cursor:pointer;
  transition:transform .18s var(--ease)}
.apply__file:hover{transform:translateY(-1px)}
.apply__file input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.apply__or{display:flex;align-items:center;color:var(--onc3);font-size:13.5px;padding:0 4px}
.apply__ar{display:inline-block;transition:transform .3s var(--spring)}
.apply__go:hover .apply__ar{transform:translateX(3px)}
.apply__url,.apply__mail{flex:1;min-width:220px;background:transparent;border:1px solid var(--cline);
  border-radius:999px;padding:14px 20px;color:#fff;font-family:var(--ui);font-size:15px;outline:none;
  transition:border-color .2s,box-shadow .2s}
.apply__url::placeholder,.apply__mail::placeholder{color:var(--onc3)}
.apply__url:focus,.apply__mail:focus{border-color:var(--onc2)}
.apply__mail{border-color:rgba(255,255,255,.28)}
.apply__mail:focus{border-color:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.08)}
.apply__mail:invalid:not(:placeholder-shown){border-color:rgba(218,0,7,.6)}
.apply__row--2{align-items:stretch}
.apply__go{padding:15px 28px;display:inline-flex;align-items:center;gap:9px;border-radius:999px;border:0;background:var(--red);color:#fff;
  font-family:var(--ui);font-weight:600;font-size:15px;cursor:pointer;white-space:nowrap;
  transition:transform .18s var(--ease),background .2s}
.apply__go:hover{transform:translateY(-1px);background:#C10006}
.apply__fine{font-size:13px;color:var(--onc3);margin:18px 0 0}
.apply__fine b{color:var(--onc);font-weight:600}

/* ══ sticky candidate CTA ══ */
.stickcta{position:fixed;left:0;right:0;bottom:0;z-index:70;transform:translateY(110%);
  transition:transform .4s var(--ease);background:#131313;
  backdrop-filter:blur(12px);border-top:1px solid var(--cline)}
.stickcta.show{transform:none}
.stickcta__in{display:flex;align-items:center;gap:14px;padding:12px 0}
.stickcta p{margin:0;font-size:14px;color:var(--onc2);flex:1;line-height:1.35}
.stickcta p b{color:#fff;font-weight:600;display:block}
@media(max-width:560px){.stickcta p b{font-size:14px}.stickcta p span{display:none}}
@media (prefers-reduced-motion:reduce){.stickcta{transition:none}}

/* ══ SECTION RHYTHM — the header owns the gap below it ══ */
.shead{margin-bottom:clamp(30px,3.6vw,52px)}
.shead + *{margin-top:0}
.shead + .ramp{margin-top:0}

/* ══ THE SMALL RETURNS — press, spring, and group awareness ══ */
:root{--spring:cubic-bezier(.34,1.42,.64,1)}

/* 1. everything you can press, presses back */
.btn,.ftab,.pre,.vseg,.step,.tl,.lt,.chip,.key__i,.inds__g span,
.qc,.door,.who__ph,.xp,.cmp__r,.sig__r,.swap__row{
  transition-timing-function:var(--spring)}
.btn:active,.ftab:active,.pre:active,.vseg:active,.tl:active,.lt:active,
.chip:active,.key__i:active,.inds__g span:active,.qc:active{
  transform:scale(.965);transition-duration:.08s}
.door:active,.panel:active{transform:scale(.995);transition-duration:.1s}
.step:active{transform:translateX(3px);transition-duration:.08s}
.flip:active{transform:scale(.99)}
.flip.is-b:active{transform:rotateY(180deg) scale(.99)}

/* 2. text links sweep instead of just changing colour */
.ft__col a,.ft__social a,.expect__lk,.plans__ft a,.chip__lk{position:relative}
.ft__col a::after{content:"";position:absolute;left:0;right:100%;bottom:-3px;height:1px;
  background:currentColor;opacity:.5;transition:right .34s var(--spring)}
.ft__col a:hover::after{right:0}

/* 3. the dot in the wordmark notices you */
.logo i{display:inline-block;transition:transform .4s var(--spring),color .3s}
.logo:hover i{transform:translateY(-2px) scale(1.25)}

/* 4. grouped tiles become aware of each other */
.bench__g:hover .xp{opacity:.55}
.bench__g:hover .xp:hover{opacity:1;transform:translateY(-2px);
  box-shadow:0 6px 18px rgba(0,0,0,.06);z-index:2;position:relative}
.tiles:hover .tl{opacity:.6}
.tiles:hover .tl:hover{opacity:1}
.whos__g:hover .who{opacity:.55}
.whos__g:hover .who:hover{opacity:1}
.bench__g .xp,.tiles .tl,.whos .who{transition:opacity .28s var(--ease),
  transform .28s var(--spring),box-shadow .28s var(--ease),background .22s var(--ease)}

/* 5. inputs lift a hair when they take focus */
.apply__url:focus,.apply__mail:focus{transform:translateY(-1px)}
.apply__url,.apply__mail{transition:border-color .2s,box-shadow .2s,transform .3s var(--spring)}

/* 6. the switcher settles rather than snapping */
.ftab,.nav__sw a{transition:background .32s var(--spring),color .22s,transform .2s var(--spring)}
.nav__sw a:active{transform:scale(.94)}

@media(prefers-reduced-motion:reduce){
  .btn:active,.ftab:active,.pre:active,.vseg:active,.tl:active,.lt:active,
  .chip:active,.key__i:active,.qc:active,.door:active,.panel:active,
  .step:active,.flip:active,.logo:hover i{transform:none}
  .ft__col a::after{transition:none}
}

/* the four boxes are there to be compared — so let them be */
.ramp__g .rp{transition:opacity .3s var(--ease),transform .34s var(--spring)}
.ramp__g:hover .rp{opacity:.42}
.ramp__g:hover .rp:hover{opacity:1;transform:translateY(-4px)}
.rp__acc b{transition:color .25s var(--ease)}
.ramp__g:hover .rp:hover .rp__acc b{color:var(--red)}
.rp .rk__ht,.rp .rk__ln{transition:stroke-opacity .3s var(--ease)}
.ramp__g:hover .rp:hover .rk__ht{stroke-opacity:1}
@media(prefers-reduced-motion:reduce){
  .ramp__g:hover .rp{opacity:1}
  .ramp__g:hover .rp:hover{transform:none}
}

/* ══ THE LAB: the tiles and the sliders are the same instrument ══ */
.lt{cursor:default;outline:none}
.lt.lit{border-color:rgba(255,255,255,.55);
  box-shadow:0 0 0 3px rgba(255,255,255,.09);transform:translateY(-2px)}
.lt.low.lit{border-color:rgba(232,163,61,.7);box-shadow:0 0 0 3px rgba(232,163,61,.16)}
.lt.heavy.lit{border-color:rgba(218,0,7,.75);box-shadow:0 0 0 3px rgba(218,0,7,.2)}
.row{margin-inline:-10px;padding-inline:10px;border-radius:8px;
  transition:background .24s var(--ease)}
.row.lit{background:rgba(255,255,255,.05)}
.row.lit .row__n{color:#fff}
.row.lit .row__p{color:#fff}
.row.lit .row__k{color:#fff}
@media(prefers-reduced-motion:reduce){.lt.lit{transform:none}}

/* ══ HOW WE ENGAGE: tracing the path ══ */
.cg{transition:opacity .28s var(--ease),transform .3s var(--spring)}
.cg__bar{transition:background .3s var(--ease),transform .34s var(--spring);transform-origin:left}
.cg__g:hover .cg{opacity:.45}
.cg__g:hover .cg:hover{opacity:1;transform:translateY(-3px)}
.cg__g:hover .cg:hover .cg__bar{background:var(--red);transform:scaleY(1.6)}
.cg__w{transition:color .28s var(--ease)}
.cg__g:hover .cg:hover .cg__w{color:var(--red)}

/* ══ THE 1:3 HINGE: each side lights its own ratio ══ */
.hinge>div{transition:opacity .28s var(--ease)}
.hinge:hover>div{opacity:.5}
.hinge:hover>div:hover,.hinge:hover>.hg__mid{opacity:1}
.ratio__r{transition:opacity .28s var(--ease)}
.hinge>div:first-child:hover ~ .hg__mid .ratio__r--us{opacity:.35}
.hinge>div:last-child:hover ~ .hg__mid .ratio__r{opacity:.35}
.ratio__sq i{transition:transform .3s var(--spring),background .25s var(--ease)}
.ratio__r:hover .ratio__sq i{transform:translateY(-2px)}
.ratio__r:hover .ratio__sq i:nth-child(2){transition-delay:.04s}
.ratio__r:hover .ratio__sq i:nth-child(3){transition-delay:.08s}
.ratio__r:hover .ratio__sq i:nth-child(4){transition-delay:.12s}
.ratio__r:hover .ratio__sq i:nth-child(5){transition-delay:.16s}
.ratio__r:hover .ratio__sq i:nth-child(6){transition-delay:.2s}
.ratio__r:hover .ratio__sq i:nth-child(7){transition-delay:.24s}
.ratio__r:hover .ratio__sq i:nth-child(8){transition-delay:.28s}

/* ══ TRUST: the lightest touch — a list you read, not play with ══ */
.tr2__l li{transition:color .25s var(--ease)}
.tr2__l li::before{transition:background .25s var(--ease),transform .3s var(--spring)}
.tr2__l li:hover{color:#fff}
.tr2__l li:hover::before{background:var(--red);transform:scale(1.3)}

@media(prefers-reduced-motion:reduce){
  .cg__g:hover .cg,.hinge:hover>div{opacity:1}
  .cg__g:hover .cg:hover,.ratio__r:hover .ratio__sq i{transform:none}
}

/* ══ TYPESETTING — no orphans, no stranded words ══ */
h1,h2,.h1,.h2,.hero h1,.fn__line,.pledge2,.swap__lead,.human,.lab__foot,
.qa__a,.hg__t,.cand__h,.vol__v,.verd__nm,.rp__t,.tl2__t,.cg__t,.expect__g b,
.door__t,.cs2__k,.bbb2__s,.xp b{text-wrap:balance}
p,li,.dek,.hero__p,.fn__dek,.lab__dek,.deal__dek,.trust__dek,.cand__lede,
.fn__math,.cases__ft,.desk__ft,.bench__note,.who__d,.qc__q,
.cg__p,.cg__v,.tl2__p,.rp__d,.vol__d,.expect__g span{text-wrap:pretty}
/* keep short paired phrases whole */
.fn__line em,.pledge2 em,.swap__lead em,.human em,.lab__foot em,.qa__a em{
  white-space:nowrap}

/* ══ FOR CANDIDATES: the section that was standing still ══ */

/* 1. the tally — hover it and the three replies separate from the 137 */
.tally .tk{transition:opacity .3s var(--ease),stroke-width .3s var(--spring)}
.fan__side--own:hover .tally .tk{opacity:.28}
.fan__side--own:hover .tally .tk--r{opacity:1;stroke-width:3.4}
.fan__was{transition:color .28s var(--ease)}
.fan__side--own:hover .fan__was{color:var(--ink)}

/* 2. the three squares are three teams — let them arrive one after another */
.fan__3 span{transition:transform .34s var(--spring),box-shadow .3s var(--ease)}
.fan__side:hover .fan__3 span{transform:translateY(-4px)}
.fan__side:hover .fan__3 span:nth-child(2){transition-delay:.06s}
.fan__side:hover .fan__3 span:nth-child(3){transition-delay:.12s}
.fan__side:hover .fan__3 span:last-child{box-shadow:0 6px 18px rgba(218,0,7,.3)}

/* 3. the candidate timeline behaves like the buyer’s one */
.tl2{transition:opacity .28s var(--ease),transform .3s var(--spring)}
.tl2__bar{transition:background .3s var(--ease),transform .34s var(--spring);transform-origin:left}
.tl2__g:hover .tl2{opacity:.45}
.tl2__g:hover .tl2:hover{opacity:1;transform:translateY(-3px)}
.tl2__g:hover .tl2:hover .tl2__bar{background:var(--red);transform:scaleY(1.6)}

/* 4. the quote acknowledges you */
.qt{transition:border-color .3s var(--ease)}
.qt:hover{border-color:var(--red)}

/* 5. the whole apply card lifts a hair when you engage with it */
.apply{transition:box-shadow .35s var(--ease),transform .35s var(--spring)}
.apply:focus-within{transform:translateY(-2px);box-shadow:0 18px 44px rgba(0,0,0,.10)}

@media(prefers-reduced-motion:reduce){
  .fan__side:hover .fan__3 span,.tl2__g:hover .tl2:hover,.apply:focus-within{transform:none}
  .fan__side--own:hover .tally .tk{opacity:1}
  .tl2__g:hover .tl2{opacity:1}
}

/* ════════ BLOG ════════ */
.hero h1 em{font-style:normal;color:var(--red)}

/* the latest piece, as an object */
.feat__k{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--onc3);margin:0 0 12px}
.feat{position:relative;display:grid;gap:0;overflow:hidden;text-decoration:none;
  background:linear-gradient(158deg,#232320,#1A1A18 46%,#141413);
  border:1px solid #33332E;border-radius:18px;padding:clamp(22px,2.4vw,30px);
  box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 24px 56px rgba(0,0,0,.45);
  transition:transform .34s var(--spring),border-color .3s var(--ease),box-shadow .3s var(--ease)}
.feat:hover{transform:translateY(-4px);border-color:#4A4A44;
  box-shadow:0 1px 0 rgba(255,255,255,.08) inset,0 32px 70px rgba(0,0,0,.55)}
.feat__glint{position:absolute;top:0;left:8%;right:8%;height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent)}
.feat__hd{display:flex;justify-content:space-between;gap:14px;
  font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--onc3);padding-bottom:16px;border-bottom:1px solid var(--cline)}
.feat__t{font-family:var(--display);font-weight:700;font-size:clamp(24px,2.9vw,34px);
  line-height:1.14;letter-spacing:-.036em;color:#fff;margin:18px 0 8px;text-wrap:balance}
.feat__sub{font-size:15px;line-height:1.45;color:var(--onc2);margin-bottom:14px}
.feat__x{font-size:14px;line-height:1.6;color:var(--onc3);text-wrap:pretty}
.feat__ft{display:flex;justify-content:space-between;align-items:center;gap:14px;
  margin-top:20px;padding-top:16px;border-top:1px solid var(--cline)}
.feat__min{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--onc3)}
.feat__go{font-size:14px;font-weight:600;color:#fff;display:inline-flex;align-items:center;gap:8px}
.feat__go i{font-style:normal;color:var(--red);transition:transform .3s var(--spring)}
.feat:hover .feat__go i{transform:translateX(4px)}

/* the filter bar */
.fbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:clamp(20px,2.4vw,30px)}
.fchip{display:inline-flex;align-items:center;gap:8px;font-family:var(--ui);font-size:13px;
  font-weight:600;padding:9px 15px;border-radius:999px;border:1px solid var(--hair);
  background:var(--card);color:var(--grey);cursor:pointer;
  transition:background .22s var(--ease),color .22s,border-color .22s,transform .2s var(--spring)}
.fchip:hover{border-color:#CFCBC1;color:var(--ink)}
.fchip:active{transform:scale(.96)}
.fchip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.fchip i{font-family:var(--mono);font-style:normal;font-size:10px;opacity:.6}
.fchip:focus-visible{outline:2px solid var(--red);outline-offset:2px}

/* the list — editorial rows, not cards */
.posts{display:grid;border-top:1px solid var(--hair)}
.post{display:grid;gap:6px 26px;padding:clamp(20px,2.2vw,26px) 12px;margin-inline:-12px;
  border-bottom:1px solid var(--hair);border-radius:10px;text-decoration:none;color:inherit;
  align-items:start;transition:background .24s var(--ease),transform .26s var(--spring),opacity .26s}
@media(min-width:880px){.post{grid-template-columns:150px 1fr 78px}}
.posts:hover .post{opacity:.48}
.posts:hover .post:hover{opacity:1;background:rgba(0,0,0,.032);transform:translateX(3px)}
.post.hide{display:none}
.post__meta{display:grid;gap:4px}
.post__d{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;color:var(--ink2)}
.post__cat{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--faint)}
.post__t{display:block;font-family:var(--display);font-weight:700;
  font-size:clamp(18px,2vw,23px);line-height:1.2;letter-spacing:-.03em;color:var(--ink)}
.post__sub{display:block;font-size:14.5px;line-height:1.4;color:var(--grey);margin:4px 0 8px}
.post__x{display:block;font-size:14px;line-height:1.6;color:var(--grey);max-width:60ch;
  text-wrap:pretty}
.post__min{font-family:var(--mono);font-size:12px;color:var(--faint);display:flex;
  align-items:baseline;gap:4px;justify-content:flex-start}
@media(min-width:880px){.post__min{justify-content:flex-end}}
.post__min i{font-style:normal;font-size:9px;letter-spacing:.1em;text-transform:uppercase}
.post__ar{color:var(--red);opacity:0;margin-left:8px;transition:opacity .25s,transform .3s var(--spring)}
.post:hover .post__ar{opacity:1;transform:translateX(3px)}
.posts__none{display:none;font-size:14.5px;color:var(--grey);padding:30px 0;margin:0}
.posts__none.on{display:block}

/* subscribe */
.sub{max-width:56ch}
.sub__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--red);margin:0 0 12px}
.sub__h{font-family:var(--display);font-weight:700;font-size:clamp(26px,3.4vw,42px);
  line-height:1.12;letter-spacing:-.038em;color:#fff;margin:0 0 14px}
.sub__s{font-size:15px;line-height:1.6;color:var(--onc2);margin:0 0 24px}

/* ════════ ABOUT ════════ */
.hero h1 em{font-style:normal;color:var(--red)}

.labcard{position:relative;background:linear-gradient(158deg,#232320,#1A1A18 46%,#141413);
  border:1px solid #33332E;border-radius:18px;padding:clamp(22px,2.4vw,30px);overflow:hidden;
  box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 24px 56px rgba(0,0,0,.45)}
.labfield{display:block;width:100%;height:62px;opacity:.95}
.labcard__n{display:flex;align-items:baseline;gap:10px;margin:20px 0 10px;
  padding-top:18px;border-top:1px solid var(--cline);flex-wrap:wrap}
.labcard__n b{font-family:var(--mono);font-weight:700;font-size:clamp(30px,3.6vw,42px);
  letter-spacing:-.05em;color:#fff;line-height:1}
.labcard__n i{font-family:var(--mono);font-style:normal;font-size:10px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--onc3)}
.labcard__x{font-size:13.5px;line-height:1.6;color:var(--onc3);margin:0}

/* the question */
.story{display:grid;gap:clamp(24px,3vw,44px);margin-top:0}
@media(min-width:880px){.story{grid-template-columns:1fr .9fr;align-items:center}}
.story__p{font-size:clamp(16px,1.7vw,20px);line-height:1.7;color:var(--ink2);margin:0 0 1.2em;
  text-wrap:pretty}
.story__p:last-child{margin-bottom:0}
.story__q{font-family:var(--display);font-weight:800;font-size:clamp(28px,4vw,52px);line-height:1.06;
  letter-spacing:-.045em;color:var(--ink);margin:0;padding-left:24px;border-left:2px solid var(--red)}
.story__q em{font-style:normal;color:var(--red)}
.story__ft{font-size:15px;line-height:1.7;color:var(--grey);margin:clamp(26px,3vw,40px) 0 0;
  padding-top:clamp(20px,2.4vw,28px);border-top:1px solid var(--hair);max-width:74ch;text-wrap:pretty}
.story__ft b{color:var(--ink);font-weight:600}

/* the year */
.jrny{display:grid;gap:26px 24px}
@media(max-width:819px){
  .jstep{padding-bottom:26px;border-bottom:1px solid rgba(255,255,255,.07)}
  .jstep:last-child{padding-bottom:0;border-bottom:0}
  .hdraw{margin:16px 0 0}
}
@media(min-width:820px){.jrny{grid-template-columns:repeat(4,1fr);gap:0 22px}
  .hdraw{margin:12px 0 14px}}
.jstep{display:grid;gap:7px;align-content:start;
  transition:opacity .28s var(--ease),transform .3s var(--spring)}
.jstep__bar{display:block;height:4px;border-radius:2px;background:#3A3A36;margin-bottom:10px;
  transform-origin:left;transition:background .3s var(--ease),transform .34s var(--spring)}
.jstep:nth-child(3) .jstep__bar{background:var(--red)}
.jrny:hover .jstep{opacity:.45}
.jrny:hover .jstep:hover{opacity:1;transform:translateY(-3px)}
.jrny:hover .jstep:hover .jstep__bar{background:var(--red);transform:scaleY(1.6)}
.jstep__d{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--onc3);margin:0}
.jstep:nth-child(3) .jstep__d{color:var(--red)}
.jstep__t{font-family:var(--display);font-weight:700;font-size:17px;letter-spacing:-.024em;
  color:#fff;margin:0}
.jstep__x{font-size:13.5px;line-height:1.55;color:var(--onc3);margin:0;text-wrap:pretty}

/* beliefs */
.bels{display:grid;gap:0;border-top:1px solid var(--hair)}
.bel{display:grid;gap:6px 26px;padding:clamp(20px,2.2vw,26px) 12px;margin-inline:-12px;
  border-bottom:1px solid var(--hair);border-radius:10px;align-items:start;
  transition:background .24s var(--ease),opacity .26s var(--ease),transform .26s var(--spring)}
@media(min-width:880px){.bel{grid-template-columns:52px 1fr 1.2fr}}
.bels:hover .bel{opacity:.48}
.bels:hover .bel:hover{opacity:1;background:rgba(0,0,0,.03);transform:translateX(3px)}
.bel__n{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--red)}
.bel__t{font-family:var(--display);font-weight:700;font-size:clamp(18px,1.9vw,22px);line-height:1.22;
  letter-spacing:-.03em;margin:0;text-wrap:balance}
.bel__x{font-size:14.5px;line-height:1.6;color:var(--grey);margin:0;text-wrap:pretty}

/* founders */
.fnds{display:grid;gap:clamp(26px,3vw,40px)}
@media(min-width:900px){.fnds{grid-template-columns:repeat(3,1fr);align-items:start}}
.fnd{display:grid;gap:18px;align-content:start;
  transition:opacity .28s var(--ease),transform .3s var(--spring)}
.fnds:hover .fnd{opacity:.5}
.fnds:hover .fnd:hover{opacity:1;transform:translateY(-3px)}
.fnd__ph{width:104px;height:104px;border-radius:50%;background-color:#E7E5DE;
  border:1px solid var(--hair);background-size:112%;background-position:center 12%;
  box-shadow:0 2px 10px rgba(0,0,0,.07);transition:box-shadow .3s var(--ease)}
.fnds:hover .fnd:hover .fnd__ph{box-shadow:0 0 0 4px rgba(218,0,7,.13),0 8px 20px rgba(0,0,0,.12)}
#ph-akshata{background-image:url('/akshata.png')}
#ph-abhishek{background-image:url('/abhishek.png')}
#ph-pranav{background-image:url('/pranav.png')}
.fnd__n{font-family:var(--display);font-weight:700;font-size:19px;letter-spacing:-.026em;margin:0;
  white-space:nowrap}
.fnd__r{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--red);margin:5px 0 12px}
.fnd__x{font-size:14px;line-height:1.6;color:var(--grey);margin:0 0 14px;text-wrap:pretty}
.fnd__q{font-size:14px;line-height:1.5;color:var(--ink2);margin:0;padding-top:13px;
  border-top:1px solid var(--hair);font-style:italic}

/* the name */
.bbb3{display:grid;gap:20px 34px}
@media(min-width:820px){.bbb3{grid-template-columns:repeat(3,1fr)}}
.bbb3__i{padding-top:18px;border-top:2px solid var(--cline);
  transition:opacity .28s var(--ease),border-color .3s var(--ease)}
.bbb3__i:first-child{border-top-color:var(--red)}
.bbb3:hover .bbb3__i{opacity:.5}
.bbb3:hover .bbb3__i:hover{opacity:1;border-top-color:var(--red)}
.bbb3__w{font-family:var(--display);font-weight:800;font-size:clamp(24px,2.8vw,34px);
  letter-spacing:-.04em;color:#fff;margin:0 0 10px}
.bbb3__i:first-child .bbb3__w{color:var(--red)}
.bbb3__x{font-size:14px;line-height:1.6;color:var(--onc2);margin:0;text-wrap:pretty}

/* ── chalk marks: the one place a hand belongs ── */
.hdraw{display:block;width:92px;height:62px;margin:14px 0 16px;overflow:visible}
.hdraw .hd{stroke-dasharray:1;stroke-dashoffset:1;
  transition:stroke-dashoffset .9s cubic-bezier(.22,.9,.3,1)}
.jrny.in .hdraw .hd{stroke-dashoffset:0}
.jrny.in .jstep:nth-child(1) .hd{transition-delay:.05s}
.jrny.in .jstep:nth-child(2) .hd{transition-delay:.35s}
