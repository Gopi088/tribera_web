/* the expand control has to look like a control */





.rest:hover .rest__pl::before,.rest:hover .rest__pl::after{background:var(--red)}


/* and the row says what the control does */
.rest__hd::after{content:"What’s included";position:absolute;right:52px;
  font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;
  color:#6E6E64;opacity:0;transform:translateX(6px);
  transition:opacity .24s var(--ease),transform .28s var(--spring);pointer-events:none;
  white-space:nowrap}
