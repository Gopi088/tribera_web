.desk{margin-top:clamp(18px,2.2vw,26px);border:1px solid rgba(255,255,255,.09);border-radius:14px;
  padding:clamp(16px,1.9vw,22px);background:rgba(255,255,255,.015)}
.desk__k{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--onc3);margin:0 0 16px}
