  transform: scaleX(1);
}
.desk__bar--frag {
  display: flex;
  gap: 3px;
  background: transparent;
  border: 0;
  padding: 0;
  overflow: visible;
}
.desk__bar--frag span {
  display: block;
  height: 12px;
  border-radius: 3px;
  background: #4e4e47;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s var(--ease);
}
.desk__bar--frag span:nth-child(2n) {
  background: #5c5c54;
}
.desk__bar--frag span:nth-child(3n) {
  background: #44443e;
}
.desk.in .desk__bar--frag span {
  transform: scaleX(1);
}
.desk.in .desk__bar--frag span:nth-child(1) {
  transition-delay: 0ms;
}
.desk.in .desk__bar--frag span:nth-child(2) {
  transition-delay: 70ms;
}
.desk.in .desk__bar--frag span:nth-child(3) {
  transition-delay: 140ms;
}
.desk.in .desk__bar--frag span:nth-child(4) {
  transition-delay: 210ms;
}
.desk.in .desk__bar--frag span:nth-child(5) {
  transition-delay: 280ms;
}
.desk.in .desk__bar--frag span:nth-child(6) {
  transition-delay: 350ms;
}
.desk.in .desk__bar--frag span:nth-child(7) {
  transition-delay: 420ms;
}
.desk.in .desk__bar--frag span:nth-child(8) {
  transition-delay: 490ms;
}
.desk__fill--us {
  width: 4%;
  min-width: 12px;
  background: var(--red);
  box-shadow: 0 0 14px rgba(218, 0, 7, 0.6);
  transition-delay: 0.75s;
}
