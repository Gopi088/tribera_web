            border border-[#da0007]/40
            bg-gradient-to-br from-[#1a0000] to-[#2a0000]
            p-5 sm:p-5 text-white"
        >
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <div
              class="w-[200px] h-[200px]
                bg-[radial-gradient(circle,rgba(218,0,7,0.9),transparent_70%)]
                blur-[40px]
                animate-[redInnerGlow_4s_ease-in-out_infinite]"
            >
            </div>
          </div>

          <div class="relative z-10 text-[13px] font-[400] leading-relaxed text-white/85">
            <span class="text-[#da0007] text-[14px] uppercase tracking-[0.2em] font-[500]">
              What most candidates don't realize
            </span>
            <p class="mt-3">
              Your resume gets 6 seconds of attention. Your LinkedIn gets skimmed. But one honest conversation with
              someone who actually understands what you've built?
            </p>

            <p class="mt-5 text-[13px] font-[400] text-white/85">
              That's what companies remember. That's what tribera captures.
            </p>
          </div>
        </div>
      </div>

      <section id="profileCard" class="flex justify-center mt-16 px-4">
        <div class="w-full max-w-[720px]">
          <div
            data-profile-card-panel
            class="rounded-[20px]
