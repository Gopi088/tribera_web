/* ══ MICRO-INTERACTIONS ══ */
/* signal rows grow a marker as they open */
.sig__r {
  position: relative;
  padding-left: 0;
  transition: padding-left 0.3s var(--ease);
}
.sig__r::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14px;
  width: 2px;
  height: 0;
  background: var(--red);
  border-radius: 2px;
  transition: height 0.3s var(--ease);
}
.sig__r:hover,
.sig__r:focus-within {
  padding-left: 12px;
}
.sig__r:hover::before,
.sig__r:focus-within::before {
  height: 14px;
}
.side {
  transition: background 0.3s var(--ease);
}
.side:hover {
  background: rgba(255, 255, 255, 0.018);
}

/* verdict pill breathes once when it arrives */
.duo.in .pill {
  animation: beat 2.2s var(--ease) 0.5s 1 both;
}
@keyframes beat {
  0% {
    box-shadow: 0 0 0 0 rgba(63, 190, 124, 0.35);
  }
  55% {
    box-shadow: 0 0 0 8px rgba(63, 190, 124, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(63, 190, 124, 0);
  }
}

/* client names come up on hover */
.logos__r span {
  transition: color 0.25s var(--ease);
  cursor: default;
}
.logos__r span:hover {
  color: #b4b4ad;
}

/* tags become filters */
.tag {
  transition:
    transform 0.18s var(--ease),
    box-shadow 0.25s var(--ease);
}
.key__i {
  cursor: pointer;
  padding: 5px 8px;
  margin: -5px -8px;
  border-radius: 999px;
  transition: background 0.2s var(--ease);
  outline: none;
}
.key__i:hover,
.key__i:focus-visible {
  background: rgba(0, 0, 0, 0.045);
}
.key__i:focus-visible {
  box-shadow: 0 0 0 2px var(--red);
}
.key__i:hover .tag,
.key__i:focus-visible .tag {
  transform: translateY(-1px);
}
.swap .swap__row {
  transition:
    background 0.22s var(--ease),
    opacity 0.28s var(--ease);
}
.swap.dim .swap__row:not(.hit) {
  opacity: 0.52;
}
.swap .swap__row.hit {
  background: rgba(0, 0, 0, 0.04);
}
.band--w .swap__row.hit,
.panel .swap__row.hit {
  background: #eeeeea;
}
.swap .swap__row.hit .tag {
  transform: translateY(-1px);
  box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
}
.swap .swap__row--keep.hit .tag {
  box-shadow: 0 0 0 3px rgba(218, 0, 7, 0.18);
}

/* guarantee + figures answer the cursor */
.gz__i .gz__k,
.adv__n {
  transition: color 0.25s var(--ease);
}
.gz__i:hover .gz__k {
  color: var(--red);
}
.tr {
  transition: background 0.22s var(--ease);
}
.tr:not(.tr--h):hover {
  background: rgba(255, 255, 255, 0.035);
}
@media (min-width: 800px) {
  .tr {
    margin-inline: -14px;
    padding-inline: 14px;
    border-radius: 8px;
  }
}

/* chips lift */

/* ══ NAV audience pill ══ */

.nav__sw a {
  font-size: 13px;
  padding: 6px 13px;
  border-radius: 999px;
  color: var(--onc2);
  text-decoration: none;
  white-space: nowrap;
  transition:
    background 0.2s,
    color 0.2s;
}

.nav__sw a:hover:not(.is) {
  color: #fff;
}

/* ══ APPLY card ══ */
.apply {
  margin-top: clamp(14px, 1.6vw, 22px);
  background: var(--char);
  border-radius: 20px;
  padding: clamp(36px, 5.5vw, 56px) clamp(22px, 4.5vw, 48px) clamp(32px, 4.5vw, 40px);
  color: var(--onc);
  overflow: hidden;
  position: relative;
}
@media (min-width: 700px) {
  .apply {
    padding-inline: clamp(32px, 4.5vw, 48px);
  }
}
.stack-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 36px;
  height: 74px;
}
.stack {
  position: relative;
  width: 220px;
  height: 74px;
}
.chip {
  position: absolute;
  top: 0;
  left: 50%;
  width: 78px;
  height: 50px;
  background: #1b1a18;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
  transform-origin: center;
}
.chip::before {
  content: "";
  position: absolute;
  top: 12px;
  left: 10px;
  right: 10px;
  height: 2px;
  background: rgba(255, 255, 255, 0.18);
}
.chip::after {
  content: "";
  position: absolute;
  top: 22px;
  left: 10px;
  width: 60%;
  height: 2px;
  background: rgba(255, 255, 255, 0.12);
}
.chip.rejected::before,
.chip.rejected::after {
  background: #7a0509;
  opacity: 0.5;
}
.chip.rejected {
  opacity: 0.55;
}
.chip.c1 {
  transform: translateX(-140px) rotate(-16deg);
  animation: applyFade 6s ease-in-out infinite;
}
.chip.c2 {
  transform: translateX(-95px) rotate(-8deg) translateY(6px);
  animation: applyFade 6s ease-in-out infinite 0.15s;
}
.chip.c3 {
  transform: translateX(-50px) rotate(-3deg);
  animation: applyFade 6s ease-in-out infinite 0.3s;
}
.chip.c4 {
  transform: translateX(-5px) rotate(4deg) translateY(4px);
  animation: applyFade 6s ease-in-out infinite 0.45s;
}
.chip.c5 {
  transform: translateX(40px) rotate(10deg);
  animation: applyFade 6s ease-in-out infinite 0.6s;
}
@keyframes applyFade {
  0%,
  55% {
    opacity: 0.55;
  }
  70%,
  100% {
    opacity: 0.12;
  }
}
.bubble {
  position: absolute;
  top: 6px;
  left: 50%;
  transform: translateX(84px);
  width: 80px;
  height: 62px;
  background: var(--red);
  border-radius: 12px 12px 12px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  animation: applyRise 6s ease-in-out infinite;
}
.bubble .dots {
  display: flex;
}
.bubble .dots span {
  display: block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #2a0f0c;
  margin: 0 3px;
}
@keyframes applyRise {
  0%,
  55% {
    opacity: 0;
    transform: translateX(84px) translateY(8px) scale(0.85);
  }
  75%,
  100% {
    opacity: 1;
    transform: translateX(84px) translateY(0) scale(1);
  }
}
@media (prefers-reduced-motion: reduce) {
  .chip,
  .bubble,
  .apply__k::before {
    animation: none;
  }
}
.apply__k {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--red);
  margin: 0 0 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}
.apply__k::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--red);
  animation: applyPulse 2s ease-in-out infinite;
}
@keyframes applyPulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.4;
    transform: scale(0.7);
  }
}
.apply__h {
  font-family: var(--display);
  font-weight: 800;
  font-size: clamp(30px, 4vw, 44px);
  line-height: 1.12;
  letter-spacing: -0.02em;
  color: #fff;
  margin: 0 auto 22px;
  max-width: 640px;
  text-align: center;
}
.apply__h .accent {
  color: var(--red);
}
.apply__s {
  font-size: 15px;
  line-height: 1.6;
  color: var(--grey);
  margin: 0 auto 36px;
  max-width: 520px;
  text-align: center;
}
.apply__s b {
  color: #d8d5c9;
  font-weight: 600;
}
.apply__form {
  display: grid;
  gap: 10px;
}
.apply__row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  max-width: 560px;
  margin-inline: auto;
}
.apply__field {
  position: relative;
  flex: 1;
}
.step-tag {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--mono);
  font-size: 10px;
  color: #5d5a52;
  letter-spacing: 0.04em;
  pointer-events: none;
}
.apply__file {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 22px;
  border-radius: 999px;
  background: var(--onc);
  color: var(--char);
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
  transition: transform 0.18s var(--ease);
}
.apply__file:hover {
  transform: translateY(-1px);
}
.apply__file input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
.apply__or {
  display: flex;
  align-items: center;
  color: var(--onc3);
  font-size: 13.5px;
  padding: 0 4px;
}
.apply__ar {
  display: inline-block;
  transition: transform 0.3s var(--spring);
}
.apply__go:hover .apply__ar {
  transform: translateX(3px);
}
.apply__url,
.apply__mail {
  width: 100%;
  height: 52px;
  background: #1b1a18;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  padding: 0 66px 0 18px;
  color: #f8f6f0;
  font-family: var(--ui);
  font-size: 14px;
  outline: none;
  transition: border-color 0.15s ease;
}
.apply__url::placeholder,
.apply__mail::placeholder {
  color: #5c594f;
}
.apply__url:focus,
.apply__mail:focus {
  border-color: rgba(224, 64, 47, 0.55);
}
.apply__mail:invalid:not(:placeholder-shown) {
  border-color: rgba(224, 72, 78, 0.6);
}
.apply__row--2 {
  align-items: stretch;
}
.apply__go {
  height: 52px;
  padding: 0 26px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: 10px;
  border: 0;
  background: var(--red);
  color: #f8f6f0;
  font-family: var(--ui);
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  white-space: nowrap;
  transition:
    transform 0.12s ease,
    background 0.15s ease;
}
.apply__go:hover {
  background: #f01018;
  transform: translateY(-1px);
}
.apply__go:active {
  transform: scale(0.98) translateY(0);
}
.apply__go svg {
  transition: transform 0.15s ease;
}
.apply__go:hover svg {
  transform: translateX(3px);
}
.apply__fine {
  font-size: 11.5px;
  line-height: 1.7;
  color: #5d5a52;
  text-align: center;
  margin: 20px auto 0;
  max-width: 60ch;
}
.apply__fine b {
  color: #b8b5a9;
  font-weight: 600;
}

/* ══ CV DROP PANEL — start here ══ */
.drop {
  margin-top: clamp(1.5rem, 3vw, 2.5rem);
}
.drop__stage[hidden] {
  display: none;
}
.drop__stage[data-stage="idle"] {
  display: grid;
  gap: 1.4rem;
}
@media (min-width: 820px) {
  .drop__stage[data-stage="idle"] {
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.35fr);
    gap: 1.6rem;
    align-items: stretch;
  }
}
.drop__panel {
  position: relative;
  overflow: hidden;
  background: linear-gradient(158deg, #252522, #1b1b19 46%, #151513);
  border: 1px solid #35352f;
  border-radius: 20px;
  padding: clamp(1.4rem, 3.5vw, 2.4rem);
  box-shadow: 0 26px 60px rgba(0, 0, 0, 0.42);
  isolation: isolate;
}
.drop__panel::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
  pointer-events: none;
  z-index: 1;
}
.feat__glint {
  position: absolute;
  top: -60%;
  left: -20%;
  width: 140%;
  height: 100%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 70%);
  transform: rotate(-8deg);
  pointer-events: none;
  z-index: 0;
}
.drop__zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  min-height: 300px;
  border: 1.5px dashed #45453e;
  border-radius: 14px;
  cursor: pointer;
  background: transparent;
  text-align: center;
  padding: 2rem 1.25rem;
  transition:
    border-color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
  position: relative;
  z-index: 1;
}
.drop__zone:hover,
.drop__zone.over {
  border-color: var(--red);
  background: rgba(224, 64, 47, 0.05);
}
.drop__zone.over {
  transform: scale(1.01);
}
.drop__mark {
  display: grid;
  grid-template-columns: repeat(2, 26px);
  grid-template-rows: repeat(2, 18px);
  gap: 4px;
  justify-content: center;
  margin-bottom: 8px;
}
.drop__mark i {
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.03);
}
.drop__mark i:nth-child(2) {
  border-color: rgba(224, 64, 47, 0.55);
}
.drop__mark i:nth-child(3) {
  border-color: rgba(255, 255, 255, 0.3);
}
.drop__t {
  color: #f8f6f0;
  font-size: 16px;
  font-weight: 600;
}
.drop__s {
  color: #8a8678;
  font-size: 13px;
}
.drop__s b {
  color: #d8d5c9;
  font-weight: 600;
}
.drop__preview {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 4px 0;
}
.drop__k {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #8a8678;
  margin: 0;
}
.ghosts {
  display: grid;
  gap: 9px;
}
.ghost {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left: 2px solid var(--red);
  border-radius: 10px;
  padding: 13px 15px;
}
.ghost__q {
  color: #e9e6dc;
  font-size: 14.5px;
  font-weight: 500;
  line-height: 1.4;
  margin: 0 0 8px;
}
.ghost__f {
  color: #75715f;
  font-size: 12.5px;
  line-height: 1.55;
  margin: 0;
}
.ghost__f span {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--red);
  margin-right: 8px;
}
.drop__pk {
  color: #5d5a52;
  font-size: 11.5px;
  margin: 2px 0 0;
}
.drop__reading {
  color: #f8f6f0;
  font-size: 15px;
  margin: 0 0 22px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.drop__reading b {
  color: #d8d5c9;
  font-weight: 600;
}
.drop__dots {
  display: inline-flex;
  gap: 4px;
  align-items: center;
}
.drop__dots i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--red);
  animation: dropDot 1s ease-in-out infinite;
}
.drop__dots i:nth-child(2) {
  animation-delay: 0.15s;
}
.drop__dots i:nth-child(3) {
  animation-delay: 0.3s;
}
@keyframes dropDot {
  0%,
  100% {
    opacity: 0.25;
    transform: scale(0.8);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}
.drop__steps {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
}
.drop__steps li {
  color: #75715f;
  font-size: 13.5px;
  padding-left: 28px;
  position: relative;
  transition: color 0.3s ease;
}
.drop__steps li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 2px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1.5px solid #45453e;
  transition:
    border-color 0.3s ease,
    background 0.3s ease;
}
.drop__steps li.done {
  color: #d8d5c9;
}
.drop__steps li.done::before {
  border-color: var(--red);
  background: var(--red);
  box-shadow: 0 0 0 4px rgba(224, 64, 47, 0.15);
}
.drop__steps li.done::after {
  content: "";
  position: absolute;
  left: 5px;
  top: 7px;
  width: 6px;
  height: 3px;
  border-left: 1.5px solid #fff;
  border-bottom: 1.5px solid #fff;
  transform: rotate(-45deg);
}
.qs {
  display: grid;
  gap: 10px;
  margin-bottom: 22px;
}
.cq { transform-origin: center;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-left: 2px solid var(--red);
  border-radius: 10px;
  padding: 14px 16px;
  opacity: 0;
  transform: translateY(10px);
  transition:
    opacity 0.35s ease,
    transform 0.35s ease;
}
.cq.in {
  opacity: 1;
  transform: none;
}
.cq__q {
  color: #e9e6dc;
  font-size: 14.5px;
  font-weight: 500;
  line-height: 1.45;
  margin: 0 0 8px;
}
.cq__from {
  color: #75715f;
  font-size: 12px;
  line-height: 1.5;
  margin: 0;
}
.cq__from span {
  font-family: var(--mono);
  font-size: 9.5px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--red);
  margin-right: 8px;
}
.cq__from b {
  color: #a8a494;
  font-weight: 600;
}
.drop__again {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: 1px solid #45453e;
  color: #d8d5c9;
  border-radius: 999px;
  padding: 10px 20px;
  font-family: var(--ui);
  font-size: 13.5px;
  cursor: pointer;
  transition:
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s var(--spring);
}
.drop__again:hover {
  border-color: var(--red);
  color: #f8f6f0;
  transform: translateY(-1px);
}
.drop__fine {
  font-size: 11.5px;
  line-height: 1.7;
  color: #5d5a52;
  text-align: center;
  margin: 16px auto 0;
  max-width: 60ch;
}
.drop__fine b {
  color: #b8b5a9;
  font-weight: 600;
}
.drop__then[hidden] {
  display: none;
}
.drop__then {
  margin-top: clamp(2rem, 4vw, 3rem);
  text-align: center;
}
.drop__thenk {
  font-family: var(--display);
  font-weight: 800;
  font-size: clamp(26px, 3.2vw, 34px);
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: #fff;
  margin: 0 0 12px;
}
.drop__thenx {
  font-size: 14.5px;
  line-height: 1.65;
  color: var(--grey);
  margin: 0 auto 26px;
  max-width: 560px;
}
.drop__thenx b {
  color: #d8d5c9;
  font-weight: 600;
}

/* ══ sticky candidate CTA ══ */
.stickcta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  transform: translateY(110%);
  transition: transform 0.4s var(--ease);
  background: rgba(19, 19, 19, 0.94);
  backdrop-filter: blur(12px);
  border-top: 1px solid var(--cline);
}
.stickcta.show {
  transform: none;
}
.stickcta__in {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 0;
}
.stickcta p {
  margin: 0;
  font-size: 14px;
  color: var(--onc2);
  flex: 1;
  line-height: 1.35;
}
.stickcta p b {
  color: #fff;
  font-weight: 600;
  display: block;
}
@media (max-width: 560px) {
  .stickcta p b {
    font-size: 14px;
  }
  .stickcta p span {
    display: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .stickcta {
    transition: none;
  }
}

/* ══ SECTION RHYTHM — the header owns the gap below it ══ */
.shead {
  margin-bottom: clamp(8px, 3.8vw, 30px);
}
.shead + * {
  margin-top: 0;
}
.shead + .ramp {
  margin-top: 0;
}

/* ══ THE SMALL RETURNS — press, spring, and group awareness ══ */
:root {
  --spring: cubic-bezier(0.34, 1.42, 0.64, 1);
}

/* 1. everything you can press, presses back */
.btn,
.ftab,
.pre,
.vseg,
.step,
.tl,
.lt,
.chip,
.key__i,
.inds__g span,
.qc,
.door,
.who__ph,
.xp,
.cmp__r,
.sig__r,
.swap__row {
  transition-timing-function: var(--spring);
}
.btn:active,
.ftab:active,
.pre:active,
.vseg:active,
.tl:active,
.lt:active,
.chip:active,
.key__i:active,
.inds__g span:active,
.qc:active {
  transform: scale(0.965);
  transition-duration: 0.08s;
}
.door:active,
.panel:active {
  transform: scale(0.995);
  transition-duration: 0.1s;
}
.step:active {
  transform: translateX(3px);
  transition-duration: 0.08s;
}
.flip:active {
  transform: scale(0.99);
}
.flip.is-b:active {
  transform: rotateY(180deg) scale(0.99);
}

/* 2. text links sweep instead of just changing colour */
.ft__col a,
.ft__social a,
.expect__lk,
.plans__ft a,
.chip__lk {
  position: relative;
}
.ft__col a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: -3px;
  height: 1px;
  background: currentColor;
  opacity: 0.5;
  transition: right 0.34s var(--spring);
}
.ft__col a:hover::after {
  right: 0;
}

/* 3. the dot in the wordmark notices you */
.logo i {
  display: inline-block;
  transition:
    transform 0.4s var(--spring),
    color 0.3s;
}
.logo:hover i {
  transform: translateY(-2px) scale(1.25);
}

/* 4. grouped tiles become aware of each other */
.bench__g:hover .xp {
  opacity: 0.55;
}
.bench__g:hover .xp:hover {
  opacity: 1;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  z-index: 2;
  position: relative;
}
.tiles:hover .tl {
  opacity: 0.6;
}
.tiles:hover .tl:hover {
  opacity: 1;
}
.whos__g:hover .who {
  opacity: 0.55;
}
.whos__g:hover .who:hover {
  opacity: 1;
}
.bench__g .xp,
.tiles .tl,
.whos .who {
  transition:
    opacity 0.28s var(--ease),
    transform 0.28s var(--spring),
    box-shadow 0.28s var(--ease),
    background 0.22s var(--ease);
}

/* 6. the switcher settles rather than snapping */
.ftab,
.nav__sw a {
  transition:
    background 0.32s var(--spring),
    color 0.22s,
    transform 0.2s var(--spring);
}
.nav__sw a:active {
  transform: scale(0.94);
}

@media (prefers-reduced-motion: reduce) {
  .btn:active,
  .ftab:active,
  .pre:active,
  .vseg:active,
  .tl:active,
  .lt:active,
  .chip:active,
  .key__i:active,
  .qc:active,
  .door:active,
  .panel:active,
  .step:active,
  .flip:active,
  .logo:hover i {
    transform: none;
  }
  .ft__col a::after {
    transition: none;
  }
}

/* the four boxes are there to be compared — so let them be */
.ramp__g .rp {
  transition:
    opacity 0.3s var(--ease),
    transform 0.34s var(--spring);
}
.ramp__g:hover .rp {
  opacity: 0.42;
}
.ramp__g:hover .rp:hover {
  opacity: 1;
  transform: translateY(-4px);
}
.rp__acc b {
  transition: color 0.25s var(--ease);
}
.ramp__g:hover .rp:hover .rp__acc b {
  color: var(--red);
}
.rp .rk__ht,
.rp .rk__ln {
  transition: stroke-opacity 0.3s var(--ease);
}
.ramp__g:hover .rp:hover .rk__ht {
  stroke-opacity: 1;
}
@media (prefers-reduced-motion: reduce) {
  .ramp__g:hover .rp {
    opacity: 1;
  }
  .ramp__g:hover .rp:hover {
    transform: none;
  }
}

/* ══ THE LAB: the tiles and the sliders are the same instrument ══ */
.lt {
  cursor: default;
  outline: none;
}
.lt.lit {
  border-color: rgba(255, 255, 255, 0.55);
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.09);
  transform: translateY(-2px);
}
.lt.low.lit {
  border-color: rgba(232, 163, 61, 0.7);
  box-shadow: 0 0 0 3px rgba(232, 163, 61, 0.16);
}
.lt.heavy.lit {
  border-color: rgba(218, 0, 7, 0.75);
  box-shadow: 0 0 0 3px rgba(218, 0, 7, 0.2);
}
.row {
  margin-inline: -10px;
  padding-inline: 10px;
  border-radius: 8px;
  transition: background 0.24s var(--ease);
}
.row.lit {
  background: rgba(255, 255, 255, 0.05);
}
.row.lit .row__n {
  color: #fff;
}
.row.lit .row__p {
  color: #fff;
}
.row.lit .row__k {
  color: #fff;
}
@media (prefers-reduced-motion: reduce) {
  .lt.lit {
    transform: none;
  }
}

/* ══ HOW WE ENGAGE: tracing the path ══ */
.cg {
  transition:
    opacity 0.28s var(--ease),
    transform 0.3s var(--spring);
}
.cg__bar {
  transition:
    background 0.3s var(--ease),
    transform 0.34s var(--spring);
  transform-origin: left;
}
.cg__g:hover .cg {
  opacity: 0.45;
}
.cg__g:hover .cg:hover {
  opacity: 1;
  transform: translateY(-3px);
}
.cg__g:hover .cg:hover .cg__bar {
  background: var(--red);
  transform: scaleY(1.6);
}
.cg__w {
  transition: color 0.28s var(--ease);
}
.cg__g:hover .cg:hover .cg__w {
  color: var(--red);
}

/* ══ THE 1:3 HINGE: each side lights its own ratio ══ */
.hinge > div {
  transition: opacity 0.28s var(--ease);
}
.hinge:hover > div {
  opacity: 0.5;
}
.hinge:hover > div:hover,
.hinge:hover > .hg__mid {
  opacity: 1;
}
.ratio__r {
  transition: opacity 0.28s var(--ease);
}
.hinge > div:first-child:hover ~ .hg__mid .ratio__r--us {
  opacity: 0.35;
}
.hinge > div:last-child:hover ~ .hg__mid .ratio__r {
  opacity: 0.35;
}
.ratio__sq i {
  transition:
    transform 0.3s var(--spring),
    background 0.25s var(--ease);
}
.ratio__r:hover .ratio__sq i {
  transform: translateY(-2px);
}
.ratio__r:hover .ratio__sq i:nth-child(2) {
  transition-delay: 0.04s;
}
.ratio__r:hover .ratio__sq i:nth-child(3) {
  transition-delay: 0.08s;
}
.ratio__r:hover .ratio__sq i:nth-child(4) {
  transition-delay: 0.12s;
}
.ratio__r:hover .ratio__sq i:nth-child(5) {
  transition-delay: 0.16s;
}
.ratio__r:hover .ratio__sq i:nth-child(6) {
  transition-delay: 0.2s;
}
.ratio__r:hover .ratio__sq i:nth-child(7) {
  transition-delay: 0.24s;
}
.ratio__r:hover .ratio__sq i:nth-child(8) {
  transition-delay: 0.28s;
}

/* ══ TRUST: the lightest touch — a list you read, not play with ══ */
.tr2__l li {
  transition: color 0.25s var(--ease);
}
.tr2__l li::before {
  transition:
    background 0.25s var(--ease),
    transform 0.3s var(--spring);
}
.tr2__l li:hover {
  color: #fff;
}
.tr2__l li:hover::before {
  background: var(--red);
  transform: scale(1.3);
}

@media (prefers-reduced-motion: reduce) {
  .cg__g:hover .cg,
  .hinge:hover > div {
    opacity: 1;
  }
  .cg__g:hover .cg:hover,
  .ratio__r:hover .ratio__sq i {
    transform: none;
  }
}

/* ══ TYPESETTING — no orphans, no stranded words ══ */
h1,
h2,
.h1,
.h2,
.hero h1,
.fn__line,
.pledge2,
.swap__lead,
.human,
.lab__foot,
.qa__a,
.hg__t,
.cand__h,
.vol__v,
.verd__nm,
.rp__t,
.tl2__t,
.cg__t,
.expect__g b,
.door__t,
.cs2__k,
.bbb2__s,
.xp b {
  text-wrap: balance;
}
p,
li,
.dek,
.hero__p,
.fn__dek,
.lab__dek,
.deal__dek,
.trust__dek,
.cand__lede,
.fn__math,
.cases__ft,
.desk__ft,
.bench__note,
.who__d,
.qc__q, .cq__q,
.cg__p,
.cg__v,
.tl2__p,
.rp__d,
.vol__d,
.expect__g span {
  text-wrap: pretty;
}
/* keep short paired phrases whole */
.fn__line em,
.pledge2 em,
.swap__lead em,
.human em,
.lab__foot em,
.qa__a em {
  white-space: nowrap;
}

/* ══ FOR CANDIDATES: the section that was standing still ══ */

/* 1. the tally — hover it and the three replies separate from the 137 */
.tally .tk {
  transition:
    opacity 0.3s var(--ease),
    stroke-width 0.3s var(--spring);
}
.fan__side--own:hover .tally .tk {
  opacity: 0.28;
}
.fan__side--own:hover .tally .tk--r {
  opacity: 1;
  stroke-width: 3.4;
}
.fan__was {
  transition: color 0.28s var(--ease);
}
.fan__side--own:hover .fan__was {
  color: var(--ink);
}

/* 2. the three squares are three teams — let them arrive one after another */
.fan__3 span {
  transition:
    transform 0.34s var(--spring),
    box-shadow 0.3s var(--ease);
}
.fan__side:hover .fan__3 span {
  transform: translateY(-4px);
}
.fan__side:hover .fan__3 span:nth-child(2) {
  transition-delay: 0.06s;
}
.fan__side:hover .fan__3 span:nth-child(3) {
  transition-delay: 0.12s;
}
.fan__side:hover .fan__3 span:last-child {
  box-shadow: 0 6px 18px rgba(218, 0, 7, 0.3);
}

/* 3. the candidate timeline behaves like the buyer's one */
.tl2 {
  transition:
    opacity 0.28s var(--ease),
    transform 0.3s var(--spring);
}
.tl2__bar {
  transition:
    background 0.3s var(--ease),
    transform 0.34s var(--spring);
  transform-origin: left;
}
.tl2__g:hover .tl2 {
  opacity: 0.45;
}
.tl2__g:hover .tl2:hover {
  opacity: 1;
  transform: translateY(-3px);
}
.tl2__g:hover .tl2:hover .tl2__bar {
  background: var(--red);
  transform: scaleY(1.6);
}

/* 4. the quote acknowledges you */
.qt {
  transition: border-color 0.3s var(--ease);
}
.qt:hover {
  border-color: var(--red);
}

/* 5. the whole apply card lifts a hair when you engage with it */
.apply {
  transition:
    box-shadow 0.35s var(--ease),
    transform 0.35s var(--spring);
}
.apply:focus-within {
  transform: translateY(-2px);
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.1);
}

@media (prefers-reduced-motion: reduce) {
  .fan__side:hover .fan__3 span,
  .tl2__g:hover .tl2:hover,
  .apply:focus-within {
    transform: none;
  }
  .fan__side--own:hover .tally .tk {
    opacity: 1;
  }
  .tl2__g:hover .tl2 {
    opacity: 1;
  }
}

/* ════════ CANDIDATES PAGE ════════ */

/* ── HERO: your profile, and the team asking ── */
.cprof {
  display: grid;
  gap: 11px;
}
.cprof__hd {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
}
.cprof__nm {
