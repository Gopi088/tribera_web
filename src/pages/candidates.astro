        hover:border-[#da0007]/40
        hover:-translate-y-2
        hover:shadow-[0_15px_40px_rgba(0,0,0,0.4)]
        flex flex-col
      "
                  >
                    <div class="flex gap-1 mb-5 text-[#da0007]">
                      {Array(5)
                        .fill(0)
                        .map((_, idx) => (
                          <Icon data-index={idx} name="tabler:star-filled" class="w-4 h-4 sm:w-5 sm:h-5" />
                        ))}
                    </div>

                    <p
                      class="
        text-[13px]
        sm:text-[14px]
        leading-relaxed
        text-white/70
        mb-6
        flex-grow
      "
                    >
                      {t.quote}
                    </p>

                    <div class="mt-4">
                      <div class="w-[40px] h-[2px] bg-[#da0007]/60 rounded-full mb-3" />

                      <div
                        class="
          text-[14px] sm:text-[15px]
          font-semibold
          text-white
          group-hover:text-[#da0007]
          transition duration-300
        "
                      >
                        {t.name}
                      </div>

                      <div class="text-[12px] sm:text-[13px] text-white/60">{t.company}</div>
                    </div>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="get-discovered" class="bg-[#f3f3f3] py-20 md:py-28">
    <div class="max-w-[900px] mx-auto text-center px-6">
      <h2 class="text-[34px] sm:text-[44px] lg:text-[55px] font-[700] leading-[1.08] tracking-[-0.02em] text-black">
        Your next role is <br />
        already looking for you.
      </h2>

      <p class="mt-6 max-w-2xl mx-auto text-[15px] sm:text-[16px] leading-relaxed text-black/50">
        Create your profile in 15 minutes. Get a clear technical signal, and spend your time on relevant conversations
        with serious teams.
      </p>

      <div class="mt-12">
        <button
          type="button"
          data-create-profile
          class="px-6 py-3 rounded-full w-full sm:w-auto
         tribera-primary-button font-semibold text-[15px]"
        >
          Create Your Profile →
        </button>
      </div>
    </div>
  </section>
</Layout>
