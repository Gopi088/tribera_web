  border: 1px solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}
.desk__fill {
  display: block;
  height: 100%;
  border-radius: 6px;
  transform-origin: left;
  transform: scaleX(0);
  transition: transform 1.1s var(--ease);
}
