                  >Python</span
                >
                <span
                  style="font-size:11px;color:rgba(0,0,0,.25);background:rgba(0,0,0,.05);padding:5px 10px;border-radius:4px"
                  >AWS</span
                >
                <span
                  style="font-size:11px;color:rgba(0,0,0,.25);background:rgba(0,0,0,.05);padding:5px 10px;border-radius:4px"
                  >Kubernetes</span
                >
                <span
