  <script is:inline>
    function setupSignalAnimation() {
      const section = document.querySelector('#signalSection');
      if (!(section instanceof HTMLElement)) return;
      if (section.dataset.signalBound === 'true') return;
      section.dataset.signalBound = 'true';
      const observerRootMargin = window.innerWidth < 768 ? '-32% 0px -32% 0px' : '-20% 0px -20% 0px';

      const scoreEl = section.querySelector('#signalScore');
      const bars = section.querySelectorAll('.fillBar');

      if (!scoreEl) return;

      let counter = null;
      let barTimeouts = [];

      const reset = () => {
        if (counter) {
          window.clearInterval(counter);
          counter = null;
        }

        barTimeouts.forEach((timeoutId) => window.clearTimeout(timeoutId));
        barTimeouts = [];

        scoreEl.textContent = '0';
        bars.forEach((bar) => {
          if (!(bar instanceof HTMLElement)) return;
          bar.style.width = '0%';
        });
      };

      const animate = () => {
        if (counter) {
          window.clearInterval(counter);
          counter = null;
        }

        barTimeouts.forEach((timeoutId) => window.clearTimeout(timeoutId));
        barTimeouts = [];

        const target = Number(scoreEl.dataset.target);
        let current = 0;
        const increment = target / 40;

        scoreEl.textContent = '0';

        counter = window.setInterval(() => {
          current += increment;

          if (current >= target) {
            scoreEl.textContent = String(target);
            window.clearInterval(counter);
            counter = null;
          } else {
            scoreEl.textContent = String(Math.floor(current));
          }
        }, 15);

        bars.forEach((bar, i) => {
          if (!(bar instanceof HTMLElement)) return;
          const width = bar.dataset.width;
          if (!width) return;

          const timeoutId = window.setTimeout(() => {
            bar.style.width = `${width}%`;
          }, i * 150);
          barTimeouts.push(timeoutId);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animate();
              return;
            }

            reset();
          });
        },
        {
          threshold: 0,
          rootMargin: observerRootMargin,
        }
      );

      observer.observe(section);
    }

    /* FIRST LOAD */
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setupSignalAnimation();
    } else {
      document.addEventListener('DOMContentLoaded', setupSignalAnimation);
    }

    /* ASTRO NAVIGATION SUPPORT */
    document.addEventListener('astro:page-load', setupSignalAnimation);
  </script>

