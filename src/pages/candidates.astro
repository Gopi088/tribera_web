---
import Layout from '~/layouts/PageLayout.astro';

// This page mirrors the reference design build (tribera-candidates.html): same
// sections, same class names, same CSS and interaction logic as the home page
// refactor. Repeated list content lives in the data below and renders with .map();
// one-off illustrations (the hero card, the big tally chart) stay as plain markup.
const metadata = {
  title: 'tribera — interviewed once, shortlisted everywhere',
  description:
    'One thirty-minute conversation with a senior expert who has done your job. Scored, recorded, and read by every team that asks for you. Anonymous until you say otherwise.',
  ignoreTitleTemplate: true,
};

// ── Hero decision card: your profile (faceA) vs. the team asking about you (faceB).
const profileMetrics: [string, number][] = [
  ['Architecture thinking', 96],
  ['Systems design', 91],
  ['Code quality', 95],
  ['Communication', 89],
];

const teamSignals: [string, string][] = [
  ['Headcount', 'Approved and funded this quarter'],
  ['Rounds', 'Three, then a decision'],
  ['Decision speed', 'Six days from final interview'],
  ['Manager tenure', 'Four years in the role'],
];

// Client logos in the marquee under the hero — same roster as the home page.
const clientLogos = [
  'Flipkart', 'Myntra', 'Heineken', 'Volkswagen', 'Mizuho', 'ICICI Bank',
  'Publicis Sapient', 'Capco', 'PayU', 'DSP Mutual Fund', 'ICICI Securities',
  'Utkarsh Bank', 'Aeries', 'SplashBI', 'Aegon Life', 'Enpro',
];

// "What a CV can carry, and what it can't" — the CV line vs. the transcript line.
const cvVsTranscript: [string, string][] = [
  ['On the CV', 'Built microservices handling two million requests a day.'],
  ['What that shows', 'That he can write a sentence about microservices.'],
  ['On the transcript', 'The trade-off he rejected, why he rejected it, and what it cost him six months later.'],
  ['What that shows', 'That he made the call — and knows what it cost.'],
];

// "Change the team, watch your score move": the same six scored dimensions feed
// both the static profile card and the interactive per-team weighting below it.
const scoreMetrics: [string, number][] = [
  ['Architecture thinking', 96],
  ['Systems design', 91],
  ['Code quality', 95],
  ['Communication', 89],
  ['Ops and on-call', 74],
  ['Product sense', 68],
];

// Button labels for "whose bar are we using" — the weight sets themselves live in
// the script since they only ever feed the interactive score card.
const scoreTeams = ['Consumer scale', 'Fintech platform', 'Infrastructure / SRE', 'Early-stage product'];

// "Every question comes off your own CV": three CV-line-to-interview-question pairs.
const cvToQuestion: [string, string][] = [
  ['Built microservices handling two million requests a day.',
    'Which service did you split off first — and what broke when you did?'],
  ['Led migration from monolith to event-driven architecture.',
    'What did you have to keep in the monolith, and who argued for keeping more?'],
  ['Reduced p99 latency by 40%.',
    'What was the 40% measured against, and what did you check before you believed it?'],
];

const interviewNotes: [string, string][] = [
  ['Thirty minutes, once',
    "Recorded and transcribed. It travels to every team that asks for you — you never answer the same question twice."],
  ['A peer, not a panel',
    "The expert interviewing you has run the systems you're describing. That is why the follow-up lands."],
];

// "We check them too": the five checks run on every team before a request reaches you.
const teamChecks: [string, string, string, boolean][] = [
  ['Is the headcount real?', "Approved and funded, or we don't list it.", 'Verified', false],
  ['How many rounds?', "Stated up front. If it changes, you hear from us, not from them.", 'Three', false],
  ['How fast do they decide?', "Measured from your final interview, not from their intake call.", '6 days', false],
  ['How long has the manager been there?', "The person you'd report to, not the org chart.", '4 yrs', false],
  ['Do people stay?', 'Twelve-month retention on their last five hires through us.', 'One flag', true],
];

const checkOutcomes: [string, string, string, string][] = [
  ['ok', 'Cleared', 'The request reaches you', 'Normal case. You see the role, the team, and what they weighted.'],
  ['fl', 'Flagged', 'It reaches you with the flag',
    'One check failed. You see which, and what it means, and you decide whether it matters.'],
  ['no', 'Declined', 'It never reaches you',
    'Unfunded headcount, or a role that has churned twice this year. You are never told about it, because there is nothing to tell.'],
];

// "Your controls": four privacy switches, each with an on/off status label.
const privacyControls: [string, string, string, string, boolean][] = [
  ['Anonymous by default',
    'Your name, employer and contact stay hidden until you release them to a specific team.',
    'Hidden', 'Visible', true],
  ['Block by name', 'Name your current employer, or anyone else. They never see you exist.',
    '3 companies blocked', 'No blocks', true],
  ['No direct contact', 'Companies cannot message you. Every request comes through us first.',
    'All requests routed', 'Direct contact allowed', true],
  ['Pause in one click', 'Got an offer? Make the profile invisible. Turn it back on whenever.',
    'Profile paused', 'Profile live', false],
];

const freebieNotes: [string, string][] = [
  ['It costs you nothing',
    "Not now, not when you're placed, not ever. Companies pay us when they hire. <b>If anyone in this industry asks you for money, walk.</b>"],
  ["Who it's for",
    "Mid-level upward, across engineering, data, infrastructure, finance, operations and leadership. If we don't run mandates in your area yet, we'll tell you that on day one rather than sit on your CV."],
];

// "What happens, and when": the candidate-side timeline and the three stats under it.
const candidateTimeline: [string, string, string, string][] = [
  ['Day 1', '15 min', 'Set up your profile',
    'Stack, preferences, and who you want blocked. Anonymous from the first second.'],
  ['Day 3–5', '30 min', 'An expert interviews you',
    'Someone who has done your job. Recorded, and you get the score.'],
  ['Day 7+', 'inbound', 'Teams ask for you',
    'Your profile goes live to teams that cleared our checks. No cold applying.'],
  ['~3 weeks', 'offer', 'You decide',
    "Accept what fits, decline what doesn't. Most people see more than one."],
];

const candidateStats: [string, string, string][] = [
  ['85', '%', 'of candidates who reach a final interview get an offer'],
  ['3', 'wks', 'median from profile going live to an offer in hand'],
  ['1.8', 'offers', 'the average person here ends up choosing between'],
];

// Voices marquee — all candidate-side this time. Doubled for the seamless CSS loop.
const candidateTestimonials: [string, string, string][] = [
  ['I was stuck in endless screening loops. After one interview here I had four relevant requests in ten days.',
    'Senior backend engineer', 'Fintech product company'],
  ["The expert had already read my GitHub. The first question was about a design decision I made in 2022. That's when I knew this was different.",
    'Senior backend engineer', '6 yrs, now placed'],
  ['It matched me to roles where I actually fit. The interview felt like a technical discussion, not an interrogation.',
    'Full-stack engineer', 'AI SaaS startup'],
  ['My profile stayed private while I explored. I only spoke to serious teams, and had an offer inside three weeks.',
    'Engineering manager', 'Enterprise platform team'],
  ['Three requests in one week, all aligned to my stack. No spam, no repetition.',
    'Frontend engineer', 'Consumer app company'],
  ["I'd paused looking for months because applying was draining. This brought the relevant ones back to me.",
    'Data engineer', 'B2B analytics company'],
  ['The score breakdown was clear and practical. I knew exactly what to work on, and the next round felt stronger.',
    'Senior platform engineer', 'Cloud infrastructure startup'],
  ['I switched without announcing I was looking. Every conversation I took was worth the time.',
    'Mobile engineer', 'Digital payments company'],
];

// Close: the two doors, looking vs. hiring (mirrored from the home page, opposite order).
const candidateDoors: [string, string, string, string, string, string, string][] = [
  ["If you're looking", 'One conversation, then teams come to you.',
    'Thirty minutes with someone who has done your job. Anonymous until you decide otherwise.',
    'Fifteen minutes to set up, and you keep the score.',
    'Create your profile', '#apply', 'btn--dark'],
  ["If you're hiring", 'Three names you’d take any of.',
    'A hundred signals, a senior expert on each shortlisted person, and the reasoning behind every rank.',
    'A 45-minute intake call. Three names back inside 36 hours.',
    'See how one role ran', '/', 'btn--ghost'],
];
import ContactSalesModal from '../components/ContactSalesModal.astro';
---

<Layout metadata={metadata}>
  <main class="tribera-candidates">
  <header class="hero" id="top">
    <div class="wrap">
      <div class="hero__top">
        <div class="hero__copy">
          <p class="eyebrow" data-rv>One conversation. Thirty minutes.</p>
          <h1 class="h1" data-rv style="--d:60ms">Interviewed once.<br />Shortlisted <em>everywhere</em>.</h1>
          <!-- <p class="hero__p" data-rv style="--d:110ms">
            Your CV gets six seconds. Your LinkedIn gets skimmed.
            <b>One honest conversation with someone who has done your job gets read</b> — by every team
            that asks for you afterwards.
          </p> -->
          <p class="hero__p" data-rv style="--d:150ms">
            <b
              >You're not one of eight in a pile. You're one of three, and they've read your interview
              before they pick up the phone.</b
            >
          </p>
          <div class="btns" data-rv style="--d:190ms">
            <a href="#apply" class="btn btn--light">Create your profile</a>
            <a href="#when" class="btn btn--wire">See how it works</a>
          </div>
        </div>

        <!-- Two-sided card: your profile as a team would see it (faceA), and the
             kind of team asking for you, vetted before the request reaches you
             (faceB). Same tilt/flip scripts as the home page's Decision Package. -->
        <div class="hero__card" data-rv style="--d:150ms">
          <div class="ftabs" role="tablist" aria-label="Two sides of the same conversation">
            <button class="ftab is" id="tabA" role="tab" aria-selected="true" aria-controls="faceA">
              Your profile
            </button>
            <button class="ftab" id="tabB" role="tab" aria-selected="false" aria-controls="faceB">
              The team asking
            </button>
          </div>
          <div class="tilt" id="tilt">
            <div class="flip cflip" id="flip">
              <div class="face" id="faceA" role="tabpanel" aria-labelledby="tabA">
                <span class="face__glint"></span>
                <div class="face__hd">
                  <span>Your profile <span class="rank">· live</span></span>
                  <span>Senior backend · Bengaluru</span>
                </div>
                <div class="side">
                  <div class="side__hd">
                    <div>
                      <p class="side__nm">A. Mehta</p>
                      <p class="side__sub">6 yrs · Python, AWS, Kubernetes · <b>anonymous</b></p>
                    </div>
                    <span class="scr">
                      <span class="scr__n"><b>88</b><i>/100</i></span>
                      <span class="pill">TOP 8%</span>
                      <span class="scale" aria-hidden="true">
                        <span class="scale__sel"></span><span class="scale__pin"></span>
                      </span>
                      <span class="scale__k">Top decile starts at 85</span>
                    </span>
                  </div>
                  <div class="vrd">
                    <p class="vrd__k">What the expert wrote</p>
                    <p class="vrd__t">
                      He has built the thing most teams are hiring for — and he can show you the decision,
                      not just the system.
                    </p>
                  </div>
                  <div class="mtr2">
                    {
                      profileMetrics.map(([name, pct], i) => (
                        <div class:list={['mtr2__r', i === profileMetrics.length - 1 && 'mtr2__r--low']}>
                          <span class="mtr2__n">{name}</span>
                          <span class="mtr2__b"><span class="mtr2__f" style={`width:${pct}%`} /></span>
                          <span class="mtr2__v">{pct}</span>
                        </div>
                      ))
                    }
                  </div>
                  <p class="tiles__cap">Four dimensions, scored on the same rubric the team receives</p>
                  <div class="notes">
                    <div class="note note--warn">
                      <span class="note__k">Next</span>
                      <p class="note__v">
                        Communication is the one below your band. One worked example of a disagreement
                        you resolved would move it.
                      </p>
                    </div>
                    <div class="note">
                      <span class="note__k">Heard</span>
                      <p class="note__v">
                        Named the failure mode he was designing against before anyone asked him to.
                      </p>
                    </div>
                  </div>
                </div>
                <div class="face__ft">
                  <span>Recorded call · you keep the transcript</span>
                  <span class="lg"><i class="lg--g">LIVE</i><i class="lg--y">PAUSED</i><i class="lg--r">HIDDEN</i></span>
                </div>
              </div>

              <div class="face face--b" id="faceB" role="tabpanel" aria-labelledby="tabB" aria-hidden="true">
                <span class="face__glint"></span>
                <div class="face__hd">
                  <span>The team asking <span class="rank">· 1 of 3</span></span>
                  <span>Consumer internet · Series D</span>
                </div>
                <div class="side">
                  <div class="side__hd">
                    <div>
                      <p class="side__nm">Platform team, 9 engineers</p>
                      <p class="side__sub">Reports to VP Engineering · <b>headcount approved</b></p>
                    </div>
                    <span class="verd__band b-sel" style="font-size:9.5px;padding:6px 11px">CLEARED</span>
                  </div>
                  <div class="vrd">
                    <p class="vrd__k">Why we let them ask</p>
                    <p class="vrd__t">They know what they want, they decide in a week, and people stay.</p>
                  </div>
                  <div class="sig__list">
                    {
                      teamSignals.map(([label, value]) => (
                        <div class="sig__r">
                          <span class="sig__k2">{label}</span>
                          <span class="sig__v">{value}</span>
                        </div>
                      ))
                    }
                  </div>
                  <div class="notes">
                    <div class="note note--warn">
                      <span class="note__k">Watch</span>
                      <p class="note__v">
                        They interview in one-week blocks. If you need longer, say so before you accept
                        the call.
                      </p>
                    </div>
                  </div>
                </div>
                <p class="tiles__cap">What we verified before this request reached you</p>
                <div class="face__ft">
                  <span>We check them before you meet them</span>
                  <span class="lg"><i class="lg--g">SERIOUS</i><i class="lg--y">SLOW</i><i class="lg--r">DECLINED</i></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="logos" data-rv>
        <p class="logos__l">Teams hiring through us</p>
        <div class="logos__vp">
          <div class="logos__tk">
            {clientLogos.map((name) => <span>{name}</span>)}
            <span aria-hidden="true" class="logos__dup">
              {clientLogos.map((name) => <span>{name}</span>)}
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══ TALLY: nothing about him changed, what they saw did ═══ -->
  <section class="band band--w" id="tally">
    <div class="wrap">
      <div class="shead">
        <div>
          <p class="eyebrow eyebrow--red" data-rv>The only thing that changed</p>
          <h2 class="h2" data-rv style="--d:60ms">Nothing about him changed. What they could see did.</h2>
        </div>
        <p class="dek" data-rv style="--d:100ms">
          Same person, same six years, same CV. In the spring he sent 140 applications and got three
          replies. Months later, three teams asked for him inside forty-eight hours —
          <b>and none of them had seen the CV.</b>
        </p>
      </div>

      <div class="big" data-rv style="--d:140ms">
        <div class="fan__side fan__side--own">
          <p class="fan__was">His spring — <span id="tallyN">140</span> applications</p>
          <!-- Hand-drawn tally chart, same technique as the home page's — one stroke
               per application, kept literal rather than generated. -->
        <svg class="tally tally--big" viewBox="0 0 300 170" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path class="tk" pathLength="1" d="M7.9 14.2 Q7.8 27.7 8.0 41.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
        <path class="tk" pathLength="1" d="M13.1 13.1 Q13.5 26.6 13.8 40.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
