---
import Icon from 'node_modules/astro-icon/components/Icon.astro';
import Layout from '~/layouts/PageLayout.astro';
import Brands from '~/components/widgets/Brands.astro';

const metadata = {
  title: 'For Candidates',
  description:
    'Get discovered by companies looking for your skills. Upload your resume and let tribera match you with roles that fit your strengths.',
};

const customerstories = [
  {
    quote:
      'I was stuck in endless screening loops. After one tribera interview, I got 4 relevant inbound requests in 10 days.',
    name: 'Senior Backend Engineer',
    company: 'Fintech Product Company',
  },
  {
    quote:
      'Unlike mass applications, tribera matched me to roles where I actually fit. The interview felt like a technical discussion, not interrogation.',
    name: 'Full Stack Engineer',
    company: 'AI SaaS Startup',
  },
  {
    quote:
      'My profile stayed private while I explored opportunities. I only spoke to serious teams, and got an offer in under 3 weeks.',
    name: 'Engineering Manager',
    company: 'Enterprise Platform Team',
  },
  {
    quote:
      'I got 3 interview requests in one week, all aligned to my stack. No spam, no repetition, and much faster decisions.',
    name: 'Frontend Engineer',
    company: 'Consumer App Company',
  },
  {
    quote:
      'I had paused job hunting for months because outbound applying was draining. tribera brought only relevant opportunities back to me.',
    name: 'Data Engineer',
    company: 'B2B Analytics Company',
  },
  {
    quote:
      'The score breakdown was clear and practical. I knew exactly what to improve, and the next round of interviews felt much stronger.',
    name: 'Senior Platform Engineer',
    company: 'Cloud Infrastructure Startup',
  },
  {
    quote:
      'I switched without announcing I was looking. Privacy controls worked well, and every conversation I took was worth my time.',
    name: 'Mobile Engineer',
    company: 'Digital Payments Company',
  },
];
---

<Layout metadata={metadata}>
  <section class="relative min-h-[90vh] md:min-h-screen flex items-center justify-center overflow-hidden bg-black">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-black"></div>

      <div
        class="absolute left-[-30%] md:left-[-15%] top-0 h-full w-[90%] md:w-[60%] bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.45),transparent_60%)]"
      >
      </div>

      <div
        class="absolute right-[-30%] md:right-[-15%] top-0 h-full w-[90%] md:w-[60%] bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.45),transparent_60%)]"
      >
      </div>
    </div>

    <div class="absolute inset-0 pointer-events-none">
      {
        Array.from({ length: 24 }).map((_, i) => (
          <span
            class="absolute rounded-full bg-[#da0007]/80"
            style={`
          width:${i % 4 === 0 ? 4 : 4}px;
          height:${i % 4 === 0 ? 4 : 4}px;
          left:${12 + Math.random() * 76}%;
          top:${8 + Math.random() * 84}%;
          --float-x1:${(Math.random() * 44 - 22).toFixed(1)}px;
          --float-y1:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x2:${(Math.random() * 52 - 26).toFixed(1)}px;
          --float-y2:${(Math.random() * 42 - 21).toFixed(1)}px;
          --float-x3:${(Math.random() * 60 - 30).toFixed(1)}px;
          --float-y3:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-y4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-x5:${(Math.random() * 56 - 28).toFixed(1)}px;
          --float-y5:${(Math.random() * 40 - 20).toFixed(1)}px;
          --float-x6:${(Math.random() * 50 - 25).toFixed(1)}px;
          --float-y6:${(Math.random() * 34 - 17).toFixed(1)}px;
          --float-scale1:${(1 + Math.random() * 0.28).toFixed(2)};
          --float-scale2:${(0.78 + Math.random() * 0.18).toFixed(2)};
          --float-scale3:${(1.02 + Math.random() * 0.22).toFixed(2)};
          --float-scale4:${(0.82 + Math.random() * 0.14).toFixed(2)};
          --float-scale5:${(1 + Math.random() * 0.2).toFixed(2)};
          --float-scale6:${(0.86 + Math.random() * 0.14).toFixed(2)};
          animation: float ${11 + Math.random() * 14}s ease-in-out infinite;
          animation-delay: -${(Math.random() * 18).toFixed(1)}s;
          box-shadow: 0 0 12px rgba(218,0,7,.6);
        `}
          />
        ))
      }
    </div>

    <div class="relative z-10 max-w-[1200px] mx-auto px-6 text-center">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5
