}
.door .door__k{font-family:var(--display);font-weight:700;font-size:clamp(16px,1.75vw,19.5px);
  line-height:1.3;letter-spacing:-.024em;color:var(--ink);margin:0 0 8px;flex:none}
.door .door__t{font-family:var(--display);font-weight:600;font-size:clamp(14.5px,1.5vw,16.5px);
  line-height:1.42;letter-spacing:-.014em;color:var(--ink2);margin:0 0 8px;flex:none}
.door .door__d{font-size:14.5px;line-height:1.55;color:var(--grey);margin:0}
.door .door__next{font-size:13px;line-height:1.5;color:var(--grey);margin:16px 0 20px;
  padding-top:14px;border-top:1px solid var(--hair)}
.door .door__next span{font-family:var(--mono);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--red);display:block;margin-bottom:6px}
.door .btn {
