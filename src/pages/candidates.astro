          >
            <div class="flex justify-between items-start">
              <div>
                <h3 class="text-[18px] font-[700] text-white">Arjun Mehta</h3>
                <p class="text-[13px] font-[500] text-white/40 mt-1">Senior Backend Engineer · 6 yrs</p>
              </div>

              <div
                class="flex items-center gap-2 px-3 py-1 rounded-md
                    bg-[#da0007]/15 border border-[#da0007]/40
                    text-[10px] font-[500] tracking-[0.15em]
                    text-[#da0007] uppercase"
              >
                <span class="w-1 h-1 bg-[#da0007] rounded-full"></span>
                Verified
              </div>
            </div>

            <div class="h-px bg-white/10 my-3"></div>

            <div class="grid grid-cols-3 gap-2 mb-4">
              {
                [
                  { id: 'score', label: 'Signal Score', value: 94, red: true },
                  { id: 'tech', label: 'Technical Score', value: 3.8, suffix: '/4' },
                  { id: 'culture', label: 'Culture Fit', value: 91, suffix: '%' },
                ].map((item) => (
                  <div class="bg-white/5 border hover:bg-white/10 hover:border-[#da0007]/10 hover:translate-y-[-2px] transition duration-500 border-white/10 rounded-[12px] p-2 text-center">
                    <div class="text-[10px] font-[550] tracking-[0.1em] text-white/30 uppercase mb-2 min-h-[30px] leading-[1.25]">
                      {item.label === 'Technical Score' ? (
                        <>
                          Technical
                          <br />
                          Score
                        </>
                      ) : (
                        item.label
                      )}
                    </div>

                    <div
                      class={`relative inline-flex items-end justify-center text-[24px] font-semibold leading-none ${item.red ? 'text-[#da0007]' : 'text-white'} ${item.suffix ? 'pr-[14px]' : ''}`}
                    >
                      <span id={item.id} class="leading-none tabular-nums">
                        0
                      </span>
                      {item.suffix && (
                        <span class="absolute right-0 bottom-0 text-white/40 text-[14px] leading-none">
                          {item.suffix}
                        </span>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="space-y-1">
              {
                [
                  { name: 'Architecture', score: 92 },
                  { name: 'Systems Design', score: 87 },
                  { name: 'Code Quality', score: 95 },
                  { name: 'Problem Solving', score: 89 },
                ].map((skill) => (
                  <div class="grid grid-cols-[140px_1fr] items-center gap-1">
                    <div class="text-[13px] font-[550] text-white/50">{skill.name}</div>

                    <div class="flex items-center gap-2">
                      <div class="relative flex-1 h-[2px] bg-white/10 rounded-full overflow-hidden">
                        <div
                          class="skill-bar h-full bg-[#e10600] w-0 transition-all duration-700 ease-out"
                          data-width={skill.score}
                        />
                      </div>

                      <div class="text-[13px] text-white/40 w-[40px] text-right">{skill.score}%</div>
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="h-px bg-white/10 my-4"></div>

            <div class="flex justify-between items-center">
              <div>
                <div class="text-[10px] font-[500] tracking-[0.1em] text-white/30 uppercase mb-2">
                  Viewing your profile
                </div>

                <div class="flex gap-2">
                  {
                    ['GS', 'MS', 'IBM'].map((company) => (
                      <span
                        class="px-2 py-1 text-[11px]
                     bg-white/5 border border-white/15
                     rounded-md text-white/40"
                      >
                        {company}
                      </span>
                    ))
                  }
                </div>
              </div>

              <div class="text-[#da0007]/70 text-[13px] font-medium hover:underline cursor-pointer">
                2 interview requests →
              </div>
            </div>
          </div>
        </div>
      </section>
      <script is:inline>
        function initProfileCard() {
          const section = document.getElementById('profileCard');
          if (!(section instanceof HTMLElement)) return;
          if (section.dataset.profileBound === 'true') return;
          section.dataset.profileBound = 'true';
          const cardPanel = section.querySelector('[data-profile-card-panel]');
          const target = cardPanel instanceof HTMLElement ? cardPanel : section;

          let activeFrames = [];
          let isActive = false;
          let rafId = null;
          let lastScrollY = window.scrollY;

          function fastCount(el, end) {
            let start = 0;
            const duration = 500;
            const increment = end / (duration / 16);
            const isDecimal = !Number.isInteger(end);

            el.textContent = '0';

            function update() {
              start += increment;

              if (start >= end) {
                el.textContent = String(end);
              } else {
                el.textContent = isDecimal ? start.toFixed(2) : String(Math.floor(start));
                const frameId = requestAnimationFrame(update);
                activeFrames.push(frameId);
              }
            }

            update();
          }

          function resetAnimation() {
            activeFrames.forEach((frameId) => window.cancelAnimationFrame(frameId));
            activeFrames = [];
            const score = section.querySelector('#score');
            const tech = section.querySelector('#tech');
            const culture = section.querySelector('#culture');

            section.querySelectorAll('.skill-bar').forEach((bar) => {
              if (!(bar instanceof HTMLElement)) return;
              bar.style.width = '0%';
            });

            if (score instanceof HTMLElement) score.textContent = '0';
            if (tech instanceof HTMLElement) tech.textContent = '0';
            if (culture instanceof HTMLElement) culture.textContent = '0';
          }

          function startAnimation() {
            resetAnimation();

            const score = section.querySelector('#score');
            const tech = section.querySelector('#tech');
            const culture = section.querySelector('#culture');

            if (score instanceof HTMLElement) fastCount(score, 94);
            if (tech instanceof HTMLElement) fastCount(tech, 3.63);
            if (culture instanceof HTMLElement) fastCount(culture, 91);

            section.querySelectorAll('.skill-bar').forEach((bar) => {
              if (!(bar instanceof HTMLElement)) return;
              const width = bar.dataset.width;
              if (!width) return;
              bar.style.width = `${width}%`;
            });
          }

          function getThresholds() {
            const isMobile = window.innerWidth < 768;
            if (isMobile) {
              return {
                downEnter: 0.72,
                upEnter: 0.38,
                topExit: 0.08,
                bottomExit: 0.92,
              };
            }

            return {
              downEnter: 0.62,
              upEnter: 0.34,
              topExit: 0.14,
              bottomExit: 0.86,
            };
          }

          function evaluateDirection() {
            const currentScrollY = window.scrollY;
            const direction = currentScrollY > lastScrollY ? 'down' : currentScrollY < lastScrollY ? 'up' : 'idle';
            lastScrollY = currentScrollY;
            return direction;
          }

          function shouldActivate(direction) {
            const rect = target.getBoundingClientRect();
            const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
            const thresholds = getThresholds();
            const downEnterLine = viewportHeight * thresholds.downEnter;
            const upEnterLine = viewportHeight * thresholds.upEnter;

            if (direction === 'up') {
              return rect.bottom >= upEnterLine && rect.top < viewportHeight;
            }

            return rect.top <= downEnterLine && rect.bottom > 0;
          }

          function shouldReset() {
            const rect = target.getBoundingClientRect();
            const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
            const thresholds = getThresholds();
            const topExitLine = viewportHeight * thresholds.topExit;
            const bottomExitLine = viewportHeight * thresholds.bottomExit;

            return rect.bottom <= topExitLine || rect.top >= bottomExitLine;
          }

          function evaluate() {
            const direction = evaluateDirection();
            const activate = shouldActivate(direction);
            const reset = shouldReset();

            if (!isActive && activate) {
              isActive = true;
              startAnimation();
              return;
            }

            if (isActive && reset) {
              isActive = false;
              resetAnimation();
            }
          }

          function requestEvaluate() {
            if (rafId) return;
            rafId = window.requestAnimationFrame(() => {
              rafId = null;
              evaluate();
            });
          }

          requestEvaluate();
          window.addEventListener('scroll', requestEvaluate, { passive: true });
          window.addEventListener('resize', requestEvaluate);
        }

        /* Run on first load */
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          initProfileCard();
        } else {
          document.addEventListener('DOMContentLoaded', initProfileCard);
        }

        /* Run again after Astro page navigation */
        document.addEventListener('astro:page-load', initProfileCard);
      </script>
    </div>
  </section>

  <section id="signalSection" class="bg-white px-6 md:px-12 py-20 md:py-28 overflow-hidden">
    <div id="signalContainer" style="max-width:1100px;margin:0 auto">
      <div id="signalHeader" style="text-align:center;margin-bottom:72px">
        <div
