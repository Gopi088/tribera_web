  <section class="bg-black px-6 sm:px-10 lg:px-14 py-16 md:py-20">
    <div class="max-w-6xl mx-auto grid gap-10 lg:gap-10 lg:grid-cols-2 items-center">
      <div>
        <span class="text-[11px] tracking-[0.1em] text-[#da0007] font-medium"> SEE YOUR PROFILE </span>

        <h2 class="mt-3 text-[34px] sm:text-[44px] lg:text-[55px] font-[700] leading-[1.08] text-white">
          Professional profile <br />
          that stands out
        </h2>

        <p class="mt-4 max-w-2xl text-[15px] sm:text-[16px] leading-relaxed text-white/50">
          Your verified profile showcases technical depth, real skills, and cultural fit — giving companies exactly what
          they need to say yes.
        </p>

        <div class="mt-10 space-y-6">
          {
            [
              [
                'Deep technical validation by real advisors',
                'A focused 30-minute session on architecture, complexity, and real-world execution.',
              ],
              [
                'AI scores the conversation',
                'Technical depth, problem-solving, culture signals — scored objectively. Companies trust it',
              ],
              [
                'Get high-intent inbound opportunities',
                'Your verified score reaches hiring teams with active roles, so conversations start with stronger context and intent.',
              ],
            ].map(([title, desc]) => (
              <div
                class="group flex gap-5 items-start cursor-pointer
             transition-all duration-300"
              >
                <div
                  class="w-[2px] min-h-[42px]
               bg-white/10
               transition-all duration-300
               group-hover:bg-[#da0007]"
                />

                <div class="max-w-xl">
                  <h4
                    class="text-[15px] font-[600]
