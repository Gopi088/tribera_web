                >
              </div>
            </div>

            <div style="height:1px;background:rgba(0,0,0,.1)"></div>

            <div>
              <div
                style="font-size:11px;font-weight:600;color:rgba(0,0,0,.2);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px"
              >
                Education
              </div>
              <div style="font-size:13px;color:rgba(0,0,0,.25)">B.Tech Computer Science</div>
            </div>

            <div>
              <div
                style="font-size:11px;font-weight:600;color:rgba(0,0,0,.2);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px"
              >
                Experience
              </div>
              <div style="font-size:13px;color:rgba(0,0,0,.25);line-height:1.6">
                Built microservices architecture<br />
                handling 2M+ daily requests
              </div>
            </div>
          </div>

          <div
            style="margin-top:32px;padding:18px 20px;background:rgba(0,0,0,.05);border-radius:10px;border-left:2px solid rgba(0,0,0,.12)"
          >
            <div style="font-size:28px;font-weight:700;color:rgba(0,0,0,.2);letter-spacing:-.04em;margin-bottom:4px">
              3%
            </div>
            <div style="font-size:12px;color:rgba(0,0,0,.4);line-height:1.5">
              Response rate.<br />
              140 applications sent.
            </div>
          </div>
        </div>

        <div class="signalCard" style="background:#000;padding:52px 48px;position:relative;color:#fff">
