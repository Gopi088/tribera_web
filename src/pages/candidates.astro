---
import Header from '~/components/widgets/Header.astro';
import Logo from '~/components/Logo.astro';
const brands = ['Flipkart', 'Myntra', 'Heineken', 'Volkswagen', 'Mizuho', 'ICICI Bank', 'Publicis Sapient', 'Capco', 'PayU', 'DSP Mutual Fund', 'ICICI Securities', 'Utkarsh Bank', 'Aeries', 'SplashBI', 'Aegon Life', 'Enpro'];
const profileDimensions = [
  ['Architecture thinking', 96],
  ['Systems design', 91],
  ['Code quality', 95],
  ['Communication', 89],
];
const profileMin = Math.min(...profileDimensions.map(d => d[1]));
const allDimensions = [
  ...profileDimensions,
  ['Ops and on-call', 74],
  ['Product sense', 68],
];
const scorePresets = [
  { name: 'Consumer scale', score: '91.1', label: 'Top of their list', rank: 'top', note: 'Scale and throughput. Architecture and systems carry two-thirds of their bar — and they barely look at product.', weights: [30, 30, 15, 15, 10, 0] },
  { name: 'Fintech platform', score: '90.0', label: 'Strongly in range', rank: 'mid', note: 'Correctness first. Depth and code discipline weighted evenly, communication low, product almost nil.', weights: [25, 25, 25, 10, 10, 5] },
  { name: 'Infrastructure / SRE', score: '87.4', label: 'In range, not top', rank: 'low', note: 'Who carries the pager. Ops experience is weighted as heavily as systems design — the one place you scored 74.', weights: [15, 30, 15, 10, 30, 0] },
  { name: 'Early-stage product', score: '84.8', label: 'In range, not top', rank: 'low', note: 'Breadth and judgment. They weight product sense above everything you scored highest on.', weights: [15, 15, 10, 25, 5, 30] },
];
const questions = [
  ['Built microservices handling two million requests a day.', 'Which service did you split off first — and what broke when you did?'],
  ['Led migration from monolith to event-driven architecture.', 'What did you have to keep in the monolith, and who argued for keeping more?'],
  ['Reduced p99 latency by 40%.', 'What was the 40% measured against, and what did you check before you believed it?'],
];
const teamChecks = [
  ['Is the headcount real?', "Approved and funded, or we don't list it.", 'Verified'],
  ['How many rounds?', 'Stated up front. If it changes, you hear from us, not from them.', 'Three'],
  ['How fast do they decide?', 'Measured from your final interview, not from their intake call.', '6 days'],
  ['How long has the manager been there?', "The person you'd report to, not the org chart.", '4 yrs'],
  ['Do people stay?', 'Twelve-month retention on their last five hires through us.', 'One flag'],
];
const controls = [
  ['Anonymous by default', 'Your name, employer and contact stay hidden until you release them to a specific team.', 'Hidden', true],
  ['Block by name', 'Name your current employer, or anyone else. They never see you exist.', '3 companies blocked', true],
  ['No direct contact', 'Companies cannot message you. Every request comes through us first.', 'All requests routed', true],
  ['Pause in one click', 'Got an offer? Make the profile invisible. Turn it back on whenever.', 'Profile live', false],
];
const timeline = [
  ['Day 1 · 15 min', 'Set up your profile', 'Stack, preferences, and who you want blocked. Anonymous from the first second.'],
  ['Day 3–5 · 30 min', 'An expert interviews you', 'Someone who has done your job. Recorded, and you get the score.'],
  ['Day 7+ · inbound', 'Teams ask for you', 'Your profile goes live to teams that cleared our checks. No cold applying.'],
  ['~3 weeks · offer', 'You decide', "Accept what fits, decline what doesn't. Most people see more than one."],
];
const testimonials = [
  ['I was stuck in endless screening loops. After one interview here I had four relevant requests in ten days.', 'Senior backend engineer', 'Fintech product company'],
  ["The expert had already read my GitHub. The first question was about a design decision I made in 2022. That's when I knew this was different.", 'Senior backend engineer', '6 yrs, now placed'],
  ['It matched me to roles where I actually fit. The interview felt like a technical discussion, not an interrogation.', 'Full-stack engineer', 'AI SaaS startup'],
  ['My profile stayed private while I explored. I only spoke to serious teams, and had an offer inside three weeks.', 'Engineering manager', 'Enterprise platform team'],
  ['Three requests in one week, all aligned to my stack. No spam, no repetition.', 'Frontend engineer', 'Consumer app company'],
  ["I'd paused looking for months because applying was draining. This brought the relevant ones back to me.", 'Data engineer', 'B2B analytics company'],
  ['The score breakdown was clear and practical. I knew exactly what to work on, and the next round felt stronger.', 'Senior platform engineer', 'Cloud infrastructure startup'],
  ['I switched without announcing I was looking. Every conversation I took was worth the time.', 'Mobile engineer', 'Digital payments company'],
];
const teamFaceChecks = [
  ['Headcount', 'Approved and funded this quarter'],
  ['Rounds', 'Three, then a decision'],
  ['Decision speed', 'Six days from final interview'],
  ['Manager tenure', 'Four years in the role'],
];
const candidatesStats = [
  ['85', '%', 'of candidates who reach a final interview get an offer'],
  ['3', 'wks', 'median from profile going live to an offer in hand'],
  ['1.8', 'offers', 'the average person here ends up choosing between'],
];
const outcomes = [
  ['Cleared', 'ok', 'The request reaches you', 'Normal case. You see the role, the team, and what they weighted.'],
  ['Flagged', 'fl', 'It reaches you with the flag', 'One check failed. You see which, and what it means, and you decide whether it matters.'],
  ['Declined', 'no', 'It never reaches you', 'Unfunded headcount, or a role that has churned twice this year. You are never told about it, because there is nothing to tell.'],
];
---
<title>Interviewed once. Shortlisted everywhere. — tribera</title>
<meta name="description" content="One conversation. Thirty minutes. Your CV gets six seconds. Your LinkedIn gets skimmed. One honest conversation with someone who has done your job gets read.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@500;600;700;800&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

<Header />

<!-- ══ HERO ══ -->
<header class="hero" id="top">
      <div class="wrap">
        <div class="hero__top">
          <div class="hero__copy">
            <p class="eyebrow" data-rv>One conversation. Thirty minutes.</p>
            <h1 class="h1" data-rv style="--d:60ms">Interviewed once.<br>Shortlisted <em>everywhere</em>.</h1>
            <p class="hero__p" data-rv style="--d:110ms">Your CV gets six seconds. Your LinkedIn gets skimmed.
            <b>One honest conversation with someone who has done your job gets read</b> — by every team that
            asks for you afterwards.</p>
            <p class="hero__p" data-rv style="--d:150ms"><b>You're not one of eight in a pile. You're one of three,
            and they've read your interview before they pick up the phone.</b></p>
            <div class="btns" data-rv style="--d:190ms">
              <a href="#apply" class="btn btn--light">Create your profile</a>
              <a href="/" class="btn btn--wire">I'm hiring</a>
            </div>
          </div>

          <div class="hero__card" data-rv style="--d:150ms">
            <div class="ftabs" role="tablist" aria-label="Two sides of the same conversation">
              <button class="ftab is" id="tabA" role="tab" aria-selected="true" aria-controls="faceA">Your profile</button>
              <button class="ftab" id="tabB" role="tab" aria-selected="false" aria-controls="faceB">The team asking</button>
            </div>
            <div class="tilt" id="tilt">
              <div class="flip cflip" id="flip">
                <div class="face" id="faceA" role="tabpanel" aria-labelledby="tabA"><span class="face__glint"></span>
                  <div class="face__hd"><span>Your profile <span class="rank">· live</span></span>
                    <span>Senior backend · Bengaluru</span></div>
                  <div class="side">
                    <div class="side__hd">
                      <div><p class="side__nm">A. Mehta</p>
                        <p class="side__sub">6 yrs · Python, AWS, Kubernetes · <b>anonymous</b></p></div>
                      <span class="scr">
                        <span class="scr__n"><b>88</b><i>/100</i></span>
                        <span class="pill">TOP 8%</span>
                        <span class="scale" aria-hidden="true"><span class="scale__sel"></span>
                          <span class="scale__pin"></span></span>
                        <span class="scale__k">Top decile starts at 85</span>
                      </span>
                    </div>
                    <div class="vrd"><p class="vrd__k">What the expert wrote</p>
                      <p class="vrd__t">He has built the thing most teams are hiring for — and he can show you
                      the decision, not just the system.</p></div>
                    <div class="mtr2">
                      {profileDimensions.map(([label, value]) => (
                        <div class="mtr2__r{value === profileMin ? ' mtr2__r--low' : ''}"><span class="mtr2__n">{label}</span><span class="mtr2__b"><span class="mtr2__f" style={`width:${value}%`}></span></span><span class="mtr2__v">{value}</span></div>
                      ))}
                    </div>
                    <p class="tiles__cap">Four dimensions, scored on the same rubric the team receives</p>
                    <div class="notes">
                      <div class="note note--warn"><span class="note__k">Next</span>
                        <p class="note__v">Communication is the one below your band. One worked example of a
                        disagreement you resolved would move it.</p></div>
                      <div class="note"><span class="note__k">Heard</span>
                        <p class="note__v">Named the failure mode he was designing against before anyone
                        asked him to.</p></div>
                    </div>
                  </div>
                  <div class="face__ft"><span>Recorded call · you keep the transcript</span>
                    <span class="lg"><i class="lg--g">LIVE</i><i class="lg--y">PAUSED</i><i class="lg--r">HIDDEN</i></span></div>
                </div>

                <div class="face face--b" id="faceB" role="tabpanel" aria-labelledby="tabB" aria-hidden="true">
                  <span class="face__glint"></span>
                  <div class="face__hd"><span>The team asking <span class="rank">· 1 of 3</span></span>
                    <span>Consumer internet · Series D</span></div>
                  <div class="side">
                    <div class="side__hd">
                      <div><p class="side__nm">Platform team, 9 engineers</p>
                        <p class="side__sub">Reports to VP Engineering · <b>headcount approved</b></p></div>
                      <span class="verd__band b-sel" style="font-size:9.5px;padding:6px 11px">CLEARED</span>
                    </div>
                    <div class="vrd"><p class="vrd__k">Why we let them ask</p>
                      <p class="vrd__t">They know what they want, they decide in a week, and people stay.</p></div>
                    <div class="sig__list">{teamFaceChecks.map(([label, value]) => (
                      <div class="sig__r"><span class="sig__k2">{label}</span><span class="sig__v">{value}</span></div>
                    ))}</div>
                    <div class="notes">
                      <div class="note note--warn"><span class="note__k">Watch</span>
                        <p class="note__v">They interview in one-week blocks. If you need longer, say so before
                        you accept the call.</p></div>
                    </div>
                  </div>
                  <p class="tiles__cap">What we verified before this request reached you</p>
                  <div class="face__ft"><span>We check them before you meet them</span>
                    <span class="lg"><i class="lg--g">SERIOUS</i><i class="lg--y">SLOW</i><i class="lg--r">DECLINED</i></span></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="logos" data-rv>
          <p class="logos__l">Teams hiring through us</p>
          <div class="logos__vp"><div class="logos__tk">{brands.map(b => <span>{b}</span>)}<span aria-hidden="true" class="logos__dup">{brands.map(b => <span>{b}</span>)}</span></div></div>
        </div>
      </div>
    </header>

    <!-- ══ TALLY ══ -->
    <section class="band band--w" id="tally"><div class="wrap">
      <div class="shead">
        <div>
          <p class="eyebrow eyebrow--red" data-rv>The only thing that changed</p>
          <h2 class="h2" data-rv style="--d:60ms">Nothing about him changed. What they could see did.</h2>
        </div>
        <p class="dek" data-rv style="--d:100ms">Same person, same six years, same CV. In the spring he sent
        140 applications and got three replies. Months later, three teams asked for him inside forty-eight
        hours — <b>and none of them had seen the CV.</b></p>
      </div>

      <div class="big" data-rv style="--d:140ms">
        <div class="fan__side fan__side--own">
          <p class="fan__was">His spring — <span id="tallyN">140</span> applications</p>
          <svg class="tally tally--big" viewBox="0 0 300 170" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path class="tk" pathLength="1" d="M7.9 14.2 Q7.8 27.7 8.0 41.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M13.1 13.1 Q13.5 26.6 13.8 40.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M17.4 13.4 Q18.4 26.2 17.9 38.9" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M22.4 15.4 Q22.9 28.3 22.6 41.3" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M5.0 36.6 Q14.8 24.7 27.0 14.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M49.3 13.9 Q50.4 26.9 49.4 39.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M55.2 14.0 Q55.1 27.2 54.7 40.5" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M60.7 15.4 Q61.4 28.2 60.3 41.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M64.6 13.4 Q65.5 26.1 64.4 38.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M48.1 37.7 Q56.9 26.2 69.7 17.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M92.6 13.9 Q92.2 27.6 91.5 41.3" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M97.2 14.8 Q95.9 27.1 96.8 39.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M102.6 14.7 Q101.8 26.8 101.7 38.9" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M106.4 14.8 Q106.6 27.0 106.3 39.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M89.0 38.6 Q98.2 27.2 110.4 16.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk tk--r" pathLength="1" d="M143.4 15.4 Q142.7 27.3 144.1 39.2" stroke="#DA0007" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M148.8 13.4 Q147.4 26.1 149.0 38.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M131.1 38.3 Q143.8 27.0 152.8 15.9" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M176.1 15.0 Q175.0 27.1 177.1 39.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M181.4 13.3 Q182.2 26.2 182.5 39.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M185.6 15.3 Q185.9 28.2 185.4 41.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M190.4 12.7 Q189.6 27.0 190.9 41.3" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M173.1 38.9 Q182.8 28.0 195.2 15.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M217.4 13.2 Q218.5 26.7 217.7 40.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M222.7 15.2 Q221.1 27.2 222.1 39.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M227.9 12.8 Q227.5 25.9 228.1 39.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M232.5 13.6 Q234.0 27.4 232.9 41.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M215.8 38.2 Q224.2 28.1 236.4 14.7" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M260.3 15.3 Q260.7 27.0 260.2 38.7" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M265.3 13.5 Q264.0 27.4 265.4 41.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M270.3 15.1 Q271.0 27.9 271.0 40.7" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M275.6 13.6 Q276.9 27.1 276.5 40.5" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M257.4 38.8 Q269.0 27.0 279.6 16.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M8.1 52.3 Q8.6 64.6 9.3 76.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M13.5 52.6 Q14.3 65.2 13.7 77.7" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M17.9 52.9 Q18.7 64.9 16.8 76.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M23.1 51.9 Q23.8 64.6 23.1 77.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M5.7 77.2 Q15.4 65.6 26.6 52.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M49.6 51.1 Q50.1 65.1 49.4 79.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M55.5 51.5 Q54.6 65.0 55.4 78.5" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M60.4 53.2 Q60.1 66.1 60.6 79.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M64.7 51.0 Q65.8 64.5 65.6 78.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M47.8 77.3 Q58.0 64.3 68.6 53.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M91.6 51.8 Q91.6 65.1 91.2 78.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M97.5 53.3 Q96.1 65.6 96.4 77.9" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M102.5 50.7 Q102.7 64.7 102.1 78.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M107.4 50.7 Q107.3 63.8 106.3 77.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M90.0 75.3 Q100.7 63.8 110.4 52.7" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M134.2 52.4 Q135.6 65.6 134.6 78.9" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M138.6 51.9 Q137.0 64.5 138.5 77.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M144.3 51.1 Q143.8 64.2 144.8 77.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M149.0 52.3 Q148.7 65.5 149.7 78.7" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M132.1 74.8 Q141.4 64.5 153.7 54.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M176.2 53.1 Q176.4 65.4 177.1 77.7" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M181.4 53.2 Q181.9 65.6 180.7 77.9" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M186.3 52.9 Q187.0 65.6 185.6 78.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M191.6 53.3 Q191.7 66.3 192.3 79.3" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M173.2 77.1 Q182.7 65.1 195.6 53.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M218.1 52.8 Q216.6 65.4 218.8 78.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M222.4 52.8 Q221.9 65.0 223.1 77.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M227.5 51.0 Q228.2 64.5 228.3 78.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk tk--r" pathLength="1" d="M233.3 53.2 Q234.7 65.6 232.3 78.0" stroke="#DA0007" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M215.1 76.1 Q226.4 65.4 236.7 54.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M260.5 52.2 Q260.1 64.8 261.3 77.5" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M265.6 51.2 Q267.1 65.1 265.6 79.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M270.1 51.2 Q270.1 64.6 270.4 78.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M274.3 53.3 Q274.0 65.7 275.1 78.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M257.6 76.0 Q268.6 64.0 279.3 52.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M8.6 91.2 Q8.6 103.3 7.7 115.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M12.9 90.9 Q12.8 104.0 12.5 117.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk tk--r" pathLength="1" d="M106.4 127.4 Q106.8 140.6 105.4 153.8" stroke="#DA0007" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M89.6 150.8 Q100.2 141.2 110.3 130.5" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M133.8 127.9 Q133.3 140.6 134.4 153.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M139.5 126.8 Q140.5 139.9 139.8 152.9" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M144.4 127.2 Q143.6 140.5 145.1 153.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M148.8 128.4 Q148.3 141.9 148.9 155.4" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M131.9 153.2 Q140.8 142.9 152.9 129.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M175.4 126.8 Q175.4 140.5 175.9 154.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M180.7 128.8 Q179.8 140.8 181.1 152.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M185.4 127.5 Q186.0 141.0 184.9 154.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M190.5 127.6 Q190.1 141.1 189.6 154.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M173.8 152.2 Q186.4 141.5 195.7 131.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M218.4 127.5 Q218.1 140.5 219.5 153.5" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M223.6 127.3 Q223.1 140.5 223.2 153.6" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M227.9 127.7 Q228.1 140.4 228.6 153.1" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M233.1 128.9 Q232.0 141.6 233.7 154.2" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M216.1 151.4 Q226.3 141.0 236.2 130.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M260.7 128.4 Q259.3 141.6 260.8 154.9" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M265.4 126.8 Q266.2 139.8 266.4 152.8" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M269.4 128.4 Q270.2 140.7 269.8 153.0" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M274.6 127.2 Q274.7 141.0 275.3 154.7" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/><path class="tk" pathLength="1" d="M257.3 151.5 Q268.5 141.2 279.7 130.5" stroke="#C8C4BA" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/></svg>
          <p class="fan__cap">Three replies. Grey is silence.</p>
        </div>
        <div>
          <p class="big__k">What a CV can carry, and what it can't</p>
          <p class="big__t">A CV describes what you were near.<br><em>A transcript shows what you decided.</em></p>
          <p class="big__d">Every line on a CV is a claim with no working shown. Thirty minutes of follow-up
          questions is the cheapest way anyone has found to tell the two apart.</p>
          <div class="ba"><div class="ba__r"><span class="ba__k">On the CV</span><p class="ba__v">Built microservices handling two million requests a day.</p></div><div class="ba__r"><span class="ba__k">What that shows</span><p class="ba__v">That he can write a sentence about microservices.</p></div><div class="ba__r"><span class="ba__k">On the transcript</span><p class="ba__v">The trade-off he rejected, why he rejected it, and what it cost him six months later.</p></div><div class="ba__r ba__r--now"><span class="ba__k">What that shows</span><p class="ba__v">That he made the call — and knows what it cost.</p></div></div>
        </div>
      </div>

      <p class="cases__ft" style="color:var(--grey);max-width:70ch">This is why the teams that asked for him
      didn't need the CV. <b style="color:var(--ink)">They had already read the part a CV leaves out.</b></p>
    </div></section>

    <!-- ══ SCORE ══ -->
    <section class="lab band" id="score"><div class="wrap">
      <div class="shead">
        <div>
          <p class="eyebrow" data-rv>The same you, four different bars</p>
          <h2 class="h2" data-rv style="--d:60ms">Change the team. Watch your score move.</h2>
        </div>
        <p class="lab__dek" data-rv style="--d:100ms">One interview, six dimensions, one set of answers. Every team
        weights them differently — <b>so you're not a number — you're a different number to each of them.</b>
        Pick a team and see where you land.</p>
      </div>

      <div class="score2" data-rv style="--d:140ms">
        <div class="vcard">
          <div class="vcard__hd">
            <div><p class="vcard__nm">A. Mehta</p>
              <p class="vcard__sub">Senior backend · 6 yrs · sample profile</p></div>
            <span class="vcard__band" id="sBand">Top of their list</span>
          </div>
          <div class="vcard__big"><b id="sScore">91.1</b><i>/ 100</i></div>
          <div class="vcard__track">
            <span class="vcard__z1"></span><span class="vcard__z2"></span>
            <span class="vcard__pin" id="sPin"></span>
          </div>
          <div class="vcard__ax"><span>70</span><span>85 · STRONG · 90 · TOP DECILE</span><span>100</span></div>
          <div class="vms">{allDimensions.map(([label, value], i) => (
            <div class="vm" id={`vm${i}`}><span class="vm__n">{label}</span><span class="vm__b"><span class="vm__f" style={`width:${value}%`}></span></span><span class="vm__v">{value}</span></div>
          ))}</div>
          <p class="vcard__ft" id="sNote"></p>
        </div>

        <div>
          <p class="score2__k">Whose bar are we using?</p>
          <div class="pres2">{scorePresets.map((p, i) => (
            <button class={`pre2${i === 0 ? ' on' : ''}`} data-i={i} type="button">{p.name}</button>
          ))}</div>
          <div class="wrs">{allDimensions.map(([label], i) => (
            <div class="wr" id={`wr${i}`}><span class="wr__n">{label}</span><span class="wr__b"><span class="wr__f" id={`wf${i}`}></span></span><span class="wr__v" id={`wv${i}`}>0%</span></div>
          ))}</div>
          <p class="wrs__ft">Your scores never change. <b>Only the weighting does</b> — and that is the whole
          reason applying to forty teams was never going to tell you anything.</p>
        </div>
      </div>

      <p class="lab__foot2" data-rv>You can't know whose bar you fit by applying.
        <em>You can find out by being measured once.</em></p>
    </div></section>

    <!-- ══ THIRTY ══ -->
    <section class="band" id="thirty"><div class="wrap">
      <div class="shead">
        <div>
          <p class="eyebrow" data-rv>The thirty minutes</p>
          <h2 class="h2" data-rv style="--d:60ms">Every question comes off your own CV.</h2>
        </div>
        <p class="dek" data-rv style="--d:100ms">Not a script, and not a quiz. The engine reads what you wrote
        and turns each claim into something only the person who did it could answer.
        <b>Then someone who has run what you run asks it, and follows up where the answer stays general.</b></p>
      </div>

      <div class="qps" data-rv style="--d:140ms">{questions.map(([evidence, question]) => (
        <div class="qp"><div class="qp__l"><span class="qp__k">On your CV</span><p class="qp__v">{evidence}</p></div><span class="qp__arrow" aria-hidden="true">→</span><div class="qp__r"><span class="qp__k qp__k--r">What you get asked</span><p class="qp__q">{question}</p></div></div>
      ))}</div>

      <div class="qnote" data-rv>
        <div><p class="qnote__k">Thirty minutes, once</p>
          <p class="qnote__v">Recorded and transcribed. It travels to every team that asks for you — you never
          answer the same question twice.</p></div>
        <div><p class="qnote__k">A peer, not a panel</p>
          <p class="qnote__v">The expert interviewing you has run the systems you're describing. That is why
          the follow-up lands.</p></div>
      </div>

      <p class="fn__line" data-rv>Most screens test whether you can describe it.<br>This one tests
      <em>whether you decided it</em>.</p>
    </div></section>

    <!-- ══ THEM ══ -->
    <section class="band band--w" id="them"><div class="wrap">
      <div class="shead">
        <div>
          <p class="eyebrow eyebrow--red" data-rv>The other half</p>
          <h2 class="h2" data-rv style="--d:60ms">We check them too, before you meet them.</h2>
        </div>
        <p class="dek" data-rv style="--d:100ms">Every job board asks you to prove yourself to a company that
        has proved nothing to you. <b>A request only reaches you if the team on the other end clears its own
        set of checks.</b></p>
      </div>
      <div class="them">{teamChecks.map(([title, copy, value], i) => (
        <div class={`them__r${i === 4 ? ' them__r--flag' : ''}`}><p class="them__k">{title}</p><p class="them__d">{copy}</p><span class="them__v">{value}</span></div>
      ))}</div>
      <div class="outc">
        <p class="outc__k">And when a check doesn't clear</p>
        <div class="outc__g">{outcomes.map(([label, css, title, copy]) => (
          <div class={`outc__i outc__i--${css}`}><span class="outc__s">{label}</span>
            <p class="outc__t">{title}</p>
            <p class="outc__d">{copy}</p></div>
        ))}</div>
      </div>
      <p class="cases__ft" style="color:var(--grey)">When something doesn't clear, you still see the request —
      <b style="color:var(--ink)">with the flag attached and the reason written out.</b> You decide whether it
      matters. We don't decide that for you.</p>
    </div></section>

    <!-- ══ CONTROLS ══ -->
    <section class="trust band" id="controls">
      <div class="wrap">
        <div class="shead">
          <div>
            <p class="eyebrow" data-rv>Your controls</p>
            <h2 class="h2" data-rv style="--d:60ms">Your employer will never know you were here.</h2>
          </div>
          <p class="trust__dek" data-rv style="--d:100ms">Looking while employed is the normal case, not the
          exception. <b>These are switches, not a policy page</b> — try them.</p>
        </div>
        <div class="ctrls" data-rv style="--d:140ms">{controls.map(([title, copy, status, enabled]) => (
          <button class={`ctl${enabled ? ' on' : ''}`} type="button" aria-pressed={String(enabled)}><span class="ctl__sw"></span><span class="ctl__body"><span class="ctl__t">{title}</span><span class="ctl__d">{copy}</span><span class="ctl__st">{status}</span></span></button>
        ))}</div>
        <div class="freeb" data-rv>
          <div><p class="freeb__k">It costs you nothing</p>
            <p class="freeb__v">Not now, not when you're placed, not ever. Companies pay us when they hire.
            <b>If anyone in this industry asks you for money, walk.</b></p></div>
          <div><p class="freeb__k">Who it's for</p>
            <p class="freeb__v">Mid-level upward, across engineering, data, infrastructure, finance,
            operations and leadership. If we don't run mandates in your area yet, we'll tell you that on
            day one rather than sit on your CV.</p></div>
        </div>
        <p class="trust__ft" data-rv>Consent is captured before anything is evaluated, your data sits in India,
        and you can ask for all of it back or deleted at any point. Transcripts are held on a defined clock and
        then purged.</p>
      </div>
    </section>

    <!-- ══ WHEN ══ -->
    <section class="wrap band" id="when">
      <div class="shead">
        <div>
          <p class="eyebrow eyebrow--red" data-rv>What happens, and when</p>
          <h2 class="h2" data-rv style="--d:60ms">No black boxes. You always know where you are.</h2>
        </div>
        <p class="dek" data-rv style="--d:100ms">And if we can't help, <b>we tell you that instead of going
        quiet.</b> Silence isn't a process, and it's the single thing people hate most about looking.</p>
      </div>
      <div class="tl2__g" data-rv style="--d:140ms">{timeline.map(([time, title, copy], i) => (
        <div class="tl2"><span class={`tl2__bar`}></span><p class="tl2__d">{time}</p><p class="tl2__t">{title}</p><p class="tl2__p">{copy}</p></div>
      ))}</div>
      <div class="cstat" data-rv>{candidatesStats.map(([num, suffix, desc], i) => (
        <div class="cstat__i"><p class="cstat__n">{num}<i>{suffix}</i></p>
          <p class="cstat__d">{desc}</p></div>
      ))}</div>
      <p class="cstat__ft" data-rv>Which is the part nobody tells you when you're applying:
      <b>the hard bit was never the interview. It was getting to one that counted.</b></p>
    </section>

    <!-- ══ VOICES ══ -->
    <section class="band band--w" id="voices">
      <div class="wrap">
        <div class="shead">
          <div>
            <p class="eyebrow eyebrow--red" data-rv>In their words</p>
            <h2 class="h2" data-rv style="--d:60ms">What people say afterwards.</h2>
          </div>
          <p class="dek" data-rv style="--d:100ms">Roles and company types are real. Names are withheld, because
          most of these people were employed at the time — <b>which is rather the point.</b></p>
        </div>
      </div>
      <div class="mq" data-rv style="--d:140ms"><div class="mq__t">{[...testimonials, ...testimonials].map(([quote, role, company]) => (
        <figure class="qc qc--cd"><span class="qc__tag">Candidate</span><blockquote class="qc__q">{quote}</blockquote><figcaption class="qc__a"><b>{role}</b><span>{company}</span></figcaption></figure>
      ))}</div></div>
    </section>

    <!-- ══ APPLY ══ -->
    <section class="cand band" id="apply"><div class="wrap">
      <div class="apply">
        <p class="apply__k">Start here</p>
        <p class="apply__h">One conversation. Then you stop applying.</p>
        <p class="apply__s">Leave your email and we'll pick it up on the next screen — your name and CV, about
        a minute. <b>We reply within a day either way</b>, and if we can't help we'll say so rather than go
        quiet.</p>
        <form class="apply__form" action="/candidates/start" method="get">
          <div class="apply__row apply__row--2">
            <input class="apply__mail" type="email" name="email" required placeholder="your@email.com"
                   aria-label="Your email address">
            <button class="apply__go" type="submit">Continue<span class="apply__ar">→</span></button>
          </div>
        </form>
        <p class="apply__fine">No account needed · <b>one minute, two fields</b> · anonymous from the first
        second · your email is only ever used to reply</p>
      </div>

      <p class="human" data-rv>We built this because we'd all been on your side of the table,
      <em>and we remembered how it felt</em>.</p>
    </div></section>

    <!-- ══ CLOSE ══ -->
    <section class="wrap band close" id="close">
      <p class="eyebrow eyebrow--red" data-rv>Two doors</p>
      <h2 class="h2" data-rv style="max-width:13ch">Two doors.<br>Same room.</h2>
      <p class="dek" data-rv style="--d:60ms">You're looking, someone else is hiring, and the whole job is
      <b>putting the two who should be in a conversation into one</b>. Tell us which side you're on.</p>
      <div class="doors" data-rv style="--d:110ms">
        <div class="door">
          <p class="door__k">If you're looking</p>
          <p class="door__t">One conversation, then teams come to you.</p>
          <p class="door__d">Thirty minutes with someone who has done your job. Anonymous until you decide
          otherwise.</p>
