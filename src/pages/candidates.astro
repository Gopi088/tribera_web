}
@media (prefers-reduced-motion: reduce) {
  .mq {
    overflow-x: auto;
    -webkit-mask-image: none;
    mask-image: none;
  }
  .mq__t {
    animation: none;
  }
}

/* ══ CLOSE ══ */
.doors {
