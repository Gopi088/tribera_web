<script>
(function(){
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  /* ══ CARD FLIP ══ */
  var flip=document.getElementById('flip'),
      tA=document.getElementById('tabA'), tB=document.getElementById('tabB'),
      fA=document.getElementById('faceA'), fB=document.getElementById('faceB'), took=false;
  function face(b){
    if(!flip) return;
    flip.classList.toggle('is-b', b);
    var cardWrap=document.querySelector('.hero__card');
    if(cardWrap) cardWrap.classList.toggle('is-flipped', b);
    tA.classList.toggle('is', !b); tB.classList.toggle('is', b);
    tA.setAttribute('aria-selected', String(!b)); tB.setAttribute('aria-selected', String(b));
    fA.setAttribute('aria-hidden', String(b)); fB.setAttribute('aria-hidden', String(!b));
  }
  if(flip){
    tA.addEventListener('click',function(){took=true;face(false);});
    tB.addEventListener('click',function(){took=true;face(true);});
    flip.addEventListener('click',function(){took=true;face(!flip.classList.contains('is-b'));});
    if(!reduce && 'IntersectionObserver' in window){
      new IntersectionObserver(function(es,ob){
        es.forEach(function(e){
          if(!e.isIntersecting) return; ob.disconnect();
          setTimeout(function(){ if(!took) face(true); }, 2600);
          setTimeout(function(){ if(!took) face(false); }, 5200);
        });
      },{threshold:.4}).observe(flip);
    }
  }

  /* ══ CARD TILT ══ */
  var cardWrap=document.querySelector('.hero__card'), tilt=document.getElementById('tilt');
  if(cardWrap && tilt && !reduce && matchMedia('(hover:hover) and (pointer:fine)').matches){
    var raf=null;
    cardWrap.addEventListener('pointermove',function(e){
      if(raf) return;
      raf=requestAnimationFrame(function(){
        raf=null;
        var r=cardWrap.getBoundingClientRect(),
            px=(e.clientX-r.left)/r.width, py=(e.clientY-r.top)/r.height;
        tilt.classList.add('live');
        tilt.style.setProperty('--ry',((px-.5)*11).toFixed(2)+'deg');
        tilt.style.setProperty('--rx',((.5-py)*8).toFixed(2)+'deg');
        cardWrap.querySelectorAll('.face').forEach(function(f){
          f.style.setProperty('--mx',(px*100).toFixed(1)+'%');
          f.style.setProperty('--my',(py*100).toFixed(1)+'%');
        });
      });
    });
    cardWrap.addEventListener('pointerleave',function(){
      tilt.classList.remove('live');
      tilt.style.setProperty('--ry','0deg'); tilt.style.setProperty('--rx','0deg');
    });
  }

  /* ══ SCORE CALCULATOR ══ */
  (function(){
    var D=[{"n": "Architecture thinking", "v": 96}, {"n": "Systems design", "v": 91}, {"n": "Code quality", "v": 95}, {"n": "Communication", "v": 89}, {"n": "Ops and on-call", "v": 74}, {"n": "Product sense", "v": 68}];
    var R=[{"id": "consumer", "nm": "Consumer scale", "w": [30, 30, 15, 15, 10, 0], "note": "Scale and throughput. Architecture and systems carry two-thirds of their bar — and they barely look at product."}, {"id": "fintech", "nm": "Fintech platform", "w": [25, 25, 25, 10, 10, 5], "note": "Correctness first. Depth and code discipline weighted evenly, communication low, product almost nil."}, {"id": "infra", "nm": "Infrastructure / SRE", "w": [15, 30, 15, 10, 30, 0], "note": "Who carries the pager. Ops experience is weighted as heavily as systems design — the one place you scored 74."}, {"id": "product", "nm": "Early-stage product", "w": [15, 15, 10, 25, 5, 30], "note": "Breadth and judgment. They weight product sense above everything you scored highest on."}];
    var pres=document.querySelectorAll('.pre2');
    var elS=document.getElementById('sScore'), elB=document.getElementById('sBand'),
        elP=document.getElementById('sPin'), elN=document.getElementById('sNote');
    if(!pres.length||!elS) return;
    var shown=0, raf=null;
    function paint(i){
      var r=R[i], tot=r.w.reduce(function(a,b){return a+b;},0);
      var score=D.reduce(function(a,d,j){return a+d.v*r.w[j];},0)/(tot||1);
      var mx=Math.max.apply(null,r.w);
      pres.forEach(function(b,j){ b.classList.toggle('on',j===i); });
      D.forEach(function(d,j){
        var wr=document.getElementById('wr'+j), vm=document.getElementById('vm'+j);
        document.getElementById('wf'+j).style.width=(r.w[j]/mx*100)+'%';
        document.getElementById('wv'+j).textContent=r.w[j]+'%';
        wr.classList.toggle('zero', r.w[j]===0);
        wr.classList.toggle('top', r.w[j]===mx);
        vm.classList.toggle('dim2', r.w[j]<=5);
        vm.classList.toggle('key', r.w[j]===mx);
      });
      elP.style.left=Math.max(1,Math.min(99,(score-70)/30*100))+'%';
      var band = score>=90 ? ['Top of their list',''] :
                 score>=86 ? ['Strongly in range','mid'] : ['In range, not top','low'];
      elB.textContent=band[0];
      elB.className='vcard__band '+ (band[1]===''?'':band[1]==='mid'?'mid':'low');
      elN.textContent=r.note;
      cancelAnimationFrame(raf);
      (function step(){
        var diff=score-shown;
        if(Math.abs(diff)<0.02){ shown=score; elS.textContent=score.toFixed(1); return; }
        shown+=diff*0.22; elS.textContent=shown.toFixed(1);
        raf=requestAnimationFrame(step);
      })();
    }
    pres.forEach(function(b,i){ b.addEventListener('click',function(){paint(i);}); });
    paint(0);
  })();

  /* ══ CONTROLS SWITCHES ══ */
  document.querySelectorAll('.ctl').forEach(function(b){
    b.addEventListener('click',function(){
      var on=b.classList.toggle('on');
      b.setAttribute('aria-pressed', String(on));
      var st=b.querySelector('.ctl__st');
      if(!st) return;
      var pair=st.dataset.pair || st.textContent;
      st.dataset.pair=pair;
      var map={'Hidden':'Visible','Visible':'Hidden',
               '3 companies blocked':'No blocks','No blocks':'3 companies blocked',
               'All requests routed':'Direct contact allowed','Direct contact allowed':'All requests routed',
               'Profile live':'Profile paused','Profile paused':'Profile live'};
      st.textContent = map[st.textContent] || st.textContent;
    });
  });

  /* ══ REVEAL ON SCROLL ══ */
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
  },{threshold:.14,rootMargin:'0px 0px -8% 0px'});
  document.querySelectorAll('[data-rv]').forEach(function(el){io.observe(el);});

  /* ══ TALLY COUNTER ══ */
  var fan=document.querySelector('.fan__side'), tN=document.getElementById('tallyN');
  if(fan && !reduce){
    new IntersectionObserver(function(es,ob){
      es.forEach(function(e){
        if(!e.isIntersecting) return;
        ob.disconnect();
        fan.parentElement.classList.add('go');
        if(!tN) return;
        var t0=null, DUR=1800;
        tN.textContent='0';
        requestAnimationFrame(function step(ts){
          if(t0===null) t0=ts;
          var u=Math.min((ts-t0)/DUR,1);
          tN.textContent=Math.round(Math.pow(u,1/0.62)*140);
          if(u<1) requestAnimationFrame(step); else tN.textContent='140';
        });
      });
    },{threshold:.35}).observe(fan);
  }
})();
</script>

