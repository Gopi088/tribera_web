        <span class="w-2 h-2 bg-[#da0007] rounded-full"></span>
        FOR CANDIDATES
      </div>

      <h1 class="font-[650] leading-[1.05] text-center">
        <span class="block text-white text-[34px] sm:text-[44px] lg:text-[55px]">
          <span class="block text-white/70"> Interviewed once. </span>

          <span class="block text-[#e10600]"> Shortlisted. </span>

          <span class="block text-white/70"> everywhere. </span>
        </span>
      </h1>

      <p class="mt-6 max-w-2xl mx-auto text-[15px] sm:text-[16px] leading-relaxed text-white/50">
        One 30-minute interview. AI scores it. Companies see your verified profile <br class="hidden sm:block" /> and reach
        out.
      </p>

      <div class="mt-5">
        <button
          type="button"
          data-create-profile
          class="px-6 py-3 rounded-full
         tribera-primary-button font-semibold text-[15px]"
        >
          Create Your Profile →
        </button>
      </div>

      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-8 text-[13px] text-white/30">
        <span>
          <span class="text-white font-semibold">50,000+</span> professionals
        </span>

        <span class="hidden sm:inline">•</span>

        <span>Fortune 500 companies</span>

        <span class="hidden sm:inline">•</span>

        <span>
          <span class="text-white font-semibold">3 wks</span> avg. time to offer
        </span>
      </div>
    </div>
  </section>

  <section id="candidates-brands" class="w-full px-6 md:px-8 py-8 md:py-10 gap-10 relative">
    <div class="pointer-events-none absolute inset-0 bg-dotted-static opacity-80"></div>

    <Brands
      title="Who We Work With"
