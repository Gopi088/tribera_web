    });
    ['dragenter', 'dragover'].forEach(function (ev) {
      zone.addEventListener(ev, function (e) {
        e.preventDefault();
        zone.classList.add('over');
      });
    });
    ['dragleave', 'drop'].forEach(function (ev) {
      zone.addEventListener(ev, function (e) {
        e.preventDefault();
        zone.classList.remove('over');
      });
    });
    zone.addEventListener('drop', function (e) {
      var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (f) read(f.name);
    });
    if (cvAgain)
      cvAgain.addEventListener('click', function () {
        setStage('idle');
        file.value = '';
      });
  })();
})();

/* ══ CANDIDATES: score bars, privacy switches ══ */
(function () {
  var card = document.querySelector('.cflip');
  if (card)
    new IntersectionObserver(
      function (es, ob) {
        es.forEach(function (e) {
          if (e.isIntersecting) {
            card.classList.add('in');
            ob.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    ).observe(card);

  /* the switches are real — they flip */
  document.querySelectorAll('.ctl').forEach(function (b) {
    b.addEventListener('click', function () {
      var on = b.classList.toggle('on');
      b.setAttribute('aria-pressed', String(on));
      var st = b.querySelector('.ctl__st');
      if (!st) return;
      var pair = st.dataset.pair || st.textContent;
      st.dataset.pair = pair;
      var map = {
        Hidden: 'Visible',
        Visible: 'Hidden',
        '3 companies blocked': 'No blocks',
        'No blocks': '3 companies blocked',
        'All requests routed': 'Direct contact allowed',
        'Direct contact allowed': 'All requests routed',
        'Profile live': 'Profile paused',
        'Profile paused': 'Profile live',
      };
      st.textContent = map[st.textContent] || st.textContent;
    });
  });
})();

/* ══ CANDIDATE SCORE: one interview, four different bars ══ */
(function () {
  var D = [
    { n: 'Architecture thinking', v: 96 },
    { n: 'Systems design', v: 91 },
    { n: 'Code quality', v: 95 },
    { n: 'Communication', v: 89 },
    { n: 'Ops and on-call', v: 74 },
    { n: 'Product sense', v: 68 },
  ];
  var R = [
    {
      id: 'consumer',
      nm: 'Consumer scale',
      w: [30, 30, 15, 15, 10, 0],
      note: 'Scale and throughput. Architecture and systems carry two-thirds of their bar \u2014 and they barely look at product.',
    },
    {
      id: 'fintech',
      nm: 'Fintech platform',
      w: [25, 25, 25, 10, 10, 5],
      note: 'Correctness first. Depth and code discipline weighted evenly, communication low, product almost nil.',
    },
    {
      id: 'infra',
      nm: 'Infrastructure / SRE',
      w: [15, 30, 15, 10, 30, 0],
      note: 'Who carries the pager. Ops experience is weighted as heavily as systems design \u2014 the one place you scored 74.',
    },
    {
      id: 'product',
      nm: 'Early-stage product',
      w: [15, 15, 10, 25, 5, 30],
      note: 'Breadth and judgment. They weight product sense above everything you scored highest on.',
    },
  ];
  var pres = document.querySelectorAll('.pre2');
  var elS = document.getElementById('sScore'),
    elB = document.getElementById('sBand'),
    elP = document.getElementById('sPin'),
    elN = document.getElementById('sNote');
  if (!pres.length || !elS) return;
  var shown = 0,
    raf = null;
  function paint(i) {
    var r = R[i],
      tot = r.w.reduce(function (a, b) {
        return a + b;
      }, 0);
    var score =
      D.reduce(function (a, d, j) {
        return a + d.v * r.w[j];
      }, 0) / (tot || 1);
    var mx = Math.max.apply(null, r.w);
    pres.forEach(function (b, j) {
      b.classList.toggle('on', j === i);
    });
    D.forEach(function (d, j) {
      var wr = document.getElementById('wr' + j),
        vm = document.getElementById('vm' + j);
      document.getElementById('wf' + j).style.width = (r.w[j] / mx) * 100 + '%';
      document.getElementById('wv' + j).textContent = r.w[j] + '%';
      wr.classList.toggle('zero', r.w[j] === 0);
      wr.classList.toggle('top', r.w[j] === mx);
      vm.classList.toggle('dim2', r.w[j] <= 5);
      vm.classList.toggle('key', r.w[j] === mx);
    });
    elP.style.left = Math.max(1, Math.min(99, ((score - 70) / 30) * 100)) + '%';
    var band =
      score >= 90
        ? ['Top of their list', '']
        : score >= 86
          ? ['Strongly in range', 'mid']
          : ['In range, not top', 'low'];
    elB.textContent = band[0];
    elB.className = 'vcard__band ' + band[1];
    elN.textContent = r.note;
    cancelAnimationFrame(raf);
    (function step() {
      var diff = score - shown;
      if (Math.abs(diff) < 0.02) {
        shown = score;
        elS.textContent = score.toFixed(1);
        return;
      }
      shown += diff * 0.22;
      elS.textContent = shown.toFixed(1);
      raf = requestAnimationFrame(step);
    })();
  }
  pres.forEach(function (b, i) {
    b.addEventListener('click', function () {
      paint(i);
    });
  });
  paint(0);
})();
</script>
