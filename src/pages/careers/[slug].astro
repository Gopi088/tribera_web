<div id="careersApplyModal" class="apm hidden" role="dialog" aria-modal="true" aria-label="Apply for this role">
  <div class="apply apm__panel">
    <button id="closeCareersApplyModal" class="apm__x" type="button" aria-label="Close">&times;</button>
    <p class="apply__k">Apply</p>
    <h2 class="apply__h">Apply for {role.title}</h2>
    <p class="apply__s">Share your details and resume. Every application is read by a person, not a
      filter.</p>
    <form id="careersApplyForm" class="apply__form" action="/.netlify/functions/careers-apply"
          method="POST" enctype="multipart/form-data">
      <input type="hidden" name="job_title" value={role.title}>
      <input type="hidden" name="job_slug" value={role.slug}>
      <input type="hidden" name="department" value={role.dept}>
      <input type="hidden" name="form_loaded_at" value="" data-form-loaded-at>
      <input type="checkbox" name="botcheck" class="apm__hp" tabindex="-1" aria-hidden="true">
      <div class="apm__grid">
        <input class="apply__url" type="text" name="name" placeholder="Full name *" autocomplete="name" required>
        <input class="apply__mail" type="email" name="email" placeholder="Email address *" autocomplete="email" required>
        <input class="apply__url" type="tel" name="mobile" placeholder="Mobile number" autocomplete="tel">
        <input class="apply__url" type="text" name="current_company" placeholder="Current company" autocomplete="organization">
        <input class="apply__url" type="url" name="linkedin" placeholder="LinkedIn URL" autocomplete="url">
        <textarea class="apm__ta" name="note" rows="3" placeholder="Anything you would like us to know?"></textarea>
      </div>
      <input type="file" id="careersResumeInput" name="resume" accept=".pdf,.doc,.docx" class="apm__hp">
      <div class="apply__row apply__row--2">
        <button type="button" id="careersUploadBtn" class="apply__file">Upload Resume *</button>
        <button type="submit" id="careersSubmitBtn" class="apply__go" disabled>Submit Application<span class="apply__ar">&rarr;</span></button>
      </div>
      <p id="careersFileName" class="apm__fn"></p>
      <p id="careersErrorMsg" class="apm__err hidden"></p>
    </form>
    <div id="careersSuccessMessage" class="apm__ok hidden">
      <span class="apm__okic">&#10003;</span>
      <h3 class="apply__h">Application Submitted</h3>
      <p class="apply__s">Thanks for applying. Our team will review your application and get back to you
        if there is a fit.</p>
    </div>
  </div>
</div>

<script is:inline>
  (function(){
    var modal=document.getElementById('careersApplyModal'),
        closeBtn=document.getElementById('closeCareersApplyModal'),
        form=document.getElementById('careersApplyForm'),
        success=document.getElementById('careersSuccessMessage'),
        uploadBtn=document.getElementById('careersUploadBtn'),
        resumeInput=document.getElementById('careersResumeInput'),
        submitBtn=document.getElementById('careersSubmitBtn'),
        fileName=document.getElementById('careersFileName'),
        errorMsg=document.getElementById('careersErrorMsg'),
        loadedAt=form && form.querySelector('[data-form-loaded-at]'),
        FAIL='Something went wrong while submitting your application. Please try again. If the issue continues, email your resume to careers@tribera.ai.';
    if(!modal||!form||!closeBtn||!uploadBtn||!resumeInput||!submitBtn||!fileName||!errorMsg) return;
    function openModal(){
      form.classList.remove('hidden');
      if(success) success.classList.add('hidden');
      errorMsg.classList.add('hidden');
      if(loadedAt) loadedAt.value=String(Date.now());
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      modal.dataset.lastOpenedAt=String(Date.now());
    }
    function closeModal(){
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }
    if(!window.__triberaCareersApplyBound){
      document.addEventListener('click',function(e){
        var t=e.target;
        if(!(t instanceof Element)) return;
        if(t.closest('[data-open-careers-apply]')){ e.preventDefault(); openModal(); }
      });
      window.__triberaCareersApplyBound=true;
    }
    if(closeBtn.dataset.bound!=='true'){
      closeBtn.dataset.bound='true';
      closeBtn.addEventListener('click',closeModal);
    }
    if(modal.dataset.overlayBound!=='true'){
      modal.dataset.overlayBound='true';
      modal.addEventListener('click',function(e){
        if(e.target!==modal) return;
        if(Date.now()-Number(modal.dataset.lastOpenedAt||0)<500) return;
        closeModal();
      });
    }
    if(!window.__triberaCareersApplyEscBound){
      document.addEventListener('keydown',function(e){
        if(e.key!=='Escape') return;
        if(modal.classList.contains('hidden')) return;
        closeModal();
      });
      window.__triberaCareersApplyEscBound=true;
    }
    if(uploadBtn.dataset.bound!=='true'){
      uploadBtn.dataset.bound='true';
      uploadBtn.addEventListener('click',function(){ resumeInput.click(); });
      resumeInput.addEventListener('change',function(){
        if(resumeInput.files && resumeInput.files.length){
          submitBtn.disabled=false;
          fileName.textContent='Selected: '+resumeInput.files[0].name;
        }else{
          submitBtn.disabled=true;
          fileName.textContent='';
        }
      });
    }
    if(form.dataset.submitBound==='true') return;
    form.dataset.submitBound='true';
    form.addEventListener('submit',async function(e){
      e.preventDefault();
      var originalText=submitBtn.textContent||'Submit Application';
      errorMsg.classList.add('hidden');
      submitBtn.disabled=true;
      submitBtn.textContent='Submitting...';
      try{
        var res=await fetch(form.action,{method:'POST',body:new FormData(form)});
        var ct=res.headers.get('content-type')||'';
        var result=ct.indexOf('application/json')!==-1
          ? await res.json()
          : {success:false,message:FAIL};
        if(!res.ok||!result.success) throw new Error(result.message||'Submission failed');
        form.classList.add('hidden');
        if(success) success.classList.remove('hidden');
        setTimeout(function(){
          form.reset();
          if(loadedAt) loadedAt.value=String(Date.now());
          form.classList.remove('hidden');
          if(success) success.classList.add('hidden');
          submitBtn.textContent=originalText;
          submitBtn.disabled=true;
          fileName.textContent='';
          closeModal();
        },3200);
      }catch(err){
        errorMsg.textContent=FAIL;
        errorMsg.classList.remove('hidden');
      }finally{
        if(!success||success.classList.contains('hidden')){
          submitBtn.textContent=originalText;
          submitBtn.disabled=!(resumeInput.files&&resumeInput.files.length);
        }
      }
    });
  })();
</script>
<script is:inline>
(function(){if(window.__triberaPrefetch)return;window.__triberaPrefetch=true;
var done={};
function pf(u){if(done[u])return;done[u]=1;var l=document.createElement('link');l.rel='prefetch';l.href=u;document.head.appendChild(l);}
document.addEventListener('mouseover',function(e){
  var a=e.target.closest&&e.target.closest('a[href]');if(!a)return;
  var u;try{u=new URL(a.href,location.href);}catch(x){return;}
  if(u.origin!==location.origin)return;
  var p=u.pathname+u.search;if(p===location.pathname+location.search)return;
  pf(p);
},{passive:true});
document.addEventListener('touchstart',function(e){
  var a=e.target.closest&&e.target.closest('a[href]');if(!a)return;
  var u;try{u=new URL(a.href,location.href);}catch(x){return;}
  if(u.origin!==location.origin)return;
  pf(u.pathname+u.search);
},{passive:true});
})();
</script>
