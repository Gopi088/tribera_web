  box-shadow .24s var(--ease),background .24s}
.chip:hover{border-color:#C4C0B6;transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.05)}
.chip:active{transform:scale(.985)}
.chip.on{border-color:var(--ink);background:#FBFBF9;box-shadow:0 6px 20px rgba(0,0,0,.07)}
.chip.on .chip__n{color:var(--ink)}
.chip:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.chip__n{font-family:var(--display);font-weight:600;font-size:14.5px;letter-spacing:-.022em;
