.jrny .jstep:hover .jstep__x{color:var(--onc2)}
.jrny .jstep:hover .jstep__t{color:#fff}
.tr2__l li:hover{color:#fff}
.tr2__l li:hover::before{background:var(--red)}
.path__g .path__s:hover .path__d{color:var(--onc2)}
.syms .sym:hover,.syms .sym.on{color:#fff}
