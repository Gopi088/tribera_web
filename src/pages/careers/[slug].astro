.miss .mis:hover .mis__x{color:var(--ink2)}
.miss .mis:hover .mis__w{color:var(--ink)}
.posts .post:hover .post__x{color:var(--ink2)}
.posts .post:hover .post__sub{color:var(--ink2)}
.bels .bel:hover .bel__x{color:var(--ink2)}
.pth__l .pth__s:hover .pth__x{color:var(--ink2)}
.pth__l .pth__s:hover .pth__t{color:var(--ink)}
.tl2__g .tl2:hover .tl2__p{color:var(--ink2)}
.cg__g .cg:hover .cg__p{color:var(--ink2)}
.them .them__r:hover .them__d{color:var(--ink2)}
.qqs .qq:hover .qq__v{color:var(--ink2)}
.inds2 .ind:hover .ind__x{color:var(--ink2)}
.two .two__c:hover .two__l li{color:var(--ink)}
.two .two__c:hover .two__f{color:var(--ink2)}
.rles .rle:hover .rle__l{color:var(--grey)}
.bench__g .xp:hover span{color:var(--grey)}
.outc__g .outc__i:hover .outc__d{color:var(--ink2)}
.rel .relc:hover .relc__x{color:var(--ink2)}
.mq .qc:hover .qc__q{color:var(--ink)}
.whos__g .who:hover .who__d{color:var(--ink2)}
.expect__g > div:hover span{color:var(--ink2)}
.soon .soon__i:hover .soon__v{color:var(--ink2)}
.estat .estat__i:hover .estat__d,
.cstat .cstat__i:hover .cstat__d{color:var(--ink2)}
.dims .dim:hover .dim__n{color:var(--ink)}
.offs .off:hover .off__a{color:var(--ink)}

/* every one of these transitions colour rather than snapping */
.step__d,.step__t,.cmp__n,.cmp__v,.cmp__stop,.jstep__x,.jstep__t,.path__d,
.bw__n,.vm__n,.wr__n,.ctl__d,.reply__w,.freeb__v,
.dl__o,.dl__ul li,.dl__k,.mis__x,.mis__w,.post__x,.post__sub,.bel__x,
.pth__x,.pth__t,.tl2__p,.cg__p,.them__d,.qq__v,.ind__x,.two__l li,.two__f,
.rle__l,.outc__d,.relc__x,.qc__q,.who__d,.soon__v,.estat__d,.cstat__d,
.dim__n,.off__a{transition:color .24s var(--ease)}

/* ── deliverables as a table you can compare, not a wall you must read ── */
.dfilt{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:clamp(18px,2.2vw,26px)}
.dfb{display:inline-flex;align-items:center;gap:7px;font-family:var(--ui);font-size:13px;
  font-weight:600;padding:8px 14px;border-radius:999px;border:1px solid var(--hair);
  background:var(--card);color:var(--grey);cursor:pointer;
  transition:background .22s var(--ease),color .22s,border-color .22s,transform .2s var(--spring)}
.dfb:hover{border-color:#CFCBC1;color:var(--ink)}
.dfb:active{transform:scale(.96)}
.dfb.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.dfb i{font-family:var(--mono);font-style:normal;font-size:10px;opacity:.6}

.drs{display:grid;border-top:1px solid var(--hair)}
