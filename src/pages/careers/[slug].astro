.vms .vm:hover .vm__n{color:#fff}
.wrs .wr:hover .wr__n{color:#fff}
.freeb div:hover .freeb__v{color:var(--onc)}
.ctrls .ctl:hover .ctl__d{color:var(--onc2)}
.reply .reply__r:hover .reply__w{color:var(--onc2)}
.qa2__q:hover{color:var(--onc2)}

/* light grounds: body copy steps up toward ink */
.dls .dl:hover .dl__o{color:var(--ink)}
