  background:transparent;cursor:pointer;text-align:left;font:inherit;color:inherit;
  transition:opacity .26s var(--ease)}
.rail:hover .ph{opacity:.45}
.rail:hover .ph:hover,.ph.on{opacity:1}
.ph__dot{width:11px;height:11px;border-radius:50%;background:var(--card);
  border:1.5px solid #CFCBC1;position:absolute;left:0;bottom:-5.5px;z-index:2;
  transition:background .25s var(--ease),border-color .25s,transform .3s var(--spring)}
