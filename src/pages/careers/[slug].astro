<header class="ahead band" id="top"><div class="wrap">
  <p class="crumb" data-rv><a href="/careers">All roles</a> <i>/</i> {role.dept}</p>
  <div class="jd__top">
    <div>
      <h1>{role.title}</h1>
      <p class="jd__lead">{role.blurb}</p>
      <div class="jd__chips"><span>{role.dept}</span><span>{role.type}</span><span>{role.loc}</span><span>{role.mode}</span><span>{role.exp}</span><span>1 position</span></div>
      <div class="btns" style="margin-top:clamp(24px,2.8vw,34px)">
        <a href="#apply" class="btn btn--light">Apply for this role</a>
        <a href="#scored" class="btn btn--wire">What we score</a>
      </div>
    </div>
    <div class="jd__card">
      <p class="feat__k">Your scorecard, before you apply</p>
      <div class="cmpw"><span class="feat__glint"></span>
        <div class="cmpw__g">
          {rows.map((d, i) => (
            <div class:list={['bw', { key: i === 0 }]}><span class="bw__n">{d.n}</span><span class="bw__b"><span class="bw__f" style={`--w:${pct(d.w)}%`}></span></span><span class="bw__v">{d.w}%</span></div>
          ))}
        </div>
        <p class="cmpw__ft"><b>{top} carries {mx}%</b> in this role. You will be scored
        on all six, and you will see the numbers whether or not we make an offer.</p>
      </div>
    </div>
  </div>
</div></header>
<section class="band band--w" id="own"><div class="wrap">
  <div class="jd__two">
    <div><p class="jd__k">What you will own</p><ul class="jd__l">
      {role.own.map((x) => <li>{x}</li>)}
    </ul></div>
    <div><p class="jd__k">Why this role matters</p>
      <p class="jd__p">{role.why}</p></div>
  </div>
</div></section>
<section class="wrap band" id="scored">
  <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
    <div><p class="eyebrow eyebrow--red" data-rv>What we score</p>
      <h2 class="h2" data-rv style="--d:60ms;max-width:none;text-align:center">Six dimensions, and what each means here.</h2></div>
    <p class="dek" data-rv style="--d:100ms;max-width:none;text-align:center">Weighted for this role, agreed before anyone interviews.
    <b>The line under each one is roughly the question you will get.</b></p>
  </div>
  <div class="scs" data-rv style="--d:140ms">
    {rows.map((d, i) => (
      <div class:list={['sc', { 'sc--top': i === 0 }]}><div class="sc__hd"><span class="sc__n">{d.n}</span><span class="sc__v">{d.w}%</span></div><span class="sc__b"><span class="sc__f" style={`--w:${pct(d.w)}%`}></span></span><p class="sc__x">{role.scored[DIM.indexOf(d.n)]}</p></div>
    ))}
  </div>
</section>
<section class="band band--w" id="bring"><div class="wrap">
  <div class="jd__two">
    <div><p class="jd__k">What you bring</p><ul class="jd__l">
      {role.bring.map((x) => <li>{x}</li>)}
    </ul></div>
    <div><p class="jd__k">Nice to have</p><ul class="jd__l jd__l--soft">
      {role.nice.map((x) => <li>{x}</li>)}
    </ul>
      <p class="jd__note">Nice to have means nice to have. Nobody has been rejected here for a missing
      line in this column.</p></div>
  </div>
</div></section>
<section class="cand band" id="process"><div class="wrap">
  <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
    <div><p class="eyebrow eyebrow--red" data-rv>The process</p>
      <h2 class="h2" data-rv style="--d:60ms;max-width:none;text-align:center">Two weeks, four steps, no surprises.</h2></div>
    <p class="dek" data-rv style="--d:100ms;max-width:none;text-align:center">The same process we ask clients to pay for.
    <b>If we ran a worse one for ourselves you would be right to notice.</b></p>
  </div>
  <div class="hsteps" data-rv style="--d:140ms">
    <div class="hs"><span class="hs__d">Within 3 days</span><p class="hs__t">A reply either way</p>
      <p class="hs__x">Including a no, with a reason.</p></div>
    <div class="hs"><span class="hs__d">45 minutes</span><p class="hs__t">One conversation</p>
      <p class="hs__x">With an engineer who has built what you would be building. Questions from your CV,
      not from a list.</p></div>
    <div class="hs"><span class="hs__d">Same week</span><p class="hs__t">Your scores, shared</p>
      <p class="hs__x">Against the six above, weakest dimension named.
      <b>Yours whether or not we make an offer.</b></p></div>
    <div class="hs hs--end"><span class="hs__d">Two weeks</span><p class="hs__t">A decision</p>
      <p class="hs__x">One panel round, then an answer. No take-home that eats your weekend.</p></div>
  </div>
</div></section>
<section class="trust band" id="apply"><div class="wrap">
  <div class="sub">
    <p class="sub__k">Apply</p>
    <p class="sub__h">Send us the CV and one paragraph.</p>
    <p class="sub__s">{role.prompt}</p>
    <form class="apply__form" action="/.netlify/functions/careers-apply" method="post" enctype="multipart/form-data">
      <input type="hidden" name="role" value={role.slug}>
      <div class="apply__row apply__row--2">
        <input class="apply__mail" type="email" name="email" required placeholder="your@email.com"
               aria-label="Your email address">
        <button class="apply__go" type="submit" data-open-careers-apply>Apply<span class="apply__ar">→</span></button>
      </div>
    </form>
    <script is:inline>
      (function(){
        var f=document.querySelector('#apply .apply__form');
        if(!f) return;
        var go=f.querySelector('.apply__go'), mail=f.querySelector('.apply__mail');
        f.addEventListener('submit',function(e){ e.preventDefault(); if(go) go.click(); });
        if(go&&mail) go.addEventListener('click',function(){
          var m=document.getElementById('careersApplyForm');
          if(!m||!mail.value) return;
          var em=m.querySelector('input[name="email"]');
          if(em) em.value=mail.value;
        });
      })();
    </script>
    <p class="apply__fine">CV and paragraph on the next screen · <b>a reply within three days, either
    way</b> · read by a person, not a filter</p>
  </div>
  <p class="trust__ft" data-rv style="text-align:center;margin-left:auto;margin-right:auto">Not quite this role? <a href="/careers" style="color:var(--onc);
  text-decoration:underline;text-underline-offset:3px">The others are here</a>, and writing anyway is
  fine if you are specific about what you would want to own.</p>
</div></section>
<section class="band band--w" id="close"><div class="wrap" style="text-align:center">
