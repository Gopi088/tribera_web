(function(){
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;



  /* ══ THE DEAL: pick your volume, the shape resolves ══ */
  (function(){
    var V=[
      {nm:'Project-based',v:'10–50',d:'One role you\u2019re stuck on, or a burst of them — permanent, contract or executive.',
       p:['Per hire, 15–20%','Nothing owed until you hire','Your bar written on the first brief']},
      {nm:'Scale',v:'50–200',d:'Several functions running at once, with one bar carried across all of them.',
       p:['Volume rate per hire','A named expert bench for your stack','Your bar reused on every brief']},
      {nm:'Full RPO',v:'200–500+',d:'Your whole talent function, run alongside your team rather than outside it.',
       p:['Experts embedded in your team','Subscription plus a reduced rate','Quarterly recalibration of the bar']}
    ];
    var segs=[].slice.call(document.querySelectorAll('.vseg')),
        out=document.getElementById('volOut');
    if(!segs.length||!out) return;
    var nm=document.getElementById('volNm'), vv=document.getElementById('volV'),
        dd=document.getElementById('volD'), pts=document.getElementById('volPts');
    function pick(i){
      var s=V[i];
      segs.forEach(function(b,j){ b.classList.toggle('is',j===i);
        b.setAttribute('aria-selected',String(j===i)); });
      nm.textContent=s.nm;
      vv.innerHTML=s.v+' <span>hires a year</span>';
      dd.textContent=s.d;
      pts.innerHTML=s.p.map(function(t){return '<li>'+t+'</li>';}).join('');
      out.classList.remove('swap-in'); void out.offsetWidth; out.classList.add('swap-in');
    }
    segs.forEach(function(b,i){
      b.addEventListener('click',function(){pick(i);});
      b.addEventListener('mouseenter',function(){pick(i);});
    });
    pick(1);
  })();

  /* ══ THE LAB: the visitor moves the bar, the verdict follows ══ */
  (function(){
    var D=[
      {k:'A',n:'Core networking, TCP/IP',w:6.25,s:5},
      {k:'B',n:'Routing and BGP depth',w:6.25,s:5},
      {k:'C',n:'Data-centre networks',w:6.25,s:3},
      {k:'D',n:'Hybrid, DCI and WAN',w:3.75,s:4},
      {k:'E',n:'Troubleshooting and RCA',w:6.25,s:5},
      {k:'F',n:'Performance and optimisation',w:5.00,s:4},
      {k:'G',n:'Change and runbook discipline',w:5.00,s:4},
      {k:'H',n:'ISP and carrier coordination',w:2.50,s:4},
      {k:'I',n:'Operations and ownership',w:3.75,s:4},
      {k:'J',n:'Linux, scripting, automation',w:1.25,s:2},
      {k:'K',n:'Authenticity',w:3.75,s:4}
    ];
    var BASE=D.map(function(d){return d.w;});
    var PRE={
      brief:BASE.slice(),
      auto:[2,2,3,2,2,2,2,1,2,12,2],
      fabric:[2,2,12,2,2,2,2,1,2,3,2],
      ops:[7,7,1,3,9,5,8,3,7,0.5,4]
    };
    var NOTE={
      brief:'As briefed: fundamentals, troubleshooting and performance carry the weight. Automation is deliberately weighted so it cannot carry a profile.',
      auto:'Weight automation above everything and he drops out of Select. He scored 2 there, and it was the one thing he could not evidence. On this brief he is a no.',
      fabric:'Weight fabric depth and he falls to the bottom of Select. He describes the estate; he has not operated the fabric himself.',
      ops:'Weight the day job — troubleshooting, change discipline, ownership — and he climbs. That is where the evidence actually sat.'
    };
    var rows=document.getElementById('labRows'), tiles=document.getElementById('labTiles'),
        elScore=document.getElementById('labScore'), elBand=document.getElementById('labBand'),
        elPin=document.getElementById('labPin'), elTot=document.getElementById('labTotal'),
        elNote=document.getElementById('labNote');
    if(!rows) return;

    rows.innerHTML=D.map(function(d,i){
      return '<div class="row" id="row'+i+'" data-i="'+i+'"><span class="row__k">'+d.k+'</span>'+
        '<span class="row__n">'+d.n+'</span>'+
        '<input type="range" min="0" max="12" step="0.25" value="'+d.w+'" data-i="'+i+'" '+
        'aria-label="Weight for '+d.n+'">'+
        '<span class="row__p" id="pts'+i+'">0.00</span></div>';
    }).join('');
    tiles.innerHTML=D.map(function(d,i){
      return '<span class="lt'+(d.s<=2?' low':'')+'" id="tile'+i+'" data-i="'+i+'" style="--s:'+d.s+'" '+
        'tabindex="0" title="'+d.n+' — '+d.s+' of 5"><i>'+d.k+'</i><b>'+d.s+'</b></span>';
    }).join('');

    var shown=42, raf=null;
    function paint(){
      var tw=0, got=0, max=0;
      D.forEach(function(d){ tw+=d.w; got+=d.w*d.s/5; if(d.w>max) max=d.w; });
      var score = tw>0 ? (got/tw)*50 : 0;
      D.forEach(function(d,i){
        document.getElementById('pts'+i).textContent=(d.w*d.s/5).toFixed(2);
        var heavy = d.w >= Math.max(7, max*0.92);
        document.getElementById('row'+i).classList.toggle('heavy',heavy);
        document.getElementById('tile'+i).classList.toggle('heavy',heavy);
      });
      elTot.textContent=tw.toFixed(2);
      elPin.style.left=Math.max(1,Math.min(99,(score/50)*100))+'%';
      var band = score>=34?['SELECT','b-sel'] : score>=28?['GREY','b-grey'] : ['REJECT','b-rej'];
      elBand.textContent=band[0];
      elBand.className='verd__band '+band[1];
      /* count the number rather than snapping it */
      cancelAnimationFrame(raf);
      (function step(){
        var diff=score-shown;
        if(Math.abs(diff)<0.02){ shown=score; elScore.textContent=score.toFixed(2); return; }
        shown+=diff*0.22; elScore.textContent=shown.toFixed(2);
        raf=requestAnimationFrame(step);
      })();
    }

    /* hover either half, the other half answers */
    function link(i,on){
      var t=document.getElementById('tile'+i), r=document.getElementById('row'+i);
      if(t) t.classList.toggle('lit',on);
      if(r) r.classList.toggle('lit',on);
    }
    function bind(host,sel){
      host.addEventListener('mouseover',function(e){
        var el=e.target.closest(sel); if(el) link(+el.dataset.i,true); });
      host.addEventListener('mouseout',function(e){
        var el=e.target.closest(sel); if(el) link(+el.dataset.i,false); });
      host.addEventListener('focusin',function(e){
        var el=e.target.closest(sel); if(el) link(+el.dataset.i,true); });
      host.addEventListener('focusout',function(e){
        var el=e.target.closest(sel); if(el) link(+el.dataset.i,false); });
    }
    bind(tiles,'.lt');
    bind(rows,'.row');

    rows.addEventListener('input',function(e){
      var t=e.target; if(t.type!=='range') return;
      D[+t.dataset.i].w=parseFloat(t.value);
      document.querySelectorAll('.pre').forEach(function(b){b.classList.remove('on');});
      paint();
    });
    document.querySelectorAll('.pre').forEach(function(btn){
      btn.addEventListener('click',function(){
        var set=PRE[btn.dataset.pre];
        D.forEach(function(d,i){ d.w=set[i];
          rows.querySelector('input[data-i="'+i+'"]').value=set[i]; });
        document.querySelectorAll('.pre').forEach(function(b){b.classList.remove('on');});
        btn.classList.add('on');
        elNote.textContent=NOTE[btn.dataset.pre];
        paint();
      });
    });
    paint();
  })();

  /* the score tiles name themselves */
  var tiles=document.getElementById('tiles'), tcap=document.getElementById('tilesCap');
  if(tiles && tcap){
    var base=tcap.textContent;
    function show(t){ tcap.classList.add('is');
      tcap.innerHTML=t.dataset.n+' — <b style="color:#fff">'+t.dataset.s+' of 5</b>'; }
    function clear(){ tcap.classList.remove('is'); tcap.textContent=base; }
    tiles.addEventListener('mouseover',function(e){var t=e.target.closest('.tl'); if(t) show(t);});
    tiles.addEventListener('focusin',function(e){var t=e.target.closest('.tl'); if(t) show(t);});
    tiles.addEventListener('mouseleave',clear);
    tiles.addEventListener('focusout',clear);
  }

  /* the card behaves like an object: it tilts toward you and catches light */
  var cardWrap=document.querySelector('.hero__card'), tilt=document.getElementById('tilt');
  if(cardWrap && tilt && !reduce && matchMedia('(hover:hover) and (pointer:fine)').matches){
    var raf=null;
    cardWrap.addEventListener('pointermove',function(e){
      if(raf) return;
      raf=requestAnimationFrame(function(){
        raf=null;
        var r=cardWrap.getBoundingClientRect(),
            px=(e.clientX-r.left)/r.width, py=(e.clientY-r.top)/r.height;
        tilt.classList.add('live');
        tilt.style.setProperty('--ry',((px-.5)*11).toFixed(2)+'deg');
        tilt.style.setProperty('--rx',((.5-py)*8).toFixed(2)+'deg');
        cardWrap.querySelectorAll('.face').forEach(function(f){
          f.style.setProperty('--mx',(px*100).toFixed(1)+'%');
          f.style.setProperty('--my',(py*100).toFixed(1)+'%');
        });
      });
    });
    cardWrap.addEventListener('pointerleave',function(){
      tilt.classList.remove('live');
      tilt.style.setProperty('--ry','0deg'); tilt.style.setProperty('--rx','0deg');
    });
  }

  /* the card has two faces — demo the flip once, then it's yours */
  var flip=document.getElementById('flip'),
      tA=document.getElementById('tabA'), tB=document.getElementById('tabB'),
      fA=document.getElementById('faceA'), fB=document.getElementById('faceB'), took=false;
  function face(b){
    if(!flip) return;
    flip.classList.toggle('is-b', b);
    if(cardWrap) cardWrap.classList.toggle('is-flipped', b);
    tA.classList.toggle('is', !b); tB.classList.toggle('is', b);
    tA.setAttribute('aria-selected', String(!b)); tB.setAttribute('aria-selected', String(b));
    fA.setAttribute('aria-hidden', String(b)); fB.setAttribute('aria-hidden', String(!b));
  }
  if(flip&&cardWrap){
    tA.addEventListener('click',function(){took=true;face(false);});
    tB.addEventListener('click',function(){took=true;face(true);});
    cardWrap.addEventListener('click',function(e){if(e.target.closest('.ftab'))return;took=true;face(!flip.classList.contains('is-b'));});
    if(!reduce && 'IntersectionObserver' in window){
      new IntersectionObserver(function(es,ob){
        es.forEach(function(e){
          if(!e.isIntersecting) return; ob.disconnect();
          setTimeout(function(){ if(!took) face(true); }, 2600);
          setTimeout(function(){ if(!took) face(false); }, 5200);
        });
      },{threshold:.4}).observe(flip);
    }
  }
  var GROUPS=[[86,1],[26,2],[9,3],[3,4],[2,5]];
  var grid=document.getElementById('grid'), sqs=[];
  if(grid){
    var html='';
    GROUPS.forEach(function(g){for(var i=0;i<g[0];i++)
      html+='<span class="sq g'+g[1]+'" data-drop="'+g[1]+'"></span>';});
    grid.innerHTML=html; sqs=[].slice.call(grid.children);
  }


  var DOT={1:'#3A3A37',2:'#5A5A55',3:'#8A8A85',4:'#D8D8D3',5:'#DA0007'};
  /* hovering a STAGE shows everyone who got that far */
  var REACH={
    1:'<b>All 126.</b> Everything the requirement returned.',
    2:'<b>40 reached an expert interview.</b> Eighty-six never did.',
    3:'<b>14 cleared the bar</b> on their own answers.',
    4:'<b>5 names reached them</b> — the first people the team ever saw.',
    5:'<b>2 hired,</b> out of five interviews.'
  };
  /* hovering a SQUARE shows where that person stopped */
  var STOP={
    1:'<b>86 stopped here</b> — screened out before anyone spent time on them.',
    2:'<b>26 stopped here</b> — interviewed by an expert, didn\u2019t clear the bar.',
    3:'<b>9 stopped here</b> — cleared the bar, ranked below the top five.',
    4:'<b>3 stopped here</b> — sent, hireable, not chosen this time.',
    5:'<b>Hired.</b> One of the two.'
  };
  var REST={
    1:'126 people, shaded by how far each one got. <b>The two in red were hired.</b>',
    2:'<b>86 have dropped away.</b> Screened out before anyone spent time on them.',
    3:'<b>26 more gone.</b> Interviewed by a person, didn\u2019t clear the bar.',
    4:'<b>9 more.</b> Good — ranked below the top five. They never reached the team.',
    5:'<b>Two hired, out of five interviews.</b> Everything else never left our desk.'
  };

  var field=document.getElementById('field'),fN=document.getElementById('fieldN'),
      fL=document.getElementById('fieldLbl'),fF=document.getElementById('fieldFt'),stage=0;

  function setStage(n){
    if(n===stage||!sqs.length) return;
    stage=n;
    sqs.forEach(function(s){ s.classList.toggle('out', +s.dataset.drop < n); });
    field.classList.toggle('at5',n===5);
    var st=document.querySelector('.step[data-n="'+n+'"]');
    if(st){fN.textContent=st.dataset.count;fL.textContent=st.dataset.lbl;}
    fF.innerHTML=REST[n];
  }
  setStage(1);

  /* hover trace — subtle, on squares and on the step text */
  function peek(n, mode){
    if(!grid) return;
    var reached = mode !== 'stopped';
    grid.classList.add('peek');
    sqs.forEach(function(s){
      var d=+s.dataset.drop;
      s.classList.toggle('co', reached ? d>=n : d===n);
    });
    fF.innerHTML='<i style="background:'+DOT[n]+'"></i>'+(reached?REACH:STOP)[n];
  }
  function unpeek(){
    if(!grid) return;
    grid.classList.remove('peek');
    sqs.forEach(function(s){ s.classList.remove('co'); });
    fF.innerHTML=REST[stage];
  }
  if(grid){
    grid.addEventListener('mouseover',function(e){
      var s=e.target.closest('.sq'); if(s) peek(+s.dataset.drop,'stopped');
    });
    grid.addEventListener('mouseleave',unpeek);
  }

  var steps=[].slice.call(document.querySelectorAll('.step'));
  var userTook=false;
  steps.forEach(function(st){
    var n=+st.dataset.n;
    st.setAttribute('tabindex','0');
    st.setAttribute('role','button');
    function take(){ userTook=true; mark(n); }
    st.addEventListener('mouseenter',function(){ take(); peek(n,'reached'); });
    st.addEventListener('mouseleave',unpeek);
    st.addEventListener('focus',function(){ take(); peek(n,'reached'); });
    st.addEventListener('blur',unpeek);
    st.addEventListener('click',take);
    st.addEventListener('keydown',function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); take(); }
    });
  });

  function mark(n){
    steps.forEach(function(s){ s.classList.toggle('on', +s.dataset.n === n); });
    setStage(n);
  }

  /* it narrows itself once when you arrive — then it's yours to poke at */
  var fn=document.getElementById('run'), played=false;
  if(fn && steps.length && 'IntersectionObserver' in window){
    new IntersectionObserver(function(es,ob){
      es.forEach(function(e){
        if(!e.isIntersecting || played) return;
        played=true; ob.disconnect();
        if(reduce){ mark(5); return; }
        [2,3,4,5].forEach(function(n,i){
          setTimeout(function(){ if(!userTook) mark(n); }, 900 + i*780);
        });
      });
    },{threshold:.35}).observe(fn);
  } else if(steps.length){ mark(5); }

  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
  },{threshold:.14,rootMargin:'0px 0px -8% 0px'});
  document.querySelectorAll('[data-rv]').forEach(function(el){io.observe(el);});

  /* signal tags act as filters over the table */
  var swap=document.querySelector('.swap'), keyBar=document.querySelector('.key');
  if(swap && keyBar){
    var rows=[].slice.call(swap.querySelectorAll('.swap__row'));
    function apply(k){
      if(!k){ swap.classList.remove('dim');
        rows.forEach(function(r){ r.classList.remove('hit'); }); return; }
      var want=k.querySelector('.tag').textContent.trim().toLowerCase();
      swap.classList.add('dim');
      rows.forEach(function(r){
        var t=r.querySelector('.tag');
        r.classList.toggle('hit', !!t && t.textContent.trim().toLowerCase()===want);
      });
    }
    keyBar.querySelectorAll('.key__i').forEach(function(k){
      k.setAttribute('tabindex','0'); k.setAttribute('role','button');
      k.addEventListener('mouseenter',function(){ apply(k); });
    });
    /* one authority for clearing — the bar itself */
    keyBar.addEventListener('mouseleave',function(){ apply(null); });
    keyBar.addEventListener('focusin',function(e){
      var k=e.target.closest('.key__i'); apply(k||null);
    });
    keyBar.addEventListener('focusout',function(e){
      if(!keyBar.contains(e.relatedTarget)) apply(null);
    });
  }

  /* the tally draws once, slowly, then the three land at speed */
  var fan=document.querySelector('.fan'), tN=document.getElementById('tallyN');
  if(fan){
    new IntersectionObserver(function(es,ob){
      es.forEach(function(e){
        if(!e.isIntersecting) return;
        ob.disconnect();
        if(reduce) return;
        fan.classList.add('go');
        if(!tN) return;
        var t0=null, DUR=1800;
        tN.textContent='0';
        requestAnimationFrame(function step(ts){
          if(t0===null) t0=ts;
          var u=Math.min((ts-t0)/DUR,1);
          tN.textContent=Math.round(Math.pow(u,1/0.62)*140);
          if(u<1) requestAnimationFrame(step); else tN.textContent='140';
        });
      });
    },{threshold:.35}).observe(fan);
  }

  var deskBlk=document.querySelector('.desk');
  if(deskBlk) new IntersectionObserver(function(es,ob){
    es.forEach(function(e){ if(e.isIntersecting){ deskBlk.classList.add('in'); ob.disconnect(); } });
  },{threshold:.4}).observe(deskBlk);

  var ramp=document.getElementById('ramp');
  if(ramp) new IntersectionObserver(function(es,ob){
    es.forEach(function(e){ if(e.isIntersecting){ ramp.classList.add('in'); ob.disconnect(); } });
  },{threshold:.3}).observe(ramp);

  /* nav switcher reflects where you are */
  var cand=document.getElementById('candidates'),
      sw=[].slice.call(document.querySelectorAll('.nav__sw a')),
      bar=document.getElementById('stickcta'),
      applyBox=document.getElementById('apply');
  var onCandPage=sw.length>1&&(function(){try{return location.pathname.replace(/\/+$/,'')===new URL(sw[1].getAttribute('href')||'/',location.href).pathname.replace(/\/+$/,'');}catch(e){return false;}})();

  /* sticky apply bar: only while the candidate section is on screen,
     and never on top of the apply card itself */
  if(cand && bar && applyBox){
    var inSection=false, atForm=false;
    function sync(){ bar.classList.toggle('show', inSection && !atForm); }
    new IntersectionObserver(function(es){
      es.forEach(function(e){ inSection=e.isIntersecting; sync(); });
    },{threshold:.12}).observe(cand);
    new IntersectionObserver(function(es){
      es.forEach(function(e){ atForm=e.isIntersecting; sync(); });
    },{threshold:.3}).observe(applyBox);
  }

  /* a filename is better feedback than a silent upload */
  var fileIn=document.querySelector('.apply__file input');
  if(fileIn) fileIn.addEventListener('change',function(){
    var lbl=fileIn.parentNode.querySelector('span');
    if(fileIn.files && fileIn.files[0]) lbl.textContent=fileIn.files[0].name;
  });
})();


  /* ══ INDUSTRIES: the same six dimensions, any two sectors ══ */
  (function(){
    var W={"consumer-digital-commerce": {"n": "Consumer & digital commerce", "w": [30, 24, 8, 22, 6, 10]}, "banking-financial-services": {"n": "Banking & financial services", "w": [20, 14, 30, 10, 18, 8]}, "enterprise-technology": {"n": "Enterprise technology", "w": [26, 26, 10, 20, 10, 8]}, "product-saas": {"n": "Product & SaaS", "w": [22, 18, 6, 20, 8, 26]}, "ai-data": {"n": "AI & data", "w": [30, 26, 10, 16, 10, 8]}, "cybersecurity": {"n": "Cybersecurity", "w": [24, 16, 32, 12, 10, 6]}, "healthcare-life-sciences": {"n": "Healthcare & life sciences", "w": [18, 12, 30, 10, 22, 8]}, "pharmaceutical": {"n": "Pharmaceutical", "w": [16, 10, 34, 8, 24, 8]}, "manufacturing": {"n": "Manufacturing", "w": [22, 14, 22, 18, 14, 10]}, "industrial-engineering": {"n": "Industrial & engineering", "w": [24, 18, 18, 18, 14, 8]}, "global-capability-centres": {"n": "Global capability centres", "w": [22, 18, 12, 20, 10, 18]}, "private-equity-portfolio": {"n": "Private equity portfolio", "w": [20, 14, 10, 32, 8, 16]}};
    var D=["Core depth", "Systems design", "Controls and risk", "Delivery speed", "Documentation", "Stakeholder handling"];
    var a=document.getElementById('secA'), b=document.getElementById('secB'),
        ft=document.getElementById('cmpFt');
    if(!a||!b) return;
    function paint(){
      var A=W[a.value], B=W[b.value], mx=0, gap=-1, gi=0;
      D.forEach(function(_,i){ mx=Math.max(mx,A.w[i],B.w[i]);
        var g=Math.abs(A.w[i]-B.w[i]); if(g>gap){gap=g;gi=i;} });
      D.forEach(function(n,i){
        document.getElementById('fa'+i).style.width=(A.w[i]/mx*100)+'%';
        document.getElementById('fb'+i).style.width=(B.w[i]/mx*100)+'%';
        document.getElementById('va'+i).textContent=A.w[i];
        document.getElementById('vb'+i).textContent=B.w[i];
        document.getElementById('bw'+i).classList.toggle('key', i===gi);
      });
      if(A.n===B.n){ ft.innerHTML='Same sector both sides. <b>Pick two and the bar moves.</b>'; return; }
      var hi = A.w[gi]>B.w[gi] ? A : B;
      ft.innerHTML='<b>'+D[gi]+'</b> moves from '+Math.min(A.w[gi],B.w[gi])+'% to '+
        Math.max(A.w[gi],B.w[gi])+'% — a '+gap+'-point swing, and <b>a different person wins</b>.';
    }
    a.addEventListener('change',paint); b.addEventListener('change',paint); paint();
  })();

  /* ══ NAV: compacts on scroll, opens on small screens ══ */
  (function(){
    var nav=document.getElementById('nav'), b=document.querySelector('.burger'),
        p=document.getElementById('navp');
    if(nav){
      var tick=function(){ if(scrollY>20){ nav.classList.add('stuck'); } else if(scrollY<=2){ nav.classList.remove('stuck'); } };
      addEventListener('scroll',tick,{passive:true}); tick();
    }
    if(b&&p){
      function setNav(open){
        p.classList.toggle('open',open); b.classList.toggle('on',open);
        if(open){
          p.style.top=(nav.offsetHeight)+'px';
          var y=window.scrollY; document.body.dataset.sy=y;
          document.body.style.position='fixed'; document.body.style.width='100%';
          document.body.style.top='-'+y+'px'; document.body.style.left='0'; document.body.style.right='0';
        } else {
          var sy=Number(document.body.dataset.sy||0);
          document.body.style.position=''; document.body.style.width='';
          document.body.style.top=''; document.body.style.left=''; document.body.style.right='';
          window.scrollTo(0,sy); delete document.body.dataset.sy;
        }
        b.setAttribute('aria-expanded',String(open));
      }
      b.addEventListener('click',function(){
        setNav(!p.classList.contains('open'));
      });
      p.addEventListener('click',function(e){ if(e.target.tagName==='A'||e.target===p) setNav(false); });
      addEventListener('keydown',function(e){ if(e.key==='Escape'&&p.classList.contains('open')) setNav(false); });
    }
  })();
    var t=document.querySelector('.navp__t'), c=document.getElementById('navp-cov');
    if(t&&c){ t.addEventListener('click',function(){
      var o=c.classList.toggle('open'); t.setAttribute('aria-expanded',String(o)); }); }

