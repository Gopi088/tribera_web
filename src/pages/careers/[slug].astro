.jd__chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:clamp(20px,2.4vw,28px)}
.jd__chips span{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;
