  .fan__side--own:hover .tally .tk{opacity:1}
  .tl2__g:hover .tl2{opacity:1}
}

/* ════════ BLOG ════════ */
.hero h1 em{font-style:normal;color:var(--red)}

/* the latest piece, as an object */
