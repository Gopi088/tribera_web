.hn{color:#C9C5BB}.hy{color:var(--red)}.hp{color:#B9A45E}
.chip--wide{grid-template-columns:1fr auto;align-items:center;gap:16px}
.always{margin-top:16px}

.det{margin-top:clamp(22px,2.6vw,32px);padding:clamp(22px,2.6vw,32px);background:var(--card);
  border:1px solid var(--hair);border-top:2px solid var(--red);border-radius:2px 2px 18px 18px;
