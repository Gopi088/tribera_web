.dd__p--sm span{display:block;font-size:12px;line-height:1.4;color:var(--onc3)}

.navp a:not(.btn){display:flex;align-items:center;gap:11px;font-family:var(--display);font-weight:600;font-size:19px;letter-spacing:-.026em;color:var(--onc2);text-decoration:none;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.06);transition:color .2s var(--ease)}
.navp a:not(.btn):hover{color:#fff}
html body .navp .navp__sw a{display:flex;align-items:center;justify-content:center;text-align:center;padding:10px 8px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);color:var(--onc2);font-family:var(--display);font-weight:600;font-size:13px;letter-spacing:normal;text-decoration:none;transition:background .25s var(--ease),color .2s}
html body .navp .navp__sw a:hover{color:#fff;background:rgba(255,255,255,.11)}

.navp a[aria-current="page"]{color:#fff}
.navp__login{color:var(--red)!important;font-weight:600}
.navp__t{display:flex;align-items:center;justify-content:space-between;width:100%;padding:7px 0;background:none;border:0;cursor:pointer;font-family:inherit;font-size:13px;font-weight:500;color:var(--onc2);text-align:left;transition:color .2s var(--ease)}
.navp__t:hover{color:#fff}
.navp__t i{width:8px;height:8px;border-right:1.5px solid var(--onc3);border-bottom:1.5px solid var(--onc3);transform:rotate(45deg);transition:transform .25s var(--ease);margin-right:6px;flex:none}
.navp__t[aria-expanded="true"] i{transform:rotate(-135deg)}
.navp__cov{display:none;padding:2px 0 8px 12px;border-left:1px solid rgba(255,255,255,.08)}
.navp__cov.open{display:block}
.navp__cols{display:grid;gap:0}
@media(min-width:520px){.navp__cols{grid-template-columns:1fr 1fr;column-gap:28px}}
.navp__c .navp__k{margin-top:12px}
.navp__cols .navp__c:first-child .navp__k{margin-top:0}
@media(min-width:520px){.navp__cols .navp__c+.navp__c .navp__k{margin-top:0}}
.navp a[aria-current="page"]{color:#fff}
.navp a[aria-current="page"]::before{background:var(--red);transform:scale(1)}
.navp .btn{color:var(--char)}
.navp .btn--wire{color:#fff}

.ind{display:grid;align-content:start;grid-template-rows:auto auto 1fr auto;gap:10px}
.isp{margin:0 0 2px}
.ind__w{margin-top:0;align-self:end}
/* ════════ INDUSTRIES ════════ */
.hero h1 em{font-style:normal;color:var(--red)}

/* hero card: one title, two sectors */
.cmpw{position:relative;background:linear-gradient(158deg,#232320,#1A1A18 46%,#141413);
  border:1px solid #33332E;border-radius:18px;padding:clamp(20px,2.2vw,26px);overflow:hidden;
  box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 24px 56px rgba(0,0,0,.45)}

.cmpw__sel{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding-bottom:16px;
  border-bottom:1px solid var(--cline);margin-bottom:6px}
.sel{display:grid;gap:6px}
.sel>span{font-family:var(--mono);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--onc3)}
.sel--b>span{color:var(--red)}
.sel select{appearance:none;-webkit-appearance:none;width:100%;font-family:var(--ui);font-size:13px;
  color:#fff;background:rgba(255,255,255,.06);border:1px solid var(--cline);border-radius:9px;
  padding:9px 26px 9px 11px;cursor:pointer;outline:none;
  background-image:linear-gradient(45deg,transparent 50%,#9C9C97 50%),
    linear-gradient(135deg,#9C9C97 50%,transparent 50%);
  background-position:calc(100% - 14px) 50%,calc(100% - 9px) 50%;
  background-size:5px 5px,5px 5px;background-repeat:no-repeat;
  transition:border-color .2s,background-color .2s}
.sel select:hover{border-color:#4A4A44}
.sel select:focus{border-color:var(--onc2)}
.sel select option{background:#1A1A18;color:#fff}
.bw{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:center;
  padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05);
  transition:opacity .28s var(--ease)}
.cmpw__g:hover .bw{opacity:.5}
.cmpw__g:hover .bw:hover,.bw.key{opacity:1}
.bw__n{font-size:12px;color:var(--onc3);line-height:1.25}
.bw.key .bw__n{color:#fff}
.bw__pair{display:grid;gap:4px}
.bw__b{height:5px;border-radius:3px;background:rgba(255,255,255,.09);overflow:hidden}
.bw__f{display:block;height:100%;width:0;border-radius:3px;background:#7E7A72;
  transition:width .55s var(--ease),background .3s var(--ease)}
.bw__f--b{background:#B4B0A6}
.bw.key .bw__f{background:#C9C9C2}
.bw.key .bw__f--b{background:var(--red);box-shadow:0 0 10px rgba(218,0,7,.5)}
.bw__v{font-family:var(--mono);font-size:10.5px;color:var(--onc3);text-align:right;line-height:1.5}
.bw__v i,.bw__v b{display:block;font-style:normal}
.bw__v b{color:#fff;font-weight:400}
.bw.key .bw__v b{color:var(--red);font-weight:700}

.cmpw__ft{font-size:12.5px;line-height:1.55;color:var(--onc3);margin:16px 0 0;padding-top:14px;
  border-top:1px solid var(--cline)}
.cmpw__ft b{color:#fff;font-weight:600}

/* the twelve */
.inds2{display:grid;gap:14px}
@media(min-width:700px){.inds2{grid-template-columns:repeat(2,1fr);gap:16px}}
@media(min-width:1080px){.inds2{grid-template-columns:repeat(3,1fr)}}
.ind{display:grid;align-content:start;gap:10px;padding:20px;text-decoration:none;color:inherit;
  background:var(--card);border:1px solid var(--hair);border-top:2px solid #DCD8CE;
  border-radius:2px 2px 14px 14px;
  transition:opacity .28s var(--ease),transform .28s var(--spring),
  box-shadow .28s var(--ease),border-top-color .28s var(--ease)}
.inds2:hover .ind{opacity:.5}
.inds2:hover .ind:hover{opacity:1;transform:translateY(-4px);border-top-color:var(--red);
  box-shadow:0 12px 30px rgba(0,0,0,.07)}
.ind__hd{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.ind__n{font-family:var(--display);font-weight:700;font-size:17px;line-height:1.2;
  letter-spacing:-.028em;text-wrap:balance}
.ind__ar{color:var(--red);font-family:var(--mono);flex:none;opacity:0;
  transition:opacity .25s,transform .3s var(--spring)}
.ind:hover .ind__ar{opacity:1;transform:translateX(3px)}
.ind__x{font-size:13.5px;line-height:1.5;color:var(--grey);text-wrap:pretty}
.ind__w{display:block;margin-top:4px;padding-top:12px;border-top:1px solid var(--hair);
  font-size:13.5px;line-height:1.45;color:var(--ink2);font-weight:600}
.ind__w i{display:block;font-family:var(--mono);font-style:normal;font-size:8.5px;
  letter-spacing:.16em;text-transform:uppercase;color:var(--faint);font-weight:400;margin-bottom:5px}

/* each sector's weighting, as a shape you can scan */
.isp{display:block;width:66px;height:26px;margin-bottom:2px;opacity:.85;
  transition:opacity .28s var(--ease),transform .3s var(--spring)}
.ind:hover .isp{opacity:1;transform:translateY(-2px)}
.ind{grid-template-rows:auto auto auto 1fr}
.ind__w{margin-top:auto}


/* ════════ INDUSTRY DETAIL ════════ */
.hero h1 em{font-style:normal;color:var(--red)}
.crumb{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--onc3);margin:0 0 clamp(20px,2.4vw,30px)}
.crumb a{color:var(--onc2);text-decoration:none;border-bottom:1px solid var(--cline);padding-bottom:2px}
.crumb a:hover{color:#fff;border-color:var(--onc2)}
.crumb i{font-style:normal;opacity:.4;margin:0 6px}

/* what a CV cannot tell you */
.miss{display:grid;border-top:1px solid var(--hair)}
.mis{display:grid;grid-template-columns:52px 1fr;gap:6px 20px;padding:clamp(20px,2.2vw,26px) 12px;
  margin-inline:-12px;border-bottom:1px solid var(--hair);border-radius:10px;align-items:start;
  transition:background .24s var(--ease),opacity .26s var(--ease),transform .26s var(--spring)}
.miss:hover .mis{opacity:.48}
.miss:hover .mis:hover{opacity:1;background:rgba(0,0,0,.03);transform:translateX(3px)}
.mis__n{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--red)}
.mis__t{font-family:var(--display);font-weight:700;font-size:clamp(18px,1.9vw,22px);line-height:1.2;
  letter-spacing:-.03em;margin:0;text-wrap:balance}
.mis__k{font-family:var(--mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--faint);margin:6px 0 10px}
.mis__x{font-size:14.5px;line-height:1.6;color:var(--grey);margin:0 0 10px;max-width:62ch;
  text-wrap:pretty}
.mis__w{font-size:14px;line-height:1.55;color:var(--ink2);margin:0;padding-top:10px;
  border-top:1px solid var(--hair);max-width:62ch;font-weight:500}

/* the questions */
.qqs{display:grid;gap:16px}
.qq{padding:clamp(20px,2.2vw,26px);background:var(--card);border:1px solid var(--hair);
  border-top:2px solid var(--ink);border-radius:2px 2px 16px 16px;
  transition:opacity .28s var(--ease),transform .28s var(--spring),box-shadow .28s var(--ease),
  border-top-color .28s}
.qqs:hover .qq{opacity:.5}
.qqs:hover .qq:hover{opacity:1;transform:translateY(-3px);border-top-color:var(--red);
  box-shadow:0 12px 30px rgba(0,0,0,.07)}
.qq__q{display:flex;gap:14px;align-items:baseline;font-family:var(--display);font-weight:700;
  font-size:clamp(17px,1.9vw,21px);line-height:1.3;letter-spacing:-.028em;margin:0 0 18px;
  text-wrap:balance}
.qq__q span{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--red);flex:none}
.qq__g{display:grid;gap:16px 30px}
@media(min-width:820px){.qq__g{grid-template-columns:.9fr 1.1fr}}
.qq__b{padding-left:18px;position:relative}
.qq__b::before{content:"";position:absolute;left:0;top:4px;bottom:2px;width:2px;border-radius:1px}
.qq__b--weak::before{background:#DCD8CE}
.qq__b--for::before{background:var(--red)}
.qq__k{font-family:var(--mono);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--faint);display:block;margin-bottom:6px}
.qq__v{font-size:14.5px;line-height:1.6;color:var(--ink2);margin:0;text-wrap:pretty}
.qq__b--weak .qq__v{color:var(--faint);font-style:italic}

/* roles */
.rles{display:grid;gap:1px;background:var(--hair);border:1px solid var(--hair);border-radius:14px;
  overflow:hidden}
@media(min-width:620px){.rles{grid-template-columns:repeat(2,1fr)}}
@media(min-width:960px){.rles{grid-template-columns:repeat(4,1fr)}}
.rle{background:var(--card);padding:17px 18px;transition:background .22s var(--ease)}
.rle:hover{background:#FAFAF8}
.rle__n{font-family:var(--display);font-weight:600;font-size:15px;letter-spacing:-.02em;margin:0}
.rle__l{font-family:var(--mono);font-size:10.5px;color:var(--faint);margin:5px 0 0}
.rles__ft{font-size:14px;color:var(--grey);margin:18px 0 0}
.rles__ft a{color:var(--red);text-decoration:none;border-bottom:1px solid rgba(218,0,7,.35)}
.rles__ft a:hover{border-color:var(--red)}

/* faq on a light ground */
.qas--l{border-top-color:var(--hair)}
.qas--l .qa2{border-bottom-color:var(--hair)}
.qas--l .qa2__q{color:var(--ink)}
.qas--l .qa2__q:hover{color:var(--grey)}
.qas--l .qa2__a{color:var(--grey)}
.close.fn h2{color:#fff}

/* ════════ SERVICES ════════ */
.hero h1 em{font-style:normal;color:var(--red)}
.syms{display:grid;gap:5px;padding-bottom:16px;border-bottom:1px solid var(--cline)}
.sym{display:grid;gap:2px;text-align:left;padding:10px 12px;margin-inline:-12px;border:0;
  border-radius:9px;background:transparent;cursor:pointer;font:inherit;color:inherit;
  transition:background .22s var(--ease),transform .2s var(--spring)}
.sym:hover{background:rgba(255,255,255,.05)}
.sym:active{transform:scale(.985)}
.sym.on{background:rgba(255,255,255,.09)}
.sym__t{font-family:var(--display);font-weight:600;font-size:14px;letter-spacing:-.02em;
  color:var(--onc2);line-height:1.3}
.sym.on .sym__t{color:#fff}
.sym__d{font-size:12px;line-height:1.4;color:var(--onc3)}
.sym:focus-visible{outline:2px solid var(--red);outline-offset:-2px}
.rec{padding-top:16px}
.rec__k{font-family:var(--mono);font-size:8.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--red);margin:0 0 8px}
.rec__n{font-family:var(--display);font-weight:700;font-size:17px;letter-spacing:-.026em;color:#fff;
  margin:0 0 8px;min-height:1.3em}
.rec__x{font-size:13px;line-height:1.6;color:var(--onc3);margin:0;min-height:calc(4 * 1.6em)}
.rec.swap .rec__n,.rec.swap .rec__x,.rec.swap .rec__s{animation:recIn .38s var(--ease) both}
@keyframes recIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}

/* engine and bench */
.two{display:grid;gap:18px}
@media(min-width:880px){.two{grid-template-columns:repeat(2,1fr);gap:24px}}
.two__c{padding:clamp(22px,2.4vw,30px);background:var(--card);border:1px solid var(--hair);
  border-top:2px solid #B8B4AA;border-radius:2px 2px 16px 16px;
  transition:opacity .28s var(--ease),transform .28s var(--spring),box-shadow .28s var(--ease)}
.two__c--b{border-top-color:var(--red)}
.two:hover .two__c{opacity:.55}
.two:hover .two__c:hover{opacity:1;transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,0,0,.07)}
.two__k{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--faint);margin:0 0 10px;display:flex;gap:8px;align-items:baseline}
.two__k i{font-style:normal;color:var(--red);font-size:8.5px}
.two__t{font-family:var(--display);font-weight:700;font-size:clamp(19px,2vw,24px);letter-spacing:-.032em;
  margin:0 0 16px}
.two__l{list-style:none;margin:0 0 16px;padding:0;display:grid}
.two__l li{position:relative;padding:11px 0 11px 20px;font-size:14.5px;line-height:1.5;color:var(--ink2);
  border-top:1px solid var(--hair)}
.two__l li::before{content:"";position:absolute;left:0;top:1.15em;width:7px;height:7px;border-radius:50%;
  background:#CFCBC1}
.two__c--b .two__l li::before{background:var(--red)}
.two__f{font-size:13.5px;line-height:1.55;color:var(--grey);margin:0;padding-top:14px;
  border-top:1px solid var(--hair)}
.two__ft{font-size:15px;line-height:1.65;color:var(--grey);margin:clamp(22px,2.6vw,32px) 0 0;max-width:74ch}
.two__ft b{color:var(--ink);font-weight:600}

/* deliverables */
.dlvs{display:grid;gap:16px}
@media(min-width:760px){.dlvs{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1140px){.dlvs{grid-template-columns:repeat(3,1fr)}}
.dlv{display:grid;align-content:start;padding:22px;background:var(--card);border:1px solid var(--hair);
  border-top:2px solid #DCD8CE;border-radius:2px 2px 14px 14px;
  transition:opacity .28s var(--ease),transform .28s var(--spring),box-shadow .28s var(--ease),
  border-top-color .28s var(--ease)}
.dlvs:hover .dlv{opacity:.48}
.dlvs:hover .dlv:hover{opacity:1;transform:translateY(-4px);border-top-color:var(--red);
  box-shadow:0 12px 30px rgba(0,0,0,.07)}

.dlv__hd{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:10px}
.dlv__n{font-family:var(--display);font-weight:700;font-size:17.5px;letter-spacing:-.028em;margin:0}
.dlv__t{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;color:var(--red);
  white-space:nowrap;text-align:right}
.dlv__o{font-size:14px;line-height:1.55;color:var(--ink2);margin:0 0 14px;font-weight:500;
  text-wrap:pretty}
.dlv__l{list-style:none;margin:0 0 14px;padding:0;display:grid}
.dlv__l li{position:relative;padding:8px 0 8px 18px;font-size:13px;line-height:1.45;color:var(--grey);
  border-top:1px solid var(--hair)}
.dlv__l li::before{content:"";position:absolute;left:0;top:1.05em;width:6px;height:6px;border-radius:50%;
  background:#D6D2C8}
.dlv__k{font-size:12.5px;line-height:1.5;color:var(--faint);margin:auto 0 0;padding-top:12px;
  border-top:1px solid var(--hair)}

.arm{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;
  font-size:14.5px;color:var(--grey);margin:clamp(26px,3vw,38px) 0 16px;
  padding-bottom:12px;border-bottom:1px solid var(--hair)}
.arm:first-of-type{margin-top:0}
.arm span{font-family:var(--display);font-weight:700;font-size:clamp(19px,2.1vw,25px);
  letter-spacing:-.032em;color:var(--ink)}
.arm--b span{color:var(--red)}

/* the diagnostic, one line per symptom */
.syms{display:grid;gap:1px;padding-bottom:14px;border-bottom:1px solid var(--cline)}
.sym{display:block;text-align:left;padding:9px 12px;margin-inline:-12px;border:0;border-radius:8px;
  background:transparent;cursor:pointer;color:var(--onc2);
  font-family:var(--display);font-weight:600;font-size:13.5px;letter-spacing:-.018em;line-height:1.35;
  transition:background .2s var(--ease),color .2s,transform .18s var(--spring)}
.sym:hover{background:rgba(255,255,255,.05);color:#fff}
.sym:active{transform:scale(.985)}
.sym.on{background:rgba(255,255,255,.1);color:#fff}
.sym:focus-visible{outline:2px solid var(--red);outline-offset:-2px}
.rec{padding-top:14px}
.rec__s{font-size:12.5px;line-height:1.45;color:var(--onc3);margin:0 0 10px;font-style:italic}
.rec__n{font-family:var(--display);font-weight:700;font-size:16px;letter-spacing:-.026em;color:#fff;
  margin:0 0 8px;min-height:1.3em}
.rec__x{font-size:12.5px;line-height:1.6;color:var(--onc3);margin:0;min-height:calc(3 * 1.6em)}

/* deliverables as rows */
.dls{display:grid;border-top:1px solid var(--hair)}
.dl{display:grid;gap:10px 34px;padding:clamp(20px,2.2vw,26px) 12px;margin-inline:-12px;
  border-bottom:1px solid var(--hair);border-radius:10px;align-items:start;
  transition:background .24s var(--ease),opacity .26s var(--ease),transform .26s var(--spring)}
@media(min-width:880px){.dl{grid-template-columns:264px 1fr}}
.dls:hover .dl{opacity:.46}
.dls:hover .dl:hover,.dl.lit{opacity:1}
.dls:hover .dl:hover{background:rgba(0,0,0,.03);transform:translateX(3px)}
.dl.lit{background:rgba(0,0,0,.035);box-shadow:inset 2px 0 0 var(--red)}
.dl__n{font-family:var(--display);font-weight:700;font-size:clamp(18px,1.9vw,21px);line-height:1.2;
  letter-spacing:-.03em;margin:0}
.dl__t{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--red);margin:7px 0 0}
.dl__k{font-size:12.5px;line-height:1.5;color:var(--faint);margin:10px 0 0;max-width:34ch}
.dl__o{font-size:15px;line-height:1.55;color:var(--ink);font-weight:500;margin:0 0 12px;
  max-width:62ch;text-wrap:pretty}
.dl__ul{list-style:none;margin:0;padding:0;display:grid;gap:0}
@media(min-width:1000px){.dl__ul{grid-template-columns:repeat(2,1fr);column-gap:28px}}
.dl__ul li{position:relative;padding:7px 0 7px 17px;font-size:13.5px;line-height:1.45;color:var(--grey)}
.dl__ul li::before{content:"";position:absolute;left:0;top:.95em;width:5px;height:5px;border-radius:50%;
  background:#D2CEC4}
.arm{margin-top:clamp(30px,3.4vw,44px)}
/* what happens after */
.paths2{display:grid;gap:clamp(24px,3vw,44px)}
@media(min-width:880px){.paths2{grid-template-columns:repeat(2,1fr)}}
.pth__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--red);margin:0 0 16px}
.pth__l{display:grid;border-top:1px solid var(--hair)}
.pth__s{padding:15px 12px;margin-inline:-12px;border-bottom:1px solid var(--hair);border-radius:9px;
  transition:background .24s var(--ease),opacity .26s var(--ease),transform .26s var(--spring)}
.pth__l:hover .pth__s{opacity:.5}
.pth__l:hover .pth__s:hover{opacity:1;background:rgba(0,0,0,.03);transform:translateX(3px)}
.pth__d{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--faint);display:block;margin-bottom:5px}
.pth__s--end .pth__d{color:var(--red)}
