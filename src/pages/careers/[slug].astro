---
import V9Layout from '~/layouts/V9Layout.astro';
import Content from '~/components/v9/content/Content.astro';
import { publicLinks } from '~/data/v9/preview-links';
import { CAREER_ROLES, CAREER_DIMENSIONS } from '../../data/careers';

export const getStaticPaths = (() => {
  return CAREER_ROLES.map((r) => ({ params: { slug: r.slug }, props: { role: r } }));
}) satisfies import('astro').GetStaticPaths;

const { role } = Astro.props;
const DIM = CAREER_DIMENSIONS;
const rows = role.w.map((w, i) => ({ n: DIM[i], w }));
const mx = Math.max(...role.w);
const top = rows.find((row) => row.w === mx)!.n;
const metaDesc = `${role.blurb} ${role.loc}, ${role.mode.toLowerCase()}, ${role.exp}, with the scorecard published before you apply.`;
---

<V9Layout
  title={`${role.title} — tribera`}
  description={metaDesc}
  headerLinkOverrides={publicLinks}
  footerLinkOverrides={publicLinks}
>
  <Content kind="careers">
    <header class="ahead band">
      <div class="wrap">
        <p class="crumb" data-v9-reveal><a href="/careers">All roles</a> <i>/</i> {role.dept}</p>
        <div class="jd__top">
          <div>
            <h1>{role.title}</h1>
            <p class="jd__lead">{role.blurb}</p>
            <div class="jd__chips">
              <span>{role.dept}</span><span>{role.type}</span><span
                >{[role.neighborhood, role.loc].filter(Boolean).join(', ')}</span
              ><span>{role.mode}</span><span>{role.exp}</span><span>1 position</span>
            </div>
            <div class="btns" style="margin-top:clamp(24px,2.8vw,34px)">
              <a href="#apply" class="btn btn--light">Apply for this role</a>
              <a href="#scored" class="btn btn--wire">What we score</a>
            </div>
          </div>
          <div class="jd__card">
            <p class="feat__k">Your scorecard, before you apply</p>
            <div class="cmpw">
              <span class="feat__glint"></span>
              <div class="cmpw__g">
                {
                  rows.map((d) => (
                    <div class:list={['bw', { key: d.w === mx }]}>
                      <>
                        <span class="bw__n">{d.n}</span>
                        <span class="bw__b">
                          <span class="bw__f" style={`--w:${d.w}%`} />
                        </span>
                        <span class="bw__v">{d.w}%</span>
                      </>
                    </div>
                  ))
                }
              </div>
              <p class="cmpw__ft">
                <b>{top} carries {mx}%</b> in this role. You will be scored on all six, and you will see the numbers whether
                or not we make an offer.
              </p>
            </div>
          </div>
        </div>
      </div>
    </header>
    <section class="band band--w" id="own">
      <div class="wrap">
        <div class="jd__two">
          <div>
            <p class="jd__k">What you will own</p><ul class="jd__l">
              {role.own.map((x) => <li>{x}</li>)}
            </ul>
          </div>
          <div>
            <p class="jd__k">Why this role matters</p>
            <p class="jd__p">{role.why}</p>
          </div>
        </div>
      </div>
    </section>
    <section class="wrap band" id="scored">
      <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
        <div>
          <p class="eyebrow eyebrow--red" data-v9-reveal>What we score</p>
          <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;text-align:center">
            Six dimensions, and what each means here.
          </h2>
        </div>
        <p class="dek" data-v9-reveal style="--d:100ms;max-width:none;text-align:center">
          Weighted for this role, agreed before anyone interviews.
          <b>The line under each one is roughly the question you will get.</b>
        </p>
      </div>
      <div class="scs" data-v9-reveal style="--d:140ms">
        {
          rows.map((d) => (
            <div class:list={['sc', { 'sc--top': d.w === mx }]}>
              <>
                <div class="sc__hd">
                  <>
                    <span class="sc__n">{d.n}</span>
                    <span class="sc__v">{d.w}%</span>
                  </>
                </div>
                <span class="sc__b">
                  <span class="sc__f" style={`--w:${d.w}%`} />
                </span>
                <p class="sc__x">{role.scored[DIM.indexOf(d.n)]}</p>
              </>
            </div>
          ))
        }
      </div>
    </section>
    <section class="band band--w" id="bring">
      <div class="wrap">
        <div class="jd__two">
          <div>
            <p class="jd__k">What you bring</p><ul class="jd__l">
              {role.bring.map((x) => <li>{x}</li>)}
            </ul>
          </div>
          <div>
            <p class="jd__k">Nice to have</p><ul class="jd__l jd__l--soft">
              {role.nice.map((x) => <li>{x}</li>)}
            </ul>
            <p class="jd__note">
              Nice to have means nice to have. Nobody has been rejected here for a missing line in this column.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="cand band" id="process">
      <div class="wrap">
        <div class="shead" style="grid-template-columns:1fr;text-align:center;justify-items:center;gap:8px">
          <div>
            <p class="eyebrow eyebrow--red" data-v9-reveal>The process</p>
            <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;text-align:center">
              Two weeks, four steps, no surprises.
            </h2>
          </div>
          <p class="dek" data-v9-reveal style="--d:100ms;max-width:none;text-align:center">
            The same process we ask clients to pay for.
            <b>If we ran a worse one for ourselves you would be right to notice.</b>
          </p>
        </div>
        <div class="hsteps" data-v9-reveal style="--d:140ms">
          <div class="hs">
            <span class="hs__d">Within 3 days</span><p class="hs__t">A reply either way</p>
            <p class="hs__x">Including a no, with a reason.</p>
          </div>
          <div class="hs">
            <span class="hs__d">45 minutes</span><p class="hs__t">One conversation</p>
            <p class="hs__x">
              With someone who has done the work you would be doing. Questions from your CV, not from a list.
            </p>
          </div>
          <div class="hs">
            <span class="hs__d">Same week</span><p class="hs__t">Your scores, shared</p>
            <p class="hs__x">
              Against the six above, weakest dimension named.
              <b>Yours whether or not we make an offer.</b>
            </p>
          </div>
          <div class="hs hs--end">
            <span class="hs__d">Two weeks</span><p class="hs__t">A decision</p>
            <p class="hs__x">One panel round, then an answer. No take-home that eats your weekend.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="trust band" id="apply">
      <div class="wrap">
        <div class="sub">
          <p class="sub__k">Apply</p>
          <p class="sub__h">Send us the CV and one paragraph.</p>
          <p class="sub__s">{role.prompt}</p>
          <div class="btns">
            <a
              class="btn"
              href={`mailto:careers@tribera.ai?subject=${encodeURIComponent(`Application: ${role.title}`)}`}
              data-open-careers-apply>Apply for this role &rarr;</a
            >
          </div>
          <p class="apply__fine">
            CV and paragraph in the application form · <b>a reply within three days, either way</b> · read by a person, not
            a filter
          </p>
        </div>
        <p class="trust__ft">
          Not quite this role? <a href="/careers">The others are here</a>, and writing anyway is fine if you are
          specific about what you would want to own.
        </p>
      </div>
    </section>
    <section class="band band--w" id="contact">
      <div class="wrap" style="text-align:center">
        <p class="eyebrow eyebrow--red" data-v9-reveal>Either way</p>
        <h2 class="h2" data-v9-reveal style="--d:60ms;max-width:none;text-align:center">Someone will write back.</h2>
        <p class="dek" data-v9-reveal style="--d:100ms;max-width:none;text-align:center">
          That is the whole promise of this page, and it is the one thing we would be most embarrassed to get wrong. <b
            >Silence isn’t a process.</b
          >
        </p>
        <div class="btns" data-v9-reveal style="--d:110ms;justify-content:center">
          <a href="/careers" class="btn btn--dark">See all roles</a>
          <a href="/contact" class="btn btn--ghost">Ask a question</a>
        </div>
      </div>
    </section>

    <dialog id="careersApplyModal" class="apm" aria-labelledby="application-title">
      <div class="apply apm__panel">
        <button id="closeCareersApplyModal" class="apm__x" type="button" aria-label="Close">&times;</button>
        <p class="apply__k">Apply</p>
        <h2 class="apply__h" id="application-title">Apply for {role.title}</h2>
        <p class="apply__s">Share your details and resume. Every application is read by a person, not a filter.</p>
        <form
          id="careersApplyForm"
          class="apply__form"
          action="/.netlify/functions/careers-apply"
          method="POST"
          enctype="multipart/form-data"
        >
          <input type="hidden" name="job_title" value={role.title} />
          <input type="hidden" name="job_slug" value={role.slug} />
          <input type="hidden" name="department" value={role.dept} />
          <input type="hidden" name="form_loaded_at" value="" data-form-loaded-at />
          <input type="checkbox" name="botcheck" class="apm__hp" tabindex="-1" aria-hidden="true" />
          <div class="apm__fields">
            <div class="apm__grid">
              <label>Full name *<input class="apply__url" type="text" name="name" autocomplete="name" required /></label
              >
              <label
                >Email address *<input
                  class="apply__mail"
                  type="email"
                  name="email"
                  autocomplete="email"
                  required
                /></label
              >
              <label>Mobile number<input class="apply__url" type="tel" name="mobile" autocomplete="tel" /></label>
              <label
                >Current company<input
                  class="apply__url"
                  type="text"
                  name="current_company"
                  autocomplete="organization"
                /></label
              >
              <label>LinkedIn URL<input class="apply__url" type="url" name="linkedin" autocomplete="url" /></label>
              <label
                >Anything you would like us to know?<textarea class="apm__ta" name="note" rows="3"></textarea></label
              >
            </div>
            <input
              type="file"
              id="careersResumeInput"
              name="resume"
              accept=".pdf,.doc,.docx"
              class="apm__hp"
              tabindex="-1"
              aria-label="Resume"
            />
            <p id="careersFileName" class="apm__fn" aria-live="polite"></p>
            <p id="careersErrorMsg" class="apm__err hidden" role="alert"></p>
          </div>
          <div class="apply__row apply__row--2 apm__actions">
            <button type="button" id="careersUploadBtn" class="apply__file">Upload Resume *</button>
            <button type="submit" id="careersSubmitBtn" class="apply__go" disabled
              >Submit Application<span class="apply__ar">&rarr;</span></button
            >
          </div>
        </form>
        <div id="careersSuccessMessage" class="apm__ok hidden" role="status" tabindex="-1">
          <span class="apm__okic">&#10003;</span>
          <h3 class="apply__h">Application Submitted</h3>
          <p class="apply__s">
            Thanks for applying. Our team will review your application and get back to you if there is a fit.
          </p>
        </div>
      </div>
    </dialog>
  </Content>

  <script>
    import { initializeCareersApplication } from '~/scripts/v9/applications';
    initializeCareersApplication();
  </script>
</V9Layout>
