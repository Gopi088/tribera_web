  border-left:3px solid var(--red)}
.qt span{display:block;font-family:var(--ui);font-weight:400;font-size:14px;letter-spacing:0;
  color:var(--grey);margin-top:15px;line-height:1.5}
.expect{margin-top:clamp(34px,4vw,52px);padding-top:clamp(20px,2.4vw,28px);
