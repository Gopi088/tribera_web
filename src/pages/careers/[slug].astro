  color:var(--faint);margin:0 0 6px}
.plans{display:grid;gap:0;margin-top:4px}

.plan{padding:20px 0 4px;border-top:1px solid var(--hair)}
.plan--on{border-top:2px solid var(--red)}
.plan__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--faint);margin:0 0 12px}
.plan--on .plan__k{color:var(--red)}
.plan__v{font-family:var(--display);font-weight:700;font-size:clamp(24px,2.6vw,32px);
  letter-spacing:-.035em;margin:0 0 8px;line-height:1}
.plan__v span{font-family:var(--ui);font-weight:400;font-size:13.5px;letter-spacing:0;color:var(--grey)}
.plan__d{font-size:14.5px;line-height:1.5;color:var(--grey);margin:0;max-width:30ch}
.plans__ft{display:flex;flex-wrap:wrap;gap:8px 20px;align-items:baseline;
