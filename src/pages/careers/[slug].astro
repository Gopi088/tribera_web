  padding-bottom:2px;transition:border-color .2s}
.plans__ft a:hover{border-color:var(--red)}

.hinge{display:grid;gap:22px;align-items:center;text-align:center}
@media(max-width:899px){
  /* stacked: the number leads, then what it means to each side */
  .hinge>.hg__mid{order:-1;padding-bottom:22px;border-bottom:1px solid var(--hair)}
  .hinge>div:not(.hg__mid){padding-top:2px}
  .hinge>div:last-child{padding-top:22px;border-top:1px solid var(--hair)}
  .hg__d{margin-inline:auto}
  .hg__t{max-width:20ch;margin-inline:auto}
}
@media(min-width:900px){.hinge{grid-template-columns:1fr auto 1fr;gap:clamp(28px,4.5vw,60px);text-align:left}}
.hg__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--faint);margin:0 0 12px}
.hg__t{font-family:var(--display);font-weight:700;font-size:clamp(19px,2.2vw,28px);
  line-height:1.15;letter-spacing:-.032em;margin:0 0 10px}
.hg__d{font-size:15px;line-height:1.55;color:var(--grey);margin:0;max-width:34ch}
@media(min-width:900px){.hinge>div:last-child{text-align:right}
  .hinge>div:last-child .hg__d{margin-left:auto}}
.hg__n{font-family:var(--mono);font-weight:700;font-size:clamp(46px,6vw,84px);
  letter-spacing:-.055em;color:var(--red);line-height:.88}

/* ══ CANDIDATES ══ */
.cand{background:var(--warm)}
.cand .eyebrow{color:var(--red)}
.cand__lede{font-family:var(--display);font-weight:600;font-size:clamp(19px,2.4vw,29px);
  line-height:1.3;letter-spacing:-.03em;max-width:26ch;margin:24px 0 0}
.fan{display:grid;gap:0;margin-top:clamp(38px,4.6vw,60px);
  background:var(--card);border-radius:18px;box-shadow:0 2px 26px rgba(0,0,0,.05);overflow:hidden}
@media(min-width:820px){.fan{grid-template-columns:1.15fr .85fr}}
.fan__side{padding:clamp(22px,2.8vw,32px);display:flex;flex-direction:column}
.fan__side--own{border-top:1px solid #EAE7E0;background:#FBFAF8;justify-content:center}
.fan__side--own .fan__cap{margin:22px 0 0;padding-top:0}
.fan__side--own .fan__was{margin-bottom:16px}
@media(min-width:820px){.fan__side--own{border-top:0;border-left:1px solid #EAE7E0}}
.fan__was{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--faint);margin:0 0 20px}
.tally{width:100%;max-width:340px;height:auto;display:block;overflow:visible}
.tk{stroke:#BDB8AC;stroke-width:1.5;stroke-linecap:round;
  stroke-dasharray:1;stroke-dashoffset:0}
.tk--r{stroke:var(--red);stroke-width:2.4}
.fan.go .tk{stroke-dashoffset:1;animation:draw .26s ease-out var(--d) forwards}
.fan.go .tk--r{animation-duration:.42s}
@keyframes draw{to{stroke-dashoffset:0}}
.fan__3 span{opacity:1}
.fan.go .fan__3 span{opacity:0;transform:scale(.55);
  animation:pop .42s var(--ease) forwards}
.fan.go .fan__3 span:nth-child(1){animation-delay:2000ms}
.fan.go .fan__3 span:nth-child(2){animation-delay:2075ms}
.fan.go .fan__3 span:nth-child(3){animation-delay:2150ms}
@keyframes pop{to{opacity:1;transform:none}}
.fan__side--own .fan__cap{transition:opacity .5s var(--ease) 2.3s}
.fan.go .fan__side--own .fan__cap{opacity:0;animation:fadein .5s ease 2.35s forwards}
@keyframes fadein{to{opacity:1}}
@media(prefers-reduced-motion:reduce){
  .fan.go .tk{animation:none;stroke-dashoffset:0}
  .fan.go .fan__3 span{animation:none;opacity:1;transform:none}
  .fan.go .fan__side--own .fan__cap{animation:none;opacity:1}
}
.fan__cap{font-size:14.5px;line-height:1.55;color:var(--grey);margin:auto 0 0;padding-top:20px}
