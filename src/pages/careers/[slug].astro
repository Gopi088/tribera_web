/* the detail panel is the object that glows */
#deliverables .det{position:relative;overflow:hidden;
  background:linear-gradient(158deg,#252522,#1B1B19 46%,#151513);
  border:1px solid #35352F;border-top:2px solid var(--red);border-radius:3px 3px 20px 20px;
  box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 28px 64px rgba(0,0,0,.5)}
