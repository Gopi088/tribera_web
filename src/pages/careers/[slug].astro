.cmp__hd{display:none}
@media(min-width:900px){
  .cmp__hd{display:grid;grid-template-columns:1fr 380px 1.2fr;gap:0 clamp(22px,2.6vw,40px);
    padding:0 12px 12px;margin-inline:-12px;align-items:end;
    border-bottom:1px solid var(--cline)}
  .cmp__hd .trk{display:grid;grid-template-columns:.8fr .8fr 1.25fr 2.4fr;gap:7px;max-width:380px}
  .cmp__hd .trk span{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--onc3);text-align:center}
  .cmp__hd .trk span::after{content:"";display:block;width:1px;height:7px;
    background:var(--cline);margin:7px auto -8px}
  .cmp__hd .trk span:last-child{color:var(--red)}
  .cmp__hd .trk span:last-child::after{background:rgba(218,0,7,.5)}
  .cmp__hd > span{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--onc3)}
}
.cmp__r{display:grid;gap:12px clamp(22px,2.6vw,40px);padding:clamp(15px,1.8vw,20px) 12px;
  margin-inline:-12px;border-radius:10px;border-top:1px solid rgba(255,255,255,.06);
  align-items:center;transition:background .22s var(--ease),transform .22s var(--ease)}
.cmp__r:first-of-type{border-top:0}
.cmp__r:hover{transform:translateX(2px)}
@media(min-width:900px){.cmp__r{grid-template-columns:1fr 380px 1.2fr}}
.cmp__r:hover{background:rgba(255,255,255,.045)}
.cmp__n{font-size:15.5px;color:var(--onc2)}
.cmp__l{font-size:14.5px;line-height:1.45;color:var(--onc3)}
.trk{display:grid;grid-template-columns:.8fr .8fr 1.25fr 2.4fr;gap:7px;align-items:center;max-width:380px}
.seg{position:relative;height:9px;border-radius:5px;background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.09);
  transition:background .3s var(--ease),border-color .3s var(--ease),opacity .3s var(--ease)}
.seg.on{background:#8E8E87;border-color:#8E8E87}
.cmp__r:hover .seg.on{background:#C9C9C2;border-color:#C9C9C2}
/* four of them hit a wall. one doesn't. */
.cmp__r:not(.cmp__r--us) .seg.last::after{content:"";position:absolute;right:-6px;top:-7px;bottom:-7px;
  width:2px;border-radius:1px;background:rgba(255,255,255,.28)}
.cmp__r--us .seg.on{background:#D6D6CF;border-color:#D6D6CF}
.cmp__r--us .seg.on.last{background:var(--red);border-color:var(--red);
  box-shadow:0 0 16px rgba(218,0,7,.5)}
.cmp__r--us{border-top:1px solid rgba(218,0,7,.45)}
.cmp__r--us .cmp__n{color:#fff;font-weight:600}
.cmp__r--us .cmp__n{color:#fff;font-weight:600}
.cmp__r--us .cmp__l{color:var(--onc)}

.cmp__stop{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--onc3)}
.cmp__r--us .cmp__stop{color:var(--red)}
@media(min-width:900px){.cmp__stop{display:none}}
@media(max-width:899px){
  .cmp__r{grid-template-columns:1fr;gap:8px;padding-block:16px}
  .cmp__n{font-size:16.5px;color:#fff;font-weight:600}
  .trk{max-width:100%}
}
.cmp__ft{font-size:13.5px;line-height:1.55;color:var(--onc3);margin:clamp(18px,2vw,26px) 0 0;
  padding-top:clamp(14px,1.7vw,20px);border-top:1px solid var(--cline)}
.cmp__ft b{color:#fff;font-weight:600}

/* ══ GUARANTEE ══ */
.pledge{margin-top:clamp(30px,3.6vw,46px)}
.pledge__t{font-family:var(--display);font-weight:700;font-size:clamp(24px,3.2vw,42px);
  line-height:1.12;letter-spacing:-.036em;margin:0;max-width:22ch}
.pledge__t em{font-style:normal;color:var(--red)}
.pledge__s{font-size:15px;line-height:1.55;color:var(--grey);margin:16px 0 0;max-width:52ch}
.gz{display:grid;margin-top:clamp(24px,2.8vw,34px);
  padding-top:clamp(20px,2.4vw,28px);border-top:1px solid var(--hair)}
@media(min-width:560px){.gz{grid-template-columns:repeat(2,1fr);column-gap:clamp(22px,2.4vw,36px)}}
.gz__i{padding:18px 0 0;border-top:1px solid var(--hair)}
.gz__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--faint);margin:0 0 9px}
.gz__v{font-size:14.5px;line-height:1.5;color:var(--ink2);margin:0}
.gz__v b{color:var(--ink);font-weight:600}


/* ══ HINGE ══ */
/* ══ PLANS ══ */
.deal2{display:grid;gap:18px;margin-top:18px}
@media(min-width:920px){.deal2{grid-template-columns:1.06fr .94fr;align-items:start}}
