.vseg.is span{background:var(--red);border-color:var(--red);box-shadow:0 0 16px rgba(218,0,7,.45)}
.vseg.is i{color:#fff}
.vseg:focus-visible span{box-shadow:0 0 0 2px var(--red)}

.vol__out{display:grid;gap:clamp(20px,2.4vw,40px);margin-top:clamp(22px,2.6vw,32px);
  padding-top:clamp(20px,2.4vw,28px);border-top:1px solid var(--cline)}
