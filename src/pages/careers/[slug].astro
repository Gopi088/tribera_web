.jd__l{list-style:none;margin:0;padding:0;display:grid;border-top:1px solid var(--hair)}
.jd__l li{position:relative;padding:13px 0 13px 20px;font-size:15px;line-height:1.55;color:var(--ink2);
  border-bottom:1px solid var(--hair);text-wrap:pretty;transition:color .24s var(--ease)}
.jd__l:hover li{opacity:.55}
