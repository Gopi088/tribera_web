.pledge2 em{font-style:normal;color:var(--red)}
.pledge2__s{font-size:14.5px;line-height:1.55;color:var(--onc3);margin:14px 0 0;max-width:54ch}

.vol{margin-top:clamp(34px,4vw,54px);border:1px solid rgba(255,255,255,.08);border-radius:16px;
  padding:clamp(18px,2.1vw,26px);background:rgba(255,255,255,.012)}
.vol__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--onc3);margin:0 0 14px}
.vol__ax{display:grid;grid-template-columns:.85fr 1.15fr 1fr;gap:8px}
.vseg{background:transparent;border:0;padding:0;cursor:pointer;text-align:left;
