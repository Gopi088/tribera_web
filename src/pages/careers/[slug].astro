.buy__dek{font-size:clamp(16px,1.7vw,20px);line-height:1.62;color:var(--onc2);max-width:54ch;margin:22px 0 0}
.cmp{margin-top:clamp(26px,3vw,40px);border:1px solid rgba(255,255,255,.08);border-radius:16px;
  padding:clamp(16px,1.9vw,24px) clamp(16px,1.9vw,26px);background:rgba(255,255,255,.012)}
.cmp:hover .cmp__r:not(:hover) .seg.on{opacity:.55}
