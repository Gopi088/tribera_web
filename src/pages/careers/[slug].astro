  transition:background .22s var(--ease),opacity .24s var(--ease)}
@media(min-width:900px){
  .dr__hd{grid-template-columns:236px 1fr 92px 116px 46px 20px}
}
.drs:hover .dr:not(.dr--head) .dr__hd{opacity:.5}
.drs:hover .dr:not(.dr--head):hover .dr__hd,.dr.op .dr__hd{opacity:1}
.dr:not(.dr--head):hover .dr__hd{background:rgba(0,0,0,.032)}
.dr__hd:focus-visible{outline:2px solid var(--red);outline-offset:-2px}
.dr__n{font-family:var(--display);font-weight:700;font-size:16px;letter-spacing:-.026em;
  display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
.dr__arm{font-family:var(--mono);font-style:normal;font-size:8px;letter-spacing:.14em;
  text-transform:uppercase;padding:3px 6px;border-radius:4px;border:1px solid var(--hair);
  color:var(--faint);font-weight:400}
.dr__arm--delivery{color:var(--red);border-color:rgba(218,0,7,.3)}
.dr__o{font-size:14px;line-height:1.4;color:var(--grey)}
.dr__t,.dr__p{font-family:var(--mono);font-size:11px;color:var(--ink2)}
.dr__p{color:var(--grey)}
.dr__h{text-align:center}
.dr__h i{font-style:normal;font-size:13px}
.hn{color:#C9C5BB}.hy{color:var(--red)}.hp{color:#B9A45E}
.dr__x{position:relative;width:11px;height:11px;justify-self:end}
