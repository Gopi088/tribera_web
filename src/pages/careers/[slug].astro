.expect__hd{display:flex;flex-wrap:wrap;gap:8px 20px;align-items:baseline;
  justify-content:space-between;margin-bottom:18px}
.expect__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--faint);margin:0}
.expect__lk{font-size:13.5px;color:var(--red);text-decoration:none;
  border-bottom:1px solid rgba(218,0,7,.35);padding-bottom:2px;transition:border-color .2s}
.expect__lk:hover{border-color:var(--red)}

.human{font-family:var(--display);font-weight:700;font-size:clamp(19px,2.5vw,31px);line-height:1.22;
  letter-spacing:-.032em;margin:clamp(36px,4.2vw,56px) 0 0;max-width:26ch}
.human em{font-style:normal;color:var(--red)}



/* ══ THE DEAL — an instrument, like the rest of the page ══ */
.deal{background:var(--char);color:var(--onc)}
.deal .eyebrow{color:var(--red)}
.deal h2{color:#fff}
.deal__dek{font-size:clamp(16px,1.7vw,20px);line-height:1.6;color:var(--onc2);max-width:44ch;margin:0}
