  color:var(--faint);margin:0}

/* ══ CANDIDATE TIMELINE ══ */
.tl2__g{display:grid;gap:22px 24px}
@media(min-width:720px){.tl2__g{grid-template-columns:repeat(4,1fr);gap:0 22px}}
.tl2{display:grid;gap:7px;align-content:start}
.tl2__bar{display:block;height:4px;border-radius:2px;background:#DDDAD2;margin-bottom:8px}
.tl2:last-child .tl2__bar{background:var(--red)}
.tl2__d{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--ink2);margin:0}
.tl2__d i{font-style:normal;color:var(--faint)}
.tl2:last-child .tl2__d{color:var(--red)}
.tl2__t{font-family:var(--display);font-weight:700;font-size:16px;letter-spacing:-.022em;margin:0}
.tl2__p{font-size:13.5px;line-height:1.45;color:var(--grey);margin:0}



/* ══ TRUST ══ */
.trust{background:var(--char);color:var(--onc)}
.trust .eyebrow{color:var(--red)}
.trust h2{color:#fff}
.trust__dek{font-size:clamp(16px,1.7vw,20px);line-height:1.6;color:var(--onc2);max-width:44ch;margin:0}
.trust__dek b{color:#fff;font-weight:600}
.tr2{display:grid;gap:26px 44px}
@media(min-width:820px){.tr2{grid-template-columns:repeat(2,1fr)}}
.tr2__k{font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--onc3);margin:0 0 6px;padding-bottom:12px;border-bottom:1px solid var(--cline)}
.tr2__l{list-style:none;margin:0;padding:0;display:grid}
.tr2__l li{position:relative;padding:12px 0 12px 22px;font-size:14.5px;line-height:1.45;
  color:var(--onc2);border-bottom:1px solid rgba(255,255,255,.055)}
.tr2__l li:last-child{border-bottom:0}
.tr2__l li::before{content:"";position:absolute;left:0;top:1.15em;width:8px;height:8px;
  border-radius:50%;background:#4E4E47}
.tr2__l li b{color:#fff;font-weight:600}
.tr2__l li:has(b)::before{background:var(--red)}
.qa{margin-top:clamp(30px,3.6vw,46px);padding-left:22px;border-left:2px solid var(--red)}
.qa__q{font-size:15px;color:var(--onc3);margin:0 0 8px;font-style:italic}
.qa__a{font-family:var(--display);font-weight:700;font-size:clamp(19px,2.3vw,28px);line-height:1.25;
  letter-spacing:-.03em;color:#fff;margin:0;max-width:26ch}
.qa__a em{font-style:normal;color:var(--red)}
.trust__ft{font-size:13.5px;line-height:1.6;color:var(--onc3);margin:clamp(26px,3vw,40px) 0 0;
  padding-top:clamp(18px,2.2vw,26px);border-top:1px solid var(--cline);max-width:72ch}

/* ══ THE CHOREOGRAPHY ══ */
.cg__g{display:grid;gap:26px 24px}
@media(min-width:760px){.cg__g{grid-template-columns:repeat(5,1fr);gap:0 20px}}
.cg{display:grid;gap:6px;align-content:start}
.cg__bar{display:block;height:4px;border-radius:2px;background:#DDDAD2;margin-bottom:10px}
.cg:last-child .cg__bar{background:var(--red)}
.cg__d{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--ink2);margin:0}
.cg__d i{font-style:normal;color:var(--faint)}
.cg:last-child .cg__d{color:var(--red)}
.cg__t{font-family:var(--display);font-weight:700;font-size:16px;letter-spacing:-.022em;margin:0}
.cg__p{font-size:13.5px;line-height:1.45;color:var(--grey);margin:0}
.cg__w{font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--faint);margin:6px 0 0;padding-top:8px;border-top:1px solid var(--hair)}
.cg__notes{display:grid;gap:18px 40px;margin-top:clamp(28px,3.2vw,44px);
  padding-top:clamp(20px,2.4vw,28px);border-top:1px solid var(--hair)}
@media(min-width:760px){.cg__notes{grid-template-columns:repeat(2,1fr)}}
.cg__k{font-family:var(--display);font-weight:700;font-size:15.5px;letter-spacing:-.02em;margin:0 0 5px;
  position:relative;padding-left:20px}
.cg__k::before{content:"";position:absolute;left:0;top:.44em;width:8px;height:8px;border-radius:50%;
  background:var(--red)}
.cg__v{font-size:13.5px;line-height:1.5;color:var(--grey);margin:0;padding-left:20px}

/* ══ VOICES marquee ══ */
.mq{overflow:hidden;margin-top:clamp(30px,3.6vw,46px);
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.mq__t{display:flex;gap:16px;width:max-content;padding-inline:var(--gut);
  animation:mqrun 68s linear infinite}
.mq:hover .mq__t,.mq:focus-within .mq__t{animation-play-state:paused}
@keyframes mqrun{to{transform:translateX(calc(-50% - 8px))}}
.qc{flex:none;width:330px;margin:0;background:#F4F4F2;border:1px solid #E9E9E5;
  border-radius:14px;padding:20px 20px 18px;display:flex;flex-direction:column;
  transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s}
.qc:hover{transform:translateY(-3px);background:#fff;box-shadow:0 10px 30px rgba(0,0,0,.07)}
.qc__tag{align-self:flex-start;font-family:var(--mono);font-size:9px;letter-spacing:.16em;
  text-transform:uppercase;padding:5px 9px;border-radius:5px;margin-bottom:14px}
.qc--ta .qc__tag{background:var(--ink);color:#fff}
.qc--cd .qc__tag{background:transparent;color:var(--red);border:1px solid rgba(218,0,7,.42)}
.qc__q{font-size:15px;line-height:1.5;color:var(--ink2);margin:0 0 auto;
  font-family:var(--display);font-weight:500;letter-spacing:-.012em}
.qc__a{margin-top:18px;padding-top:14px;border-top:1px solid #E4E4DE;display:grid;gap:2px}
.qc__a b{font-size:13.5px;font-weight:600;color:var(--ink)}
.qc__a span{font-size:12.5px;color:var(--grey)}
@media (prefers-reduced-motion:reduce){
  .mq{overflow-x:auto;-webkit-mask-image:none;mask-image:none}
  .mq__t{animation:none}
}

/* ══ CLOSE ══ */
.doors{display:grid;gap:18px;margin-top:clamp(36px,4.4vw,56px)}
@media(min-width:760px){.doors{grid-template-columns:repeat(2,1fr)}}
.door{background:var(--card);border-radius:18px;padding:clamp(26px,3.2vw,40px);
  box-shadow:0 2px 24px rgba(0,0,0,.05);display:flex;flex-direction:column;
  transition:box-shadow .3s,transform .3s var(--ease)}
.door:hover{box-shadow:0 12px 40px rgba(0,0,0,.09);transform:translateY(-2px)}
.door p{color:var(--grey);font-size:15.5px;line-height:1.6;margin:12px 0 0;flex:1}
.door .btn{align-self:flex-start;margin-top:24px}
.bbb2{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px;
  margin:clamp(48px,5.5vw,76px) 0 0;padding-top:clamp(30px,3.4vw,44px);border-top:1px solid var(--hair)}
.bbb2 span{font-family:var(--display);font-weight:800;font-size:clamp(20px,2.4vw,30px);
  letter-spacing:-.038em;color:var(--ink)}
.bbb2 span:first-child{color:var(--red)}
.bbb2 i{display:block;width:5px;height:5px;border-radius:50%;background:#CFCBC1}
.bbb2__s{text-align:center;font-size:14px;line-height:1.55;color:var(--grey);
  margin:14px auto 0;max-width:44ch}

.ft{background:var(--char);color:var(--onc3);padding-block:clamp(48px,5.5vw,76px) 32px;font-size:14px}
.ft__top{display:grid;gap:clamp(30px,3.4vw,44px)}
@media(min-width:760px){.ft__top{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1020px){.ft__top{grid-template-columns:1.5fr repeat(4,.9fr);gap:clamp(24px,2.6vw,44px)}}
.ft__brand .logo{color:var(--onc)}
.ft__line{font-size:14.5px;line-height:1.55;color:var(--onc3);margin:16px 0 0;max-width:36ch}
.ft__line b{color:var(--onc);font-weight:600;display:block;margin-bottom:6px}
.ft__tribe{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--faint);margin:16px 0 0}
.ft__bbb{display:flex;align-items:center;gap:10px;flex-wrap:nowrap;white-space:nowrap;
  font-family:var(--display);font-weight:700;font-size:15px;letter-spacing:-.02em;
  color:var(--onc2);margin:7px 0 0}
.ft__bbb em{font-style:normal;color:var(--red)}
.ft__bbb i{display:block;width:4px;height:4px;border-radius:50%;background:#4A4A44;flex:none}
.ft__social{display:flex;flex-wrap:wrap;gap:18px;margin-top:20px}
.ft__social a{font-size:13.5px;color:var(--onc2);text-decoration:none;
  border-bottom:1px solid var(--cline);padding-bottom:3px;transition:color .2s,border-color .2s}
.ft__social a:hover{color:#fff;border-color:var(--onc2)}
.ft__col{display:flex;flex-direction:column;gap:11px;align-items:flex-start}
.ft__ttl{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--red);margin:0 0 5px}
.ft__col a{font-size:14px;color:var(--onc2);text-decoration:none;transition:color .2s,transform .2s}
.ft__col a:hover{color:#fff;transform:translateX(2px)}
.ft__bar{display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between;align-items:baseline;
  margin-top:clamp(36px,4vw,56px);padding-top:22px;border-top:1px solid var(--cline);
  font-size:12.5px;color:var(--onc3)}
.ft__made{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase}

/* ══ MICRO-INTERACTIONS ══ */
/* signal rows grow a marker as they open */
.sig__r{position:relative;padding-left:0;transition:padding-left .3s var(--ease)}
.sig__r::before{content:"";position:absolute;left:0;top:14px;width:2px;height:0;
  background:var(--red);border-radius:2px;transition:height .3s var(--ease)}
.sig__r:hover,.sig__r:focus-within{padding-left:12px}
.sig__r:hover::before,.sig__r:focus-within::before{height:14px}
.side{transition:background .3s var(--ease)}
.side:hover{background:rgba(255,255,255,.018)}

/* verdict pill breathes once when it arrives */
.duo.in .pill{animation:beat 2.2s var(--ease) .5s 1 both}
@keyframes beat{0%{box-shadow:0 0 0 0 rgba(63,190,124,.35)}
  55%{box-shadow:0 0 0 8px rgba(63,190,124,0)}100%{box-shadow:0 0 0 0 rgba(63,190,124,0)}}

/* client names come up on hover */
.logos__r span{transition:color .25s var(--ease);cursor:default}
.logos__r span:hover{color:#B4B4AD}

/* tags become filters */
.tag{transition:transform .18s var(--ease),box-shadow .25s var(--ease)}
.key__i{cursor:pointer;padding:5px 8px;margin:-5px -8px;border-radius:999px;
  transition:background .2s var(--ease);outline:none}
.key__i:hover,.key__i:focus-visible{background:rgba(0,0,0,.045)}
.key__i:focus-visible{box-shadow:0 0 0 2px var(--red)}
.key__i:hover .tag,.key__i:focus-visible .tag{transform:translateY(-1px)}
.swap .swap__row{transition:background .22s var(--ease),opacity .28s var(--ease)}
.swap.dim .swap__row:not(.hit){opacity:.52}
.swap .swap__row.hit{background:rgba(0,0,0,.04)}
.band--w .swap__row.hit,.panel .swap__row.hit{background:#EEEEEA}
.swap .swap__row.hit .tag{transform:translateY(-1px);box-shadow:0 0 0 3px rgba(0,0,0,.08)}
.swap .swap__row--keep.hit .tag{box-shadow:0 0 0 3px rgba(218,0,7,.18)}

/* guarantee + figures answer the cursor */
.gz__i .gz__k,.adv__n{transition:color .25s var(--ease)}
.gz__i:hover .gz__k{color:var(--red)}
.tr{transition:background .22s var(--ease)}
.tr:not(.tr--h):hover{background:rgba(255,255,255,.035)}
@media(min-width:800px){.tr{margin-inline:-14px;padding-inline:14px;border-radius:8px}}

/* chips lift */


/* ══ NAV audience pill ══ */

.nav__sw a{font-size:13px;padding:6px 13px;border-radius:999px;color:var(--onc2);
  text-decoration:none;white-space:nowrap;transition:background .2s,color .2s}

.nav__sw a:hover:not(.is){color:#fff}


/* ══ APPLY card ══ */
.apply{margin-top:clamp(38px,4.6vw,60px);background:var(--char);border-radius:20px;
  padding:clamp(26px,3.4vw,44px);color:var(--onc)}
.apply__k{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--red);margin:0 0 14px}
.apply__h{font-family:var(--display);font-weight:700;font-size:clamp(23px,2.9vw,36px);
  line-height:1.1;letter-spacing:-.034em;color:#fff;margin:0;max-width:20ch}
.apply__s{font-size:15.5px;line-height:1.55;color:var(--onc2);margin:14px 0 0;max-width:48ch}
.apply__form{display:grid;gap:10px;margin-top:clamp(22px,2.6vw,30px);max-width:56ch;
  margin-left:auto;margin-right:auto}
.apply__row{display:flex;flex-wrap:wrap;gap:10px}
.apply__file{display:inline-flex;align-items:center;gap:10px;padding:14px 22px;border-radius:999px;
  background:var(--onc);color:var(--char);font-weight:600;font-size:15px;cursor:pointer;
  transition:transform .18s var(--ease)}
.apply__file:hover{transform:translateY(-1px)}
.apply__file input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.apply__or{display:flex;align-items:center;color:var(--onc3);font-size:13.5px;padding:0 4px}
.apply__ar{display:inline-block;transition:transform .3s var(--spring)}
.apply__go:hover .apply__ar{transform:translateX(3px)}
.apply__url,.apply__mail{flex:1;min-width:220px;background:transparent;border:1px solid var(--cline);
  border-radius:999px;padding:14px 20px;color:#fff;font-family:var(--ui);font-size:15px;outline:none;
  transition:border-color .2s,box-shadow .2s}
.apply__url::placeholder,.apply__mail::placeholder{color:var(--onc3)}
.apply__url:focus,.apply__mail:focus{border-color:var(--onc2)}
.apply__mail{border-color:rgba(255,255,255,.28)}
.apply__mail:focus{border-color:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.08)}
.apply__mail:invalid:not(:placeholder-shown){border-color:rgba(218,0,7,.6)}
.apply__row--2{align-items:stretch}
.apply__go{padding:15px 28px;display:inline-flex;align-items:center;gap:9px;border-radius:999px;border:0;background:var(--red);color:#fff;
  font-family:var(--ui);font-weight:600;font-size:15px;cursor:pointer;white-space:nowrap;
  transition:transform .18s var(--ease),background .2s}
.apply__go:hover{transform:translateY(-1px);background:#C10006}
.apply__fine{font-size:13px;color:var(--onc3);margin:18px 0 0}
.apply__fine b{color:var(--onc);font-weight:600}

/* ══ sticky candidate CTA ══ */
.stickcta{position:fixed;left:0;right:0;bottom:0;z-index:70;transform:translateY(110%);
  transition:transform .4s var(--ease);background:rgba(19,19,19,.94);
  backdrop-filter:blur(12px);border-top:1px solid var(--cline)}
.stickcta.show{transform:none}
.stickcta__in{display:flex;align-items:center;gap:14px;padding:12px 0}
.stickcta p{margin:0;font-size:14px;color:var(--onc2);flex:1;line-height:1.35}
.stickcta p b{color:#fff;font-weight:600;display:block}
@media(max-width:560px){.stickcta p b{font-size:14px}.stickcta p span{display:none}}
@media (prefers-reduced-motion:reduce){.stickcta{transition:none}}

/* ══ SECTION RHYTHM — the header owns the gap below it ══ */
.shead{margin-bottom:clamp(50px,5.8vw,88px)}
.shead + *{margin-top:0}
.shead + .ramp{margin-top:0}

/* ══ THE SMALL RETURNS — press, spring, and group awareness ══ */
:root{--spring:cubic-bezier(.34,1.42,.64,1)}

/* 1. everything you can press, presses back */
.btn,.ftab,.pre,.vseg,.step,.tl,.lt,.chip,.key__i,.inds__g span,
.qc,.door,.who__ph,.xp,.cmp__r,.sig__r,.swap__row{
  transition-timing-function:var(--spring)}
.btn:active,.ftab:active,.pre:active,.vseg:active,.tl:active,.lt:active,
.chip:active,.key__i:active,.inds__g span:active,.qc:active{
  transform:scale(.965);transition-duration:.08s}
.door:active,.panel:active{transform:scale(.995);transition-duration:.1s}
.step:active{transform:translateX(3px);transition-duration:.08s}
.flip:active{transform:scale(.99)}
.flip.is-b:active{transform:rotateY(180deg) scale(.99)}

/* 2. text links sweep instead of just changing colour */
.ft__col a,.ft__social a,.expect__lk,.plans__ft a,.chip__lk{position:relative}
.ft__col a::after{content:"";position:absolute;left:0;right:100%;bottom:-3px;height:1px;
  background:currentColor;opacity:.5;transition:right .34s var(--spring)}
.ft__col a:hover::after{right:0}

/* 3. the dot in the wordmark notices you */
.logo i{display:inline-block;transition:transform .4s var(--spring),color .3s}
.logo:hover i{transform:translateY(-2px) scale(1.25)}

/* 4. grouped tiles become aware of each other */
.bench__g:hover .xp{opacity:.55}
.bench__g:hover .xp:hover{opacity:1;transform:translateY(-2px);
  box-shadow:0 6px 18px rgba(0,0,0,.06);z-index:2;position:relative}
.tiles:hover .tl{opacity:.6}
.tiles:hover .tl:hover{opacity:1}
.whos__g:hover .who{opacity:.55}
.whos__g:hover .who:hover{opacity:1}
.bench__g .xp,.tiles .tl,.whos .who{transition:opacity .28s var(--ease),
  transform .28s var(--spring),box-shadow .28s var(--ease),background .22s var(--ease)}

/* 5. inputs lift a hair when they take focus */
.apply__url:focus,.apply__mail:focus{transform:translateY(-1px)}
.apply__url,.apply__mail{transition:border-color .2s,box-shadow .2s,transform .3s var(--spring)}

/* 6. the switcher settles rather than snapping */
.ftab,.nav__sw a{transition:background .32s var(--spring),color .22s,transform .2s var(--spring)}
.nav__sw a:active{transform:scale(.94)}

@media(prefers-reduced-motion:reduce){
  .btn:active,.ftab:active,.pre:active,.vseg:active,.tl:active,.lt:active,
  .chip:active,.key__i:active,.qc:active,.door:active,.panel:active,
  .step:active,.flip:active,.logo:hover i{transform:none}
  .ft__col a::after{transition:none}
}

/* the four boxes are there to be compared — so let them be */
.ramp__g .rp{transition:opacity .3s var(--ease),transform .34s var(--spring)}
.ramp__g:hover .rp{opacity:.42}
.ramp__g:hover .rp:hover{opacity:1;transform:translateY(-4px)}
.rp__acc b{transition:color .25s var(--ease)}
.ramp__g:hover .rp:hover .rp__acc b{color:var(--red)}
.rp .rk__ht,.rp .rk__ln{transition:stroke-opacity .3s var(--ease)}
.ramp__g:hover .rp:hover .rk__ht{stroke-opacity:1}
@media(prefers-reduced-motion:reduce){
  .ramp__g:hover .rp{opacity:1}
  .ramp__g:hover .rp:hover{transform:none}
}

/* ══ THE LAB: the tiles and the sliders are the same instrument ══ */
.lt{cursor:default;outline:none}
.lt.lit{border-color:rgba(255,255,255,.55);
  box-shadow:0 0 0 3px rgba(255,255,255,.09);transform:translateY(-2px)}
.lt.low.lit{border-color:rgba(232,163,61,.7);box-shadow:0 0 0 3px rgba(232,163,61,.16)}
.lt.heavy.lit{border-color:rgba(218,0,7,.75);box-shadow:0 0 0 3px rgba(218,0,7,.2)}
.row{margin-inline:-10px;padding-inline:10px;border-radius:8px;
  transition:background .24s var(--ease)}
.row.lit{background:rgba(255,255,255,.05)}
.row.lit .row__n{color:#fff}
.row.lit .row__p{color:#fff}
.row.lit .row__k{color:#fff}
@media(prefers-reduced-motion:reduce){.lt.lit{transform:none}}

/* ══ HOW WE ENGAGE: tracing the path ══ */
.cg{transition:opacity .28s var(--ease),transform .3s var(--spring)}
.cg__bar{transition:background .3s var(--ease),transform .34s var(--spring);transform-origin:left}
.cg__g:hover .cg{opacity:.45}
.cg__g:hover .cg:hover{opacity:1;transform:translateY(-3px)}
.cg__g:hover .cg:hover .cg__bar{background:var(--red);transform:scaleY(1.6)}
.cg__w{transition:color .28s var(--ease)}
.cg__g:hover .cg:hover .cg__w{color:var(--red)}

/* ══ THE 1:3 HINGE: each side lights its own ratio ══ */
.hinge>div{transition:opacity .28s var(--ease)}
.hinge:hover>div{opacity:.5}
.hinge:hover>div:hover,.hinge:hover>.hg__mid{opacity:1}
.ratio__r{transition:opacity .28s var(--ease)}
.hinge>div:first-child:hover ~ .hg__mid .ratio__r--us{opacity:.35}
.hinge>div:last-child:hover ~ .hg__mid .ratio__r{opacity:.35}
.ratio__sq i{transition:transform .3s var(--spring),background .25s var(--ease)}
.ratio__r:hover .ratio__sq i{transform:translateY(-2px)}
.ratio__r:hover .ratio__sq i:nth-child(2){transition-delay:.04s}
.ratio__r:hover .ratio__sq i:nth-child(3){transition-delay:.08s}
.ratio__r:hover .ratio__sq i:nth-child(4){transition-delay:.12s}
.ratio__r:hover .ratio__sq i:nth-child(5){transition-delay:.16s}
.ratio__r:hover .ratio__sq i:nth-child(6){transition-delay:.2s}
.ratio__r:hover .ratio__sq i:nth-child(7){transition-delay:.24s}
