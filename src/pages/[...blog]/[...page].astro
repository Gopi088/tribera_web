---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import type { Post } from '~/types';

import Layout from '~/layouts/PageLayout.astro';
import Pagination from '~/components/blog/Pagination.astro';
import HeroFilters from '~/components/blog/HeroFilters.astro';
import EntryGrid from '~/components/blog/EntryGrid.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const posts = (page.data ?? []) as Array<Post>;

const metadata = {
  title: `Blog - tribera`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-black">
    <!-- Background -->
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-black"></div>

      <!-- LEFT red glow -->
      <div
        class="absolute left-[-15%] top-0 h-full w-[60%] bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.45),transparent_60%)]"
      >
      </div>

      <!-- RIGHT red glow -->
      <div
        class="absolute right-[-15%] top-0 h-full w-[60%] bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.45),transparent_60%)]"
      >
      </div>
    </div>

    <!-- FAST MOVING DOTS -->
    <div class="absolute inset-0 pointer-events-none">
      {
        Array.from({ length: 8 }).map((_, i) => (
          <span
            class="absolute rounded-full bg-[#da0007]/80"
            style={`
          width:${i % 4 === 0 ? 4 : 4}px;
          height:${i % 4 === 0 ? 4 : 4}px;
          left:${Math.random() * 80}%;
          top:${Math.random() * 80}%;
          animation: float ${7 + Math.random() * 9}s linear infinite;
          box-shadow: 0 0 12px rgba(218,0,7,.6);
        `}
          />
        ))
      }
    </div>

    <!-- Content -->
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <p class="text-[#da0007] text-[11px] font-semibold tracking-[0.25em] uppercase mb-3">Insights & Updates</p>

      <h1 class="text-white text-6xl md:text-6xl font-semibold leading-[1.05]">
        Building the future<br />
        of technical hiring.
      </h1>

      <p class="mt-6 text-white/60 text-[18px] md:text-[20px] max-w-2xl mx-auto leading-relaxed">
        How we’re using AI and senior advisor expertise to help companies hire exceptional talent — and help that talent
        get discovered properly.
      </p>

      <HeroFilters activeType="all" />
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <EntryGrid posts={posts} />
    </div>

    <div class="mt-12">
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>
</Layout>
