  <h4 class="text-[15px] font-bold text-black mb-4">
    Search by Tags:
  </h4>

  <div class="flex flex-wrap gap-3">
    {tags.map((tag) => (
      <button
        type="button"
        class="
          px-4 py-2 rounded-md text-[13px] font-bold
          border border-black/10
          bg-white text-black/70
          transition duration-300
          hover:border-[#da0007]/40
          hover:text-[#da0007]
          hover:-translate-y-1
        "
      >
        {tag}
      </button>
    ))}
  </div>

</section> -->



  
</Layout>
