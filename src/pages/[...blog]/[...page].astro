---
import { SITE } from 'astrowind:config';
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import type { Post } from '~/types';

import Layout from '~/layouts/PageLayout.astro';
import Pagination from '~/components/blog/Pagination.astro';
import HeroFilters from '~/components/blog/HeroFilters.astro';
import EntryGrid from '~/components/blog/EntryGrid.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const posts = (page.data ?? []) as Array<Post>;
const siteUrl = Astro.site ?? new URL(SITE.site);
const defaultOgImage = String(new URL('/og-default.png', siteUrl));

const metadata = {
  title: `Blog - tribera`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
    images: [
      {
        url: defaultOgImage,
        width: 1200,
        height: 628,
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <section
    class="blog-editorial relative min-h-[90vh] md:min-h-screen flex items-center justify-center overflow-hidden bg-black"
  >
    <!-- Background -->
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-black"></div>

      <!-- LEFT red glow -->
      <div
        class="absolute left-[-30%] md:left-[-15%] top-0 h-full w-[90%] md:w-[60%] bg-[radial-gradient(circle_at_left_center,rgba(218,0,7,0.45),transparent_60%)]"
      >
      </div>

      <!-- RIGHT red glow -->
      <div
        class="absolute right-[-30%] md:right-[-15%] top-0 h-full w-[90%] md:w-[60%] bg-[radial-gradient(circle_at_right_center,rgba(218,0,7,0.45),transparent_60%)]"
      >
      </div>
    </div>

    <!-- FAST MOVING DOTS -->
    <div class="absolute inset-0 pointer-events-none">
      {
        Array.from({ length: 24 }).map((_, i) => (
          <span
            class="absolute rounded-full bg-[#da0007]/80"
            style={`
          width:${i % 4 === 0 ? 4 : 4}px;
          height:${i % 4 === 0 ? 4 : 4}px;
          left:${12 + Math.random() * 76}%;
          top:${8 + Math.random() * 84}%;
          --float-x1:${(Math.random() * 44 - 22).toFixed(1)}px;
          --float-y1:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x2:${(Math.random() * 52 - 26).toFixed(1)}px;
          --float-y2:${(Math.random() * 42 - 21).toFixed(1)}px;
          --float-x3:${(Math.random() * 60 - 30).toFixed(1)}px;
          --float-y3:${(Math.random() * 36 - 18).toFixed(1)}px;
          --float-x4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-y4:${(Math.random() * 48 - 24).toFixed(1)}px;
          --float-x5:${(Math.random() * 56 - 28).toFixed(1)}px;
          --float-y5:${(Math.random() * 40 - 20).toFixed(1)}px;
          --float-x6:${(Math.random() * 50 - 25).toFixed(1)}px;
          --float-y6:${(Math.random() * 34 - 17).toFixed(1)}px;
          --float-scale1:${(1 + Math.random() * 0.28).toFixed(2)};
          --float-scale2:${(0.78 + Math.random() * 0.18).toFixed(2)};
          --float-scale3:${(1.02 + Math.random() * 0.22).toFixed(2)};
          --float-scale4:${(0.82 + Math.random() * 0.14).toFixed(2)};
          --float-scale5:${(1 + Math.random() * 0.2).toFixed(2)};
          --float-scale6:${(0.86 + Math.random() * 0.14).toFixed(2)};
          animation: float ${11 + Math.random() * 14}s ease-in-out infinite;
          animation-delay: -${(Math.random() * 18).toFixed(1)}s;
          box-shadow: 0 0 12px rgba(218,0,7,.6);
        `}
          />
        ))
      }
    </div>

    <!-- Content -->
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <div
        class="mb-3 inline-flex items-center gap-2 rounded-full border border-[#da0007]/40 bg-white/[0.03] px-3.5 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/80"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#da0007]"></span>
        <span>Insights &amp; Updates</span>
      </div>

      <h1
        class="blog-display text-white text-[2.45rem] sm:text-6xl md:text-6xl font-semibold leading-[0.98] sm:leading-[1.05]"
      >
        Building the future<br />
        of technical hiring.
      </h1>

      <HeroFilters activeType="all" />
    </div>
  </section>

  <section class="blog-editorial py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <EntryGrid posts={posts} />
    </div>

    <div class="mt-12">
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>
</Layout>
