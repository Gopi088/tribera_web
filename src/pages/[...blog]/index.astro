---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { STANDALONE_BLOG_PERMALINKS } from '~/data/standalone-blog';
import Layout from '~/layouts/V9Layout.astro';
import Content from '~/components/v9/content/Content.astro';
import { publicLinks } from '~/data/v9/preview-links';
import { blogPostRobots, getStaticPathsBlogPost } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;
export const getStaticPaths = (async () => {
  const paths = await getStaticPathsBlogPost();
  return paths.filter(({ props }) => !STANDALONE_BLOG_PERMALINKS.has(props.post.permalink));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props as Props;
---

<Layout
  title={post.metadata?.title || post.title}
  description={post.metadata?.description || post.excerpt || post.title}
  noindex={post.metadata?.robots?.index === false || blogPostRobots?.index === false}
  robotsFollow={post.metadata?.robots?.follow !== false && blogPostRobots?.follow !== false}
  canonicalPath={post.metadata?.canonical || getPermalink(post.permalink, 'post')}
  openGraphType="article"
  image={typeof post.image === 'string' ? post.image : post.image?.src}
  headerLinkOverrides={publicLinks}
  footerLinkOverrides={publicLinks}
>
  <Content kind="article">
    <header class="ahead band">
      <div class="wrap">
        <p class="ahead__meta">
          <time datetime={post.publishDate.toISOString()}
            >{
              post.publishDate.toLocaleDateString('en-GB', {
                timeZone: 'UTC',
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })
            }</time
          ><span>{post.readingTime} read</span>{
            post.category && <a href={getPermalink(post.category.slug, 'category')}>{post.category.title}</a>
          }
        </p>
        <h1>{post.title}</h1>
        {post.excerpt && <p class="ahead__sub">{post.excerpt}</p>}
        {post.author && <p class="ahead__by">{post.author}</p>}
      </div>
    </header>
    <div class="wrap">
      <article class="art">{post.Content ? <post.Content /> : <Fragment set:html={post.content || ''} />}</article><p
        class="cases__ft"
      >
        <a href="/blog">Back to field notes &rarr;</a>
      </p>
    </div>
  </Content>
</Layout>
