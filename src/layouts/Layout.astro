---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import StructuredData from '~/components/common/StructuredData.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCandidatesPage = pathname === '/candidates';
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <StructuredData metadata={metadata} />
    <SiteVerification />
    <Analytics />
    <link
      rel="preload"
      as="script"
      href="https://res.public.onecdn.static.microsoft/customerconnect/v1/7dttl/init.js"
      crossorigin
    />
    <link rel="preconnect" href="https://res.public.onecdn.static.microsoft" crossorigin />
    <link rel="preconnect" href="https://customerconnect.teams.usercontent.microsoft" crossorigin />
    <link rel="dns-prefetch" href="//res.public.onecdn.static.microsoft" />
    <link rel="dns-prefetch" href="//customerconnect.teams.usercontent.microsoft" />
    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="bg-page overflow-x-hidden">
    <slot />
    <BasicScripts />

    <script is:inline>
      (() => {
        window.__triberaChatbotCleanup?.();

        const allowedHosts = new Set(['tribera.ai', 'www.tribera.ai', 'tribera-webv2.netlify.app']);
        const environmentId = '75186a18-80c9-e34b-b323-d376419f05d1';
        const chatbotScriptId = 'chatbot';
        const chatbotIframeId = 'teams-chat-bot-iframe-a3b60c17-95c7-4cba-8036-be9da15bcc26';
        const chatbotScriptSrc = 'https://res.public.onecdn.static.microsoft/customerconnect/v1/7dttl/init.js';
        const chatbotOrigin = 'https://customerconnect.teams.usercontent.microsoft';
        const chatStatusId = 'tribera-chat-status';
        const chatFallbackId = 'tribera-chat-fallback';
        const chatFallbackTimeoutMs = 5000;
        const salesMailto = 'mailto:sales@tribera.ai';

        const chatState = (window.__triberaChatState ||= {
          phase: 'idle',
          lastSize: null,
          sawFirstToggleAfterOpen: false,
          launcherVisible: false,
        });
        let chatFallbackTimer = null;

        const parseSize = (value) => {
          const parsed = Number.parseInt(String(value || ''), 10);
          return Number.isFinite(parsed) ? parsed : null;
        };

        const isMeaningfulExpand = (last, next) => {
          const deltaHeight = next.height - last.height;
          const relativeGrow = last.height > 0 ? (next.height - last.height) / last.height : 0;
          return deltaHeight > 60 && relativeGrow > 0.15;
        };

        const isMeaningfulMinimize = (last, next) => {
          const deltaHeight = next.height - last.height;
          const relativeDrop = last.height > 0 ? (last.height - next.height) / last.height : 0;
          return deltaHeight < -60 && relativeDrop > 0.15;
        };

        const dispatchChatState = (name, detail = {}) => {
          window.dispatchEvent(
            new CustomEvent(`tribera:${name}`, {
              detail: {
                phase: chatState.phase,
                ...detail,
              },
            })
          );
        };

        const getLauncher = () => document.querySelector('img[aria-label="Open Customer Connect chat bot assistant"]');

        const syncLauncherVisibility = () => {
          const launcher = getLauncher();
          if (!(launcher instanceof HTMLElement)) {
            chatState.launcherVisible = false;
            return;
          }

          const style = getComputedStyle(launcher);
          chatState.launcherVisible = style.display !== 'none' && style.visibility !== 'hidden';
        };

        const markChatOpening = () => {
          chatState.phase = 'opening';
          chatState.sawFirstToggleAfterOpen = false;
        };

        const clearFallbackTimer = () => {
          if (chatFallbackTimer) {
            window.clearTimeout(chatFallbackTimer);
            chatFallbackTimer = null;
          }
        };

        const getChatStatus = () => document.getElementById(chatStatusId);
        const getChatFallback = () => document.getElementById(chatFallbackId);

        const setChatStatusVisible = (visible, label = 'Starting live chat...') => {
          const status = getChatStatus();
          if (!(status instanceof HTMLElement)) return;

          status.textContent = label;
          status.style.opacity = visible ? '1' : '0';
          status.style.transform = visible ? 'translateY(0)' : 'translateY(8px)';
          status.style.pointerEvents = visible ? 'auto' : 'none';
        };

        const setChatFallbackVisible = (visible) => {
          const fallback = getChatFallback();
          if (!(fallback instanceof HTMLElement)) return;

          fallback.hidden = false;
          fallback.style.opacity = visible ? '1' : '0';
          fallback.style.transform = visible ? 'translateY(0)' : 'translateY(10px)';
          fallback.style.pointerEvents = visible ? 'auto' : 'none';
          fallback.style.visibility = visible ? 'visible' : 'hidden';
        };

        const hideChatAssistUi = () => {
          clearFallbackTimer();
          setChatStatusVisible(false);
          setChatFallbackVisible(false);
        };

        const scheduleChatFallback = () => {
          clearFallbackTimer();
          chatFallbackTimer = window.setTimeout(() => {
            if (chatState.phase !== 'opening') return;
            setChatStatusVisible(false);
            setChatFallbackVisible(true);
          }, chatFallbackTimeoutMs);
        };

        const mountChatAssistUi = () => {
          if (getChatStatus() || getChatFallback()) return;

          const status = document.createElement('div');
          status.id = chatStatusId;
          status.style.cssText = [
            'position:fixed',
            'right:16px',
            'bottom:88px',
            'z-index:10002',
            'padding:10px 14px',
            'border-radius:999px',
            'background:rgba(18,18,18,0.92)',
            'color:#fff',
            'font:600 13px/1.2 Inter, system-ui, sans-serif',
            'box-shadow:0 14px 34px rgba(0,0,0,0.24)',
            'opacity:0',
            'pointer-events:none',
            'transform:translateY(8px)',
            'transition:opacity 160ms ease, transform 160ms ease',
          ].join(';');
          status.textContent = 'Starting live chat...';
          document.body.appendChild(status);

          const fallback = document.createElement('div');
          fallback.id = chatFallbackId;
          fallback.hidden = false;
          fallback.style.cssText = [
            'position:fixed',
            'right:16px',
            'bottom:88px',
            'z-index:10002',
            'width:min(300px,calc(100vw - 32px))',
            'padding:16px',
            'border-radius:18px',
            'background:rgba(18,18,18,0.96)',
            'color:#fff',
            'box-shadow:0 18px 42px rgba(0,0,0,0.28)',
            'opacity:0',
            'visibility:hidden',
            'pointer-events:none',
            'transform:translateY(10px)',
            'transition:opacity 180ms ease, transform 180ms ease, visibility 180ms ease',
            'font-family:Inter, system-ui, sans-serif',
          ].join(';');
          fallback.innerHTML = `
            <div style="font-size:15px;font-weight:700;line-height:1.2;">Chat is taking longer than expected</div>
            <div style="margin-top:8px;font-size:13px;line-height:1.45;color:rgba(255,255,255,0.76);">
              Microsoft Teams is still loading. You can keep waiting or use another path.
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;">
              <button type="button" data-chat-fallback-action="wait" style="border:0;border-radius:999px;padding:9px 12px;background:#f30b0c;color:#fff;font:600 13px/1 Inter, system-ui, sans-serif;cursor:pointer;">Keep waiting</button>
              <a href="/contact" style="border-radius:999px;padding:9px 12px;background:rgba(255,255,255,0.08);color:#fff;text-decoration:none;font:600 13px/1 Inter, system-ui, sans-serif;">Book a demo</a>
              <a href="${salesMailto}" style="border-radius:999px;padding:9px 12px;background:rgba(255,255,255,0.08);color:#fff;text-decoration:none;font:600 13px/1 Inter, system-ui, sans-serif;">Email us</a>
            </div>
          `;

          fallback.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            if (!target.closest('[data-chat-fallback-action="wait"]')) return;
            setChatFallbackVisible(false);
            setChatStatusVisible(true, 'Still starting live chat...');
          });

          document.body.appendChild(fallback);
        };

        const bindChatStateTracking = () => {
          if (window.__triberaChatStateBound) return;
          window.__triberaChatStateBound = true;

          document.addEventListener(
            'click',
            (event) => {
              const target = event.target;
              if (!(target instanceof Element)) return;
              if (!target.closest('img[aria-label="Open Customer Connect chat bot assistant"]')) return;
              markChatOpening();
              setChatFallbackVisible(false);
              setChatStatusVisible(true);
              scheduleChatFallback();
            },
            true
          );

          window.addEventListener('message', (event) => {
            if (event.origin !== chatbotOrigin) return;
            if (event.data?.type !== 'toggle') return;

            const width = parseSize(event.data.width);
            const height = parseSize(event.data.height);
            if (width === null || height === null) return;

            const nextSize = { width, height };

            if (chatState.phase === 'opening' && !chatState.sawFirstToggleAfterOpen) {
              chatState.phase = 'open';
              chatState.sawFirstToggleAfterOpen = true;
              chatState.lastSize = nextSize;
              syncLauncherVisibility();
              hideChatAssistUi();
              dispatchChatState('chat-opened', { size: nextSize });
              return;
            }

            if (chatState.lastSize) {
              const delta = {
                width: nextSize.width - chatState.lastSize.width,
                height: nextSize.height - chatState.lastSize.height,
              };

              if (isMeaningfulMinimize(chatState.lastSize, nextSize)) {
                chatState.phase = 'minimized';
                syncLauncherVisibility();
                hideChatAssistUi();
                dispatchChatState('chat-minimized', { size: nextSize, delta });
              } else if (isMeaningfulExpand(chatState.lastSize, nextSize)) {
                chatState.phase = 'open';
                syncLauncherVisibility();
                hideChatAssistUi();
                dispatchChatState('chat-expanded', { size: nextSize, delta });
              }
            }

            chatState.lastSize = nextSize;
          });

          const observer = new MutationObserver(() => {
            const previous = chatState.launcherVisible;
            syncLauncherVisibility();

            if (!previous && chatState.launcherVisible && chatState.phase !== 'idle') {
              chatState.phase = 'minimized';
              hideChatAssistUi();
              dispatchChatState('chat-launcher-visible');
            }
          });

          observer.observe(document.body, { childList: true, subtree: true, attributes: true });
          syncLauncherVisibility();
        };

        const ensureChatbotScript = () => {
          let script = document.getElementById(chatbotScriptId);
          if (script instanceof HTMLScriptElement) return script;

          script = document.createElement('script');
          script.id = chatbotScriptId;
          script.async = true;
          script.type = 'text/javascript';
          script.src = chatbotScriptSrc;
          script.crossOrigin = 'anonymous';
          script.setAttribute('environmentId', environmentId);
          document.head.appendChild(script);

          return script;
        };

        const cleanup = () => {
          const iframe = document.getElementById(chatbotIframeId);
          if (iframe instanceof HTMLIFrameElement) {
            iframe.remove();
          }

          const script = document.getElementById(chatbotScriptId);
          if (script instanceof HTMLScriptElement) {
            script.remove();
          }

          const status = getChatStatus();
          if (status instanceof HTMLElement) {
            status.remove();
          }

          const fallback = getChatFallback();
          if (fallback instanceof HTMLElement) {
            fallback.remove();
          }

          clearFallbackTimer();

          window.__triberaChatbotCleanup = undefined;
        };

        window.__triberaChatbotCleanup = cleanup;
        document.addEventListener('astro:before-swap', cleanup, { once: true });

        if (!allowedHosts.has(window.location.hostname)) return;

        mountChatAssistUi();
        bindChatStateTracking();

        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          ensureChatbotScript();
        } else {
          window.addEventListener('DOMContentLoaded', ensureChatbotScript, { once: true });
        }
      })();
    </script>

    <!-- GLOBAL FULL-WIDTH SCROLL CTA -->
    <div
      id="scroll-cta"
      class="fixed bottom-0 left-0 right-0
         bg-white
         border-t border-black/10
         shadow-[0_-20px_50px_rgba(0,0,0,0.12)]
         translate-y-full opacity-0
         pointer-events-none
         transition-all duration-500 ease-out
         z-[90]"
      style="padding-bottom: env(safe-area-inset-bottom);"
    >
      <div
        class="max-w-6xl mx-auto
              px-4 sm:px-7 lg:px-10
              py-1.5 sm:py-3.5
              flex flex-col sm:flex-row
              items-center
              justify-between
              gap-1.5 sm:gap-5 relative
              pr-10 sm:pr-0"
      >
        <!-- LEFT TEXT -->
        <div class="text-center md:text-left">
          {
            isCandidatesPage ? (
              <>
                <div class="font-semibold text-[13px] sm:text-[16px] text-black">Ready to get discovered faster?</div>
                <div class="hidden sm:block mt-0.5 sm:mt-1 text-[12px] sm:text-[14px] text-black/60">
                  Build your profile once. Get matched with high-intent teams.
                </div>
              </>
            ) : (
              <>
                <div class="font-semibold text-[13px] sm:text-[16px] text-black">Ready to transform your hiring?</div>
                <div class="hidden sm:block mt-0.5 sm:mt-1 text-[12px] sm:text-[14px] text-black/60">
                  Join Fortune 500 teams using Tribera's AI-powered platform
                </div>
              </>
            )
          }
        </div>

        <!-- RIGHT ACTIONS -->
        <div class="flex items-center justify-center sm:justify-start gap-3 w-full sm:w-auto">
          {
            isCandidatesPage ? (
              <button
                type="button"
                data-create-profile
                class="px-4 sm:px-5 py-1.5 sm:py-2
               rounded-full
               tribera-primary-button
               text-[12px] sm:text-[13px] font-semibold
               "
              >
                Create Your Profile →
              </button>
            ) : (
              <button
                type="button"
                id="openDemoBtn"
                class="px-4 sm:px-6 py-1.5 sm:py-2.5
               rounded-full
               tribera-primary-button
               text-[12px] sm:text-[13px] font-semibold
               "
              >
                Book a Demo →
              </button>
            )
          }

          <button
            id="close-cta"
            class="absolute top-1.5 right-2.5
               sm:static
               w-6 h-6 sm:w-8 sm:h-8
               rounded-full
               border border-black/10
               flex items-center justify-center
               text-[11px] sm:text-[13px] text-black/40
               hover:text-black
               hover:bg-black/5
               transition"
          >
            ✕
          </button>
        </div>
      </div>
    </div>

    <div
      id="demoModal"
      class="fixed inset-0 hidden items-center justify-center
            bg-black/60 backdrop-blur-sm z-[1200] p-4"
    >
      <div class="relative bg-white w-full max-w-md rounded-2xl p-6 shadow-2xl">
        <button id="closeDemoBtn" class="absolute top-3 right-3 text-black/50 hover:text-black text-xl"> ✕ </button>

        <h3 class="text-[20px] font-[600] text-black mb-4">Book a Platform Demo</h3>

        <form id="demoForm" action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
          <input type="hidden" name="access_key" value="f3c09cb0-6c94-405e-af37-4f01141d40bd" />
          <input type="hidden" name="subject" value="New Demo Request - Tribera" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <input
            type="text"
            name="name"
            placeholder="Full Name"
            autocomplete="name"
            required
            class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]"
          />

          <input
            type="email"
            name="email"
            placeholder="Email Address"
            autocomplete="email"
            required
            class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]"
          />

          <input
            type="tel"
            name="phone"
            placeholder="Phone Number"
            autocomplete="tel"
            class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]"
          />

          <input
            type="text"
            name="company"
            placeholder="Company Name"
            autocomplete="organization"
            class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]"
          />

          <button
            id="demoSubmitBtn"
            type="submit"
            class="w-full tribera-primary-button py-3 rounded-lg
          text-[14px] font-semibold"
          >
            Submit
          </button>

          <div id="successMsg" class="hidden text-center pt-2">
            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#DA0007]/10 flex items-center justify-center">
              <svg
                viewBox="0 0 24 24"
                class="w-7 h-7 text-[#DA0007]"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>

            <h4 class="text-[20px] font-[700] text-black">Demo Request Submitted</h4>

            <p class="mt-2 text-[14px] leading-relaxed text-black/60">
              Thanks for reaching out. Our team will contact you shortly.
            </p>
          </div>

          <p id="demoErrorMsg" class="hidden text-[13px] text-black/60 text-center">
            Submission failed. Please try again in a moment.
          </p>
        </form>
      </div>
    </div>

    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <script>
      function initHowItWorksCTA() {
        if (window.__triberaHowItWorksCTAScroll) {
          window.removeEventListener('scroll', window.__triberaHowItWorksCTAScroll);
          window.__triberaHowItWorksCTAScroll = undefined;
        }

        if (window.__triberaHowItWorksCTAClose) {
          const previousCloseBtn = document.getElementById('close-cta');
          if (previousCloseBtn instanceof HTMLElement) {
            previousCloseBtn.removeEventListener('click', window.__triberaHowItWorksCTAClose);
          }
          window.__triberaHowItWorksCTAClose = undefined;
        }

        if (window.location.pathname !== '/') return;

        const section = document.getElementById('how-it-works');
        const cta = document.getElementById('scroll-cta');
        const closeBtn = document.getElementById('close-cta');

        if (!section || !cta) return;
        const sectionEl = section as HTMLElement;
        const ctaEl = cta as HTMLElement;

        if (window.__triberaHowItWorksCTAScroll) {
          window.removeEventListener('scroll', window.__triberaHowItWorksCTAScroll);
        }

        if (window.__triberaHowItWorksCTAClose && closeBtn instanceof HTMLElement) {
          closeBtn.removeEventListener('click', window.__triberaHowItWorksCTAClose);
        }

        let closedThisSession = false;

        function handleScroll() {
          if (closedThisSession) return;

          const sectionTop = sectionEl.offsetTop;
          const scrollPosition = window.scrollY + window.innerHeight * 0.4;

          if (scrollPosition >= sectionTop) {
            ctaEl.classList.remove('translate-y-full', 'opacity-0');
            ctaEl.classList.add('translate-y-0', 'opacity-100');
          } else {
            ctaEl.classList.add('translate-y-full', 'opacity-0');
            ctaEl.classList.remove('translate-y-0', 'opacity-100');
          }
        }

        const handleClose = () => {
          closedThisSession = true;

          ctaEl.classList.add('translate-y-full', 'opacity-0');
          ctaEl.classList.remove('translate-y-0', 'opacity-100');
        };

        closeBtn?.addEventListener('click', handleClose);
        window.addEventListener('scroll', handleScroll);
        window.__triberaHowItWorksCTAScroll = handleScroll;
        window.__triberaHowItWorksCTAClose = handleClose;
        handleScroll();
      }

      document.addEventListener('astro:before-swap', () => {
        if (window.__triberaHowItWorksCTAScroll) {
          window.removeEventListener('scroll', window.__triberaHowItWorksCTAScroll);
          window.__triberaHowItWorksCTAScroll = undefined;
        }

        if (window.__triberaHowItWorksCTAClose) {
          const closeBtn = document.getElementById('close-cta');
          if (closeBtn instanceof HTMLElement) {
            closeBtn.removeEventListener('click', window.__triberaHowItWorksCTAClose);
          }
          window.__triberaHowItWorksCTAClose = undefined;
        }
      });

      window.addEventListener('load', initHowItWorksCTA);
      document.addEventListener('astro:page-load', initHowItWorksCTA);
    </script>
  </body>
</html>
