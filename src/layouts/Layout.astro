---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import StructuredData from '~/components/common/StructuredData.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCandidatesPage = pathname === '/candidates';
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <StructuredData metadata={metadata} />
    <SiteVerification />
    <Analytics />
    <link rel="dns-prefetch" href="//res.public.onecdn.static.microsoft" />
    <link rel="dns-prefetch" href="//customerconnect.teams.usercontent.microsoft" />
    <link rel="dns-prefetch" href="//statics.teams.cdn.office.net" />
    <link rel="preconnect" href="https://res.public.onecdn.static.microsoft" crossorigin="anonymous" />
    <link rel="preconnect" href="https://customerconnect.teams.usercontent.microsoft" crossorigin="anonymous" />
    <link rel="preconnect" href="https://statics.teams.cdn.office.net" crossorigin="anonymous" />
    <link
      rel="preload"
      as="script"
      href="https://res.public.onecdn.static.microsoft/customerconnect/v1/7dttl/init.js"
      crossorigin="anonymous"
    />
    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="bg-page overflow-x-hidden">
    <Fragment
      set:html={`<script type="text/javascript" src="https://res.public.onecdn.static.microsoft/customerconnect/v1/7dttl/init.js" id="chatbot" environmentId="75186a18-80c9-e34b-b323-d376419f05d1" crossorigin="anonymous" async><\/script>`}
    />
    <script is:inline>
      (() => {
        const chatbotScriptId = 'chatbot';
        const chatbotScriptSrc = 'https://res.public.onecdn.static.microsoft/customerconnect/v1/7dttl/init.js';
        const environmentId = '75186a18-80c9-e34b-b323-d376419f05d1';
        const chatbotIframeId = 'teams-chat-bot-iframe-a3b60c17-95c7-4cba-8036-be9da15bcc26';
        const chatbotFrameSrc = `https://customerconnect.teams.usercontent.microsoft/customer-service-chatbot?environmentId=${environmentId}`;
        const prewarmIframeId = 'tribera-chatbot-prewarm-frame';
        const prewarmIdleTimeoutMs = 1200;
        const prewarmFallbackDelayMs = 600;
        const prewarmFrameTtlMs = 120000;
        const microsoftOrigins = [
          'https://res.public.onecdn.static.microsoft',
          'https://customerconnect.teams.usercontent.microsoft',
          'https://statics.teams.cdn.office.net',
        ];

        const getLauncher = () => document.querySelector('img[aria-label="Open Customer Connect chat bot assistant"]');
        const getIframe = () => document.getElementById(chatbotIframeId);
        const getLoader = () => document.querySelector('.chatclient-loader');
        const debugStore =
          window.__triberaChatDebug ||
          (window.__triberaChatDebug = {
            sessionStartedAt: Date.now(),
            events: [],
            resources: [],
          });
        const prewarmState =
          window.__triberaChatPrewarm ||
          (window.__triberaChatPrewarm = {
            requested: false,
            completed: false,
            timerId: null,
            cleanupTimerId: null,
          });
        const pushDebugEvent = (type, detail = {}) => {
          const entry = {
            type,
            ts: Date.now(),
            sinceSessionMs: Date.now() - debugStore.sessionStartedAt,
            ...detail,
          };
          debugStore.events.push(entry);
          console.log('[tribera-chat-debug]', entry);

          if (type === 'launcher-click') {
            console.info('[tribera-chat-timing] first-click started', entry);
          } else if (type === 'iframe-found') {
            console.info('[tribera-chat-timing] iframe inserted', entry);
          } else if (type === 'iframe-load') {
            console.info('[tribera-chat-timing] iframe loaded', entry);
          } else if (type === 'message') {
            console.info('[tribera-chat-timing] iframe message', entry);
          }

          return entry;
        };

        const recordIframeSnapshot = (reason) => {
          const iframe = getIframe();
          if (!(iframe instanceof HTMLIFrameElement)) return;

          pushDebugEvent(reason, {
            iframeSrc: iframe.src,
            width: iframe.style.width || null,
            height: iframe.style.height || null,
          });
        };

        const relevantResource = (name) => microsoftOrigins.some((origin) => name.startsWith(origin));
        const isWidgetMessage = (event) => {
          if (microsoftOrigins.includes(event.origin)) return true;

          const iframe = getIframe();
          if (!(iframe instanceof HTMLIFrameElement)) return false;

          try {
            return event.source === iframe.contentWindow;
          } catch {
            return false;
          }
        };

        const canPrewarmChat = () => {
          const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          if (!connection) return true;
          if (connection.saveData) return false;

          const effectiveType = String(connection.effectiveType || '').toLowerCase();
          return !effectiveType.includes('2g');
        };

        const removePrewarmFrame = () => {
          if (prewarmState.cleanupTimerId) {
            window.clearTimeout(prewarmState.cleanupTimerId);
            prewarmState.cleanupTimerId = null;
          }

          const frame = document.getElementById(prewarmIframeId);
          if (frame instanceof HTMLIFrameElement) {
            frame.remove();
            pushDebugEvent('prewarm-frame-removed');
          }
        };

        const ensurePrewarmFrame = () => {
          if (prewarmState.requested || prewarmState.completed) return;
          if (!canPrewarmChat()) return;
          if (getIframe() instanceof HTMLIFrameElement) return;

          prewarmState.requested = true;

          const start = () => {
            if (document.getElementById(prewarmIframeId)) return;
            if (getIframe() instanceof HTMLIFrameElement) return;

            const frame = document.createElement('iframe');
            frame.id = prewarmIframeId;
            frame.src = chatbotFrameSrc;
            frame.setAttribute('aria-hidden', 'true');
            frame.tabIndex = -1;
            frame.className = 'pointer-events-none fixed bottom-0 right-0 h-0 w-0 border-0 opacity-0';

            frame.addEventListener(
              'load',
              () => {
                prewarmState.completed = true;
                pushDebugEvent('prewarm-frame-load');
                prewarmState.cleanupTimerId = window.setTimeout(removePrewarmFrame, prewarmFrameTtlMs);
              },
              { once: true }
            );

            document.body.appendChild(frame);
            pushDebugEvent('prewarm-frame-created', { iframeSrc: chatbotFrameSrc });
            prewarmState.cleanupTimerId = window.setTimeout(removePrewarmFrame, prewarmFrameTtlMs);
          };

          if ('requestIdleCallback' in window) {
            prewarmState.timerId = window.requestIdleCallback(start, { timeout: prewarmIdleTimeoutMs });
            return;
          }

          prewarmState.timerId = window.setTimeout(start, prewarmFallbackDelayMs);
        };

        const observeResources = () => {
          if (!('PerformanceObserver' in window)) return;

          try {
            const observer = new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) {
                if (!relevantResource(entry.name)) continue;
                const resource = {
                  name: entry.name,
                  initiatorType: entry.initiatorType,
                  startTime: Math.round(entry.startTime),
                  duration: Math.round(entry.duration),
                  transferSize: entry.transferSize,
                };
                debugStore.resources.push(resource);
                console.log('[tribera-chat-resource]', resource);
                console.info('[tribera-chat-timing] resource', resource);
              }
            });

            observer.observe({ type: 'resource', buffered: true });
          } catch {
            // Ignore unsupported PerformanceObserver configurations.
          }
        };

        const observeIframeLifecycle = () => {
          const observer = new MutationObserver(() => {
            const iframe = getIframe();
            if (!(iframe instanceof HTMLIFrameElement)) return;
            if (iframe.dataset.triberaObserved === 'true') return;

            removePrewarmFrame();
            iframe.dataset.triberaObserved = 'true';
            recordIframeSnapshot('iframe-found');
            iframe.addEventListener('load', () => recordIframeSnapshot('iframe-load'));
          });

          observer.observe(document.body, { childList: true, subtree: true });
        };

        const removeChatbotArtifacts = () => {
          const script = document.getElementById(chatbotScriptId);
          if (script instanceof HTMLScriptElement) script.remove();

          const iframe = getIframe();
          if (iframe instanceof HTMLIFrameElement) iframe.remove();

          const launcher = getLauncher();
          if (launcher instanceof HTMLElement) launcher.remove();

          const loader = getLoader();
          if (loader instanceof HTMLElement) loader.remove();
        };

        const ensureChatbotScript = (forceRemount = false) => {
          let script = document.getElementById(chatbotScriptId);
          if (!forceRemount) {
            if (script instanceof HTMLScriptElement) return script;
          } else {
            removeChatbotArtifacts();
            script = null;
          }

          script = document.createElement('script');
          script.type = 'text/javascript';
          script.src = chatbotScriptSrc;
          script.id = chatbotScriptId;
          script.async = true;
          script.crossOrigin = 'anonymous';
          script.setAttribute('environmentId', environmentId);
          document.body.appendChild(script);
          return script;
        };

        const shouldReinitForLink = (link) => {
          if (!(link instanceof HTMLAnchorElement)) return false;
          if (!link.matches('[data-reload], [data-astro-reload]')) return false;
          if (!link.href) return false;

          try {
            const url = new URL(link.href, window.location.href);
            if (url.origin !== window.location.origin) return false;
            return url.protocol === 'http:' || url.protocol === 'https:';
          } catch {
            return false;
          }
        };

        const initChatbot = () => {
          ensureChatbotScript();
          ensurePrewarmFrame();
        };

        const reinitChatbotOnPageShow = () => {
          ensureChatbotScript();
          ensurePrewarmFrame();
        };

        document.addEventListener('astro:page-load', initChatbot);
        window.addEventListener('load', initChatbot);
        window.addEventListener('pageshow', reinitChatbotOnPageShow);
        window.addEventListener('message', (event) => {
          if (!isWidgetMessage(event)) return;
          pushDebugEvent('message', { origin: event.origin, data: event.data });
          recordIframeSnapshot('iframe-after-message');
        });

        document.addEventListener(
          'click',
          (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const link = target.closest('a');
            if (!shouldReinitForLink(link)) return;
            pushDebugEvent('nav-remount', { href: link.href });
            if (prewarmState.timerId) {
              if ('cancelIdleCallback' in window && typeof prewarmState.timerId === 'number') {
                window.cancelIdleCallback(prewarmState.timerId);
              } else {
                window.clearTimeout(prewarmState.timerId);
              }
              prewarmState.timerId = null;
            }
            prewarmState.requested = false;
            prewarmState.completed = false;
            removePrewarmFrame();
            ensureChatbotScript(true);
            ensurePrewarmFrame();
          },
          true
        );

        document.addEventListener(
          'click',
          (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const launcher = target.closest('img[aria-label="Open Customer Connect chat bot assistant"]');
            if (!(launcher instanceof HTMLImageElement)) return;
            pushDebugEvent('launcher-click', { ariaLabel: launcher.getAttribute('aria-label') });
          },
          true
        );

        observeResources();
        observeIframeLifecycle();
        ensurePrewarmFrame();
      })();
    </script>
    <slot />
    <BasicScripts />

    <!-- GLOBAL FULL-WIDTH SCROLL CTA -->
    <div
      id="scroll-cta"
      class="fixed bottom-0 left-0 right-0
         bg-white
         border-t border-black/10
         shadow-[0_-20px_50px_rgba(0,0,0,0.12)]
         translate-y-full opacity-0
         pointer-events-none
         transition-all duration-500 ease-out
         z-[90]"
      style="padding-bottom: env(safe-area-inset-bottom);"
    >
      <div
        class="max-w-6xl mx-auto
              px-4 sm:px-7 lg:px-10
              py-1.5 sm:py-3.5
              flex flex-col sm:flex-row
              items-center
              justify-between
              gap-1.5 sm:gap-5 relative
              pr-10 sm:pr-0"
      >
        <!-- LEFT TEXT -->
        <div class="text-center md:text-left">
          {
            isCandidatesPage ? (
              <>
                <div class="font-semibold text-[13px] sm:text-[16px] text-black">Ready to get discovered faster?</div>
                <div class="hidden sm:block mt-0.5 sm:mt-1 text-[12px] sm:text-[14px] text-black/60">
                  Build your profile once. Get matched with high-intent teams.
                </div>
              </>
            ) : (
              <>
                <div class="font-semibold text-[13px] sm:text-[16px] text-black">Ready to transform your hiring?</div>
                <div class="hidden sm:block mt-0.5 sm:mt-1 text-[12px] sm:text-[14px] text-black/60">
                  Join Fortune 500 teams using Tribera's AI-powered platform
                </div>
              </>
            )
          }
        </div>

        <!-- RIGHT ACTIONS -->
        <div class="flex items-center justify-center sm:justify-start gap-3 w-full sm:w-auto">
          {
            isCandidatesPage ? (
              <button
                type="button"
                data-create-profile
                class="px-4 sm:px-5 py-1.5 sm:py-2
               rounded-full
               tribera-primary-button
               text-[12px] sm:text-[13px] font-semibold
               "
              >
                Create Your Profile →
              </button>
            ) : (
              <button
                type="button"
                id="openDemoBtn"
                class="px-4 sm:px-6 py-1.5 sm:py-2.5
               rounded-full
               tribera-primary-button
               text-[12px] sm:text-[13px] font-semibold
               "
              >
                Book a Demo →
              </button>
            )
          }

          <button
            id="close-cta"
            class="absolute top-1.5 right-2.5
               sm:static
               w-6 h-6 sm:w-8 sm:h-8
               rounded-full
               border border-black/10
               flex items-center justify-center
               text-[11px] sm:text-[13px] text-black/40
               hover:text-black
               hover:bg-black/5
               transition"
          >
            ✕
          </button>
        </div>
      </div>
    </div>

    <div
      id="demoModal"
      class="fixed inset-0 hidden items-center justify-center
            bg-black/60 backdrop-blur-sm z-[1200] p-4"
    >
      <div class="relative bg-white w-full max-w-md rounded-2xl p-6 shadow-2xl">
        <button id="closeDemoBtn" class="absolute top-3 right-3 text-black/50 hover:text-black text-xl"> ✕ </button>

        <h3 class="text-[20px] font-[600] text-black mb-4">Book a Platform Demo</h3>

        <form id="demoForm" action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
          <input type="hidden" name="access_key" value="f3c09cb0-6c94-405e-af37-4f01141d40bd" />
          <input type="hidden" name="subject" value="New Demo Request - Tribera" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <input
            type="text"
            name="name"
            placeholder="Full Name"
            autocomplete="name"
            required
            class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]"
          />

          <input
            type="email"
            name="email"
            placeholder="Email Address"
            autocomplete="email"
            required
            class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]"
          />

          <input
            type="tel"
            name="phone"
            placeholder="Phone Number"
            autocomplete="tel"
            class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]"
          />

          <input
            type="text"
            name="company"
            placeholder="Company Name"
            autocomplete="organization"
            class="w-full border border-black/20 rounded-lg px-4 py-3 text-[14px]"
          />

          <button
            id="demoSubmitBtn"
            type="submit"
            class="w-full tribera-primary-button py-3 rounded-lg
          text-[14px] font-semibold"
          >
            Submit
          </button>

          <div id="successMsg" class="hidden text-center pt-2">
            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#DA0007]/10 flex items-center justify-center">
              <svg
                viewBox="0 0 24 24"
                class="w-7 h-7 text-[#DA0007]"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>

            <h4 class="text-[20px] font-[700] text-black">Demo Request Submitted</h4>

            <p class="mt-2 text-[14px] leading-relaxed text-black/60">
              Thanks for reaching out. Our team will contact you shortly.
            </p>
          </div>

          <p id="demoErrorMsg" class="hidden text-[13px] text-black/60 text-center">
            Submission failed. Please try again in a moment.
          </p>
        </form>
      </div>
    </div>

    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <script>
      function initHowItWorksCTA() {
        if (window.__triberaHowItWorksCTAScroll) {
          window.removeEventListener('scroll', window.__triberaHowItWorksCTAScroll);
          window.__triberaHowItWorksCTAScroll = undefined;
        }

        if (window.__triberaHowItWorksCTAClose) {
          const previousCloseBtn = document.getElementById('close-cta');
          if (previousCloseBtn instanceof HTMLElement) {
            previousCloseBtn.removeEventListener('click', window.__triberaHowItWorksCTAClose);
          }
          window.__triberaHowItWorksCTAClose = undefined;
        }

        if (window.location.pathname !== '/') return;

        const section = document.getElementById('how-it-works');
        const cta = document.getElementById('scroll-cta');
        const closeBtn = document.getElementById('close-cta');

        if (!section || !cta) return;
        const sectionEl = section as HTMLElement;
        const ctaEl = cta as HTMLElement;

        if (window.__triberaHowItWorksCTAScroll) {
          window.removeEventListener('scroll', window.__triberaHowItWorksCTAScroll);
        }

        if (window.__triberaHowItWorksCTAClose && closeBtn instanceof HTMLElement) {
          closeBtn.removeEventListener('click', window.__triberaHowItWorksCTAClose);
        }

        let closedThisSession = false;

        function handleScroll() {
          if (closedThisSession) return;

          const sectionTop = sectionEl.offsetTop;
          const scrollPosition = window.scrollY + window.innerHeight * 0.4;

          if (scrollPosition >= sectionTop) {
            ctaEl.classList.remove('translate-y-full', 'opacity-0');
            ctaEl.classList.add('translate-y-0', 'opacity-100');
          } else {
            ctaEl.classList.add('translate-y-full', 'opacity-0');
            ctaEl.classList.remove('translate-y-0', 'opacity-100');
          }
        }

        const handleClose = () => {
          closedThisSession = true;

          ctaEl.classList.add('translate-y-full', 'opacity-0');
          ctaEl.classList.remove('translate-y-0', 'opacity-100');
        };

        closeBtn?.addEventListener('click', handleClose);
        window.addEventListener('scroll', handleScroll);
        window.__triberaHowItWorksCTAScroll = handleScroll;
        window.__triberaHowItWorksCTAClose = handleClose;
        handleScroll();
      }

      document.addEventListener('astro:before-swap', () => {
        if (window.__triberaHowItWorksCTAScroll) {
          window.removeEventListener('scroll', window.__triberaHowItWorksCTAScroll);
          window.__triberaHowItWorksCTAScroll = undefined;
        }

        if (window.__triberaHowItWorksCTAClose) {
          const closeBtn = document.getElementById('close-cta');
          if (closeBtn instanceof HTMLElement) {
            closeBtn.removeEventListener('click', window.__triberaHowItWorksCTAClose);
          }
          window.__triberaHowItWorksCTAClose = undefined;
        }
      });

      window.addEventListener('load', initHowItWorksCTA);
      document.addEventListener('astro:page-load', initHowItWorksCTA);
    </script>
  </body>
</html>
