---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
const isChatEnabledHost = Astro.url.hostname === 'www.tribera.ai';
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <link
      rel="preload"
      href="/fonts/figtree-800.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-tight-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <StructuredData metadata={metadata} />
    <SiteVerification />
    <Analytics />
    {
      isChatEnabledHost && (
        <>
          <link rel="dns-prefetch" href="//res.public.onecdn.static.microsoft" />
          <link rel="dns-prefetch" href="//customerconnect.teams.usercontent.microsoft" />
          <link rel="dns-prefetch" href="//statics.teams.cdn.office.net" />
          <link rel="preconnect" href="https://res.public.onecdn.static.microsoft" crossorigin="anonymous" />
          <link rel="preconnect" href="https://customerconnect.teams.usercontent.microsoft" crossorigin="anonymous" />
          <link rel="preconnect" href="https://statics.teams.cdn.office.net" crossorigin="anonymous" />
          <link
            rel="preload"
            as="script"
            href="https://res.public.onecdn.static.microsoft/customerconnect/v1/7dttl/init.js"
            crossorigin="anonymous"
          />
        </>
      )
    }
  </head>

  <body class="bg-page overflow-x-hidden">
    <script is:inline>
      (() => {
        if (!window.location || window.location.hostname !== 'www.tribera.ai') return;
        const runtimeVersion = '2026-03-23.1';
        const runtimeKey = '__triberaChatRuntime';
        const existingRuntime = window[runtimeKey];
        if (existingRuntime?.version === runtimeVersion) {
          existingRuntime.handlePageVisit?.('chat-inline-bootstrap-reuse');
          return;
        }

        existingRuntime?.teardown?.();
        const chatbotScriptId = 'chatbot';
        const chatbotScriptSrc = 'https://res.public.onecdn.static.microsoft/customerconnect/v1/7dttl/init.js';
        const environmentId = '75186a18-80c9-e34b-b323-d376419f05d1';
        const chatbotIframeId = 'teams-chat-bot-iframe-a3b60c17-95c7-4cba-8036-be9da15bcc26';
        const chatbotFrameSrc = `https://customerconnect.teams.usercontent.microsoft/customer-service-chatbot?environmentId=${environmentId}`;
        const prewarmIframeId = 'tribera-chatbot-prewarm-frame';
        const chatStatusBadgeId = 'tribera-chat-status-badge';
        const chatStatusTimeoutMs = 10000;
        const prewarmIdleTimeoutMs = 1200;
        const prewarmFallbackDelayMs = 600;
        const prewarmFrameTtlMs = 120000;
        const microsoftOrigins = [
          'https://res.public.onecdn.static.microsoft',
          'https://customerconnect.teams.usercontent.microsoft',
          'https://statics.teams.cdn.office.net',
        ];

        const getLauncher = () => document.querySelector('img[aria-label="Open Customer Connect chat bot assistant"]');
        const getIframe = () => document.getElementById(chatbotIframeId);
        const getPrewarmFrame = () => document.getElementById(prewarmIframeId);
        const getLoader = () => document.querySelector('.chatclient-loader');
        const getWidgetStyles = () =>
          Array.from(document.querySelectorAll('style')).filter(
            (node) =>
              node instanceof HTMLStyleElement &&
              /chatclient-button|chatclient-loader|teams-chat-bot-iframe/i.test(node.textContent || '')
          );
        const chatRuntime = {
          version: runtimeVersion,
          scriptRequested: false,
          scriptLoaded: false,
          iframeObserver: null,
          pageLoadHandler: null,
          loadHandler: null,
          pageShowHandler: null,
          beforeSwapHandler: null,
          prewarmMessageCaptureHandler: null,
          messageHandler: null,
          navClickHandler: null,
          launcherClickHandler: null,
          preservedNodes: {
            script: null,
            iframe: null,
            launcher: null,
            loader: null,
            badge: null,
            styles: [],
          },
          teardown() {
            if (this.pageLoadHandler) document.removeEventListener('astro:page-load', this.pageLoadHandler);
            if (this.loadHandler) window.removeEventListener('load', this.loadHandler);
            if (this.pageShowHandler) window.removeEventListener('pageshow', this.pageShowHandler);
            if (this.beforeSwapHandler) document.removeEventListener('astro:before-swap', this.beforeSwapHandler);
            if (this.prewarmMessageCaptureHandler) {
              window.removeEventListener('message', this.prewarmMessageCaptureHandler, true);
            }
            if (this.messageHandler) window.removeEventListener('message', this.messageHandler);
            if (this.navClickHandler) document.removeEventListener('click', this.navClickHandler, true);
            if (this.launcherClickHandler) document.removeEventListener('click', this.launcherClickHandler, true);
            this.iframeObserver?.disconnect?.();
          },
          handlePageVisit: null,
        };
        window[runtimeKey] = chatRuntime;
        const prewarmState =
          window.__triberaChatPrewarm ||
          (window.__triberaChatPrewarm = {
            requested: false,
            completed: false,
            timerId: null,
            cleanupTimerId: null,
          });
        const chatStatusState =
          window.__triberaChatStatus ||
          (window.__triberaChatStatus = {
            visible: false,
            timeoutId: null,
          });
        const isWidgetMessage = (event) => {
          if (microsoftOrigins.includes(event.origin)) return true;

          const iframe = getIframe();
          if (!(iframe instanceof HTMLIFrameElement)) return false;

          try {
            return event.source === iframe.contentWindow;
          } catch {
            return false;
          }
        };

        const isPrewarmMessage = (event) => {
          if (!microsoftOrigins.includes(event.origin)) return false;

          const frame = getPrewarmFrame();
          if (!(frame instanceof HTMLIFrameElement)) return false;

          try {
            return event.source === frame.contentWindow;
          } catch {
            return false;
          }
        };

        const canPrewarmChat = () => {
          const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          if (!connection) return true;
          if (connection.saveData) return false;

          const effectiveType = String(connection.effectiveType || '').toLowerCase();
          return !effectiveType.includes('2g');
        };

        const ensureChatStatusBadge = () => {
          let badge = document.getElementById(chatStatusBadgeId);
          if (badge instanceof HTMLDivElement) return badge;

          badge = document.createElement('div');
          badge.id = chatStatusBadgeId;
          badge.className =
            'pointer-events-none fixed bottom-[98px] right-5 z-[10020] hidden w-[260px] rounded-[22px] border border-white/10 bg-[rgba(14,14,16,0.92)] px-4 py-3 text-white shadow-[0_20px_60px_rgba(0,0,0,0.38)] backdrop-blur';
          badge.innerHTML = `
            <div class="flex items-start gap-3">
              <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#da0007] text-white shadow-[0_8px_24px_rgba(218,0,7,0.28)]">
                <span class="h-2.5 w-2.5 rounded-full bg-white animate-pulse"></span>
              </span>
              <div class="min-w-0">
                <div class="text-[13px] font-semibold leading-5 text-white">Connecting to chat</div>
                <div class="mt-1 text-[12px] leading-5 text-white/65">Andy’s on the way.</div>
              </div>
            </div>
          `;
          document.body.appendChild(badge);
          return badge;
        };

        const clearChatStatusTimeout = () => {
          if (chatStatusState.timeoutId) {
            window.clearTimeout(chatStatusState.timeoutId);
            chatStatusState.timeoutId = null;
          }
        };

        const setChatStatusVisible = (visible) => {
          const badge = ensureChatStatusBadge();
          chatStatusState.visible = visible;
          badge.classList.toggle('hidden', !visible);
          badge.classList.toggle('block', visible);

          if (!visible) {
            clearChatStatusTimeout();
          }
        };

        const showConnectingStatus = () => {
          setChatStatusVisible(true);
          clearChatStatusTimeout();
          chatStatusState.timeoutId = window.setTimeout(() => {
            setChatStatusVisible(false);
          }, chatStatusTimeoutMs);
        };

        const preserveNode = (key, node) => {
          if (!(node instanceof HTMLElement)) return;
          chatRuntime.preservedNodes[key] = node;
        };

        const preserveWidgetStyles = () => {
          chatRuntime.preservedNodes.styles = getWidgetStyles();
        };

        const clearPreservedArtifacts = () => {
          chatRuntime.preservedNodes.script = null;
          chatRuntime.preservedNodes.iframe = null;
          chatRuntime.preservedNodes.launcher = null;
          chatRuntime.preservedNodes.loader = null;
          chatRuntime.preservedNodes.badge = null;
          chatRuntime.preservedNodes.styles = [];
        };

        const preserveChatArtifacts = () => {
          preserveNode('script', document.getElementById(chatbotScriptId));
          preserveNode('iframe', getIframe());
          preserveNode('launcher', getLauncher());
          preserveNode('loader', getLoader());
          preserveNode('badge', document.getElementById(chatStatusBadgeId));
          preserveWidgetStyles();
        };

        const reattachPreservedArtifacts = () => {
          if (!(document.body instanceof HTMLBodyElement)) return;

          for (const styleNode of chatRuntime.preservedNodes.styles) {
            if (!(styleNode instanceof HTMLStyleElement)) continue;
            if (styleNode.isConnected) continue;
            document.body.appendChild(styleNode);
          }

          for (const [key, node] of Object.entries(chatRuntime.preservedNodes)) {
            if (key === 'styles') continue;
            if (!(node instanceof HTMLElement)) continue;
            if (node.isConnected) continue;
            document.body.appendChild(node);
          }
        };

        const removePrewarmFrame = () => {
          if (prewarmState.cleanupTimerId) {
            window.clearTimeout(prewarmState.cleanupTimerId);
            prewarmState.cleanupTimerId = null;
          }

          const frame = document.getElementById(prewarmIframeId);
          if (frame instanceof HTMLIFrameElement) {
            frame.remove();
          }
        };

        const ensurePrewarmFrame = () => {
          if (prewarmState.requested || prewarmState.completed) return;
          if (!canPrewarmChat()) return;
          if (getIframe() instanceof HTMLIFrameElement) return;

          prewarmState.requested = true;

          const start = () => {
            if (document.getElementById(prewarmIframeId)) return;
            if (getIframe() instanceof HTMLIFrameElement) return;

            const frame = document.createElement('iframe');
            frame.id = prewarmIframeId;
            frame.src = chatbotFrameSrc;
            frame.setAttribute('aria-hidden', 'true');
            frame.tabIndex = -1;
            frame.className = 'pointer-events-none fixed bottom-0 right-0 h-0 w-0 border-0 opacity-0';

            frame.addEventListener(
              'load',
              () => {
                prewarmState.completed = true;
                prewarmState.cleanupTimerId = window.setTimeout(removePrewarmFrame, prewarmFrameTtlMs);
              },
              { once: true }
            );

            document.body.appendChild(frame);
            prewarmState.cleanupTimerId = window.setTimeout(removePrewarmFrame, prewarmFrameTtlMs);
          };

          if ('requestIdleCallback' in window) {
            prewarmState.timerId = window.requestIdleCallback(start, { timeout: prewarmIdleTimeoutMs });
            return;
          }

          prewarmState.timerId = window.setTimeout(start, prewarmFallbackDelayMs);
        };

        const observeIframeLifecycle = () => {
          if (chatRuntime.iframeObserver) return;

          chatRuntime.iframeObserver = new MutationObserver(() => {
            const iframe = getIframe();
            if (!(iframe instanceof HTMLIFrameElement)) return;
            if (iframe.dataset.triberaObserved === 'true') return;

            removePrewarmFrame();
            iframe.dataset.triberaObserved = 'true';
            iframe.addEventListener('load', () => {
              setChatStatusVisible(false);
            });
          });

          chatRuntime.iframeObserver.observe(document.body, { childList: true, subtree: true });
        };

        const removeChatbotArtifacts = () => {
          const script = document.getElementById(chatbotScriptId);
          const iframe = getIframe();
          const launcher = getLauncher();
          const loader = getLoader();
          const styles = getWidgetStyles();

          if (script instanceof HTMLScriptElement) script.remove();
          if (iframe instanceof HTMLIFrameElement) iframe.remove();
          if (launcher instanceof HTMLElement) launcher.remove();
          if (loader instanceof HTMLElement) loader.remove();
          for (const styleNode of styles) {
            styleNode.remove();
          }
        };

        const ensureChatbotScript = (forceRemount = false) => {
          let script = document.getElementById(chatbotScriptId);
          if (!forceRemount) {
            if (script instanceof HTMLScriptElement) {
              preserveNode('script', script);
              return script;
            }
            if (chatRuntime.scriptRequested || chatRuntime.scriptLoaded) {
              reattachPreservedArtifacts();
              return null;
            }
          } else {
            removeChatbotArtifacts();
            script = null;
            chatRuntime.scriptRequested = false;
            chatRuntime.scriptLoaded = false;
          }

          script = document.createElement('script');
          script.type = 'text/javascript';
          script.src = chatbotScriptSrc;
          script.id = chatbotScriptId;
          script.async = true;
          script.crossOrigin = 'anonymous';
          script.setAttribute('environmentId', environmentId);
          script.addEventListener(
            'load',
            () => {
              chatRuntime.scriptRequested = false;
              chatRuntime.scriptLoaded = true;
              script.dataset.triberaLoaded = 'true';
              preserveNode('script', script);
            },
            { once: true }
          );
          script.addEventListener(
            'error',
            () => {
              chatRuntime.scriptRequested = false;
              chatRuntime.scriptLoaded = false;
            },
            { once: true }
          );
          chatRuntime.scriptRequested = true;
          document.body.appendChild(script);
          preserveNode('script', script);
          return script;
        };

        const shouldReinitForLink = (link) => {
          if (!(link instanceof HTMLAnchorElement)) return false;
          if (!link.matches('[data-reload], [data-astro-reload]')) return false;
          if (!link.href) return false;

          try {
            const url = new URL(link.href, window.location.href);
            if (url.origin !== window.location.origin) return false;
            return url.protocol === 'http:' || url.protocol === 'https:';
          } catch {
            return false;
          }
        };

        const initChatbot = (_source = 'unknown') => {
          reattachPreservedArtifacts();
          ensureChatbotScript();
          ensurePrewarmFrame();
        };

        const reinitChatbotOnPageShow = () => {
          reattachPreservedArtifacts();
          ensureChatbotScript();
          ensurePrewarmFrame();
        };

        chatRuntime.handlePageVisit = (source = 'runtime:handlePageVisit') => {
          reattachPreservedArtifacts();
          initChatbot(source);
        };
        chatRuntime.pageLoadHandler = () => initChatbot('astro:page-load');
        chatRuntime.loadHandler = () => initChatbot('window:load');
        chatRuntime.pageShowHandler = reinitChatbotOnPageShow;
        chatRuntime.beforeSwapHandler = () => {
          const iframe = getIframe();
          if (iframe instanceof HTMLIFrameElement) {
            preserveChatArtifacts();
          } else {
            removeChatbotArtifacts();
            clearPreservedArtifacts();
            chatRuntime.scriptRequested = false;
            chatRuntime.scriptLoaded = false;
          }
          removePrewarmFrame();
          setChatStatusVisible(false);
        };
        chatRuntime.prewarmMessageCaptureHandler = (event) => {
          if (!isPrewarmMessage(event)) return;
          if (getIframe() instanceof HTMLIFrameElement) return;

          const messageType =
            event.data && typeof event.data === 'object' && 'type' in event.data ? String(event.data.type) : '';

          if (!['toggle', 'resize'].includes(messageType)) return;
          event.stopImmediatePropagation();
        };
        chatRuntime.messageHandler = (event) => {
          if (!isWidgetMessage(event)) return;
          preserveChatArtifacts();
          setChatStatusVisible(false);
        };
        chatRuntime.navClickHandler = (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('a');
          if (!shouldReinitForLink(link)) return;
          preserveChatArtifacts();
          if (prewarmState.timerId) {
            if ('cancelIdleCallback' in window && typeof prewarmState.timerId === 'number') {
              window.cancelIdleCallback(prewarmState.timerId);
            } else {
              window.clearTimeout(prewarmState.timerId);
            }
            prewarmState.timerId = null;
          }
          prewarmState.requested = false;
          prewarmState.completed = false;
          removePrewarmFrame();
          setChatStatusVisible(false);
        };
        chatRuntime.launcherClickHandler = (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const launcher = target.closest('img[aria-label="Open Customer Connect chat bot assistant"]');
          if (!(launcher instanceof HTMLImageElement)) return;
          preserveChatArtifacts();
          showConnectingStatus();
        };
        document.addEventListener('astro:page-load', chatRuntime.pageLoadHandler);
        window.addEventListener('load', chatRuntime.loadHandler);
        window.addEventListener('pageshow', chatRuntime.pageShowHandler);
        document.addEventListener('astro:before-swap', chatRuntime.beforeSwapHandler);
        window.addEventListener('message', chatRuntime.prewarmMessageCaptureHandler, true);
        window.addEventListener('message', chatRuntime.messageHandler);
        document.addEventListener('click', chatRuntime.navClickHandler, true);
        document.addEventListener('click', chatRuntime.launcherClickHandler, true);

        observeIframeLifecycle();
        preserveChatArtifacts();
        ensurePrewarmFrame();
      })();
    </script>
    <script is:inline>
      (() => {
        if (window.__triberaFullReloadLinksBound) return;
        window.__triberaFullReloadLinksBound = true;

        const normalizePathname = (value) => value.replace(/\/index\.html$/, '').replace(/\/+$/, '') || '/';

        document.addEventListener(
          'click',
          (event) => {
            if (event.defaultPrevented) return;
            if (event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

            const target = event.target;
            if (!(target instanceof Element)) return;

            const link = target.closest('a[href]');
            if (!(link instanceof HTMLAnchorElement)) return;
            if (!link.href) return;
            if (link.target && link.target !== '_self') return;
            if (link.hasAttribute('download')) return;

            let url;
            try {
              url = new URL(link.href, window.location.href);
            } catch {
              return;
            }

            if (url.origin !== window.location.origin) return;
            if (url.protocol !== 'http:' && url.protocol !== 'https:') return;

            const currentPath = normalizePathname(window.location.pathname);
            const nextPath = normalizePathname(url.pathname);

            if (currentPath === nextPath) return;

            event.preventDefault();
            window.location.assign(url.href);
          },
          true
        );
      })();
    </script>
    <slot />
    <BasicScripts />

    <div id="demoModal" class="fixed inset-0 z-[1200] hidden overflow-y-auto bg-black/55 px-4 py-6 sm:px-6 sm:py-8">
      <div class="pointer-events-none flex min-h-full items-center justify-center">
        <div
          class="pointer-events-auto relative w-full max-w-[560px] overflow-hidden rounded-[30px] border border-white/10 bg-[#0a0a0a] px-6 py-6 text-white shadow-[0_28px_100px_rgba(0,0,0,0.45)] sm:px-8 sm:py-8"
        >
          <div
            class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#DA0007]/80 to-transparent"
          >
          </div>
          <div class="pointer-events-none absolute -left-20 top-0 h-52 w-52 rounded-full bg-[#DA0007]/12 blur-3xl">
          </div>
          <div class="pointer-events-none absolute -right-16 bottom-0 h-44 w-44 rounded-full bg-white/[0.04] blur-3xl">
          </div>
          <button
            id="closeDemoBtn"
            type="button"
            class="absolute right-4 top-4 z-20 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/[0.02] p-0 text-white/45 transition-colors duration-200 hover:border-[#DA0007]/35 hover:bg-[#DA0007]/12 hover:text-white/85"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="h-[18px] w-[18px]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
            >
              <path d="M6 6L18 18" stroke-linecap="round"></path>
              <path d="M18 6L6 18" stroke-linecap="round"></path>
            </svg>
          </button>

          <div class="relative">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#DA0007]">For Hiring Teams</p>
            <h3 class="pr-12 text-[1.5rem] font-[640] leading-[1.02] tracking-[-0.035em] text-white sm:text-[1.8rem]">
              Book a Platform Demo
            </h3>
            <p class="mt-4 max-w-[28rem] text-[14px] leading-7 text-white/58 sm:text-[15px]">
              Tell us about your team and hiring goals. We will set up the right walkthrough.
            </p>
          </div>

          <form
            id="demoForm"
            action="/.netlify/functions/site-inquiry"
            method="POST"
            class="relative mt-7 space-y-4 sm:mt-8"
          >
            <input type="hidden" name="form_type" value="demo" />
            <input type="hidden" name="form_loaded_at" value="" data-form-loaded-at />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <div class="grid gap-3.5 sm:grid-cols-2 sm:gap-4">
              <input
                type="text"
                name="name"
                placeholder="Full name"
                autocomplete="name"
                required
                class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
              />

              <input
                type="email"
                name="email"
                placeholder="Work email"
                autocomplete="email"
                required
                class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
              />
            </div>

            <div class="grid gap-3.5 sm:grid-cols-2 sm:gap-4">
              <input
                type="tel"
                name="phone"
                placeholder="Phone number"
                autocomplete="tel"
                class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
              />

              <input
                type="text"
                name="company"
                placeholder="Company name"
                autocomplete="organization"
                class="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3.5 text-[14px] text-white placeholder:text-white/35 focus:border-[#DA0007]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-1 focus:ring-[#DA0007]/25"
              />
            </div>

            <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-[12px] leading-6 text-white/35">We typically respond within 24 hours.</p>
              <button
                id="demoSubmitBtn"
                type="submit"
                class="w-full rounded-full bg-[#DA0007] px-8 py-3 text-[14px] font-semibold text-white transition hover:bg-[#b80005] sm:w-auto"
              >
                Request a demo
              </button>
            </div>

            <div id="successMsg" class="hidden pt-2 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#DA0007]/10">
                <svg
                  viewBox="0 0 24 24"
                  class="w-7 h-7 text-[#DA0007]"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="M20 7L10 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>

              <h4 class="text-[20px] font-[700] text-white">Demo Request Submitted</h4>

              <p class="mt-2 text-[14px] leading-relaxed text-white/60">
