---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import ContactSalesModal from '~/components/ContactSalesModal.astro';

import { headerData, footerData } from '~/navigation';

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header {...headerData} isSticky showToggleTheme />
  </slot>

  <main class="w-full overflow-x-hidden">
    <slot />
  </main>

  <ContactSalesModal />
  <slot name="footer">
    <Footer {...footerData} />
  </slot>

  <script is:inline>
    (() => {
      if (window.__triberaDirectionalTrigger) return;

      window.__triberaCountAnimationConfig = {
        durationMs: 1200,
        steps: 72,
      };

      const defaultThresholds = {
        mobile: {
          downEnter: 0.72,
          upEnter: 0.38,
          topExit: 0.08,
          bottomExit: 0.92,
        },
        desktop: {
          downEnter: 0.62,
          upEnter: 0.34,
          topExit: 0.14,
          bottomExit: 0.86,
        },
      };

      window.__triberaDirectionalTrigger = ({ element, onEnter, onExit, thresholds = {} }) => {
        if (!(element instanceof HTMLElement)) return () => {};

        let active = false;
        let rafId = null;
        let lastScrollY = window.scrollY;

        const getThresholds = () => {
          const isMobile = window.innerWidth < 768;
          const base = isMobile ? defaultThresholds.mobile : defaultThresholds.desktop;
          const override = isMobile ? thresholds.mobile || {} : thresholds.desktop || {};
          return { ...base, ...override };
        };

        const getDirection = () => {
          const currentScrollY = window.scrollY;
          const direction = currentScrollY > lastScrollY ? 'down' : currentScrollY < lastScrollY ? 'up' : 'idle';
          lastScrollY = currentScrollY;
          return direction;
        };

        const shouldActivate = (direction) => {
          const rect = element.getBoundingClientRect();
          const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
          const nextThresholds = getThresholds();
          const downEnterLine = viewportHeight * nextThresholds.downEnter;
          const upEnterLine = viewportHeight * nextThresholds.upEnter;

          if (direction === 'up') {
            return rect.bottom >= upEnterLine && rect.top < viewportHeight;
          }

          return rect.top <= downEnterLine && rect.bottom > 0;
        };

        const shouldReset = () => {
          const rect = element.getBoundingClientRect();
          const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
          const nextThresholds = getThresholds();
          const topExitLine = viewportHeight * nextThresholds.topExit;
          const bottomExitLine = viewportHeight * nextThresholds.bottomExit;

          return rect.bottom <= topExitLine || rect.top >= bottomExitLine;
        };

        const evaluate = () => {
          const direction = getDirection();
          const activate = shouldActivate(direction);
          const reset = shouldReset();

          if (!active && activate) {
            active = true;
            onEnter?.();
            return;
          }

          if (active && reset) {
            active = false;
            onExit?.();
          }
        };

        const requestEvaluate = () => {
          if (rafId) return;
          rafId = window.requestAnimationFrame(() => {
            rafId = null;
            evaluate();
          });
        };

        requestEvaluate();
        window.addEventListener('scroll', requestEvaluate, { passive: true });
        window.addEventListener('resize', requestEvaluate);

        return () => {
          if (rafId) {
            window.cancelAnimationFrame(rafId);
            rafId = null;
          }
          window.removeEventListener('scroll', requestEvaluate);
          window.removeEventListener('resize', requestEvaluate);
        };
      };
    })();
  </script>

  <script is:inline>
    function initCTAAndModal() {
      if (window.__triberaCTAAndModalInit) return;
      window.__triberaCTAAndModalInit = true;

      const cta = document.getElementById('scroll-cta');
      const modal = document.getElementById('demoModal');
      const successMsg = document.getElementById('successMsg');
      const errorMsg = document.getElementById('demoErrorMsg');
      const form = document.getElementById('demoForm');
      const submitBtn = document.getElementById('demoSubmitBtn');

      let lastScrollY = window.scrollY;
      let closed = false;

      function showCTA() {
        cta.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
        cta.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }

      function hideCTA() {
        cta.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
        cta.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }

      // Scroll behavior
      if (cta) {
        window.addEventListener(
          'scroll',
          () => {
            if (closed) return;

            const currentY = window.scrollY;

            if (currentY > lastScrollY && currentY > 200) {
              showCTA();
            }

            if (currentY < lastScrollY) {
              hideCTA();
            }

            lastScrollY = currentY;
          },
          { passive: true }
        );
      }

      // 🔥 GLOBAL CLICK HANDLER (Astro-safe)
      document.addEventListener('click', (e) => {
        // Open modal
        if (e.target.closest('#openDemoBtn, [data-open-demo]')) {
          e.preventDefault();
          modal?.classList.remove('hidden');
          modal?.classList.add('flex');
        }

        // Close modal (X button)
        if (e.target.closest('#closeDemoBtn')) {
          modal?.classList.add('hidden');
          modal?.classList.remove('flex');
        }

        // Close CTA
        if (e.target.closest('#close-cta')) {
          closed = true;
          hideCTA();
        }

        // Click outside modal
        if (e.target.id === 'demoModal') {
          modal?.classList.add('hidden');
          modal?.classList.remove('flex');
        }
      });

      // Form submit
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);

        const originalBtnText = submitBtn?.textContent;
        if (submitBtn) {
          submitBtn.textContent = 'Submitting...';
          submitBtn.setAttribute('disabled', 'true');
        }

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          const result = await res.json();
          if (!res.ok || !result.success) {
            throw new Error(result.message || 'Submission failed');
          }

          form.reset();
          successMsg?.classList.remove('hidden');

          setTimeout(() => {
            successMsg?.classList.add('hidden');
            modal?.classList.add('hidden');
            modal?.classList.remove('flex');
          }, 3000);
        } catch (error) {
          console.error('Demo form submit failed:', error);
          errorMsg?.classList.remove('hidden');
        } finally {
          if (submitBtn) {
            submitBtn.textContent = originalBtnText || 'Submit';
            submitBtn.removeAttribute('disabled');
          }
        }
      });
    }

    // Astro-safe init
    document.addEventListener('astro:page-load', initCTAAndModal);
    window.addEventListener('load', initCTAAndModal);
  </script>

  <script is:inline>
    function initSamePageSectionLinks() {
      if (window.__triberaSamePageSectionLinksBound) return;
      window.__triberaSamePageSectionLinksBound = true;

      const normalizePath = (path) => {
        const clean = path
          .split('#')[0]
          .replace(/\/index\.html$/, '')
          .replace(/\/+$/, '');
        return clean || '/';
      };

      const isSectionInFocus = (target) => {
        if (!(target instanceof HTMLElement)) return false;

        const rect = target.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const visibleTop = Math.max(rect.top, 0);
        const visibleBottom = Math.min(rect.bottom, viewportHeight);
        const visibleHeight = Math.max(visibleBottom - visibleTop, 0);
        const targetHeight = Math.max(Math.min(rect.height, viewportHeight), 1);

        return visibleHeight / targetHeight >= 0.55;
      };

      const getAlignedTop = (target) => {
        if (!(target instanceof HTMLElement)) return 0;

        const targetTop = target.getBoundingClientRect().top + window.scrollY;
        const scrollMarginTop = Number.parseFloat(window.getComputedStyle(target).scrollMarginTop);
        const offset = Number.isFinite(scrollMarginTop) ? scrollMarginTop : 88;
        return Math.max(targetTop - offset, 0);
      };

      const nudgeToSection = (target) => {
        if (!(target instanceof HTMLElement)) return;

        const alignedTop = getAlignedTop(target);
        const overshootTop = Math.max(alignedTop - 36, 0);

        window.scrollTo({ top: overshootTop, behavior: 'smooth' });
        window.setTimeout(() => {
          window.scrollTo({ top: alignedTop, behavior: 'smooth' });
        }, 120);
      };

      document.addEventListener('click', (event) => {
        if (event.defaultPrevented) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (event.button !== 0) return;

        const link = event.target instanceof Element ? event.target.closest('a[href*="#"]') : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        if (!link.hash || link.hash === '#') return;
        if (link.target && link.target !== '_self') return;
        if (link.hasAttribute('download')) return;

        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin) return;

        const currentPath = normalizePath(window.location.pathname);
        const targetPath = normalizePath(url.pathname);
        if (currentPath !== targetPath) return;

        const hash = decodeURIComponent(url.hash.slice(1));
        const target = document.getElementById(hash);
        if (!target) return;

        event.preventDefault();

        if (window.location.hash !== `#${hash}`) {
          window.history.replaceState({}, '', `#${hash}`);
        }

        if (isSectionInFocus(target)) {
          nudgeToSection(target);
          return;
        }

        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    initSamePageSectionLinks();
    document.addEventListener('astro:page-load', initSamePageSectionLinks);
  </script>
  <script is:inline>
    function initMailtoFallback() {
      if (window.__triberaMailtoFallbackBound) return;
      window.__triberaMailtoFallbackBound = true;

      const toastId = 'tribera-mailto-fallback';
      const shownSessionKey = '__triberaMailtoFallbackShown';

      const isLikelyMacDesktop = () => {
        const userAgentData = navigator.userAgentData;
        const platformFromUAData =
          userAgentData && typeof userAgentData.platform === 'string' ? userAgentData.platform : '';
        const platform = platformFromUAData || navigator.platform || '';
        const userAgent = navigator.userAgent || '';
        const maxTouchPoints = Number(navigator.maxTouchPoints || 0);

        const isMacPlatform = /mac/i.test(platform) || /\bmac os x\b/i.test(userAgent);
        const isIOSDevice = /iphone|ipad|ipod/i.test(platform) || /iphone|ipad|ipod/i.test(userAgent);

        return isMacPlatform && !isIOSDevice && maxTouchPoints < 2;
      };

      const shouldShowMailtoFallback = () => {
        if (!isLikelyMacDesktop()) return false;
        if (window.sessionStorage?.getItem(shownSessionKey) === 'true') return false;
        return true;
      };

      const ensureToast = () => {
        let toast = document.getElementById(toastId);
        if (toast) return toast;

        toast = document.createElement('div');
        toast.id = toastId;
        toast.className =
          'fixed left-1/2 bottom-5 z-[1300] hidden w-[calc(100%-2rem)] max-w-md -translate-x-1/2 rounded-2xl border border-white/10 bg-black/95 p-4 text-white shadow-[0_20px_60px_rgba(0,0,0,0.45)] backdrop-blur';
        toast.innerHTML = `
          <div class="flex items-start gap-3">
            <div class="mt-0.5 h-2.5 w-2.5 shrink-0 rounded-full bg-[#da0007]"></div>
            <div class="min-w-0 flex-1">
              <p class="text-[13px] font-semibold">If your email app did not open</p>
              <p class="mt-1 text-[12px] leading-relaxed text-white/65">
                Email <span class="font-semibold text-white">sales@tribera.ai</span> directly or continue on the contact page.
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center rounded-full bg-[#da0007] px-3 py-1.5 text-[11px] font-semibold text-white transition hover:bg-[#c10006]"
                >
                  Open Contact Page
                </a>
                <button
                  type="button"
                  data-copy-sales-email
                  class="inline-flex items-center justify-center rounded-full border border-white/15 px-3 py-1.5 text-[11px] font-semibold text-white/85 transition hover:border-white/30 hover:text-white"
                >
                  Copy Email
                </button>
                <button
                  type="button"
                  data-close-mailto-fallback
                  class="inline-flex items-center justify-center rounded-full border border-white/15 px-3 py-1.5 text-[11px] font-semibold text-white/65 transition hover:border-white/30 hover:text-white"
                >
                  Dismiss
                </button>
              </div>
            </div>
          </div>
        `;

        document.body.appendChild(toast);
        return toast;
      };

      const hideToast = () => {
        const toast = document.getElementById(toastId);
        if (!toast) return;
        toast.classList.add('hidden');
      };

      document.addEventListener('click', async (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;

        const copyBtn = target.closest('[data-copy-sales-email]');
        if (copyBtn) {
          try {
            await navigator.clipboard.writeText('sales@tribera.ai');
            copyBtn.textContent = 'Copied';
          } catch {
            copyBtn.textContent = 'Copy failed';
          }

          window.setTimeout(() => {
            if (copyBtn instanceof HTMLElement) copyBtn.textContent = 'Copy Email';
          }, 1600);
          return;
        }

        if (target.closest('[data-close-mailto-fallback]')) {
          hideToast();
          return;
        }

        if (event.defaultPrevented) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (event.button !== 0) return;

        const link = target.closest('a[data-mailto-fallback]');
        if (!(link instanceof HTMLAnchorElement)) return;
        if (!link.href.startsWith('mailto:')) return;

        event.preventDefault();
        hideToast();
        window.location.href = link.href;

        if (!shouldShowMailtoFallback()) return;

        window.clearTimeout(window.__triberaMailtoFallbackTimer);
        window.__triberaMailtoFallbackTimer = window.setTimeout(() => {
          if (document.visibilityState === 'hidden') return;
          const toast = ensureToast();
          window.sessionStorage?.setItem(shownSessionKey, 'true');
          toast.classList.remove('hidden');
        }, 1800);
      });

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
          hideToast();
        }
      });
    }

    initMailtoFallback();
    document.addEventListener('astro:page-load', initMailtoFallback);
  </script>
  <script is:inline defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <script is:inline>
    function initCandidateSection() {
      const section = document.getElementById('platform-overview');
      const scorecard = document.getElementById('candidateScorecard');
      if (!section || !scorecard) return;
      if (typeof scorecard.__candidateTriggerCleanup === 'function') {
        scorecard.__candidateTriggerCleanup();
      }

      let barTimeouts = [];
      const bars = Array.from(scorecard.querySelectorAll('.metric-bar'));

      const reset = () => {
        barTimeouts.forEach((timeoutId) => window.clearTimeout(timeoutId));
        barTimeouts = [];

        bars.forEach((bar) => {
          if (bar instanceof HTMLElement) {
            bar.style.width = '0%';
          }
        });
      };

      const animate = () => {
        reset();
        bars.forEach((bar, index) => {
          if (!(bar instanceof HTMLElement)) return;
          const targetWidth = bar.dataset.width;

          const timeoutId = window.setTimeout(() => {
            bar.style.width = targetWidth || '0%';
          }, index * 260);
          barTimeouts.push(timeoutId);
        });
      };

      reset();
      scorecard.__candidateTriggerCleanup = window.__triberaDirectionalTrigger({
        element: scorecard,
        onEnter: animate,
        onExit: reset,
      });
    }

    /* FIRST LOAD */
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCandidateSection();
    } else {
      document.addEventListener('DOMContentLoaded', initCandidateSection);
    }

    /* ASTRO NAVIGATION */
    document.addEventListener('astro:page-load', initCandidateSection);
  </script>

  <script is:inline>
    function initProofSection() {
      const section = document.getElementById('proof');
      if (!section) return;

      if (typeof section.__proofCleanup === 'function') {
        section.__proofCleanup();
      }

      let barTimeoutId = null;
      const counterFrames = new Map();

      const counters = Array.from(section.querySelectorAll('.count-number'));
      const bar = section.querySelector('#triberaBar');
      const countersGrid = section.querySelector('#proofCountersGrid');
      const efficiencyCard = section.querySelector('#proofInterviewEfficiencyCard');

      const resetCounters = () => {
        counters.forEach((counter) => {
          const frameId = counterFrames.get(counter);
          if (frameId) {
            cancelAnimationFrame(frameId);
            counterFrames.delete(counter);
          }

          counter.innerText = '0';
        });
      };

      const animateCounters = () => {
        resetCounters();

        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            counters.forEach((counter) => {
              const target = Number(counter.dataset.target);
              const countConfig = window.__triberaCountAnimationConfig || { durationMs: 1200, steps: 72 };
              let current = 0;
              const increment = target / countConfig.steps;

              const update = () => {
                current += increment;

                if (current < target) {
                  counter.innerText = String(Math.floor(current));
                  const frameId = requestAnimationFrame(update);
                  counterFrames.set(counter, frameId);
                  return;
                }

                counter.innerText = String(target);
                counterFrames.delete(counter);
              };

              update();
            });
          });
        });
      };

      const resetBar = () => {
        if (!bar) return;
        if (barTimeoutId) {
          clearTimeout(barTimeoutId);
          barTimeoutId = null;
        }

        bar.style.transition = 'none';
        bar.style.width = '0%';
        void bar.offsetWidth;
        bar.style.transition = '';
      };

      const cleanup = () => {
        resetCounters();
        resetBar();
      };

      const animateBar = () => {
        if (!bar) return;
        resetBar();
        barTimeoutId = window.setTimeout(() => {
          bar.style.width = '37%';
          barTimeoutId = null;
        }, 400);
      };

      const counterTriggerCleanup =
        countersGrid instanceof HTMLElement
          ? window.__triberaDirectionalTrigger({
              element: countersGrid,
              onEnter: animateCounters,
              onExit: resetCounters,
            })
          : () => {};

      const barTriggerCleanup =
        efficiencyCard instanceof HTMLElement
          ? window.__triberaDirectionalTrigger({
              element: efficiencyCard,
              onEnter: animateBar,
              onExit: resetBar,
            })
          : () => {};

      section.__proofCleanup = () => {
        counterTriggerCleanup();
        barTriggerCleanup();
        cleanup();
      };
    }

    /* FIRST LOAD */
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initProofSection();
    } else {
      document.addEventListener('DOMContentLoaded', initProofSection);
    }

    /* ASTRO NAVIGATION SUPPORT */
    document.addEventListener('astro:page-load', initProofSection);
  </script>

  <script is:inline>
    function parseDurationToMs(raw) {
      const value = String(raw || '').trim();
      if (!value) return 70000;
      if (value.endsWith('ms')) return Number.parseFloat(value) || 70000;
      if (value.endsWith('s')) return (Number.parseFloat(value) || 70) * 1000;
      return Number.parseFloat(value) || 70000;
    }

    function initCustomerMarquee() {
      const marquees = document.querySelectorAll('[data-customer-marquee]');
      if (!marquees.length) return;

      marquees.forEach((marquee) => {
        if (marquee.dataset.marqueeInitialized === 'true') return;
        marquee.dataset.marqueeInitialized = 'true';

        const track = marquee.querySelector('.customer-marquee-track');
        const groups = marquee.querySelectorAll('.customer-marquee-group');
        if (!track || groups.length < 2) return;

        const firstGroup = groups[0];
        const secondGroup = groups[1];
        const mobileQuery = window.matchMedia('(max-width: 640px)');
        const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

        let groupWidth = 0;
        let pxPerMs = 0;
        let offset = 0;
        let lastTs = 0;
        let rafId = 0;
        let paused = false;
        let destroyed = false;
        let ro = null;

        const durationMs = parseDurationToMs(getComputedStyle(track).getPropertyValue('--customer-marquee-duration'));
        const pixelRatio = Math.max(1, window.devicePixelRatio || 1);

        // Remove seam-prone CSS infinite loop once JS takes over.
        track.classList.remove('animate-customer-marquee');

        const shouldAnimate = () => !mobileQuery.matches && !reduceMotionQuery.matches && groupWidth > 0.5;

        const measure = () => {
          const firstRect = firstGroup.getBoundingClientRect();
          const secondRect = secondGroup.getBoundingClientRect();
          const shift = secondRect.left - firstRect.left;

          if (shift > 0.5) {
            groupWidth = shift;
            pxPerMs = groupWidth / durationMs;
          }
        };

        const handleResize = () => {
          measure();
          if (!shouldAnimate()) {
            offset = 0;
            track.style.transform = 'translate3d(0,0,0)';
          }
          lastTs = 0;
        };

        const handleMouseEnter = () => {
          paused = true;
        };

        const handleMouseLeave = () => {
          paused = false;
        };

        const destroy = () => {
          if (destroyed) return;
          destroyed = true;

          if (rafId) cancelAnimationFrame(rafId);
          rafId = 0;
          window.removeEventListener('resize', handleResize);
          marquee.removeEventListener('mouseenter', handleMouseEnter);
          marquee.removeEventListener('mouseleave', handleMouseLeave);
          marquee.removeEventListener('focusin', handleMouseEnter);
          marquee.removeEventListener('focusout', handleMouseLeave);
          if (mobileQuery.removeEventListener) mobileQuery.removeEventListener('change', handleResize);
          if (reduceMotionQuery.removeEventListener) reduceMotionQuery.removeEventListener('change', handleResize);
          if (ro) ro.disconnect();
        };

        const tick = (ts) => {
          if (!document.body.contains(marquee)) {
            destroy();
            return;
          }

          if (!lastTs) lastTs = ts;
          const dt = ts - lastTs;
          lastTs = ts;

          if (!paused && shouldAnimate()) {
            offset += dt * pxPerMs;
            if (offset >= groupWidth) offset -= groupWidth;

            // Snap to physical pixels to avoid compositor seam jitter at wrap.
            const snappedOffset = Math.round(offset * pixelRatio) / pixelRatio;
            track.style.transform = `translate3d(${-snappedOffset}px,0,0)`;
          }

          rafId = requestAnimationFrame(tick);
        };

        measure();
        handleResize();
        window.addEventListener('resize', handleResize, { passive: true });

        if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', handleResize);
        if (reduceMotionQuery.addEventListener) reduceMotionQuery.addEventListener('change', handleResize);

        marquee.addEventListener('mouseenter', handleMouseEnter);
        marquee.addEventListener('mouseleave', handleMouseLeave);
        marquee.addEventListener('focusin', handleMouseEnter);
        marquee.addEventListener('focusout', handleMouseLeave);

        if ('ResizeObserver' in window) {
          ro = new ResizeObserver(handleResize);
          ro.observe(firstGroup);
          ro.observe(secondGroup);
          ro.observe(track);
        }

        rafId = requestAnimationFrame(tick);
      });
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCustomerMarquee();
    } else {
      document.addEventListener('DOMContentLoaded', initCustomerMarquee);
    }

    document.addEventListener('astro:page-load', initCustomerMarquee);
  </script>
</Layout>
