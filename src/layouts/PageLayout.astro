---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import ContactSalesModal from '~/components/ContactSalesModal.astro';

import { headerData, footerData } from '~/navigation';

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header {...headerData} isSticky showToggleTheme />
  </slot>

  <main class="w-full overflow-x-hidden">
    <slot />
  </main>

  <ContactSalesModal />
  <slot name="footer">
    <Footer {...footerData} />
  </slot>

  <script is:inline>
    function initCTAAndModal() {
      if (window.__triberaCTAAndModalInit) return;
      window.__triberaCTAAndModalInit = true;

      const cta = document.getElementById('scroll-cta');
      const modal = document.getElementById('demoModal');
      const successMsg = document.getElementById('successMsg');
      const errorMsg = document.getElementById('demoErrorMsg');
      const form = document.getElementById('demoForm');
      const submitBtn = document.getElementById('demoSubmitBtn');

      if (!cta) return;

      let lastScrollY = window.scrollY;
      let closed = false;

      function showCTA() {
        cta.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
        cta.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }

      function hideCTA() {
        cta.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
        cta.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }

      // Scroll behavior
      window.addEventListener(
        'scroll',
        () => {
          if (closed) return;

          const currentY = window.scrollY;

          if (currentY > lastScrollY && currentY > 200) {
            showCTA();
          }

          if (currentY < lastScrollY) {
            hideCTA();
          }

          lastScrollY = currentY;
        },
        { passive: true }
      );

      // 🔥 GLOBAL CLICK HANDLER (Astro-safe)
      document.addEventListener('click', (e) => {
        // Open modal
        if (e.target.closest('#openDemoBtn, [data-open-demo]')) {
          modal?.classList.remove('hidden');
          modal?.classList.add('flex');
        }

        // Close modal (X button)
        if (e.target.closest('#closeDemoBtn')) {
          modal?.classList.add('hidden');
          modal?.classList.remove('flex');
        }

        // Close CTA
        if (e.target.closest('#close-cta')) {
          closed = true;
          hideCTA();
        }

        // Click outside modal
        if (e.target.id === 'demoModal') {
          modal?.classList.add('hidden');
          modal?.classList.remove('flex');
        }
      });

      // Form submit
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);

        const originalBtnText = submitBtn?.textContent;
        if (submitBtn) {
          submitBtn.textContent = 'Submitting...';
          submitBtn.setAttribute('disabled', 'true');
        }

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          const result = await res.json();
          if (!res.ok || !result.success) {
            throw new Error(result.message || 'Submission failed');
          }

          form.reset();
          successMsg?.classList.remove('hidden');

          setTimeout(() => {
            successMsg?.classList.add('hidden');
            modal?.classList.add('hidden');
            modal?.classList.remove('flex');
          }, 3000);
        } catch (error) {
          console.error('Demo form submit failed:', error);
          errorMsg?.classList.remove('hidden');
        } finally {
          if (submitBtn) {
            submitBtn.textContent = originalBtnText || 'Submit';
            submitBtn.removeAttribute('disabled');
          }
        }
      });
    }

    // Astro-safe init
    document.addEventListener('astro:page-load', initCTAAndModal);
    window.addEventListener('load', initCTAAndModal);
  </script>

  <script>
    function initHeroScroll() {
      const heroes = document.querySelectorAll<HTMLElement>('.hero-section');

      if (!heroes.length) return;

      heroes.forEach((hero) => {
        if (hero.dataset.heroScrollBound === 'true') return;
        hero.dataset.heroScrollBound = 'true';

        const content = hero.querySelector('.hero-content');
        if (!content) return;
        const contentEl = content as HTMLElement;

        let lastScrollY = window.scrollY;
        let ticking = false;

        function onScroll() {
          if (ticking) return;

          ticking = true;

          requestAnimationFrame(() => {
            const currentY = window.scrollY;
            const heroTop = hero.offsetTop;
            const heroHeight = hero.offsetHeight;

            if (currentY >= heroTop && currentY <= heroTop + heroHeight) {
              const delta = Math.min(Math.max((currentY - heroTop) / heroHeight, 0), 1);

              // ✅ ONLY when scrolling DOWN
              if (currentY > lastScrollY) {
                contentEl.style.transform = `
          translateY(${delta * -40}px)
          scale(${1 - delta * 0.04})
        `;
                contentEl.style.opacity = `${1 - delta * 1.1}`;
                contentEl.style.filter = `blur(${delta * 4}px)`;
              }

              // ✅ When scrolling UP → instantly reset
              if (currentY < lastScrollY) {
                contentEl.style.transform = 'translateY(0px) scale(1)';
                contentEl.style.opacity = '1';
                contentEl.style.filter = 'blur(0px)';
              }
            }

            lastScrollY = currentY;
            ticking = false;
          });
        }

        window.addEventListener('scroll', onScroll, { passive: true });
      });
    }

    // INITIAL LOAD
    initHeroScroll();

    // IMPORTANT: RE-INIT ON ASTRO PAGE CHANGE
    document.addEventListener('astro:page-load', () => {
      initHeroScroll();
    });
  </script>
  <script is:inline>
    function initSamePageSectionLinks() {
      if (window.__triberaSamePageSectionLinksBound) return;
      window.__triberaSamePageSectionLinksBound = true;

      const normalizePath = (path) => {
        const clean = path.split('#')[0].replace(/\/index\.html$/, '').replace(/\/+$/, '');
        return clean || '/';
      };

      const isSectionInFocus = (target) => {
        if (!(target instanceof HTMLElement)) return false;

        const rect = target.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const visibleTop = Math.max(rect.top, 0);
        const visibleBottom = Math.min(rect.bottom, viewportHeight);
        const visibleHeight = Math.max(visibleBottom - visibleTop, 0);
        const targetHeight = Math.max(Math.min(rect.height, viewportHeight), 1);

        return visibleHeight / targetHeight >= 0.55;
      };

      const getAlignedTop = (target) => {
        if (!(target instanceof HTMLElement)) return 0;

        const targetTop = target.getBoundingClientRect().top + window.scrollY;
        const scrollMarginTop = Number.parseFloat(window.getComputedStyle(target).scrollMarginTop);
        const offset = Number.isFinite(scrollMarginTop) ? scrollMarginTop : 88;
        return Math.max(targetTop - offset, 0);
      };

      const nudgeToSection = (target) => {
        if (!(target instanceof HTMLElement)) return;

        const alignedTop = getAlignedTop(target);
        const overshootTop = Math.max(alignedTop - 36, 0);

        window.scrollTo({ top: overshootTop, behavior: 'smooth' });
        window.setTimeout(() => {
          window.scrollTo({ top: alignedTop, behavior: 'smooth' });
        }, 120);
      };

      document.addEventListener('click', (event) => {
        if (event.defaultPrevented) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (event.button !== 0) return;

        const link = event.target instanceof Element ? event.target.closest('a[href*="#"]') : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        if (!link.hash || link.hash === '#') return;
        if (link.target && link.target !== '_self') return;
        if (link.hasAttribute('download')) return;

        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin) return;

        const currentPath = normalizePath(window.location.pathname);
        const targetPath = normalizePath(url.pathname);
        if (currentPath !== targetPath) return;

        const hash = decodeURIComponent(url.hash.slice(1));
        const target = document.getElementById(hash);
        if (!target) return;

        event.preventDefault();

        if (window.location.hash !== `#${hash}`) {
          window.history.replaceState({}, '', `#${hash}`);
        }

        if (isSectionInFocus(target)) {
          nudgeToSection(target);
          return;
        }

        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    initSamePageSectionLinks();
    document.addEventListener('astro:page-load', initSamePageSectionLinks);
  </script>
  <script is:inline defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <script is:inline>
    function initCandidateSection() {
      const section = document.getElementById('platform-overview');
      const scorecard = document.getElementById('candidateScorecard');
      if (!section || !scorecard) return;

      let barsAnimated = false;
      const bars = Array.from(scorecard.querySelectorAll('.metric-bar'));

      bars.forEach((bar) => {
        if (bar instanceof HTMLElement) {
          bar.style.width = '0%';
        }
      });

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting || barsAnimated) return;

          barsAnimated = true;

          bars.forEach((bar, index) => {
            if (!(bar instanceof HTMLElement)) return;
            const targetWidth = bar.dataset.width;

            setTimeout(() => {
              bar.style.width = targetWidth || '0%';
            }, index * 260);
          });

          observer.disconnect();
        },
        { threshold: 0.65 }
      );

      observer.observe(scorecard);
    }

    /* FIRST LOAD */
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCandidateSection();
    } else {
      document.addEventListener('DOMContentLoaded', initCandidateSection);
    }

    /* ASTRO NAVIGATION */
    document.addEventListener('astro:page-load', initCandidateSection);
  </script>

  <script is:inline>
    function initProofSection() {
      const section = document.getElementById('proof');
      if (!section) return;

      if (typeof section.__proofCleanup === 'function') {
        section.__proofCleanup();
      }

      let barFilled = false;
      let barTimeoutId = null;
      const counterFrames = new Map();

      const counters = Array.from(section.querySelectorAll('.count-number'));
      const bar = section.querySelector('#triberaBar');

      const resetCounters = () => {
        counters.forEach((counter) => {
          const frameId = counterFrames.get(counter);
          if (frameId) {
            cancelAnimationFrame(frameId);
            counterFrames.delete(counter);
          }

          counter.innerText = '0';
        });
      };

      const animateCounters = () => {
        resetCounters();

        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            counters.forEach((counter) => {
              const target = Number(counter.dataset.target);
              let current = 0;
              const increment = target / 40;

              const update = () => {
                current += increment;

                if (current < target) {
                  counter.innerText = String(Math.floor(current));
                  const frameId = requestAnimationFrame(update);
                  counterFrames.set(counter, frameId);
                  return;
                }

                counter.innerText = String(target);
                counterFrames.delete(counter);
              };

              update();
            });
          });
        });
      };

      const resetBar = () => {
        if (!bar) return;
        if (barTimeoutId) {
          clearTimeout(barTimeoutId);
          barTimeoutId = null;
        }

        barFilled = false;
        bar.style.transition = 'none';
        bar.style.width = '0%';
        void bar.offsetWidth;
        bar.style.transition = '';
      };

      const cleanup = () => {
        resetCounters();
        resetBar();
        observer.disconnect();
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];

          if (entry.isIntersecting) {
            animateCounters();

            /* ===== FILL BAR (replays on every re-entry) ===== */
            if (bar && !barFilled) {
              barFilled = true;

              // Reset without animation, then trigger fill transition.
              bar.style.transition = 'none';
              bar.style.width = '0%';
              void bar.offsetWidth;
              bar.style.transition = '';

              barTimeoutId = window.setTimeout(() => {
                bar.style.width = '37%';
                barTimeoutId = null;
              }, 400);
            }
            return;
          }

          resetCounters();
          resetBar();
        },
        { threshold: 0.3 }
      );

      observer.observe(section);
      section.__proofCleanup = cleanup;
    }

    /* FIRST LOAD */
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initProofSection();
    } else {
      document.addEventListener('DOMContentLoaded', initProofSection);
    }

    /* ASTRO NAVIGATION SUPPORT */
    document.addEventListener('astro:page-load', initProofSection);
  </script>

  <script is:inline>
    function parseDurationToMs(raw) {
      const value = String(raw || '').trim();
      if (!value) return 70000;
      if (value.endsWith('ms')) return Number.parseFloat(value) || 70000;
      if (value.endsWith('s')) return (Number.parseFloat(value) || 70) * 1000;
      return Number.parseFloat(value) || 70000;
    }

    function initCustomerMarquee() {
      const marquees = document.querySelectorAll('[data-customer-marquee]');
      if (!marquees.length) return;

      marquees.forEach((marquee) => {
        if (marquee.dataset.marqueeInitialized === 'true') return;
        marquee.dataset.marqueeInitialized = 'true';

        const track = marquee.querySelector('.customer-marquee-track');
        const groups = marquee.querySelectorAll('.customer-marquee-group');
        if (!track || groups.length < 2) return;

        const firstGroup = groups[0];
        const secondGroup = groups[1];
        const mobileQuery = window.matchMedia('(max-width: 640px)');
        const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

        let groupWidth = 0;
        let pxPerMs = 0;
        let offset = 0;
        let lastTs = 0;
        let rafId = 0;
        let paused = false;
        let destroyed = false;
        let ro = null;

        const durationMs = parseDurationToMs(getComputedStyle(track).getPropertyValue('--customer-marquee-duration'));
        const pixelRatio = Math.max(1, window.devicePixelRatio || 1);

        // Remove seam-prone CSS infinite loop once JS takes over.
        track.classList.remove('animate-customer-marquee');

        const shouldAnimate = () => !mobileQuery.matches && !reduceMotionQuery.matches && groupWidth > 0.5;

        const measure = () => {
          const firstRect = firstGroup.getBoundingClientRect();
          const secondRect = secondGroup.getBoundingClientRect();
          const shift = secondRect.left - firstRect.left;

          if (shift > 0.5) {
            groupWidth = shift;
            pxPerMs = groupWidth / durationMs;
          }
        };

        const handleResize = () => {
          measure();
          if (!shouldAnimate()) {
            offset = 0;
            track.style.transform = 'translate3d(0,0,0)';
          }
          lastTs = 0;
        };

        const handleMouseEnter = () => {
          paused = true;
        };

        const handleMouseLeave = () => {
          paused = false;
        };

        const destroy = () => {
          if (destroyed) return;
          destroyed = true;

          if (rafId) cancelAnimationFrame(rafId);
          rafId = 0;
          window.removeEventListener('resize', handleResize);
          marquee.removeEventListener('mouseenter', handleMouseEnter);
          marquee.removeEventListener('mouseleave', handleMouseLeave);
          marquee.removeEventListener('focusin', handleMouseEnter);
          marquee.removeEventListener('focusout', handleMouseLeave);
          if (mobileQuery.removeEventListener) mobileQuery.removeEventListener('change', handleResize);
          if (reduceMotionQuery.removeEventListener) reduceMotionQuery.removeEventListener('change', handleResize);
          if (ro) ro.disconnect();
        };

        const tick = (ts) => {
          if (!document.body.contains(marquee)) {
            destroy();
            return;
          }

          if (!lastTs) lastTs = ts;
          const dt = ts - lastTs;
          lastTs = ts;

          if (!paused && shouldAnimate()) {
            offset += dt * pxPerMs;
            if (offset >= groupWidth) offset -= groupWidth;

            // Snap to physical pixels to avoid compositor seam jitter at wrap.
            const snappedOffset = Math.round(offset * pixelRatio) / pixelRatio;
            track.style.transform = `translate3d(${-snappedOffset}px,0,0)`;
          }

          rafId = requestAnimationFrame(tick);
        };

        measure();
        handleResize();
        window.addEventListener('resize', handleResize, { passive: true });

        if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', handleResize);
        if (reduceMotionQuery.addEventListener) reduceMotionQuery.addEventListener('change', handleResize);

        marquee.addEventListener('mouseenter', handleMouseEnter);
        marquee.addEventListener('mouseleave', handleMouseLeave);
        marquee.addEventListener('focusin', handleMouseEnter);
        marquee.addEventListener('focusout', handleMouseLeave);

        if ('ResizeObserver' in window) {
          ro = new ResizeObserver(handleResize);
          ro.observe(firstGroup);
          ro.observe(secondGroup);
          ro.observe(track);
        }

        rafId = requestAnimationFrame(tick);
      });
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCustomerMarquee();
    } else {
      document.addEventListener('DOMContentLoaded', initCustomerMarquee);
    }

    document.addEventListener('astro:page-load', initCustomerMarquee);
  </script>
</Layout>
