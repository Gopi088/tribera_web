---
import Layout from '~/layouts/PageLayout.astro';
import EditorialHeading from '~/components/v58/EditorialHeading.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    robots?: MetaData['robots'];
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
  robots: frontmatter?.robots,
};
---

<Layout metadata={metadata}>
  <section class="legal-document">
    <EditorialHeading as="h1">
      {frontmatter.title}
    </EditorialHeading>
    <div class="legal-document__body">
      <slot />
    </div>
  </section>
</Layout>

<style>
  .legal-document {
    width: min(calc(100% - clamp(44px, 10vw, 144px)), 860px);
    margin-inline: auto;
    padding-block: clamp(96px, 10vw, 140px);
  }
  .legal-document__body {
    margin-top: 32px;
    font: 400 16px/1.75 var(--v58-ui);
    color: var(--v58-muted);
    overflow-wrap: anywhere;
  }
  .legal-document__body :global(h2) {
    margin: 2em 0 0.75em;
    font: 500 clamp(1.5rem, 3vw, 2rem)/1.2 var(--v58-display);
    color: var(--v58-ink);
  }
  .legal-document__body :global(h3) {
    margin: 1.5em 0 0.5em;
    font: 500 1.25rem/1.3 var(--v58-display);
    color: var(--v58-ink);
  }
  .legal-document__body :global(p),
  .legal-document__body :global(ul),
  .legal-document__body :global(ol) {
    margin-block: 1em;
  }
  .legal-document__body :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
  }
  .legal-document__body :global(ol) {
    list-style: decimal;
    padding-left: 1.5em;
  }
  .legal-document__body :global(a) {
    color: var(--v58-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
