---
import '../assets/styles/v9/foundation.css';
import HeadAssets from '../components/v9/HeadAssets.astro';
import Header from '../components/v9/Header.astro';
import Footer from '../components/v9/Footer.astro';
interface Props {
  title: string;
  description: string;
  audience?: 'hiring' | 'candidate';
  activeRoute?: string;
  cta?: { label: string; href: string };
  canonicalPath?: string;
  noindex?: boolean;
  footerLinkOverrides?: Record<string, string>;
  headerLinkOverrides?: Record<string, string>;
}
const {
  title,
  description,
  audience = 'hiring',
  activeRoute = Astro.url.pathname,
  cta,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  footerLinkOverrides,
  headerLinkOverrides,
} = Astro.props;
const canonical = new URL(canonicalPath, 'https://www.tribera.ai');
---

<!doctype html>
<html lang="en-IN" class="v9-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />
    <HeadAssets />
    <slot name="head" />
  </head>
  <body class="v9" id="top">
    <a class="v9-skip" href="#main">Skip to content</a>
    <Header {audience} {activeRoute} {cta} linkOverrides={headerLinkOverrides} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer linkOverrides={footerLinkOverrides} />
    <script>
      import '../scripts/v9/foundation';
    </script>
  </body>
</html>
