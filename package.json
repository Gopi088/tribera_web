{
  "name": "tribera-website",
  "version": "1.0.0-beta.52",
  "description": "Marketing website for tribera, an AI plus advisor talent intelligence platform.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bash scripts/netlify-dev.sh",
    "start": "bash scripts/netlify-dev.sh",
    "dev:astro": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:handlers": "node --test tests/netlify-functions.test.mjs",
    "visual:shots": "node scripts/visual-sweep.mjs",
    "visual:shots:all": "npm run build && npm run visual:shots",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w ."
  },
  "dependencies": {
