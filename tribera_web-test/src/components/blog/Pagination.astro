---
import { Icon } from '~/components/common/icon-module';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'Newer posts', nextText = 'Older posts' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 sm:px-8 lg:px-12">
      <a
        href={prevUrl ? getPermalink(prevUrl) : undefined}
        class:list={[
          'inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2.5 text-[14px] font-medium text-black/60 transition-all duration-200 hover:border-[#da0007]/25 hover:text-black hover:shadow-[0_10px_30px_-20px_rgba(218,0,7,0.35)]',
          !prevUrl && 'pointer-events-none invisible',
        ]}
      >
        <Icon name="tabler:chevron-left" class="h-4 w-4" />
        <span>{prevText}</span>
      </a>

      <a
        href={nextUrl ? getPermalink(nextUrl) : undefined}
        class:list={[
          'inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2.5 text-[14px] font-medium text-black/60 transition-all duration-200 hover:border-[#da0007]/25 hover:text-black hover:shadow-[0_10px_30px_-20px_rgba(218,0,7,0.35)]',
          !nextUrl && 'pointer-events-none invisible',
        ]}
      >
        <span>{nextText}</span>
        <Icon name="tabler:chevron-right" class="h-4 w-4" />
      </a>
    </div>
  )
}
