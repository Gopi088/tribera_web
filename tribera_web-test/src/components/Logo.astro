---
import { SITE } from 'astrowind:config';
import Image from '~/components/common/Image.astro';
const logo = '~/assets/images/tribera_logo_default.svg';
const { variant = 'header' } = Astro.props;

const sizes = {
  header: {
    frame: 'h-[28px] w-[92px] sm:h-[33px] sm:w-[110px]',
    image: 'h-[92px] w-[92px] -translate-x-[2px] -translate-y-[33px] sm:h-[110px] sm:w-[110px] sm:-translate-y-[40px]',
    dots: 'mt-0.5 gap-1 pl-[4px] sm:gap-1 sm:pl-[5px]',
    dotSize: 'h-[5px] w-[5px] sm:h-1.5 sm:w-1.5',
  },
  footer: {
    frame: 'h-[28px] w-[92px] sm:h-[33px] sm:w-[110px]',
    image: 'h-[92px] w-[92px] -translate-x-[2px] -translate-y-[33px] sm:h-[110px] sm:w-[110px] sm:-translate-y-[40px]',
    dots: 'mt-0.5 gap-1 pl-[4px] sm:mt-0.5 sm:gap-1 sm:pl-[5px]',
    dotSize: 'h-[5px] w-[5px] sm:h-1.5 sm:w-1.5',
  },
};

const current = sizes[variant] ?? sizes.header;
---

<div class="inline-flex flex-col items-start">
  <div class:list={['relative overflow-hidden', current.frame]}>
    <Image src={logo} alt={SITE?.name} width={140} height={140} class:list={['block max-w-none', current.image]} />
  </div>
  <div class:list={['flex items-center', current.dots]}>
    <span class:list={[current.dotSize, 'rounded-full bg-[#c2c2c2]']}></span>
    <span class:list={[current.dotSize, 'rounded-full bg-[#c2c2c2]']}></span>
    <span class:list={[current.dotSize, 'rounded-full bg-[#da0007]']}></span>
  </div>
</div>
