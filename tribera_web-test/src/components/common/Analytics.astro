---
import { ANALYTICS } from 'astrowind:config';

const analyticsId = ANALYTICS?.vendors?.googleAnalytics?.id ? String(ANALYTICS.vendors.googleAnalytics.id) : '';
const usePartytown = Boolean(ANALYTICS?.vendors?.googleAnalytics?.partytown);
const analyticsBootstrap = analyticsId
  ? [
      'window.dataLayer = window.dataLayer || [];',
      'function gtag(){dataLayer.push(arguments);}',
      "gtag('js', new Date());",
      `gtag('config', '${analyticsId}');`,
    ].join('\n')
  : '';
---

{
  analyticsId ? (
    <>
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}
        type={usePartytown ? 'text/partytown' : undefined}
      />
      <script type={usePartytown ? 'text/partytown' : undefined} is:inline set:html={analyticsBootstrap} />
    </>
  ) : null
}
