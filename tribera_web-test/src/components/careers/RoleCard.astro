---
type Role = {
  title: string;
  slug: string;
  permalink?: string;
  summary: string;
  department: string;
  employmentType?: string;
  location?: string;
  remotePolicy?: string;
  experienceLevel?: string;
  positions?: number;
};

const { role, featured = false } = Astro.props as {
  role: Role;
  featured?: boolean;
};

const href = role.permalink || `/careers/${role.slug}`;

const labelMap: Record<string, string> = {
  'full-time': 'Full-time',
  'go-to-market': 'Go-to-market',
  intern: 'Intern',
};

const formatLabel = (value: string) => {
  const normalized = value.toLowerCase();

  if (labelMap[normalized]) {
    return labelMap[normalized];
  }

  if (/[0-9]/.test(value)) {
    return value;
  }

  return value
    .split(/[-_]+|\s+/)
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())
    .join(' ');
};

const metaItems = [
  role.employmentType ? formatLabel(role.employmentType) : undefined,
  role.location,
  role.remotePolicy ? formatLabel(role.remotePolicy) : undefined,
  role.experienceLevel,
].filter((item): item is string => Boolean(item));

const positions = role.positions ?? 1;
---

<a
  href={href}
  data-astro-reload
  aria-label={`View ${role.title}`}
  class:list={[
    'group relative block overflow-hidden rounded-2xl border border-black/5 bg-white p-5 md:p-7 shadow-[0_12px_35px_rgba(0,0,0,0.05)] transition-all duration-500 hover:-translate-y-1',
    featured ? 'hover:shadow-[0_20px_50px_rgba(218,0,7,0.16)]' : 'hover:shadow-[0_18px_50px_rgba(218,0,7,0.14)]',
  ]}
>
  <div
    class:list={[
      'absolute inset-x-0 top-0 h-[3px]',
      featured ? 'bg-gradient-to-r from-[#da0007] to-[#ff6b6b]' : 'bg-[#da0007]',
    ]}
  >
  </div>

  {
    featured && (
      <div class="absolute right-4 top-4 rounded-full border border-[#da0007]/15 bg-[#da0007]/8 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#da0007]">
        Featured
      </div>
    )
  }

  <div class="relative z-10 pr-12 sm:pr-16">
    <p class="text-[11px] uppercase tracking-[0.22em] text-[#da0007]">{role.department}</p>
    <h3 class="mt-3 text-[19px] sm:text-[21px] font-[700] leading-[1.12] text-black">{role.title}</h3>
  </div>

  <p class="mt-3 text-[13px] sm:text-[14px] leading-relaxed text-black/60">{role.summary}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {
      metaItems.map((item) => (
        <span class="inline-flex items-center rounded-full border border-black/10 bg-black/[0.02] px-3 py-1 text-[11px] font-[600] text-black/65">
          {item}
        </span>
      ))
    }
  </div>

  <div class="mt-5 flex items-center justify-between gap-4 border-t border-black/5 pt-4 sm:mt-6 sm:pt-5">
    <span class="text-[12px] text-black/45">
      {positions} position{positions === 1 ? '' : 's'}
    </span>
    <span
      class="inline-flex items-center justify-center rounded-full bg-[#da0007] px-4 py-2 text-[12px] font-semibold text-white transition duration-300 group-hover:bg-[#c50006]"
    >
      View role
    </span>
  </div>
</a>
